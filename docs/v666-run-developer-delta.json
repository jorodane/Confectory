    ".run-debug-info{position:absolute;top:10px;left:10px;max-width:calc(100% - 20px);padding:7px 9px;border:1px solid #7fa3a34d;border-radius:5px;background:#0b111bd9;color:#c9e7e0;z-index:4;font-size:10px;line-height:1.6;font-variant-numeric:tabular-nums;white-space:pre-line;pointer-events:none}",
