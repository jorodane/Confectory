var state=AppDomain.CurrentDomain.GetData("Confectory.EditorHome."+session) as object[];if(state is null)return;
lock(state){
 // true means closing: commands are rejected, but CloseSession remains retryable.
 state[6]=true;var errors=new System.Collections.Generic.List<Exception>();
 try{calls.ChatUse.Invoke(session,"close","{}");}catch(Exception error){errors.Add(error);}
 try{calls.HelperAgents.Invoke(session,"close","{}");}catch(Exception error){errors.Add(error);}
 try{if(AppDomain.CurrentDomain.GetData("Confectory.EditorHome.McpBridge."+session+".stop") is Action stopMcp)stopMcp();}catch(Exception error){errors.Add(error);}
 try{calls.CodexOnboarding.Invoke(session,"close","{}");}catch(Exception error){errors.Add(error);}
 // Retire compiler leases before draft owners attempt their final Save.
 try{calls.StopBuilds.Invoke(calls.Executions.Invoke((string[])state[0]));}catch(Exception error){throw new AggregateException("Build jobs remain closing; retry CloseSession",error);}
 try{calls.CodexPreparation.Invoke(session,"close","{}");}catch(Exception error){errors.Add(error);}
 try{calls.CodexLogin.Invoke(session,"close","{}");}catch(Exception error){errors.Add(error);}
 var aiSessions=(System.Collections.Generic.Dictionary<string,string>)state[11];
 foreach(var entry in System.Linq.Enumerable.ToArray(aiSessions)){try{calls.AIClose.Invoke(entry.Value);aiSessions.Remove(entry.Key);}catch(Exception error){errors.Add(error);}}
 foreach(var check in ((System.Text.Json.Nodes.JsonObject)state[3])["connectionChecks"]?.AsObject()??new System.Text.Json.Nodes.JsonObject())try{calls.CodexVerification.Invoke(check.Value!.ToString(),"close","{}");}catch(Exception error){errors.Add(error);}
 // Keep borrowed draft/project/Helper resources alive if an AI owner cannot retire.
 if(errors.Count>0)throw new AggregateException("Project AI remains closing; retry CloseSession",errors);
 var boxes=(System.Collections.Generic.Dictionary<string,string>)state[12];foreach(var box in System.Linq.Enumerable.ToArray(boxes)){try{calls.YogiClose.Invoke(box.Value);boxes.Remove(box.Key);}catch(Exception error){errors.Add(error);}}
 if(errors.Count>0)throw new AggregateException("Yogi storage remains closing; live project resources retained for retry",errors);
 try{calls.CloseTables.Invoke(session,"");}catch(Exception error){errors.Add(error);}
 if(errors.Count>0)throw new AggregateException("Table views remain closing; borrowed project resources retained for retry",errors);
 var shells=(System.Collections.Generic.Dictionary<string,string>)state[7];
 foreach(var shell in System.Linq.Enumerable.ToArray(shells)){try{calls.ShellClose.Invoke(shell.Value);shells.Remove(shell.Key);}catch(Exception error){errors.Add(error);}}
 var packViews=(System.Collections.Generic.Dictionary<string,string>)state[9];
 foreach(var view in System.Linq.Enumerable.ToArray(packViews)){try{calls.PackClose.Invoke(view.Value);packViews.Remove(view.Key);}catch(Exception error){errors.Add(error);}}
 var workspaces=(System.Collections.Generic.List<string>)state[5];
 foreach(string workspace in workspaces.ToArray()){try{calls.WorkspaceClose.Invoke(workspace);workspaces.Remove(workspace);}catch(Exception error){errors.Add(error);}}
 if(((string)state[10]).Length>0)try{calls.HelperClose.Invoke((string)state[10]);state[10]="";}catch(Exception error){errors.Add(error);}
 try{calls.Dispose.Invoke((string[])state[0]);}catch(Exception error){errors.Add(error);}
 if(errors.Count>0)throw new AggregateException("Entry/home resources remain closing; retry CloseSession",errors);
 AppDomain.CurrentDomain.SetData("Confectory.EditorHome.BuildCursor."+session,null);
 AppDomain.CurrentDomain.SetData("Confectory.EditorHome.ContextActions."+session,null);
 AppDomain.CurrentDomain.SetData("Confectory.EditorHome."+session,null);
}
