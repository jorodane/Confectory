 var unique=new System.Collections.Generic.HashSet<string>(StringComparer.Ordinal);foreach(var key in expanded){string id=key?.GetValue<string>()??"";if(id.Length==0||id.Length>512||!unique.Add(id)||!(id=="root"||id.StartsWith("ns:",StringComparison.Ordinal)||id.StartsWith("decl:",StringComparison.Ordinal)))throw new ArgumentException("Native tree expansion identity");}
