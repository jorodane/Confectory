var args=System.Text.Json.Nodes.JsonNode.Parse(payload)!.AsObject();
if(operation=="project"){
 var value=Validate(args["value"]!.AsObject());var inventory=args["inventory"]!;var relations=args["relationsMap"]!;
 string Group(string kind)=>kind is "function" or "implementation"?"feature":kind=="module"?"module":"concept";
 var rows=new System.Collections.Generic.Dictionary<string,System.Text.Json.Nodes.JsonObject>(StringComparer.Ordinal);var owned=new System.Collections.Generic.Dictionary<string,System.Text.Json.Nodes.JsonObject>(StringComparer.Ordinal);var links=new System.Collections.Generic.Dictionary<string,System.Text.Json.Nodes.JsonArray>(StringComparer.Ordinal);var sources=new System.Collections.Generic.Dictionary<string,System.Text.Json.Nodes.JsonObject>(StringComparer.Ordinal);
 foreach(var row in inventory["declarations"]?.AsArray()??new System.Text.Json.Nodes.JsonArray()){var item=row!.DeepClone().AsObject();item["group"]=Group(item["kind"]!.ToString());rows[item["id"]!.ToString()]=item;}
 foreach(var node in relations["nodes"]?.AsArray()??new System.Text.Json.Nodes.JsonArray())if(node?["owned"]?.GetValue<bool>()==true)owned[node["id"]!.ToString()]=node.AsObject();
 foreach(var edge in relations["edges"]?.AsArray()??new System.Text.Json.Nodes.JsonArray()){
  string id=edge!["source"]!.ToString();if(!links.ContainsKey(id))links[id]=new();links[id].Add(edge.DeepClone());
  if(owned.TryGetValue(id,out var source)&&source["valid"]?.GetValue<bool>()==true)foreach(string field in new[]{"target","function","scope"})if(edge[field] is not null&&!sources.ContainsKey(edge[field]!.ToString()))sources[edge[field]!.ToString()]=source;
 }
 foreach(var pair in owned){var item=pair.Value.DeepClone().AsObject();item["namespace"]=pair.Key.Split("::")[0];item["group"]=Group(item["kind"]!.ToString());item["parent"]=null;var extra=new System.Text.Json.Nodes.JsonArray();foreach(var edge in links.TryGetValue(pair.Key,out var found)?found:new System.Text.Json.Nodes.JsonArray()){if(edge!["role"]?.ToString()=="parent"&&item["parent"] is null)item["parent"]=edge["target"]?.DeepClone();if(edge["role"]?.ToString()=="contain"||edge["kind"]?.ToString()=="schema"&&edge["role"]?.ToString() is "use" or "field")extra.Add(edge.DeepClone());}item["relationships"]=extra;rows[pair.Key]=item;}
 var parents=new System.Text.Json.Nodes.JsonObject();foreach(var pair in rows){var row=pair.Value;string id=pair.Key,status=row["owned"]?.GetValue<bool>()==true?(row["valid"]?.GetValue<bool>()==false?"invalid-source":owned.ContainsKey(id)?"root":"unobserved"):"unobserved",parent=row["parent"]?.ToString()??"",accepted="";
  if(parent.Length>0&&row["valid"]?.GetValue<bool>()!=false){string at=parent;int depth=0;var seen=new System.Collections.Generic.HashSet<string>(StringComparer.Ordinal){id};status="linked";while(at.Length>0){if(depth++>=64){status="depth-limit";break;}if(!seen.Add(at)){status=at==id?"cycle":"ancestor-cycle";break;}if(!rows.TryGetValue(at,out var target)){status=depth==1?"unresolved":"ancestor-unresolved";break;}if(target["group"]!.ToString()!=row["group"]!.ToString()){status=depth==1?"group-boundary":"ancestor-boundary";break;}if(target["valid"]?.GetValue<bool>()==false){status=depth==1?"invalid-parent":"ancestor-invalid";break;}at=target["parent"]?.ToString()??"";}if(status=="linked"||status.StartsWith("ancestor-",StringComparison.Ordinal))accepted=parent;}
  row["status"]=status;row["declaredParent"]=parent;row["acceptedParent"]=accepted;parents[id]=new System.Text.Json.Nodes.JsonObject{["parent"]=accepted,["status"]=status,["declaredParent"]=parent};if(sources.TryGetValue(id,out var source))row["source"]=new System.Text.Json.Nodes.JsonObject{["sourceId"]=source["id"]!.DeepClone(),["expectedRevision"]=source["revision"]!.DeepClone(),["expectedHash"]=source["textHash"]!.DeepClone(),["id"]=id};
 }
 var nodes=new System.Collections.Generic.Dictionary<string,System.Text.Json.Nodes.JsonObject>(StringComparer.Ordinal);nodes["root"]=new(){["key"]="root",["label"]="ProjectPack",["kind"]="root",["parent"]=""};
 string Namespace(string name){if(name.Length==0)return "root";string key="ns:"+name;if(nodes.ContainsKey(key))return key;int split=name.LastIndexOf('.');string parent=Namespace(split<0?"":name[..split]);nodes[key]=new(){["key"]=key,["label"]=split<0?name:name[(split+1)..],["kind"]="namespace",["parent"]=parent};return key;}
 foreach(var pack in inventory["packs"]?.AsArray()??new System.Text.Json.Nodes.JsonArray())nodes[Namespace(pack!["namespace"]!.ToString())]["pack"]=true;
 string group=value["group"]!.ToString();var visible=System.Linq.Enumerable.ToDictionary(System.Linq.Enumerable.Where(rows,p=>group.Length==0||(group=="category"?p.Value["kind"]!.ToString()=="category":p.Value["group"]!.ToString()==group)),p=>p.Key,p=>p.Value,StringComparer.Ordinal);
 foreach(var pair in visible){string ns=pair.Key.Split("::")[0];Namespace(ns);string parent=pair.Value["acceptedParent"]!.ToString();nodes["decl:"+pair.Key]=new(){["key"]="decl:"+pair.Key,["label"]=pair.Key.Split("::")[^1],["kind"]="declaration",["parent"]=parent.Length>0&&visible.ContainsKey(parent)?"decl:"+parent:"ns:"+ns,["row"]=pair.Value.DeepClone()};}
 var children=new System.Collections.Generic.Dictionary<string,System.Collections.Generic.List<string>>(StringComparer.Ordinal);foreach(var node in nodes.Values){string parent=node["parent"]!.ToString();if(parent.Length==0)continue;if(!children.ContainsKey(parent))children[parent]=new();children[parent].Add(node["key"]!.ToString());}foreach(var list in children.Values)list.Sort((a,b)=>{int kind=(nodes[a]["kind"]!.ToString()=="declaration"?1:0).CompareTo(nodes[b]["kind"]!.ToString()=="declaration"?1:0);return kind!=0?kind:StringComparer.Ordinal.Compare(a,b);});
 var expanded=new System.Collections.Generic.HashSet<string>(System.Linq.Enumerable.Select(value["expanded"]!.AsArray(),k=>k!.ToString()),StringComparer.Ordinal);var keep=new System.Collections.Generic.HashSet<string>(StringComparer.Ordinal);var forced=new System.Collections.Generic.HashSet<string>(StringComparer.Ordinal);string query=value["query"]!.ToString().Trim();
 if(query.Length>0)foreach(var node in nodes.Values){string haystack=node["row"] is System.Text.Json.Nodes.JsonNode row?row["id"]+" "+row["title"]+" "+row["declaredParent"]:node["key"]!.ToString()+" "+node["label"];if(!haystack.Contains(query,StringComparison.OrdinalIgnoreCase))continue;string at=node["key"]!.ToString();while(at.Length>0&&keep.Add(at)){string parent=nodes[at]["parent"]!.ToString();if(parent.Length>0)forced.Add(parent);at=parent;}}
 var flat=new System.Text.Json.Nodes.JsonArray();var stack=new System.Collections.Generic.Stack<(string Key,int Depth)>();stack.Push(("root",0));bool truncated=false;while(stack.Count>0){var (key,depth)=stack.Pop();if(query.Length>0&&!keep.Contains(key))continue;if(flat.Count>=2048){truncated=true;break;}var node=nodes[key].DeepClone().AsObject();node["depth"]=depth;node["hasChildren"]=children.ContainsKey(key);node["expanded"]=expanded.Contains(key)||forced.Contains(key);flat.Add(node);if(node["expanded"]!.GetValue<bool>()&&children.TryGetValue(key,out var kids))for(int n=kids.Count-1;n>=0;n--)stack.Push((kids[n],depth+1));}
 string selection=value["selection"]!.ToString();System.Text.Json.Nodes.JsonObject? selectedRow=null;if(nodes.TryGetValue(selection,out var selected)){selectedRow=selected.DeepClone().AsObject();selectedRow["hasChildren"]=children.ContainsKey(selection);selectedRow["expanded"]=expanded.Contains(selection)||forced.Contains(selection);int selectedDepth=0;string at=selected["parent"]!.ToString();while(at.Length>0){selectedDepth++;at=nodes[at]["parent"]!.ToString();}selectedRow["depth"]=selectedDepth;}return new System.Text.Json.Nodes.JsonObject{["rows"]=flat,["selected"]=selectedRow,["missingSelection"]=!nodes.ContainsKey(selection),["truncated"]=truncated,["parents"]=parents,["depthLimit"]=64,["rowLimit"]=2048}.ToJsonString();
}
if(operation is not ("load" or "save"))throw new ArgumentException("Native tree operation");
string relative="native-trees/"+Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(project))).ToLowerInvariant()+".json",path=System.IO.Path.Combine(storage,relative);
if(System.IO.File.Exists(path)&&new System.IO.FileInfo(path).Length>262144)throw new ArgumentException("Native tree saved byte budget");var saved=calls.Snapshot.Invoke(path);if(saved[1].Length>262144)throw new ArgumentException("Native tree saved byte budget");
var state=saved[0]=="exists"?Validate(System.Text.Json.Nodes.JsonNode.Parse(saved[1])!.AsObject()):new System.Text.Json.Nodes.JsonObject{["version"]=1,["projectId"]=project,["expanded"]=new System.Text.Json.Nodes.JsonArray("root"),["selection"]="root",["query"]="",["queryInput"]="",["group"]="concept",["offset"]=0};
if(operation=="save"){if(args.Count!=2||args["revision"]?.GetValue<string>()!=saved[2])throw new InvalidOperationException("Native tree saved state changed; inputs retained, reload explicitly");var candidate=Validate(args["value"]!.DeepClone().AsObject());if(calls.Commit.Invoke(storage,new[]{relative},new[]{saved[2]},new[]{candidate.ToJsonString()})[0]!="applied")throw new InvalidOperationException("Native tree saved state changed; inputs retained");state=candidate;saved=calls.Snapshot.Invoke(path);}
return new System.Text.Json.Nodes.JsonObject{["status"]="available",["revision"]=saved[2],["value"]=state}.ToJsonString();
