string[] snapshot;
try{for(string? check=path;check is not null;check=System.IO.Path.GetDirectoryName(check))if((System.IO.File.Exists(check)||System.IO.Directory.Exists(check))&&(System.IO.File.GetAttributes(check)&System.IO.FileAttributes.ReparsePoint)!=0)throw new InvalidOperationException();if(System.IO.Directory.Exists(path)||System.IO.File.Exists(path)&&new System.IO.FileInfo(path).Length>262144)throw new InvalidOperationException();snapshot=calls.Snapshot.Invoke(path);if(snapshot[0]=="exists")Validate(System.Text.Json.Nodes.JsonNode.Parse(snapshot[1])!);}
