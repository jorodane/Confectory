if(operation!="save")throw new ArgumentException("profile_operation");var input=System.Text.Json.Nodes.JsonNode.Parse(payload)!.AsObject();Keys(input,new[]{"revision","value"});if(input["revision"]?.ToString()!=snapshot[2])throw new InvalidOperationException("profile_storage_changed");var candidate=Validate(input["value"]!);string serialized=candidate.ToJsonString();if(calls.Commit.Invoke(root,new[]{file},new[]{snapshot[2]},new[]{serialized})[0]!="applied")throw new InvalidOperationException("profile_storage_changed");return new System.Text.Json.Nodes.JsonObject{["status"]="ready",["revision"]=Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(serialized))).ToLowerInvariant(),["value"]=candidate.DeepClone()}.ToJsonString();
