System.Text.Json.Nodes.JsonObject Validate(System.Text.Json.Nodes.JsonNode node){var value=node.AsObject();Keys(value,new[]{"version","name","title","status","introduction","icon"});if(value["version"]?.GetValue<int>()!=1)throw new ArgumentException("profile_version");foreach(var field in new[]{("name",40),("title",60),("status",120),("introduction",500)}){string text=value[field.Item1]?.GetValue<string>()??throw new ArgumentException("profile_text");if(text.Length>field.Item2||field.Item1=="name"&&string.IsNullOrWhiteSpace(text)||text.IndexOf('\0')>=0)throw new ArgumentException("profile_text_budget");}string icon=value["icon"]?.GetValue<string>()??throw new ArgumentException("profile_icon");if(icon.StartsWith("data:",StringComparison.Ordinal)){var match=System.Text.RegularExpressions.Regex.Match(icon,"^data:image/(png|jpeg|webp);base64,([A-Za-z0-9+/=]+)$");if(icon.Length>131072||!match.Success)throw new ArgumentException("profile_icon_budget");byte[] bytes=Convert.FromBase64String(match.Groups[2].Value);bool valid=match.Groups[1].Value switch{"png"=>bytes.Length>=8&&bytes[0]==137&&bytes[1]==80&&bytes[2]==78&&bytes[3]==71&&bytes[4]==13&&bytes[5]==10&&bytes[6]==26&&bytes[7]==10,"jpeg"=>bytes.Length>=3&&bytes[0]==255&&bytes[1]==216&&bytes[2]==255,"webp"=>bytes.Length>=12&&System.Text.Encoding.ASCII.GetString(bytes,0,4)=="RIFF"&&System.Text.Encoding.ASCII.GetString(bytes,8,4)=="WEBP",_=>false};if(!valid)throw new ArgumentException("profile_icon_format");}else if(icon.Length>128||icon.IndexOf('\0')>=0)throw new ArgumentException("profile_icon_budget");return value;}
