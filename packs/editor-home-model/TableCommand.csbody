 if(!System.Text.RegularExpressions.Regex.IsMatch(table,"\\A[a-zA-Z0-9_-]{1,64}\\z",System.Text.RegularExpressions.RegexOptions.CultureInvariant))throw new ArgumentException("Bounded table identity required");string key=prefix+table;
 if(action is "open" or "configure"){
  var ids=System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Select(args["ids"]!.AsArray(),v=>v!.GetValue<string>()));var columns=System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Select(args["columns"]!.AsArray(),v=>v!.GetValue<string>()));string request=args["request"]?.GetValue<string>()??"";
  if(System.Linq.Enumerable.Any(ids,id=>!id.StartsWith(selected["namespace"]!.ToString()+"::",StringComparison.Ordinal)))throw new ArgumentException("Table rows require root-owned objects");
  if(action=="configure"&&(rows[table] is null||args["definitionHash"]?.ToString()!=rows[table]!["definitionHash"]!.ToString()))throw new InvalidOperationException("Table definition changed; inspect the current definition before configuring");
  if(action=="open"&&rows[table] is not null){if(!System.Text.Json.Nodes.JsonNode.DeepEquals(rows[table]!["ids"],args["ids"])||!System.Text.Json.Nodes.JsonNode.DeepEquals(rows[table]!["columns"],args["columns"])||rows[table]!["request"]!.ToString()!=request)throw new InvalidOperationException("Table definition changed; open a new table identity");Snapshot(table);return;}
  if(rows[table] is null&&rows.Count>=8)throw new InvalidOperationException("Close an existing table before opening another");
  string handle=calls.Create.Invoke(calls.Borrow.Invoke(workspace),ids,columns,request);try{
   var snapshot=System.Text.Json.Nodes.JsonNode.Parse(calls.Snapshot.Invoke(handle));
   string definitionHash=Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(new System.Text.Json.Nodes.JsonObject{["ids"]=args["ids"]!.DeepClone(),["columns"]=args["columns"]!.DeepClone(),["request"]=request}.ToJsonString()))).ToLowerInvariant();
   if(handles.TryGetValue(key,out string? previous))calls.Close.Invoke(previous);
   rows[table]=new System.Text.Json.Nodes.JsonObject{["table"]=table,["projectId"]=selected["projectId"]!.DeepClone(),["ids"]=args["ids"]!.DeepClone(),["columns"]=args["columns"]!.DeepClone(),["request"]=request,["definitionHash"]=definitionHash,["snapshot"]=snapshot};handles[key]=handle;
  }catch{calls.Close.Invoke(handle);throw;}return;
 }
 if(rows[table] is null||!handles.TryGetValue(key,out string? owned))throw new InvalidOperationException("Reopen the actual table for this project");
 if(action=="close"){calls.Close.Invoke(owned);handles.Remove(key);rows.Remove(table);return;}
 if(action=="refresh"){Snapshot(table);return;}
 if(action!="edit")throw new ArgumentException("Supported table action required");
 var selectedIds=System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Select(args["ids"]!.AsArray(),v=>v!.GetValue<string>()));
 bool applied=calls.Edit.Invoke(owned,selectedIds,args["field"]!.GetValue<string>(),args["valueJson"]?.GetValue<string>()??"null",args["versions"]!.ToJsonString(),args["operation"]!.GetValue<string>());
 if(!applied){model["status"]="Table version conflict; refresh explicitly; unapplied input retained";throw new InvalidOperationException("Table displayed source or schema version changed");}
 calls.PackCommand.Invoke(workspace,"cancel-review","{}");
 foreach(var pair in rows)Snapshot(pair.Key);model["status"]="Table drafts staged; Save and Review/Confirm remain explicit";
}
