 // Startup and explicit Send inspect only an already registered, active CLI/account.
 // Neither path discovers, installs, logs in, changes identity or registers an Agent.
 string RegisteredReadiness(System.Text.Json.Nodes.JsonObject binding,bool begin,string ticket,bool retry=false){
  string agent=binding["connection"]!.ToString(),basis=BindingBasis(binding);
  string Reply(string phase,string code,string message,string token=""){var result=new System.Text.Json.Nodes.JsonObject{["state"]=phase,["code"]=code,["message"]=message,["token"]=token};return result.ToJsonString();}
  if(binding["offline"]?.GetValue<bool>()==true)return Reply("blocked","agent-offline","연결 해제한 Agent입니다. Codex에서 다시 연결하세요.");
  if(agent!="Confectory.Agent.Codex::Connection")return ticket.Length>0?Reply("blocked","codex-readiness-changed","확인 중인 Agent가 바뀌었어요. 다시 보내세요."):Reply("ready","ready","");
  string pin=binding["identity"]?["fingerprint"]?.ToString()??"";
  if(binding["config"]?["connectionMethod"]?.ToString()!="local-cli"||!System.Text.RegularExpressions.Regex.IsMatch(pin,"^[a-f0-9]{64}$"))return Reply("blocked","codex-registration-unverified","등록한 계정 확인이 필요해요. Codex에서 사용할 계정을 확인하세요.");
  if(!System.IO.File.Exists(binding["config"]?["executable"]?.ToString()??""))return Reply("blocked","codex-runtime-missing","등록한 Codex 실행 파일을 찾지 못했어요.");
  var status=System.Text.Json.Nodes.JsonNode.Parse(calls.CodexVerification.Invoke(binding["config"]!.ToJsonString(),"status","{}"))!;readiness.TryGetValue(agent,out var pending);
  if(!begin&&(pending is null||ticket!=pending["token"]?.ToString()||basis!=pending["basis"]?.ToString()||status["checkId"]?.ToString()!=pending["checkId"]?.ToString()))return Reply("blocked","codex-readiness-changed","확인 중인 Agent 설정이 바뀌었어요. 다시 보내세요.");
  if(status["supported"]?.GetValue<bool>()==true){if(status["accountIdentity"]?["fingerprint"]?.ToString()!=pin){calls.ChatUse.Invoke(session,"revoke-agent",System.Text.Json.JsonSerializer.Serialize(new{agent}));return Reply("blocked","codex-account-mismatch","등록한 계정의 확인 정보가 달라요. Codex에서 사용할 계정을 확인하세요.");}return Reply("ready","ready","");}
  if(status["state"]?.ToString()=="checking"){if(pending?["basis"]?.ToString()==basis&&pending["checkId"]?.ToString()==status["checkId"]?.ToString())return Reply("checking","checking","등록한 계정의 연결 상태를 확인하고 있어요.",pending["token"]!.ToString());return Reply("blocked","codex-verification-busy","다른 연결 확인이 진행 중입니다. 완료 후 다시 보내세요.");}
