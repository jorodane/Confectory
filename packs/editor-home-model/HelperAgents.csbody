  return Reply("checking","checking","등록한 계정의 연결 상태를 확인하고 있어요.",attempt["token"]!.ToString());
 }
 void CancelReadiness(string agent){if(readiness.TryGetValue(agent,out var pending)){string config=pending["config"]!.ToJsonString();var status=System.Text.Json.Nodes.JsonNode.Parse(calls.CodexVerification.Invoke(config,"status","{}"))!;if(status["state"]?.ToString()=="checking"&&status["checkId"]?.ToString()==pending["checkId"]?.ToString())calls.CodexVerification.Invoke(config,"cancel","{}");}}
