  string result=RegisteredReadiness(Binding(Text("helper")),input["begin"]?.GetValue<bool>()==true,Text("token"));Publish();return result;
 }
 if(operation is "cancel-readiness" or "retry-readiness"){
  string agent=Text("agent");if(agent!="Confectory.Agent.Codex::Connection"||registry["agents"]?[agent] is not System.Text.Json.Nodes.JsonObject binding)throw new ArgumentException("Registered Codex Agent required");
