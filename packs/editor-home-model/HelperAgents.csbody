   var connectionState=item.Key=="Confectory.Agent.Codex::Connection"?ConnectionState(item.Value!,evidence):null;
   string status=item.Value?["offline"]?.GetValue<bool>()==true?"offline":evidence?["supported"]?.GetValue<bool>()==true?"ready":"configured";foreach(var turn in turns.Values){var row=(System.Text.Json.Nodes.JsonObject)turn[0];if(status!="offline"&&row["agent"]?.ToString()==item.Key&&row["state"]?.ToString()=="running")status="running";else if(status is not ("offline" or "running")&&row["agent"]?.ToString()==item.Key&&row["state"]?.ToString()=="completed"&&row["answerReceived"]?.GetValue<bool>()==true)status="responded";}
   if(connectionState is not null&&connectionState["state"]?.ToString()!="ready")status=connectionState["state"]!.ToString();
   agents.Add(new System.Text.Json.Nodes.JsonObject{["id"]=item.Key,["connection"]=item.Key,["model"]=item.Value!["config"]!["model"]!.DeepClone(),["state"]=status,["source"]="registered-configuration",["accountVerified"]=false,["accountMetadataVerified"]=evidence?["accountMetadataVerified"]?.GetValue<bool>()==true,["accountIdentity"]=item.Value?["identity"]?.DeepClone(),["configFingerprint"]=Hash(item.Value!["config"]!.ToJsonString()),["readiness"]=connectionState});
  }
