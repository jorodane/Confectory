  var savedSettings=new System.Text.Json.Nodes.JsonObject();foreach(string connection in new[]{"Confectory.Agent.Codex::Connection","Confectory.Agent.Responses::Connection"})savedSettings[connection]=System.IO.File.Exists(System.IO.Path.Combine(storage,"ai-settings",Hash(connection)[..16],"project.cpack"));
