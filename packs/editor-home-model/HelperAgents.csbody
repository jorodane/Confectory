   calls.PackCommand.Invoke(workspace,"select","{\"id\":\"Confectory.AISettings::Settings\"}");var projection=System.Text.Json.Nodes.JsonNode.Parse(calls.PackCommand.Invoke(workspace,"schema-view","{}"))!["effective"]!;if(projection["status"]?.ToString()!="available"||projection["schemaModel"]?["validation"]?["status"]?.ToString()!="valid")throw new InvalidOperationException("Provider configuration must satisfy its declared schema");
   var settings=new System.Text.Json.Nodes.JsonObject();foreach(var item in projection["schemaModel"]!["data"]!.AsObject()){if(item.Value?["kind"]?.ToString()!="general")throw new ArgumentException("Scalar provider settings required");settings[item.Key]=item.Value["scalar"]?.DeepClone();}
   var config=System.Text.Json.Nodes.JsonNode.Parse(calls.Configuration.Invoke(connection,settings.ToJsonString()))!;var next=(System.Text.Json.Nodes.JsonObject)registry.DeepClone();next["agents"]![connection]=new System.Text.Json.Nodes.JsonObject{["connection"]=connection,["config"]=config};if(connection=="Confectory.Agent.Codex::Connection"){var evidence=System.Text.Json.Nodes.JsonNode.Parse(calls.CodexVerification.Invoke(config.ToJsonString(),"status","{}"))!;if(evidence["supported"]?.GetValue<bool>()==true)next["agents"]![connection]!["identity"]=evidence["accountIdentity"]?.DeepClone();}if(connection=="Confectory.Agent.Codex::Connection"&&registry["agents"]?[connection] is System.Text.Json.Nodes.JsonNode oldBinding&&!System.Text.Json.Nodes.JsonNode.DeepEquals(oldBinding,next["agents"]![connection]))calls.ChatUse.Invoke(session,"revoke-agent",System.Text.Json.JsonSerializer.Serialize(new{agent=connection}));SaveRegistry(next);RetirePreview();
  }finally{calls.PackClose.Invoke(workspace);}Publish();return "{}";
 }
 if(operation is "create" or "import"){
