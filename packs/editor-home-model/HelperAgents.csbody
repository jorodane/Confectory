  foreach(var item in turns){var turn=item.Value;var row=(System.Text.Json.Nodes.JsonObject)turn[0];if(row["state"]?.ToString()!="running"||((string)turn[2]).Length==0)continue;var result=System.Text.Json.Nodes.JsonNode.Parse(calls.AgentPoll.Invoke((string)turn[2]))!;foreach(var e in result["events"]!.AsArray())if(e!["requestID"]?.ToString()==row["requestId"]!.ToString()&&e["kind"]?.ToString()=="delta")row["output"]=row["output"]!.ToString()+e["text"]!.ToString();row["state"]=result["state"]!.DeepClone();row["errorCode"]=result["errorCode"]?.DeepClone();row["errorDiagnostics"]=result["errorDiagnostics"]?.DeepClone();
   if(row["state"]!.ToString()!="running"){
    row["answerReceived"]=row["state"]!.ToString()=="completed"&&row["output"]!.ToString().Length>0;var journal=Journal(item.Key);var next=(System.Text.Json.Nodes.JsonObject)((System.Text.Json.Nodes.JsonObject)journal[0]).DeepClone();var record=System.Linq.Enumerable.Last(next["records"]!.AsArray());record!["state"]=row["state"]!.DeepClone();record["output"]=row["output"]!.DeepClone();record["errorCode"]=row["errorCode"]?.DeepClone();record["errorDiagnostics"]=row["errorDiagnostics"]?.DeepClone();try{SaveJournal(item.Key,journal,next);}catch{row["historyError"]="history_save_failed";}string agent=(string)turn[1];turn[3]=System.Threading.Tasks.Task.Run(()=>calls.AgentClose.Invoke(agent));
   }
  }Publish();return "{}";
 }
 if(operation!="snapshot")throw new ArgumentException("Unknown Helper/Agent action");RefreshHelpers();Publish();return model["helperAgents"]!.ToJsonString();
}
