 void ChangingAgent(string agent){foreach(var run in model["aiRuns"]?.AsObject()??new System.Text.Json.Nodes.JsonObject())if(run.Value?["state"]?.ToString()=="running"&&model["aiBindings"]?[run.Key]?["connection"]?.ToString()==agent)throw new InvalidOperationException("Stop this Agent's project request before changing it");if(model["aiPreview"]?["connection"]?.ToString()==agent)model["aiPreview"]=null;}
 void Cleanup(object[] turn,bool wait=false){if(((string)turn[1]).Length==0)return;if(turn[3] is System.Threading.Tasks.Task task){if(!task.IsCompleted&&(!wait||!task.Wait(5000)))throw new InvalidOperationException("Prior owned Agent is still closing");task.GetAwaiter().GetResult();turn[1]="";turn[3]=null!;}else{calls.AgentClose.Invoke((string)turn[1]);turn[1]="";}}
 System.Text.Json.Nodes.JsonObject ConnectionState(System.Text.Json.Nodes.JsonNode binding,System.Text.Json.Nodes.JsonNode? evidence){
  string code=evidence?["code"]?.ToString()??"preflight_required",phase="needs-check",pin=binding["identity"]?["fingerprint"]?.ToString()??"";
  if(binding["offline"]?.GetValue<bool>()==true){phase="offline";code="agent-offline";}
  else if(pin.Length==0){phase="unverified";code="codex-registration-unverified";}
  else if(evidence?["supported"]?.GetValue<bool>()==true){phase=evidence["accountIdentity"]?["fingerprint"]?.ToString()==pin?"ready":"account-mismatch";code=phase=="ready"?"ready":"codex-account-mismatch";}
  else if(evidence?["state"]?.ToString()=="checking")phase="checking";
  else if(evidence?["state"]?.ToString()=="unauthenticated")phase="auth-required";
  else if(!System.IO.File.Exists(binding["config"]?["executable"]?.ToString()??"")){phase="missing-runtime";code="codex-runtime-missing";}
  else if(evidence?["state"]?.ToString()=="cancelled")phase="cancelled";
  else if(evidence?["state"]?.ToString() is "blocked" or "unsupported")phase="blocked";
  if(!System.Text.RegularExpressions.Regex.IsMatch(code,"^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"))code="codex-readiness-failed";
  string message=phase switch{"ready"=>"Codex 연결 준비가 끝났어요. 실제 응답은 대화 요청 시 확인합니다.","checking"=>"등록한 Codex 연결을 확인하고 있어요.","offline"=>"연결 해제됨 · 기존 Helper와 설정은 보관됩니다.","auth-required"=>"저장된 인증을 사용할 수 없어요. Codex 로그인을 확인하세요.","account-mismatch"=>"등록한 계정과 확인 정보가 달라요. 사용할 계정을 확인하세요.","missing-runtime"=>"등록한 Codex 실행 파일을 찾지 못했어요.","unverified"=>"등록한 계정 정보를 먼저 확인하세요.","cancelled"=>"연결 확인을 취소했어요.","blocked"=>"Codex 연결 확인을 마치지 못했어요.",_=>"등록한 Codex 연결 상태를 다시 확인하세요."};
  return new System.Text.Json.Nodes.JsonObject{["state"]=phase,["code"]=code,["message"]=message};
 }
 void Publish(){
