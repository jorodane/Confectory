  string connection=binding["connection"]!.ToString();var policy=System.Text.Json.Nodes.JsonNode.Parse(calls.Permission.Invoke(connection,binding["config"]!.ToJsonString()))!.AsObject();PinAccount(binding,policy);policy["contentScope"]=new System.Text.Json.Nodes.JsonObject{["kind"]="helper-global",["helperId"]=helper,["conversationId"]=history["conversationId"]!.DeepClone()};policy["disclosures"]=new System.Text.Json.Nodes.JsonArray("This turn sends only the displayed global Helper profile, selected common memory, completed conversation history and message. No project memory/files/tools are granted.","Saved Agent configuration does not prove account authentication. Actual usage may incur charges; local draft/history saving is not an AI reply.");
  RetirePreview();string token=Guid.NewGuid().ToString("N");var row=new System.Text.Json.Nodes.JsonObject{["state"]="prepared",["helper"]=helper,["agent"]=connection,["requestId"]=token,["message"]=message,["includeCommon"]=common,["context"]=context,["config"]=binding["config"]!.DeepClone(),["policy"]=policy,["historyBasis"]=Hash(history.ToJsonString()),["output"]="",["answerReceived"]=false};turns[helper]=new object[]{row,"","",null!};model["globalHelperPreview"]=new System.Text.Json.Nodes.JsonObject{["helper"]=helper,["token"]=token,["connection"]=connection,["model"]=binding["config"]!["model"]!.DeepClone(),["message"]=message,["context"]=context.DeepClone(),["policy"]=policy.DeepClone(),["canStart"]=policy["supported"]?.DeepClone()};if(connection=="Confectory.Agent.Codex::Connection")model["globalHelperPreview"]!["useConsent"]=System.Text.Json.Nodes.JsonNode.Parse(calls.ChatUse.Invoke(session,"status",System.Text.Json.JsonSerializer.Serialize(new{kind="global",helper})));Publish();return model["globalHelperPreview"]!.ToJsonString();
 }
 if(operation=="cancel-preview"){RetirePreview();Publish();return "{}";}
 if(operation=="start"){
  string helper=Text("helper");Find(helper,true);if(!turns.TryGetValue(helper,out var turn))throw new InvalidOperationException("Prepare the exact global content first");var row=(System.Text.Json.Nodes.JsonObject)turn[0];var preview=model["globalHelperPreview"];if(preview?["helper"]?.ToString()!=helper||preview["token"]?.ToString()!=Text("token")||row["requestId"]!.ToString()!=Text("token")||row["state"]!.ToString()!="prepared")throw new InvalidOperationException("Global request approval is stale");
  var binding=Binding(helper);if(binding["offline"]?.GetValue<bool>()==true)throw new InvalidOperationException("The registered Agent is offline");var journal=Journal(helper);var current=(System.Text.Json.Nodes.JsonObject)journal[0];var context=System.Text.Json.Nodes.JsonNode.Parse(calls.Context.Invoke(store,helper,"local-user","",row["includeCommon"]!.GetValue<bool>()))!.AsObject();context["conversationId"]=current["conversationId"]!.DeepClone();context["history"]=row["context"]!["history"]!.DeepClone();var policy=System.Text.Json.Nodes.JsonNode.Parse(calls.Permission.Invoke(binding["connection"]!.ToString(),binding["config"]!.ToJsonString()))!.AsObject();PinAccount(binding,policy);policy["contentScope"]=row["policy"]!["contentScope"]!.DeepClone();policy["disclosures"]=row["policy"]!["disclosures"]!.DeepClone();
  if(binding["connection"]!.ToString()!=row["agent"]!.ToString()||binding["config"]!.ToJsonString()!=row["config"]!.ToJsonString()||context.ToJsonString()!=row["context"]!.ToJsonString()||Hash(current.ToJsonString())!=row["historyBasis"]!.ToString()||policy.ToJsonString()!=row["policy"]!.ToJsonString())throw new InvalidOperationException("Helper context, Agent or permission changed; prepare again");
  System.Text.Json.Nodes.JsonNode? use=null;if(binding["connection"]!.ToString()=="Confectory.Agent.Codex::Connection"){use=System.Text.Json.Nodes.JsonNode.Parse(calls.ChatUse.Invoke(session,"authorize",System.Text.Json.JsonSerializer.Serialize(new{kind="global",helper})))!;if(use["state"]?.ToString()!="granted")throw new UnauthorizedAccessException("chat-use-consent-required");}
  string grant;try{var authorization=System.Text.Json.Nodes.JsonNode.Parse(calls.Authorize.Invoke(policy.ToJsonString(),"",use?["approvals"]?.ToJsonString()??input["approvals"]?.ToJsonString()??"{}"))!;if(use is not null)authorization["chatUseToken"]=use["token"]!.DeepClone();grant=authorization.ToJsonString();var next=(System.Text.Json.Nodes.JsonObject)current.DeepClone();next["records"]!.AsArray().Add(new System.Text.Json.Nodes.JsonObject{["requestId"]=Text("token"),["agent"]=row["agent"]!.DeepClone(),["message"]=row["message"]!.DeepClone(),["output"]="",["state"]="running"});SaveJournal(helper,journal,next);}catch{if(use?["token"] is System.Text.Json.Nodes.JsonNode issuedToken&&AppDomain.CurrentDomain.GetData("Confectory.ChatUse.Guard."+issuedToken.ToString()) is object[] issuedGuard)((Action)issuedGuard[2])();throw;}
  try{turn[1]=calls.AgentOpen.Invoke(row["config"]!.ToJsonString());turn[2]=calls.AgentStart.Invoke((string)turn[1],Text("token"),new System.Text.Json.Nodes.JsonObject{["kind"]="helper-global-chat",["message"]=row["message"]!.DeepClone(),["context"]=context,["authorization"]=System.Text.Json.Nodes.JsonNode.Parse(grant)}.ToJsonString());row["state"]="running";model["globalHelperPreview"]=null;}catch{if(use?["token"] is System.Text.Json.Nodes.JsonNode useToken&&AppDomain.CurrentDomain.GetData("Confectory.ChatUse.Guard."+useToken.ToString()) is object[] useGuard)((Action)useGuard[2])();row["state"]="error";model["globalHelperPreview"]=null;var failed=(System.Text.Json.Nodes.JsonObject)((System.Text.Json.Nodes.JsonObject)journal[0]).DeepClone();System.Linq.Enumerable.Last(failed["records"]!.AsArray())!["state"]="error";try{SaveJournal(helper,journal,failed);}catch{row["historyError"]="history_save_failed";}try{Cleanup(turn);}finally{Publish();}throw;}Publish();return "{}";
 }
 if(operation=="cancel"){
  if(turns.TryGetValue(Text("helper"),out var turn)&&((string)turn[2]).Length>0){if(((System.Text.Json.Nodes.JsonObject)turn[0])["requestId"]?.ToString()!=Text("requestId"))throw new InvalidOperationException("Original request identity required");calls.AgentCancel.Invoke((string)turn[2]);}return "{}";
 }
 if(operation=="poll"){
  foreach(var agent in registry["agents"]!.AsObject())if(agent.Key=="Confectory.Agent.Codex::Connection"&&agent.Value?["offline"]?.GetValue<bool>()!=true&&readiness.TryGetValue(agent.Key,out var pending)){
   var status=System.Text.Json.Nodes.JsonNode.Parse(calls.CodexVerification.Invoke(agent.Value!["config"]!.ToJsonString(),"status","{}"))!;if(status["state"]?.ToString()=="checking")RegisteredReadiness(agent.Value.DeepClone().AsObject(),false,pending["token"]!.ToString());
  }
  foreach(var item in turns){var turn=item.Value;var row=(System.Text.Json.Nodes.JsonObject)turn[0];if(row["state"]?.ToString()!="running"||((string)turn[2]).Length==0)continue;var result=System.Text.Json.Nodes.JsonNode.Parse(calls.AgentPoll.Invoke((string)turn[2]))!;foreach(var e in result["events"]!.AsArray())if(e!["requestID"]?.ToString()==row["requestId"]!.ToString()&&e["kind"]?.ToString()=="delta")row["output"]=row["output"]!.ToString()+e["text"]!.ToString();row["state"]=result["state"]!.DeepClone();row["errorCode"]=result["errorCode"]?.DeepClone();row["errorDiagnostics"]=result["errorDiagnostics"]?.DeepClone();
   if(row["state"]!.ToString()!="running"){
    row["answerReceived"]=row["state"]!.ToString()=="completed"&&row["output"]!.ToString().Length>0;var journal=Journal(item.Key);var next=(System.Text.Json.Nodes.JsonObject)((System.Text.Json.Nodes.JsonObject)journal[0]).DeepClone();var record=System.Linq.Enumerable.Last(next["records"]!.AsArray());record!["state"]=row["state"]!.DeepClone();record["output"]=row["output"]!.DeepClone();record["errorCode"]=row["errorCode"]?.DeepClone();record["errorDiagnostics"]=row["errorDiagnostics"]?.DeepClone();try{SaveJournal(item.Key,journal,next);}catch{row["historyError"]="history_save_failed";}string agent=(string)turn[1];turn[3]=System.Threading.Tasks.Task.Run(()=>calls.AgentClose.Invoke(agent));
