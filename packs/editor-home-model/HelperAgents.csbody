   foreach(var run in model["aiRuns"]?.AsObject()??new System.Text.Json.Nodes.JsonObject())if(run.Value?["state"]?.ToString()=="running"&&model["aiBindings"]?[run.Key]?["connection"]?.ToString()==agent&&run.Value?["chatUse"]?.GetValue<bool>()!=true)throw new InvalidOperationException("Stop the Agent's explicit project task before disconnecting");
