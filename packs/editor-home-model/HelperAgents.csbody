 if(operation=="startup"){
  foreach(var agent in registry["agents"]!.AsObject())if(agent.Key=="Confectory.Agent.Codex::Connection"&&agent.Value?["offline"]?.GetValue<bool>()!=true)try{RegisteredReadiness(agent.Value!.DeepClone().AsObject(),true,"");}catch(ArgumentException){/* Publish reports invalid registration without replacing it. */}
