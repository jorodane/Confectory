  if(name.Length is <1 or >80||personality.Length is <1 or >2048||speciality.Length is <1 or >160)throw new ArgumentException("Bounded Helper name, personality and speciality required");
  if(operation!="import"||Text("helper").Length==0)calls.Recruit.Invoke(store,"local-user",new System.Text.Json.Nodes.JsonObject{["helper"]=helper,["owner"]="local-user",["personality"]=personality,["speciality"]=speciality,["membership"]=new System.Text.Json.Nodes.JsonObject{["kind"]="global",["projectId"]=""}}.ToJsonString());
  var profile=System.Text.Json.Nodes.JsonNode.Parse(calls.Presentation.Invoke(storage,helper,"load","{}"))!;if(profile["value"]!["name"]!.ToString().Length==0){var value=profile["value"]!.DeepClone();value["name"]=name;value["shortDescription"]=speciality;value["description"]=personality;calls.Presentation.Invoke(storage,helper,"save",new System.Text.Json.Nodes.JsonObject{["revision"]=profile["revision"]!.DeepClone(),["value"]=value}.ToJsonString());}
  var next=(System.Text.Json.Nodes.JsonObject)registry.DeepClone();if(agent.Length>0)next["assignments"]![helper]=agent;if(registry["assignments"]?[helper] is not null&&registry["assignments"]?[helper]?.ToString()!=agent)calls.ChatUse.Invoke(session,"revoke-helper",System.Text.Json.JsonSerializer.Serialize(new{helper}));SaveRegistry(next);RetirePreview();if(model["aiPreview"]?["helperContext"]?["helper"]?.ToString()==helper){model["aiPreview"]=null;helperProjectionChanged=true;}RefreshHelpers();Publish();return new System.Text.Json.Nodes.JsonObject{["helper"]=helper}.ToJsonString();
