 if(action!="snapshot"&&result["view"]?["state"]?.ToString()=="ready"){
  try{string completion=result["completionId"]!.ToString();if(model["codexOnboardingApplied"]?.ToString()!=completion){var config=result["configuration"]!;string view=SetupView(Codex);foreach(string field in new[]{"connectionMethod","executable","managedHome","credentialReference","model"})SetupValue(Codex,field,config[field]!.ToString());calls.CheckSettings.Invoke(System.Text.Json.Nodes.JsonNode.Parse(calls.PackSnapshot.Invoke(view))!["unit"]!["text"]!.ToString());calls.PackCommand.Invoke(view,"save","{}");model["connectionSetupModes"]![Codex]="existing";connectionSetupMode="existing";calls.HelperAgents.Invoke(session,"register",System.Text.Json.JsonSerializer.Serialize(new{connection=Codex}));model["codexOnboardingApplied"]=completion;SetupSnapshot(Codex,view);}
   if(action is "begin" or "retry")calls.HelperAgents.Invoke(session,"connection-state",System.Text.Json.JsonSerializer.Serialize(new{agent=Codex,offline=false}));
  }catch{model["codexOnboarding"]=new System.Text.Json.Nodes.JsonObject{["state"]="failed",["code"]="settings_save_failed",["retryable"]=true,["message"]="연결 설정을 저장하지 못했어요. 입력과 기존 설정은 유지됩니다."};model["codexOnboarding"]!["message"]="연결 설정을 저장하지 못했어요. 입력과 기존 설정은 유지됩니다. 다시 시도하세요.";throw;}
 }
}

