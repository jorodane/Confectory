 var matched=System.Linq.Enumerable.OrderBy(System.Linq.Enumerable.Where(union,p=>query.Trim().Length==0||(p.Key+" "+p.Value["label"]).Contains(query.Trim(),StringComparison.OrdinalIgnoreCase)),p=>p.Key,StringComparer.Ordinal);var bounded=System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Take(matched,512));int matchedCount=System.Linq.Enumerable.Count(matched);pageIndex=Math.Min(pageIndex,Math.Max(0,(bounded.Length-1)/16));var columns=System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Take(System.Linq.Enumerable.Skip(bounded,pageIndex*16),16));offset=Math.Min(offset,ids.Length-1);var pageRows=new System.Text.Json.Nodes.JsonArray();int valueBytes=0;bool valuesLimited=false;
 System.Text.Json.Nodes.JsonNode? Value(System.Text.Json.Nodes.JsonNode? datum){if(datum is null)return null;if(datum["kind"]?.ToString()=="reference")return new System.Text.Json.Nodes.JsonObject{["$ref"]=datum["reference"]!.DeepClone()};if(datum["items"] is System.Text.Json.Nodes.JsonArray items)return new System.Text.Json.Nodes.JsonArray(System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Select(items,Value)));if(datum["members"] is System.Text.Json.Nodes.JsonObject members){var result=new System.Text.Json.Nodes.JsonObject();foreach(var member in members)result[member.Key]=Value(member.Value);return result;}return datum["scalar"]?.DeepClone();}
