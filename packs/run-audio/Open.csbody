// An explicit software stream on the existing owned frame channel. No audio device or task clock.
string key="Confectory.RunAudio."+Guid.NewGuid().ToString("N"),runtime=Guid.NewGuid().ToString("N");object gate=new();bool closed=false;int thread=Environment.CurrentManagedThreadId,retainedSamples=0;long sequence=0,total=0;var chunks=new System.Collections.Generic.Queue<System.Text.Json.Nodes.JsonObject>();
string Decimal(long n)=>n.ToString(System.Globalization.CultureInfo.InvariantCulture);
Func<string,string> read=cursor=>{if(cursor.Length>52)throw new ArgumentException("Audio cursor budget");lock(gate){if(closed||chunks.Count==0)return "{\"available\":false}";string prefix=runtime+":";long requested=0;bool same=cursor.StartsWith(prefix,StringComparison.Ordinal);if(same){string number=cursor[prefix.Length..];if(!long.TryParse(number,System.Globalization.NumberStyles.None,System.Globalization.CultureInfo.InvariantCulture,out requested)||requested<0||Decimal(requested)!=number||requested>sequence)throw new ArgumentException("Audio cursor sequence");}var first=chunks.Peek();long oldest=long.Parse(first["sequence"]!.ToString(),System.Globalization.CultureInfo.InvariantCulture),start=long.Parse(first["start"]!.ToString(),System.Globalization.CultureInfo.InvariantCulture);bool reset=cursor.Length==0||!same||requested<oldest-1;string reason=cursor.Length==0?"baseline":!same?"publisher":requested<oldest-1?"gap":"";var result=new System.Text.Json.Nodes.JsonArray();long from=total;if(!reset)foreach(var chunk in chunks)if(long.Parse(chunk["sequence"]!.ToString(),System.Globalization.CultureInfo.InvariantCulture)>requested){if(result.Count==0)from=long.Parse(chunk["start"]!.ToString(),System.Globalization.CultureInfo.InvariantCulture);result.Add(chunk.DeepClone());}return new System.Text.Json.Nodes.JsonObject{["available"]=true,["runtime"]=runtime,["sequence"]=Decimal(sequence),["samples"]=Decimal(total),["oldest"]=Decimal(oldest),["oldestSample"]=Decimal(start),["cursor"]=prefix+Decimal(sequence),["format"]="pcm16le",["rate"]=16000,["channels"]=1,["reset"]=reset,["reason"]=reason,["fromSample"]=Decimal(from),["chunks"]=result}.ToJsonString();}};
calls.Attach.Invoke(frameOwner,read);
Func<string,long> append=pcm=>{if(pcm.Length>4268)throw new ArgumentException("Audio chunk budget");byte[] bytes=Convert.FromBase64String(pcm);if(bytes.Length is <2 or >3200||bytes.Length%2!=0||Convert.ToBase64String(bytes)!=pcm)throw new ArgumentException("Canonical mono PCM16LE, 1..1600 sample frames required");int count=bytes.Length/2;string sha=Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(bytes)).ToLowerInvariant();lock(gate){if(closed)throw new ObjectDisposedException("Audio output");long next=checked(sequence+1),end=checked(total+count);var chunk=new System.Text.Json.Nodes.JsonObject{["sequence"]=Decimal(next),["start"]=Decimal(total),["samples"]=count,["sha256"]=sha,["pcm"]=pcm.TrimEnd('=').Replace('+','-').Replace('/','_')};chunks.Enqueue(chunk);retainedSamples+=count;while(chunks.Count>64||retainedSamples>32000)retainedSamples-=chunks.Dequeue()["samples"]!.GetValue<int>();sequence=next;total=end;return sequence;}};
Action close=()=>{if(Environment.CurrentManagedThreadId!=thread)throw new InvalidOperationException("Audio retirement belongs to the frame owner thread");lock(gate){if(closed)return;}calls.Detach.Invoke(frameOwner,read);lock(gate){closed=true;chunks.Clear();retainedSamples=0;}};
try{AppDomain.CurrentDomain.SetData(key,new object[]{append,close});return key;}catch{calls.Detach.Invoke(frameOwner,read);throw;}
