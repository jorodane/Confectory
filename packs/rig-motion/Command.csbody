foreach(string id in order){var a=start[id]!.AsObject();var b=end[id]!.AsObject();var ta=Vector(a["translation"],3,10000);var tb=Vector(b["translation"],3,10000);var sa=Vector(a["scale"],3,100);var sb=Vector(b["scale"],3,100);var qa=Vector(a["rotation"],4,1);var qb=Vector(b["rotation"],4,1);double[] p=new double[3],s=new double[3];for(int n=0;n<3;n++){p[n]=ta[n]+(tb[n]-ta[n])*blend;s[n]=sa[n]+(sb[n]-sa[n])*blend;if(!double.IsFinite(p[n])||Math.Abs(p[n])>10000||s[n]<.001||s[n]>100)throw new ArgumentException("Bezier overshoot exceeds transform bounds");}var q=System.Numerics.Quaternion.Normalize(System.Numerics.Quaternion.Slerp(new((float)qa[0],(float)qa[1],(float)qa[2],(float)qa[3]),new((float)qb[0],(float)qb[1],(float)qb[2],(float)qb[3]),(float)blend));var matrix=System.Numerics.Matrix4x4.CreateScale((float)s[0],(float)s[1],(float)s[2])*System.Numerics.Matrix4x4.CreateFromQuaternion(q)*System.Numerics.Matrix4x4.CreateTranslation((float)p[0],(float)p[1],(float)p[2]);string? parent=jointMap[id]["parent"]?.GetValue<string>();if(parent is not null)matrix*=matrices[parent];float[] values={matrix.M11,matrix.M12,matrix.M13,matrix.M14,matrix.M21,matrix.M22,matrix.M23,matrix.M24,matrix.M31,matrix.M32,matrix.M33,matrix.M34,matrix.M41,matrix.M42,matrix.M43,matrix.M44};foreach(float v in values)if(!float.IsFinite(v)||Math.Abs(v)>10000000)throw new ArgumentException("Composed hierarchy transform bound");matrices[id]=matrix;resultJoints.Add(new System.Text.Json.Nodes.JsonObject{["id"]=id,["parent"]=parent,["local"]=System.Text.Json.JsonSerializer.SerializeToNode(new{translation=p,rotation=new[]{q.X,q.Y,q.Z,q.W},scale=s}),["worldPosition"]=System.Text.Json.JsonSerializer.SerializeToNode(new[]{matrix.M41,matrix.M42,matrix.M43}),["worldMatrix"]=System.Text.Json.JsonSerializer.SerializeToNode(values)});}
return new System.Text.Json.Nodes.JsonObject{["schemaVersion"]=1,["rig"]=rig,["action"]=selected,["time"]=at,["duration"]=durationTotal,["segment"]=segment,["fraction"]=blend,["joints"]=resultJoints}.ToJsonString();

