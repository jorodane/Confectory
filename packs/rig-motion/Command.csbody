Fields(data,"schemaVersion","id","joints","actions");string rig=ID(data["id"]);var joints=data["joints"]!.AsArray();var actions=data["actions"]!.AsArray();if(joints.Count<1||joints.Count>32||actions.Count<1||actions.Count>16)throw new ArgumentException("Bounded joint/action count");
