double Bezier(double t,double a,double b){double u=1-t;return 3*u*u*t*a+3*u*t*t*b+t*t*t;}double lo=0,hi=1;for(int n=0;n<48;n++){double mid=(lo+hi)/2;if(Bezier(mid,easing[0],easing[2])<fraction)lo=mid;else hi=mid;}double blend=fraction==0?0:fraction==1?1:Bezier((lo+hi)/2,easing[1],easing[3]);
