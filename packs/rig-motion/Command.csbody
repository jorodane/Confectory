foreach(var item in actions){var action=item!.AsObject();Fields(action,"id","meaning","keyPoses","deltas");string id=ID(action["id"]);if(!actionMap.TryAdd(id,action))throw new ArgumentException("Duplicate action ID");string meaning=action["meaning"]?.GetValue<string>()??"";if(string.IsNullOrWhiteSpace(meaning)||meaning.Length>512)throw new ArgumentException("Action meaning required");var poses=action["keyPoses"]!.AsArray();var deltas=action["deltas"]!.AsArray();if(poses.Count<2||poses.Count>32||deltas.Count!=poses.Count-1)throw new ArgumentException("Consecutive KeyPose/AnimationDelta sequence required");var poseIDs=new System.Collections.Generic.HashSet<string>(StringComparer.Ordinal);foreach(var p in poses){var pose=p!.AsObject();Fields(pose,"id","transforms");if(!poseIDs.Add(ID(pose["id"])))throw new ArgumentException("Duplicate KeyPose ID");var transforms=pose["transforms"]!.AsObject();if(transforms.Count!=jointMap.Count)throw new ArgumentException("Complete per-joint KeyPose required");foreach(var t in transforms){if(!jointMap.ContainsKey(t.Key))throw new ArgumentException("Unknown KeyPose joint");Transform(t.Value);}}double total=0;for(int n=0;n<deltas.Count;n++){var delta=deltas[n]!.AsObject();Fields(delta,"from","to","duration","easing");if(ID(delta["from"])!=poses[n]!["id"]!.GetValue<string>()||ID(delta["to"])!=poses[n+1]!["id"]!.GetValue<string>())throw new ArgumentException("Delta must connect consecutive poses");double duration=delta["duration"]!.GetValue<double>();if(!double.IsFinite(duration)||duration<.001||duration>600)throw new ArgumentException("Bounded positive duration seconds");total+=duration;var curve=Vector(delta["easing"],4,4);if(curve[0]<0||curve[0]>1||curve[2]<curve[0]||curve[2]>1)throw new ArgumentException("Monotonic cubic-Bezier x controls required");}if(total>3600)throw new ArgumentException("Motion duration bound");durations[id]=total;}
