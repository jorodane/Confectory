pack Confectory.PackWorkspace version "0.1.0" {
standalone false;
element History function "History.celem";element HistoryBody implementation "HistoryBody.celem";
element Conflict function "Conflict.celem";element ConflictBody implementation "ConflictBody.celem";
dependency Confectory.ChangeSet version "0.1.0";
dependency Confectory.SchemaEditing version "0.1.0";
dependency Confectory.FileStream version "0.1.0";
dependency Confectory.EditWorkspace version "0.1.0";
dependency Confectory.Save version "0.1.0";
element Open function "Open.celem";
element OpenBody implementation "OpenBody.celem";
element Snapshot function "Snapshot.celem";
element SnapshotBody implementation "SnapshotBody.celem";
element CreateVariation function "CreateVariation.celem";element CreateVariationBody implementation "CreateVariationBody.celem";
element Command function "Command.celem";
element CommandBody implementation "CommandBody.celem";
element Close function "Close.celem";
element CloseBody implementation "CloseBody.celem";
element BorrowDraft function "BorrowDraft.celem"; element BorrowDraftBody implementation "BorrowDraftBody.celem";
}
