 var file=calls.FileSnapshot.Invoke(ownedPath);rows.Add(new System.Text.Json.Nodes.JsonObject{["id"]=reviewedId,["kind"]=u[1],["path"]=u[2],["revision"]=u[4],["baseline"]=u[5],["currentHash"]=file[2],["before"]=file[1],["after"]=u[3],["dirty"]=u[6]=="dirty"});}
