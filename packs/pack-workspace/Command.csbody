 var checkedReview=compoundPending?calls.Review.Invoke(draft,selectedReview):null;
 bool compoundConflict=checkedReview?[0]=="conflict";
 if(!compoundConflict)calls.ValidateSelection.Invoke(draft,selectedReview);
 foreach(var row in rows){try{row!["semantic"]=System.Text.Json.Nodes.JsonNode.Parse(calls.Locate.Invoke("reviewSummary",new System.Text.Json.Nodes.JsonObject{["kind"]=row["kind"]!.DeepClone(),["before"]=row["before"]!.DeepClone(),["after"]=row["after"]!.DeepClone(),["project"]=identity[0],["path"]=row["path"]!.DeepClone()}.ToJsonString()));}catch{row!["semantic"]=new System.Text.Json.Nodes.JsonObject{["changes"]=new System.Text.Json.Nodes.JsonArray(),["additionalChanges"]=true};}}
