 var review=rows[0]!.DeepClone().AsObject();review["token"]=compoundConflict?"":Guid.NewGuid().ToString("N");review["target"]=target;review["status"]=checkedReview![0];review["selection"]=state["selected"]!.GetValue<string>();review["units"]=rows;review["requiredIds"]=System.Text.Json.JsonSerializer.SerializeToNode(System.Linq.Enumerable.Where(selectedReview,reviewRequired.Contains));review["changes"]=System.Text.Json.JsonSerializer.SerializeToNode(changes);state["review"]=review;break;
