  string AcceptedSourceHash(string text)=>Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(text))).ToLowerInvariant();
  foreach(var frame in state["blueprintBases"]?.AsObject()??new System.Text.Json.Nodes.JsonObject()){
   if(frame.Value is not System.Text.Json.Nodes.JsonObject basis||basis["kind"] is not null||basis["slotContext"] is not null||basis["sources"] is not System.Text.Json.Nodes.JsonObject inputs)continue;
   try{bool valid=true;var versions=new System.Collections.Generic.Dictionary<string,long>(StringComparer.Ordinal);
    foreach(var input in inputs){var prior=input.Value!;var current=calls.Read.Invoke(draft,input.Key);long receiptBefore=prior["revision"]!.GetValue<long>(),receiptAfter=long.Parse(current[4],System.Globalization.CultureInfo.InvariantCulture);if(current[3]!=prior["text"]!.ToString()||current[2]!=prior["path"]!.ToString()||AcceptedSourceHash(current[3])!=prior["hash"]!.ToString()||current[1]!=prior["kind"]!.ToString()){valid=false;break;}
     var accepted=System.Linq.Enumerable.SingleOrDefault(rows,row=>row!["id"]!.ToString()==input.Key);if(accepted is null){if(receiptAfter!=receiptBefore){valid=false;break;}}
     else{if(accepted["revision"]!.ToString()!=receiptBefore.ToString(System.Globalization.CultureInfo.InvariantCulture)||accepted["after"]!.ToString()!=prior["text"]!.ToString()||accepted["path"]!.ToString()!=current[2]||receiptAfter!=receiptBefore&&receiptAfter!=receiptBefore+1){valid=false;break;}if(receiptAfter!=receiptBefore)versions[input.Key]=receiptAfter;}
    }
    if(valid)foreach(var version in versions)inputs[version.Key]!["revision"]=version.Value;
   }catch{ /* A stale/incomplete receipt remains stale; never change Confirm's result. */ }
  }
  state["review"]=null;
 }
 var snapshot=System.Text.Json.Nodes.JsonNode.Parse(calls.Snapshot.Invoke(handle))!.AsObject();snapshot["confirmation"]=System.Text.Json.JsonSerializer.SerializeToNode(confirmed);return snapshot.ToJsonString();
}
case "save":calls.Save.Invoke(draft);break;
case "sources":var files=new System.Text.Json.Nodes.JsonArray();foreach(string source in calls.List.Invoke(draft)){var u=calls.Read.Invoke(draft,source);files.Add(new System.Text.Json.Nodes.JsonObject{["id"]=u[0],["kind"]=u[1],["path"]=u[2],["text"]=u[3],["revision"]=long.Parse(u[4],System.Globalization.CultureInfo.InvariantCulture),["dirty"]=u[6]=="dirty"});}return new System.Text.Json.Nodes.JsonObject{["files"]=files}.ToJsonString();
