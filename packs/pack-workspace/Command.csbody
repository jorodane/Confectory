var state=AppDomain.CurrentDomain.GetData("Confectory.PackWorkspace."+handle) as System.Text.Json.Nodes.JsonObject??throw new ObjectDisposedException("PackWorkspace");
var request=System.Text.Json.Nodes.JsonNode.Parse(payload)?.AsObject()??throw new ArgumentException("Object payload required.");
lock(state){if(state["closing"]!.GetValue<bool>())throw new ObjectDisposedException("PackWorkspace");string draft=state["draft"]!.GetValue<string>();bool conflict=false;
switch(operation){
case "select":string id=request["id"]!.GetValue<string>();calls.Read.Invoke(draft,id);state["selected"]=id;break;
case "page":int page=request["page"]!.GetValue<int>();if(page<0)throw new ArgumentOutOfRangeException("page");state["page"]=page;break;
case "edit":string selected=state["selected"]!.GetValue<string>();if(selected=="")throw new InvalidOperationException("Select an owned unit first.");long expected=request["expectedRevision"]!.GetValue<long>();if(expected<0)throw new ArgumentOutOfRangeException("expectedRevision");string text=request["text"]!.GetValue<string>();if(text.Length>1048576)throw new ArgumentException("Draft exceeds one million characters.");conflict=!calls.Edit.Invoke(draft,selected,text,expected);break;
case "save":calls.Save.Invoke(draft);break;
case "sources":var files=new System.Text.Json.Nodes.JsonArray();foreach(string source in calls.List.Invoke(draft)){var u=calls.Read.Invoke(draft,source);files.Add(new System.Text.Json.Nodes.JsonObject{["id"]=u[0],["kind"]=u[1],["path"]=u[2],["text"]=u[3],["revision"]=long.Parse(u[4],System.Globalization.CultureInfo.InvariantCulture),["dirty"]=u[6]=="dirty"});}return new System.Text.Json.Nodes.JsonObject{["files"]=files}.ToJsonString();
default:throw new ArgumentException("Unknown workspace operation.");}
var result=System.Text.Json.Nodes.JsonNode.Parse(calls.Snapshot.Invoke(handle))!.AsObject();result["conflict"]=conflict;return result.ToJsonString();}
