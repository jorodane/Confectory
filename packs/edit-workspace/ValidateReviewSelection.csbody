var state=AppDomain.CurrentDomain.GetData("Confectory.EditWorkspace."+handle) as System.Text.Json.Nodes.JsonObject??throw new ObjectDisposedException("EditWorkspace");
lock(state){
 foreach(string id in selected)if(state["units"]?[id]?["retirementGroup"] is not null&&System.Linq.Enumerable.Any(calls.CreationGroup.Invoke(handle,id),member=>Array.IndexOf(selected,member)<0))throw new InvalidOperationException("Review the recovered sources and registration together");
 foreach(string id in selected)if(state["units"]?[id]?["hierarchyGroup"] is not null){var required=calls.CreationGroup.Invoke(handle,id);if(System.Linq.Enumerable.Any(required,member=>!System.Linq.Enumerable.Contains(selected,member,StringComparer.Ordinal)))throw new InvalidOperationException("Review the complete hierarchy move together");}
 foreach(string id in selected)if(state["units"]?[id]?["rootContractGroup"] is not null){var group=calls.CreationGroup.Invoke(handle,id);if(System.Linq.Enumerable.Any(group,key=>Array.IndexOf(selected,key)<0))throw new InvalidOperationException("Review the function, implementation and root graph together");}

 var folderMembers=new System.Collections.Generic.HashSet<string>(StringComparer.Ordinal);foreach(string id in selected)if(state["units"]?[id]?["hierarchyGroup"] is System.Text.Json.Nodes.JsonArray members&&System.Linq.Enumerable.Any(members,member=>state["units"]?[member!.ToString()]?["kind"]?.ToString()=="category"))foreach(var member in members)folderMembers.Add(member!.ToString());
 if(folderMembers.Count>0){var folderUnits=new System.Text.Json.Nodes.JsonArray();foreach(string id in folderMembers){var unit=state["units"]![id]!;folderUnits.Add(new System.Text.Json.Nodes.JsonObject{["id"]=id,["kind"]=unit["kind"]!.DeepClone(),["text"]=unit["draft"]!.DeepClone()});}calls.Metadata.Invoke("browserFolderValidate",new System.Text.Json.Nodes.JsonObject{["namespace"]=state["namespace"]!.DeepClone(),["units"]=folderUnits}.ToJsonString());}

 var conversionChanges=calls.Changes.Invoke(handle,selected);
 foreach(var conversion in state["units"]!.AsObject()){
  if(conversion.Value?["conversionOrigin"] is null||conversion.Value["baseline"]?.ToString()!="missing")continue;
  var conversionOrigin=conversion.Value["conversionOrigin"]!;
  for(int index=0;index<conversionChanges.Length;index+=4){
   if(conversionChanges[index]==conversionOrigin["id"]!.ToString())continue;
   string destination=System.IO.Path.GetFullPath(System.IO.Path.Combine(state["root"]!.ToString(),conversionChanges[index+1]));
   if(System.Linq.Enumerable.Any(conversionOrigin["observations"]!.AsArray(),input=>string.Equals(input!["path"]!.ToString(),destination,OperatingSystem.IsWindows()?StringComparison.OrdinalIgnoreCase:StringComparison.Ordinal)))throw new InvalidOperationException("Confirm the conversion before changing its original source files");
  }
  var required=calls.CreationGroup.Invoke(handle,conversion.Key);if(!System.Linq.Enumerable.Any(required,id=>Array.IndexOf(selected,id)>=0))continue;
  if(!System.Linq.Enumerable.All(required,id=>Array.IndexOf(selected,id)>=0))throw new InvalidOperationException("Body conversion requires the implementation, graph and independent body together");
  calls.Metadata.Invoke("blueprintConversion",new System.Text.Json.Nodes.JsonObject{["action"]="verify",["project"]=state["project"]!.DeepClone(),["origin"]=conversion.Value["conversionOrigin"]!.DeepClone()}.ToJsonString());
 }
 foreach(var entry in state["units"]!.AsObject())if(entry.Value?["kind"]?.ToString()=="schema"&&entry.Value["baseline"]?.ToString()=="missing"&&entry.Value["creationOwner"] is not null){var required=calls.CreationGroup.Invoke(handle,entry.Key);if(System.Linq.Enumerable.Any(required,id=>Array.IndexOf(selected,id)>=0)&&!System.Linq.Enumerable.All(required,id=>Array.IndexOf(selected,id)>=0))throw new InvalidOperationException("New object properties require their object, schema and registration together");}
 var ids=new System.Collections.Generic.HashSet<string>(selected,StringComparer.Ordinal);var changes=calls.Changes.Invoke(handle,selected);var changed=new System.Collections.Generic.HashSet<string>(StringComparer.Ordinal);for(int i=0;i<changes.Length;i+=4)changed.Add(changes[i]);
 bool manifest=false;for(int i=0;i<changes.Length;i+=4)if(changes[i+1]==System.IO.Path.GetFileName(state["project"]!.ToString()))manifest=true;
 for(int i=0;i<changes.Length;i+=4)if(changes[i+2]=="missing"&&state["units"]![changes[i]]?["conversionOrigin"] is null&&state["units"]![changes[i]]!["kind"]!.ToString()!="blueprint-node"&&!manifest)throw new InvalidOperationException("New declaration review must explicitly include its manifest registration.");
 // A new graph is one registration transaction, including its external contract and stub.
 foreach(var pair in state["units"]!.AsObject()){
  if(pair.Value!["kind"]!.ToString()!="blueprint"||pair.Value["baseline"]?.ToString()!="missing"||pair.Value["conversionOrigin"] is not null)continue;
  string implementationId=pair.Key[..pair.Key.IndexOf("/body:",StringComparison.Ordinal)];var implementation=calls.Read.Invoke(handle,implementationId);
  string functionId=System.Text.Json.Nodes.JsonNode.Parse(calls.Metadata.Invoke("inspect",System.Text.Json.JsonSerializer.Serialize(new{text=implementation[3]})))!["function"]!.ToString();
  var required=new System.Collections.Generic.HashSet<string>(StringComparer.Ordinal){pair.Key,implementationId};
  if(state["units"]?[functionId]?["baseline"]?.ToString()=="missing")required.Add(functionId);
  foreach(var unit in state["units"]!.AsObject())if(unit.Value!["path"]!.ToString()==System.IO.Path.GetFileName(state["project"]!.ToString())||unit.Value["kind"]!.ToString()=="blueprint-node"&&unit.Value["baseline"]?.ToString()=="missing"&&unit.Key.StartsWith(pair.Key+"/node:",StringComparison.Ordinal))required.Add(unit.Key);
  foreach(string owner in calls.CreationOwners.Invoke(handle,pair.Key)){var unit=state["units"]![owner]!;if(unit["draft"] is not null&&(unit["baseline"]?.ToString()=="missing"||unit["draft"]!.ToString()!=unit["original"]!.ToString()))required.Add(owner);}
  if(System.Linq.Enumerable.Any(required,ids.Contains)&&!System.Linq.Enumerable.All(required,changed.Contains))throw new InvalidOperationException("New feature review requires its function, implementation, graph, node sources and manifest registration together");
 }
 foreach(var pair in state["units"]!.AsObject()){
  var unit=pair.Value!;if(unit["kind"]!.ToString()!="blueprint-node"||unit["draft"] is null||unit["baseline"]?.ToString()!="missing")continue;
  int marker=pair.Key.IndexOf("/node:",StringComparison.Ordinal);string graphId=pair.Key[..marker];if(!ids.Contains(pair.Key)&&!ids.Contains(graphId))continue;
  if(!ids.Contains(pair.Key)||!changed.Contains(graphId))throw new InvalidOperationException("New node review requires its body and changed owning graph together");
  var graph=calls.Read.Invoke(handle,graphId);int bodyMarker=graphId.IndexOf("/body:",StringComparison.Ordinal);string implementationId=graphId[..bodyMarker];var implementation=calls.Read.Invoke(handle,implementationId);
  var located=System.Text.Json.Nodes.JsonNode.Parse(calls.Metadata.Invoke("bodyUnits",new System.Text.Json.Nodes.JsonObject{["project"]=state["project"]!.DeepClone(),["id"]=implementationId,["path"]=implementation[2],["text"]=implementation[3],["blueprintDrafts"]=new System.Text.Json.Nodes.JsonObject{[graphId]=graph[3]}}.ToJsonString()))!;
  if(!System.Linq.Enumerable.Any(located["units"]!.AsArray(),row=>row!["id"]!.ToString()==graphId&&row["kind"]!.ToString()=="blueprint"&&row["path"]!.ToString()==graph[2])||!System.Linq.Enumerable.Any(located["units"]!.AsArray(),row=>row!["id"]!.ToString()==pair.Key&&row["kind"]!.ToString()=="blueprint-node"&&row["path"]!.ToString()==unit["path"]!.ToString()))throw new InvalidOperationException("New node source no longer belongs to the reviewed graph and implementation");
 }
}
