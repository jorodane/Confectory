 foreach(var recorded in entry["units"]!.AsArray()){var unit=state["units"]![recorded!["id"]!.ToString()]!;unit["draft"]=recorded[operation=="undo"?"before":"after"]!.DeepClone();unit["revision"]=unit["revision"]!.GetValue<long>()+1;if(recorded["hierarchyVersion"]?.GetValue<int>()==1){unit.AsObject().Remove("hierarchyGroup");var group=recorded[operation=="undo"?"beforeGroup":"afterGroup"];if(group is not null)unit["hierarchyGroup"]=group.DeepClone();}}
 if(entry["cellRemoval"] is System.Text.Json.Nodes.JsonObject removal){
  string graphId=removal["graph"]!.ToString(),leafId=graphId+"/node:"+removal["node"]!.ToString().Replace("/","/node:",StringComparison.Ordinal);
  var graph=state["units"]![graphId]!.AsObject();
  graph.Remove("authorSaveReceipt");
