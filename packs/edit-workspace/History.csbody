string Inspect(bool accepted=false,bool changed=false,string? code=null){
 var history=state["history"]!;var entries=new System.Text.Json.Nodes.JsonArray();foreach(string direction in new[]{"undo","redo"})foreach(var entry in System.Linq.Enumerable.Reverse(history[direction]!.AsArray()))entries.Add(new System.Text.Json.Nodes.JsonObject{["id"]=entry!["id"]!.DeepClone(),["label"]=entry["label"]!.DeepClone(),["direction"]=direction,["ids"]=new System.Text.Json.Nodes.JsonArray(System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Select(entry["units"]!.AsArray(),unit=>(System.Text.Json.Nodes.JsonNode?)System.Text.Json.Nodes.JsonValue.Create(unit!["id"]!.ToString()))))});
