  string id=recorded!["id"]!.ToString();var unit=state["units"]?[id];bool matches=unit is not null&&unit["draft"] is not null&&unit["kind"]!.ToString()==recorded["kind"]!.ToString()&&unit["path"]!.ToString()==recorded["path"]!.ToString()&&unit["draft"]!.ToString()==recorded[direction=="undo"?"after":"before"]!.ToString();if(recorded["hierarchyVersion"]?.GetValue<int>()==1)matches&=System.Text.Json.Nodes.JsonNode.DeepEquals(unit?["hierarchyGroup"],recorded[direction=="undo"?"afterGroup":"beforeGroup"]);else if(unit?["hierarchyGroup"] is not null)matches=false;available&=matches;
