lock(state){
 if(!ReferenceEquals(AppDomain.CurrentDomain.GetData(key),state))throw new ObjectDisposedException("EditWorkspace");
 var preview=Preview(operation);if(preview["available"]!.GetValue<bool>()!=true||preview["token"]?.ToString()!=expected)return Inspect(code:"HISTORY_CHANGED");
