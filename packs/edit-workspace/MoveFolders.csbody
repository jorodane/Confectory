if(plan.Length>65536)throw new ArgumentException("Browser folder move budget");var request=System.Text.Json.Nodes.JsonNode.Parse(plan)!.AsObject();if(request.Count!=1||request["moves"] is not System.Text.Json.Nodes.JsonArray)throw new ArgumentException("Explicit folder moves required");
string key="Confectory.EditWorkspace."+handle;var state=AppDomain.CurrentDomain.GetData(key) as System.Text.Json.Nodes.JsonObject??throw new ObjectDisposedException("EditWorkspace");string Hash(string text)=>Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(text))).ToLowerInvariant();
System.Text.Json.Nodes.JsonObject before;string ns;lock(state){ns=state["namespace"]!.ToString();if(ns=="Confectory.AISettings")throw new UnauthorizedAccessException("Connection settings are not Browser folders");var declarations=System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Where(state["units"]!.AsObject(),row=>row.Key.StartsWith(ns+"::",StringComparison.Ordinal)&&row.Value!["kind"]!.ToString() is ("object" or "concept" or "category" or "schema" or "function" or "module" or "implementation")));if(declarations.Length>256)throw new ArgumentException("Browser folder graph budget");foreach(var row in declarations)calls.Read.Invoke(handle,row.Key);before=state["units"]!.DeepClone().AsObject();}
var units=new System.Text.Json.Nodes.JsonArray();foreach(var row in before){var source=row.Value!;if(!row.Key.StartsWith(ns+"::",StringComparison.Ordinal)||source["kind"]!.ToString() is not ("object" or "concept" or "category" or "schema" or "function" or "module" or "implementation"))continue;units.Add(new System.Text.Json.Nodes.JsonObject{["id"]=row.Key,["kind"]=source["kind"]!.DeepClone(),["text"]=source["draft"]!.DeepClone(),["revision"]=source["revision"]!.DeepClone(),["hash"]=Hash(source["draft"]!.ToString())});}
var prepared=System.Text.Json.Nodes.JsonNode.Parse(calls.Metadata.Invoke("browserFolderMove",new System.Text.Json.Nodes.JsonObject{["namespace"]=ns,["units"]=units,["moves"]=request["moves"]!.DeepClone()}.ToJsonString()))!;var changes=prepared["changes"]!.AsArray();if(changes.Count==0)return "{\"moved\":false,\"sourceWritten\":false}";
foreach(var row in before)if(row.Value?["hierarchyGroup"] is System.Text.Json.Nodes.JsonArray prior&&System.Linq.Enumerable.Any(prior,id=>before[id!.ToString()]?["draft"]?.ToString()!=before[id!.ToString()]?["original"]?.ToString()))throw new InvalidOperationException("Finish the pending hierarchy group before classifying another source; all drafts retained");
var group=prepared["group"]!.AsArray();var moved=new System.Collections.Generic.HashSet<string>(System.Text.Json.JsonSerializer.Deserialize<string[]>(prepared["moved"]!.ToJsonString())!,StringComparer.Ordinal);if(group.Count is <1 or >32)throw new ArgumentException("Folder review group budget");foreach(var member in group){var unit=before[member!.ToString()]!;if(unit["baseline"]?.ToString()=="missing"||unit["rootContractGroup"] is not null||unit["retirementGroup"] is not null||unit["hierarchyGroup"] is not null)throw new InvalidOperationException("Finish the existing source group before moving folders; all input retained");if(!moved.Contains(member.ToString())&&unit["draft"]!.ToString()!=unit["original"]!.ToString())throw new InvalidOperationException("A category or inherited classification has a pending edit; preserve and finish it first");}
lock(state){if(!ReferenceEquals(AppDomain.CurrentDomain.GetData(key),state)||!System.Text.Json.Nodes.JsonNode.DeepEquals(before,state["units"]))throw new InvalidOperationException("Folder dependencies changed; no move applied");var active=state["units"]!.AsObject();var history=new System.Text.Json.Nodes.JsonObject();foreach(var member in group){var unit=active[member!.ToString()]!;history[member.ToString()]=new System.Text.Json.Nodes.JsonObject{["text"]=unit["draft"]!.DeepClone(),["hierarchyGroup"]=unit["hierarchyGroup"]?.DeepClone()};if(group.Count>1)unit["hierarchyGroup"]=group.DeepClone();}foreach(var change in changes){var unit=active[change!["id"]!.ToString()]!;unit["draft"]=change["text"]!.DeepClone();unit["revision"]=unit["revision"]!.GetValue<long>()+1;}if(AppDomain.CurrentDomain.GetData("Confectory.EditWorkspace.HistoryRecorder."+handle) is Action<System.Text.Json.Nodes.JsonObject,string> record)record(history,"batch-edit");}
return new System.Text.Json.Nodes.JsonObject{["moved"]=true,["ids"]=prepared["moved"]!.DeepClone(),["group"]=group.DeepClone(),["sourceWritten"]=false}.ToJsonString();
