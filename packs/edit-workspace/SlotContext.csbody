string key="Confectory.EditWorkspace."+handle;var state=AppDomain.CurrentDomain.GetData(key) as System.Text.Json.Nodes.JsonObject??throw new ObjectDisposedException("EditWorkspace");
string Hash(string text)=>Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(text))).ToLowerInvariant();
System.Text.Json.Nodes.JsonObject before;string ns,project,manifestId;
lock(state){ns=state["namespace"]!.ToString();var declarations=System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Where(state["units"]!.AsObject(),row=>row.Key.StartsWith(ns+"::",StringComparison.Ordinal)&&row.Value!["kind"]!.ToString() is ("object" or "schema" or "module" or "function" or "implementation" or "category" or "concept")));if(declarations.Length>255)throw new ArgumentException("Slot context declaration budget");foreach(var row in declarations){calls.Read.Invoke(handle,row.Key);if(row.Value!["kind"]!.ToString()=="implementation")calls.DiscoverBodies.Invoke(handle,row.Key);}foreach(var row in state["units"]!.AsObject())if(row.Value!["kind"]!.ToString() is "body" or "blueprint" or "blueprint-node")calls.Read.Invoke(handle,row.Key);if(System.Text.Encoding.UTF8.GetByteCount(state["units"]!.ToJsonString())>16777216)throw new ArgumentException("Slot context byte budget");before=state["units"]!.DeepClone().AsObject();project=state["project"]!.ToString();manifestId=ns+(before[ns+"::ProjectManifest"] is null?"::PackManifest":"::ProjectManifest");}
string checkpointPath=System.IO.Path.Combine(state["root"]!.ToString(),".confectory","edit-workspaces",Hash(System.Text.Json.JsonSerializer.Serialize(new[]{project,state["participant"]!.ToString(),state["context"]!.ToString()})),"draft.json");for(System.IO.FileSystemInfo? entry=new System.IO.FileInfo(checkpointPath);entry is not null;entry=entry is System.IO.FileInfo file?file.Directory:((System.IO.DirectoryInfo)entry).Parent){if(entry.LinkTarget is not null)throw new System.IO.IOException("Slot checkpoint must remain in owned storage");if(entry.FullName==state["root"]!.ToString())break;}var checkpoint=calls.Snapshot.Invoke(checkpointPath);string checkpointHash=checkpoint[2];
var source=before[owner];if(source?["kind"]?.ToString() is not ("object" or "schema" or "function" or "category" or "concept" or "module")||!owner.StartsWith(ns+"::",StringComparison.Ordinal))throw new ArgumentException("Owned slot object required");
var overlays=new System.Text.Json.Nodes.JsonArray();var guards=new System.Text.Json.Nodes.JsonObject();var fingerprints=new System.Text.Json.Nodes.JsonObject();
foreach(var row in System.Linq.Enumerable.OrderBy(before,row=>row.Key,StringComparer.Ordinal)){var unit=row.Value!;if(unit["draft"] is null)continue;guards[row.Key]=unit.DeepClone();fingerprints[row.Key]=new System.Text.Json.Nodes.JsonObject{["kind"]=unit["kind"]!.DeepClone(),["path"]=unit["path"]!.DeepClone(),["hash"]=Hash(unit["draft"]!.ToString())};if(row.Key!=owner&&unit["kind"]!.ToString() is not ("project" or "pack" or "body" or "blueprint" or "blueprint-node"))overlays.Add(new System.Text.Json.Nodes.JsonObject{["id"]=row.Key,["text"]=unit["draft"]!.DeepClone()});}
var resolved=System.Text.Json.Nodes.JsonNode.Parse(calls.Metadata.Invoke("effective",new System.Text.Json.Nodes.JsonObject{["project"]=project,["manifest"]=before[manifestId]!["draft"]!.DeepClone(),["id"]=owner,["text"]=source["draft"]!.DeepClone(),["drafts"]=overlays,["observeSources"]=true}.ToJsonString()))!;
if(resolved["status"]?.ToString()!="available"||resolved["observations"] is not System.Text.Json.Nodes.JsonArray)throw new InvalidOperationException("Slot contracts unavailable; retain choices and inspect the current module");
lock(state){if(!ReferenceEquals(AppDomain.CurrentDomain.GetData(key),state)||!System.Text.Json.Nodes.JsonNode.DeepEquals(before,state["units"]))throw new InvalidOperationException("Slot context changed while reading; retain choices");}
return new System.Text.Json.Nodes.JsonObject{["checkpointHash"]=checkpointHash,["owner"]=owner,["guards"]=guards,["observations"]=resolved["observations"]!.DeepClone(),["requirements"]=resolved["requirements"]!.DeepClone(),["providers"]=resolved["providers"]!.DeepClone(),["ownFunctions"]=resolved["ownFunctions"]?.DeepClone()??new System.Text.Json.Nodes.JsonArray(),["fingerprint"]=Hash(new System.Text.Json.Nodes.JsonObject{["checkpointHash"]=checkpointHash,["owned"]=fingerprints,["observations"]=resolved["observations"]!.DeepClone()}.ToJsonString())}.ToJsonString();
