  if(!path.StartsWith(root+System.IO.Path.DirectorySeparatorChar,cmp))throw new UnauthorizedAccessException("Large owner source outside project");
  for(System.IO.FileSystemInfo? node=new System.IO.FileInfo(path);node is not null;node=node is System.IO.FileInfo file?file.Directory:((System.IO.DirectoryInfo)node).Parent){if(node.LinkTarget is not null)throw new UnauthorizedAccessException("Large owner source cannot traverse links");if(node.FullName.Equals(root,cmp))break;}
  var observed=calls.Snapshot.Invoke(path);
  if(observed[0]!="exists"||observed[2]!=unit["baseline"]?.ToString()||observed[1]!=unit["original"]?.ToString())throw new InvalidOperationException("Large owner source changed; retain input");
 }
}
before=state["units"]!.DeepClone().AsObject();project=state["project"]!.ToString();manifestId=ns+(before[ns+"::ProjectManifest"] is null?"::PackManifest":"::ProjectManifest");}
string checkpointPath=System.IO.Path.Combine(state["root"]!.ToString(),".confectory","edit-workspaces",Hash(System.Text.Json.JsonSerializer.Serialize(new[]{project,state["participant"]!.ToString(),state["context"]!.ToString()})),"draft.json");for(System.IO.FileSystemInfo? entry=new System.IO.FileInfo(checkpointPath);entry is not null;entry=entry is System.IO.FileInfo file?file.Directory:((System.IO.DirectoryInfo)entry).Parent){if(entry.LinkTarget is not null)throw new System.IO.IOException("Slot checkpoint must remain in owned storage");if(entry.FullName==state["root"]!.ToString())break;}var checkpoint=calls.Snapshot.Invoke(checkpointPath);string checkpointHash=checkpoint[2];
var source=before[owner];if(source?["kind"]?.ToString() is not ("object" or "schema" or "function" or "category" or "concept" or "module" or "enum")||!owner.StartsWith(ns+"::",StringComparison.Ordinal))throw new ArgumentException("Owned slot object required");
lock(state){if(!ReferenceEquals(AppDomain.CurrentDomain.GetData(key),state)||!System.Text.Json.Nodes.JsonNode.DeepEquals(before,state["units"]))throw new InvalidOperationException("Slot context changed while reading; retain choices");}
return new System.Text.Json.Nodes.JsonObject{["units"]=before,["namespace"]=ns,["project"]=project,["manifest"]=manifestId,["checkpointHash"]=checkpointHash,["compactClean"]=compactClean}.ToJsonString();
