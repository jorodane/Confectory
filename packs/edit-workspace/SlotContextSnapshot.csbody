lock(state){ns=state["namespace"]!.ToString();var declarations=System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Where(state["units"]!.AsObject(),row=>row.Key.StartsWith(ns+"::",StringComparison.Ordinal)&&row.Value!["kind"]!.ToString() is ("object" or "schema" or "module" or "function" or "implementation" or "category" or "concept" or "enum")));compactClean=declarations.Length>255;
if(compactClean&&(declarations.Length>1024||state["units"]?[owner]?["kind"]?.ToString()!="object"))throw new ArgumentException("Slot context declaration budget");foreach(var row in declarations){calls.Read.Invoke(handle,row.Key);if(row.Value!["kind"]!.ToString()=="implementation")calls.DiscoverBodies.Invoke(handle,row.Key);}foreach(var row in state["units"]!.AsObject())if(row.Value!["kind"]!.ToString() is "body" or "blueprint" or "blueprint-node")calls.Read.Invoke(handle,row.Key);if(System.Text.Encoding.UTF8.GetByteCount(state["units"]!.ToJsonString())>16777216)throw new ArgumentException("Slot context byte budget");if(compactClean){
 // Keep all original guard rows. Omit only unchanged declarations from the
 // bounded semantic overlay, after checking their actual owned source bytes.
 string root=state["root"]!.ToString();var cmp=OperatingSystem.IsWindows()?StringComparison.OrdinalIgnoreCase:StringComparison.Ordinal;
 foreach(var row in state["units"]!.AsObject()){
  var unit=row.Value!;if(unit["draft"] is null)continue;
  if(row.Key!=owner&&(unit["baseline"]?.ToString()=="missing"||!System.Text.Json.Nodes.JsonNode.DeepEquals(unit["draft"],unit["original"])))throw new InvalidOperationException("Large owner edit requires unchanged other declarations; retain existing drafts");
