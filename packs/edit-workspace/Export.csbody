var state=AppDomain.CurrentDomain.GetData("Confectory.EditWorkspace."+handle) as System.Text.Json.Nodes.JsonObject??throw new ObjectDisposedException("EditWorkspace");
lock(state)
{
 if(handle.StartsWith("private-selection-",StringComparison.Ordinal)&&state["privateCopyCheckpoint"] is System.Text.Json.Nodes.JsonObject baseline){var saved=baseline.DeepClone();saved["privateCopies"]=state["privateCopies"]?.DeepClone();return saved.ToJsonString();}
 var changes=new System.Text.Json.Nodes.JsonArray();foreach(var entry in state["units"]!.AsObject()){var unit=entry.Value!;if(unit["draft"] is null)continue;bool activeRoot=unit["rootContractGroup"] is System.Text.Json.Nodes.JsonArray group&&System.Linq.Enumerable.Any(group,id=>state["units"]?[id!.ToString()] is System.Text.Json.Nodes.JsonObject member&&member["draft"] is not null&&member["draft"]!.ToString()!=member["original"]!.ToString());bool activeHierarchy=unit["hierarchyGroup"] is System.Text.Json.Nodes.JsonArray hierarchy&&System.Linq.Enumerable.Any(hierarchy,id=>state["units"]?[id!.ToString()] is System.Text.Json.Nodes.JsonObject member&&member["draft"] is not null&&member["draft"]!.ToString()!=member["original"]!.ToString());bool activeRetirement=unit["retirementGroup"] is not null;bool activeAtomic=unit["atomicEditGroup"] is System.Text.Json.Nodes.JsonArray atomic&&System.Linq.Enumerable.Any(atomic,id=>state["units"]?[id!.ToString()] is System.Text.Json.Nodes.JsonObject member&&(member["baseline"]?.ToString()=="missing"||member["draft"]!.ToString()!=member["original"]!.ToString()));if(activeAtomic||activeRoot||activeHierarchy||activeRetirement||unit["draft"]!.GetValue<string>()!=unit["original"]!.GetValue<string>()||unit["baseline"]!.GetValue<string>()=="missing")changes.Add(unit.DeepClone());}
 return new System.Text.Json.Nodes.JsonObject{["version"]=1,["history"]=state["history"]?.DeepClone(),["retirements"]=state["retirements"]?.DeepClone(),["retirementOutcomes"]=state["retirementOutcomes"]?.DeepClone(),["privateCopies"]=state["privateCopies"]?.DeepClone(),["project"]=state["project"]!.GetValue<string>(),["participant"]=state["participant"]!.GetValue<string>(),["context"]=state["context"]!.GetValue<string>(),["changes"]=changes}.ToJsonString();
