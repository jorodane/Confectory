 var disk=Disk(path);lock(state){var unit=state["units"]![id];if(!SameOwner(unit)){notices.Add(id);notices.Add("identity-changed");continue;}if(disk[2]==unit!["baseline"]!.GetValue<string>())continue;if(!SameBasis(unit)||unit["draft"]!.GetValue<string>()!=unit["original"]!.GetValue<string>()){notices.Add(id);notices.Add("baseline-changed");continue;}}
 if(disk[0]!="exists"){notices.Add(id);notices.Add("missing");continue;}
 if(kind is "blueprint" or "blueprint-node")calls.Metadata.Invoke("blueprintSourceValidate",System.Text.Json.JsonSerializer.Serialize(new{id,kind,text=disk[1],_streamProject=state["project"]!.GetValue<string>()}));
 else if(kind is not ("body" or "project" or "pack")){var parsed=System.Text.Json.Nodes.JsonNode.Parse(calls.Inspect.Invoke(disk[1]))!;if(parsed["id"]!.GetValue<string>()!=id||parsed["kind"]!.GetValue<string>()!=kind){notices.Add(id);notices.Add("identity-changed");continue;}}
 lock(state){var unit=state["units"]![id];if(!SameOwner(unit)){notices.Add(id);notices.Add("identity-changed");continue;}if(!SameBasis(unit!)||unit!["draft"]!.GetValue<string>()!=unit["original"]!.GetValue<string>()||Disk(path)[2]!=disk[2]){notices.Add(id);notices.Add("baseline-changed");continue;}unit["baseline"]=disk[2];unit["original"]=disk[1];unit["draft"]=disk[1];unit["revision"]=revision+1;notices.Add(id);notices.Add("refreshed");}
