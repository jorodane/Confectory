var state=AppDomain.CurrentDomain.GetData("Confectory.EditWorkspace."+handle) as System.Text.Json.Nodes.JsonObject??throw new ObjectDisposedException("EditWorkspace");var notices=new System.Collections.Generic.List<string>();
foreach(string id in selected)
{
 string path,kind;long revision;lock(state){var unit=state["units"]![id];if(unit is null)continue;path=System.IO.Path.Combine(state["root"]!.GetValue<string>(),unit["path"]!.GetValue<string>());kind=unit["kind"]!.GetValue<string>();revision=unit["revision"]!.GetValue<long>();}
 var disk=calls.Snapshot.Invoke(path);lock(state){var unit=state["units"]![id]!;if(disk[2]==unit["baseline"]!.GetValue<string>())continue;if(unit["revision"]!.GetValue<long>()!=revision||unit["draft"]!.GetValue<string>()!=unit["original"]!.GetValue<string>()){notices.Add(id);notices.Add("baseline-changed");continue;}}
