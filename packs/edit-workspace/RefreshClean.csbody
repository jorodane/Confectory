string[] Disk(string path){
 path=System.IO.Path.GetFullPath(path);
 if(!path.StartsWith(root+System.IO.Path.DirectorySeparatorChar,OperatingSystem.IsWindows()?StringComparison.OrdinalIgnoreCase:StringComparison.Ordinal))throw new ArgumentException("Refresh source escapes owner");
