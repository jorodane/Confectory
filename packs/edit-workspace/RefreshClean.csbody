 if(kind is not ("body" or "project" or "pack")){var parsed=System.Text.Json.Nodes.JsonNode.Parse(calls.Inspect.Invoke(disk[1]))!;if(parsed["id"]!.GetValue<string>()!=id||parsed["kind"]!.GetValue<string>()!=kind){notices.Add(id);notices.Add("identity-changed");continue;}}
 lock(state){var unit=state["units"]![id]!;if(unit["revision"]!.GetValue<long>()!=revision||unit["draft"]!.GetValue<string>()!=unit["original"]!.GetValue<string>()){notices.Add(id);notices.Add("baseline-changed");continue;}unit["baseline"]=disk[2];unit["original"]=disk[1];unit["draft"]=disk[1];unit["revision"]=revision+1;notices.Add(id);notices.Add("refreshed");}
}
return notices.ToArray();
