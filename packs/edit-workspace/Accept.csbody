 }
 foreach(var operation in System.Linq.Enumerable.ToArray(state["retirements"]?.AsObject()??new System.Text.Json.Nodes.JsonObject())){var receipt=operation.Value!;var ids=System.Text.Json.JsonSerializer.Deserialize<string[]>(receipt["ids"]!.ToJsonString())!;if(Array.IndexOf(selected,receipt["manifest"]!.ToString())<0||System.Linq.Enumerable.Any(ids,id=>Array.IndexOf(selected,id)<0))continue;if(receipt["state"]?.ToString()=="pending")receipt["state"]="confirmed";else if(receipt["state"]?.ToString()=="restoring"){foreach(string id in System.Linq.Enumerable.Prepend(ids,receipt["manifest"]!.ToString()))state["units"]![id]!.AsObject().Remove("retirementGroup");state["retirements"]!.AsObject().Remove(operation.Key);}}
 foreach(var row in state["units"]!.AsObject())if(row.Value?["atomicEditGroup"] is System.Text.Json.Nodes.JsonArray atomic&&System.Linq.Enumerable.All(atomic,member=>state["units"]?[member!.ToString()] is System.Text.Json.Nodes.JsonObject unit&&unit["baseline"]?.ToString()!="missing"&&unit["draft"]?.ToString()==unit["original"]?.ToString()))row.Value!.AsObject().Remove("atomicEditGroup");
 foreach(var row in state["units"]!.AsObject())if(row.Value?["hierarchyGroup"] is System.Text.Json.Nodes.JsonArray group&&System.Linq.Enumerable.All(group,member=>state["units"]?[member!.ToString()] is System.Text.Json.Nodes.JsonObject unit&&unit["draft"]?.ToString()==unit["original"]?.ToString()))row.Value!.AsObject().Remove("hierarchyGroup");
