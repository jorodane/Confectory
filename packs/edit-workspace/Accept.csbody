var state=AppDomain.CurrentDomain.GetData("Confectory.EditWorkspace."+handle) as System.Text.Json.Nodes.JsonObject??throw new ObjectDisposedException("EditWorkspace");
lock(state)
{
 foreach(string id in selected){var unit=state["units"]![id] as System.Text.Json.Nodes.JsonObject;if(unit is null){var archived=System.Linq.Enumerable.SingleOrDefault(state["retirements"]?.AsObject()??new System.Text.Json.Nodes.JsonObject(),row=>row.Value?["state"]?.ToString()=="pending"&&row.Value["entries"]?[id] is not null);if(archived.Value is null)throw new ArgumentException("Unknown owned unit");var receipt=archived.Value!;var source=receipt["entries"]![id]!;var file=calls.Snapshot.Invoke(System.IO.Path.Combine(state["root"]!.ToString(),source["path"]!.ToString()));if(file[0]!="exists"||file[2]!=source["baseline"]!.ToString()||file[1]!=source["original"]!.ToString())throw new InvalidOperationException("Retained original changed before acceptance");continue;}

 var snapshot=calls.Snapshot.Invoke(System.IO.Path.Combine(state["root"]!.GetValue<string>(),unit["path"]!.GetValue<string>()));
 if(snapshot[0]!="exists"||snapshot[1]!=unit["draft"]!.GetValue<string>())throw new InvalidOperationException("Committed source changed before workspace acceptance; preserve draft.");
 unit.AsObject().Remove("conversionOrigin");
