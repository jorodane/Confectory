if(plan.Length>65536)throw new ArgumentException("Parent move batch budget");var request=System.Text.Json.Nodes.JsonNode.Parse(plan)!.AsObject();if(request.Count!=1||request["moves"] is not System.Text.Json.Nodes.JsonArray moves||moves.Count is <2 or >32)throw new ArgumentException("Explicit parent move batch required");
string key="Confectory.EditWorkspace."+handle;var state=AppDomain.CurrentDomain.GetData(key) as System.Text.Json.Nodes.JsonObject??throw new ObjectDisposedException("EditWorkspace");
string Hash(string text)=>Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(text))).ToLowerInvariant();
System.Text.Json.Nodes.JsonObject before;string ns,project,manifestId;
lock(state){ns=state["namespace"]!.ToString();var declarations=System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Where(state["units"]!.AsObject(),row=>row.Key.StartsWith(ns+"::",StringComparison.Ordinal)&&row.Value!["kind"]!.ToString() is ("object" or "schema" or "module" or "function" or "implementation" or "category" or "concept" or "project" or "pack")));if(declarations.Length>256)throw new ArgumentException("Move graph budget");foreach(var row in declarations)calls.Read.Invoke(handle,row.Key);before=state["units"]!.DeepClone().AsObject();project=state["project"]!.ToString();manifestId=ns+(before[ns+"::ProjectManifest"] is null?"::PackManifest":"::ProjectManifest");}
var ids=new System.Collections.Generic.HashSet<string>(StringComparer.Ordinal);var replacements=new System.Collections.Generic.Dictionary<string,string>(StringComparer.Ordinal);
foreach(var item in moves){var move=item!.AsObject();if(move.Count!=4||System.Linq.Enumerable.Any(move,p=>p.Key is not ("id" or "parent" or "revision" or "hash"))||!move.ContainsKey("parent"))throw new ArgumentException("Explicit parent and displayed source proof required");string id=move["id"]!.GetValue<string>(),hash=move["hash"]!.GetValue<string>();long revision=move["revision"]!.GetValue<long>();string? parent=move["parent"]?.GetValue<string>();var source=before[id];if(!ids.Add(id)||!id.StartsWith(ns+"::",StringComparison.Ordinal)||source?["kind"]?.ToString()!="object"||revision<0||source["revision"]!.GetValue<long>()!=revision||Hash(source["draft"]!.ToString())!=hash)throw new InvalidOperationException("Move source changed; all input retained");if(parent is not null&&(parent==id||!parent.StartsWith(ns+"::",StringComparison.Ordinal)||before[parent]?["kind"]?.ToString()!="object"))throw new ArgumentException("Different owned object parent or Root required");if(source["baseline"]?.ToString()=="missing"||source["rootContractGroup"] is not null)throw new InvalidOperationException("Complete the existing creation or contract group before moving");
 replacements.Add(id,System.Text.Json.JsonSerializer.Deserialize<string>(calls.Metadata.Invoke("editDeclaration",new System.Text.Json.Nodes.JsonObject{["text"]=source["draft"]!.DeepClone(),["edit"]=new System.Text.Json.Nodes.JsonObject{["action"]="parent",["value"]=parent}}.ToJsonString()))!);
}
foreach(string id in ids)if(before[id]?["hierarchyGroup"] is System.Text.Json.Nodes.JsonArray prior&&System.Linq.Enumerable.Any(prior,member=>!ids.Contains(member!.ToString())&&before[member.ToString()]?["draft"]?.ToString()!=before[member.ToString()]?["original"]?.ToString()))throw new InvalidOperationException("Move the complete pending hierarchy group");
foreach(string id in ids){var overlays=new System.Text.Json.Nodes.JsonArray();foreach(var row in before){if(row.Key==id||!row.Key.StartsWith(ns+"::",StringComparison.Ordinal)||row.Value!["kind"]!.ToString() is not ("object" or "schema" or "module" or "function" or "implementation" or "category" or "concept"))continue;overlays.Add(new System.Text.Json.Nodes.JsonObject{["id"]=row.Key,["text"]=replacements.TryGetValue(row.Key,out string? replacement)?replacement:row.Value["draft"]!.ToString()});}
 var checkedGraph=System.Text.Json.Nodes.JsonNode.Parse(calls.Metadata.Invoke("effective",System.Text.Json.JsonSerializer.Serialize(new{project,manifest=before[manifestId]!["draft"]!.ToString(),id,text=replacements[id],drafts=overlays,schemaView=true,validateObjects=true})))!;if(checkedGraph["status"]?.ToString()!="available"||checkedGraph["schemaModel"]?["validation"]?["status"]?.ToString()!="valid")throw new InvalidOperationException("Move graph rejected: "+(checkedGraph["code"]?.ToString()??checkedGraph["schemaModel"]?["validation"]?["code"]?.ToString()??"SCHEMA_INVALID"));}
lock(state){if(!ReferenceEquals(AppDomain.CurrentDomain.GetData(key),state)||!System.Text.Json.Nodes.JsonNode.DeepEquals(before,state["units"]))throw new InvalidOperationException("Move dependencies changed during validation; no partial move applied");var units=state["units"]!.AsObject();bool changed=System.Linq.Enumerable.Any(replacements,row=>row.Value!=units[row.Key]!["draft"]!.ToString());if(changed){var group=System.Text.Json.JsonSerializer.SerializeToNode(System.Linq.Enumerable.Order(ids,StringComparer.Ordinal))!;var history=new System.Text.Json.Nodes.JsonObject();foreach(var row in replacements){var unit=units[row.Key]!;history[row.Key]=new System.Text.Json.Nodes.JsonObject{["text"]=unit["draft"]!.DeepClone(),["hierarchyGroup"]=unit["hierarchyGroup"]?.DeepClone()};if(row.Value!=unit["draft"]!.ToString()){unit["draft"]=row.Value;unit["revision"]=unit["revision"]!.GetValue<long>()+1;}unit["hierarchyGroup"]=group.DeepClone();}if(AppDomain.CurrentDomain.GetData("Confectory.EditWorkspace.HistoryRecorder."+handle) is Action<System.Text.Json.Nodes.JsonObject,string> record)record(history,"batch-edit");}}
return System.Text.Json.JsonSerializer.Serialize(new{ids=System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Order(ids,StringComparer.Ordinal)),sourceWritten=false});
