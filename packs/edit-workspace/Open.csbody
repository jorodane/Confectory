if(string.IsNullOrWhiteSpace(project)||string.IsNullOrWhiteSpace(participant)||string.IsNullOrWhiteSpace(context))throw new ArgumentException("Explicit project, participant and work-context required.");
project=System.IO.Path.GetFullPath(project);if(OperatingSystem.IsWindows())project=project.ToUpperInvariant();
string identity=Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(System.Text.Json.JsonSerializer.Serialize(new[]{project,participant,context}))));
string key="Confectory.EditWorkspace.Identity."+identity;
lock(AppDomain.CurrentDomain)
{
 if(AppDomain.CurrentDomain.GetData(key) is string existing)return existing;
 var description=System.Text.Json.Nodes.JsonNode.Parse(calls.Describe.Invoke("describe",System.Text.Json.JsonSerializer.Serialize(new{project,metadataOnly=true})))!;var units=new System.Text.Json.Nodes.JsonObject();string root=System.IO.Path.GetDirectoryName(project)!;
 foreach(var item in description["units"]!.AsArray())
 {
  string id=item!["id"]!.GetValue<string>(),path=item["path"]!.GetValue<string>();
  var unit=new System.Text.Json.Nodes.JsonObject{["id"]=id,["kind"]=item["kind"]!.GetValue<string>(),["path"]=path,["revision"]=0L};
  if(unit["kind"]!.GetValue<string>() is "project" or "pack"){var snapshot=calls.Snapshot.Invoke(System.IO.Path.Combine(root,path));if(snapshot[0]!="exists")throw new System.IO.FileNotFoundException("Owned manifest missing.",path);unit["baseline"]=snapshot[2];unit["original"]=snapshot[1];unit["draft"]=snapshot[1];}
  units.Add(id,unit);
 }
 string handle=Guid.NewGuid().ToString("N");var state=new System.Text.Json.Nodes.JsonObject{["project"]=project,["root"]=root,["participant"]=participant,["context"]=context,["namespace"]=description["namespace"]!.GetValue<string>(),["identity"]=identity,["units"]=units};
 state["history"]=new System.Text.Json.Nodes.JsonObject{["epoch"]=Guid.NewGuid().ToString("N"),["revision"]=0L,["undo"]=new System.Text.Json.Nodes.JsonArray(),["redo"]=new System.Text.Json.Nodes.JsonArray()};
 // One owner-local recorder is called by successful writers inside the same draft gate.
 AppDomain.CurrentDomain.SetData("Confectory.EditWorkspace.HistoryRecorder."+handle,(Action<System.Text.Json.Nodes.JsonObject,string>)((before,label)=>{
  lock(state){
   var history=state["history"]!;history["revision"]=history["revision"]!.GetValue<long>()+1;history["redo"]=new System.Text.Json.Nodes.JsonArray();
   if(before.Count==0){history["undo"]=new System.Text.Json.Nodes.JsonArray();history["boundary"]=label;return;}
   var changed=new System.Text.Json.Nodes.JsonArray();foreach(var pair in before){var unit=state["units"]![pair.Key]!;if(unit["draft"]!.ToString()==pair.Value!.ToString())continue;changed.Add(new System.Text.Json.Nodes.JsonObject{["id"]=pair.Key,["kind"]=unit["kind"]!.DeepClone(),["path"]=unit["path"]!.DeepClone(),["before"]=pair.Value.DeepClone(),["after"]=unit["draft"]!.DeepClone()});}
   if(changed.Count==0)return;
   var entry=new System.Text.Json.Nodes.JsonObject{["id"]=Guid.NewGuid().ToString("N"),["label"]=label,["units"]=changed};
   if(entry.ToJsonString().Length>1048576){history["undo"]=new System.Text.Json.Nodes.JsonArray();history["boundary"]="ENTRY_BUDGET";return;}
   var undo=history["undo"]!.AsArray();undo.Add(entry);while(undo.Count>32||undo.ToJsonString().Length>2097152)undo.RemoveAt(0);history["boundary"]=null;
  }
 }));
 AppDomain.CurrentDomain.SetData("Confectory.EditWorkspace."+handle,state);AppDomain.CurrentDomain.SetData(key,handle);return handle;
}
