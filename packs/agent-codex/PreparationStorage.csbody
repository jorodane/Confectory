if(rootBase==System.IO.Path.GetPathRoot(rootBase)||rootBase.StartsWith("//",StringComparison.Ordinal)||rootBase.StartsWith(@"\\",StringComparison.Ordinal)||rootBase.Contains('\0')||rootBase.Contains('\n')||rootBase.Contains('\r'))throw new ArgumentException("Private local preparation root required");
bool LocalPart(string value)=>System.Text.RegularExpressions.Regex.IsMatch(value,@"^[A-Za-z0-9._-]{1,80}$")&&value is not ("." or "..");if(!LocalPart(version)||!LocalPart(target))throw new ArgumentException("Release storage identifier");
void NoLinks(string path){for(string? part=System.IO.Path.GetFullPath(path);part is not null;part=System.IO.Path.GetDirectoryName(part)){var info=System.IO.Directory.Exists(part)?(System.IO.FileSystemInfo)new System.IO.DirectoryInfo(part):new System.IO.FileInfo(part);if(info.LinkTarget is not null||(info.Exists&&(info.Attributes&System.IO.FileAttributes.ReparsePoint)!=0))throw new InvalidOperationException("storage_link_blocked");}}
