 return new System.Text.Json.Nodes.JsonObject{["installations"]=installations,["homes"]=homes}.ToJsonString();
}
string selected=args["root"]?.ToString()??throw new ArgumentException("Owned root selection required");if(!System.Linq.Enumerable.Contains(roots,selected,StringComparerFromComparison()))throw new ArgumentException("Foreign preparation root");
StringComparer StringComparerFromComparison()=>OperatingSystem.IsWindows()?StringComparer.OrdinalIgnoreCase:StringComparer.Ordinal;
object gate;string gateKey="Confectory.Codex.Storage."+Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(selected.ToUpperInvariant())));lock(AppDomain.CurrentDomain){gate=AppDomain.CurrentDomain.GetData(gateKey)??new object();AppDomain.CurrentDomain.SetData(gateKey,gate);}
