 }
 if(operation is "delete-install" or "delete-account"){
  NoLinks(directory);if(!System.IO.Directory.Exists(directory))return "{}";NoLinks(ownership);if(!System.IO.File.Exists(ownership)||new System.IO.FileInfo(ownership).Length!=32||System.IO.File.ReadAllText(ownership)!=nonce)throw new InvalidOperationException("cleanup_ownership_lost");
  void Remove(string path){NoLinks(path);foreach(string child in System.IO.Directory.EnumerateFileSystemEntries(path)){var attributes=System.IO.File.GetAttributes(child);if((attributes&System.IO.FileAttributes.Directory)!=0){if((attributes&System.IO.FileAttributes.ReparsePoint)!=0)System.IO.Directory.Delete(child);else Remove(child);}else System.IO.File.Delete(child);}NoLinks(path);System.IO.Directory.Delete(path);}
  Remove(directory);return "{}";
 }
 throw new ArgumentException("Preparation storage operation");
