 bool account=operation.Contains("account",StringComparison.Ordinal);string parent=account?System.IO.Path.Combine(selected,"accounts"):System.IO.Path.Combine(selected,"installations",version,target),directory=System.IO.Path.Combine(parent,(account?"account-":".pending-")+nonce),ownership=System.IO.Path.Combine(directory,account?".confectory-account":".confectory-stage");
