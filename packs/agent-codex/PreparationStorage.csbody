void PrivateDirectory(string path){NoLinks(path);if(!System.IO.Directory.Exists(path)){System.IO.Directory.CreateDirectory(path);if(!OperatingSystem.IsWindows())System.IO.File.SetUnixFileMode(path,System.IO.UnixFileMode.UserRead|System.IO.UnixFileMode.UserWrite|System.IO.UnixFileMode.UserExecute);}NoLinks(path);}
