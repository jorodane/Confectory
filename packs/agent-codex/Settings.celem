schema Confectory.Agent.Codex::Settings extends Confectory.AIConnection::Configuration { field connectionMethod single general string; field sessionSocket single general string; field workspaceTriggerId single general string; field workspaceCredentialReference single general string; field executable single general string; field managedHome single general string; value editorHelpConnectionMethod = "local-cli / desktop-ide / chatgpt-work. Method selection grants no account or execution permission."; value editorHelpSessionSocket = "Explicit official app-server Unix control socket path. No private IPC or implicit session discovery."; value editorHelpWorkspaceTriggerId = "Published Workspace Agent API channel ID (agtch_...). Ordinary Work chats do not supply this API channel automatically."; value editorHelpWorkspaceCredentialReference = "env:NAME reference only, never a token. Provision Workspace Agent scope separately after reviewing persistent access."; value editorHelpManagedHome = "Explicit Codex configuration/authentication storage directory chosen through a separately approved managed connection boundary. Editing this path grants no access."; value editorHelpExecutable = "User-selected existing Codex executable. Selection never starts a process or signs in."; }
