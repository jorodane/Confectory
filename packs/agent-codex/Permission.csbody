var value=System.Text.Json.Nodes.JsonNode.Parse(calls.Validate.Invoke(config))!;string method=value["connectionMethod"]?.ToString()??"local-cli";
if(method=="chatgpt-work")return new System.Text.Json.Nodes.JsonObject{["requirements"]=new System.Text.Json.Nodes.JsonArray(new System.Text.Json.Nodes.JsonObject{["id"]="contentApproved",["label"]="Review project/Helper input before a separate published agent request"},new System.Text.Json.Nodes.JsonObject{["id"]="usageApproved",["label"]="Review usage terms separately"}),["pins"]=new System.Text.Json.Nodes.JsonObject{["workspaceTriggerId"]=value["workspaceTriggerId"]!.DeepClone(),["model"]=value["model"]!.DeepClone(),["connectionMethod"]=method,["sessionSocket"]=value["sessionSocket"]?.DeepClone(),["protocolVerified"]=false},["supported"]=false,["blockedReason"]="Workspace Agent API can submit input and track a run, but cannot retrieve an agent reply or cancel the remote run. Helper/Worker execution is unsupported. Configure an owned published API channel and separately provision scoped access before any account experiment.",["disclosures"]=new System.Text.Json.Nodes.JsonArray("No token value, login or request is read or performed by selecting this method.","Ordinary ChatGPT Work UI and a published Workspace Agent API channel are different entry points. API acceptance/status is not a Helper answer or goal completion."),["diagnostics"]=new System.Text.Json.Nodes.JsonObject{["processStarted"]=false,["credentialRead"]=false,["accountVerified"]=false,["checks"]=new System.Text.Json.Nodes.JsonArray(new System.Text.Json.Nodes.JsonObject{["label"]="ChatGPT Work API",["status"]="요청·상태 조회 가능 · 응답 본문·원격 중지 API 없음"})}}.ToJsonString();
var permissions=new System.Text.Json.Nodes.JsonArray();void Require(string id,string label){permissions.Add(new System.Text.Json.Nodes.JsonObject{["id"]=id,["label"]=label});}Require("contentApproved","Send reviewed project context and tool results");Require("usageApproved","Consume model usage / possible charges");
Require("processApproved",method=="desktop-ide"?"Connect only the selected official control socket for this turn":"Run selected executable for this turn");Require("managedCredentialApproved","Use my separately signed-in account");Require("managedConfigurationApproved","Read selected managed configuration");Require("managedStorageApproved","Write selected managed storage / scratch");
// Passive checks of the explicitly selected paths. No executable/config/auth file is opened.
bool desktop=!OperatingSystem.IsBrowser()&&!OperatingSystem.IsAndroid();
var checks=new System.Text.Json.Nodes.JsonArray();void Check(string label,string status){checks.Add(new System.Text.Json.Nodes.JsonObject{["label"]=label,["status"]=status});}
bool LocalPath(string path)=>!path.StartsWith("//",StringComparison.Ordinal)&&!path.StartsWith(@"\\",StringComparison.Ordinal);
if(method=="desktop-ide")Check("공식 제어 소켓", "명시한 경로로 연결 · 앱 탐지·실계정 연결 미검증");else Check("선택한 Codex 실행 파일",desktop?(LocalPath(value["executable"]!.ToString())?(System.IO.File.Exists(value["executable"]!.ToString())?"경로에 파일 있음 · 버전 미확인":"경로에 파일 없음"):"네트워크·장치 경로 자동 확인 미지원"):"현재 호스트에서 stdio 실행 미지원");
Check("선택한 Codex 설정 디렉터리",desktop?(LocalPath(value["managedHome"]!.ToString())?(System.IO.Directory.Exists(value["managedHome"]!.ToString())?"디렉터리 있음 · 계정 미확인":"디렉터리 없음"):"네트워크·장치 경로 자동 확인 미지원"):"미확인");
Check("기존 ChatGPT 로그인","미확인 · 승인된 실행에서 공식 계정 조회 후 확인");
Check("모델 도구 접근 범위","사전 확인 결과와 요청 전 재확인에 결부됨 · read-only는 읽기 격리가 아님");
Check("대화 복구","실행마다 새 대화 · 다른 Codex 대화 자동 복구 없음");
Check("프로젝트 접근","검토한 Helper 문맥과 기존 초안 도구 범위");
var evidence=System.Text.Json.Nodes.JsonNode.Parse(calls.Verification.Invoke(config,"status","{}"))!;bool verified=evidence["supported"]?.GetValue<bool>()==true;
var preflight=new System.Text.Json.Nodes.JsonArray();foreach(var requirement in new[]{("checkProcessApproved",method=="desktop-ide"?"선택한 공식 소켓에 사전 확인 연결":"선택한 실행 파일을 사전 확인용으로 실행"),("checkAccountApproved","선택한 설정의 기존 로그인에 대해 공식 account/read 조회 · 갱신·로그인 없음"),("checkConfigurationApproved","선택한 유효 설정·모델 목록·도구 제한 확인"),("checkStorageApproved","선택한 Codex 저장소와 임시 대화 생성 · 모델 요청 없음")})preflight.Add(new System.Text.Json.Nodes.JsonObject{["id"]=requirement.Item1,["label"]=requirement.Item2});
return new System.Text.Json.Nodes.JsonObject{["requirements"]=permissions,["preflightRequirements"]=method=="desktop-ide"?new System.Text.Json.Nodes.JsonArray():preflight,["pins"]=new System.Text.Json.Nodes.JsonObject{["model"]=value["model"]!.DeepClone(),["executable"]=value["executable"]!.DeepClone(),["managedHome"]=value["managedHome"]!.DeepClone(),["connectionMethod"]=method,["sessionSocket"]=value["sessionSocket"]?.DeepClone(),["protocolVerified"]=verified,["verificationId"]=evidence["verificationId"]?.DeepClone(),["verificationFingerprint"]=evidence["verificationFingerprint"]?.DeepClone()},["supported"]=verified,["blockedReason"]=verified?null:evidence["message"]?.DeepClone(),["service"]="Official OpenAI Codex provider, checked through the selected managed configuration before each approved request",["authentication"]="Existing user-owned ChatGPT sign-in via official account/read(refreshToken:false); user performs any required login separately",["disclosures"]=new System.Text.Json.Nodes.JsonArray("Preflight consent only permits installation/account/configuration inspection and temporary thread creation. It sends no project context and starts no model turn.","A verified session lasts ten minutes and is bound to installation, model, managed account, effective configuration and environmentless tool profile. Settings edits, cancellation or changed evidence require another check and request approval.","Native file/exec/apply-patch access is removed with environments=[] before inference. Hosted search and external tools are excluded by confirmed startup controls; read-only is only a write policy.","Scoped Confectory draft tools are supplied at thread creation. Internal clock/planning/UI utilities may remain and confer no project file/process/connector/recipient rights.","Every actual request rechecks account and effective configuration before sending context. No login, refresh, token import, account switching or persistent access is configured here.","A Codex turn can perform multiple inference requests/retries; there is no enforceable monetary/model-request cap in this interface."),["diagnostics"]=new System.Text.Json.Nodes.JsonObject{["checks"]=checks,["processStarted"]=false,["credentialRead"]=false,["accountVerified"]=verified},["verification"]=evidence.DeepClone(),["limits"]=new System.Text.Json.Nodes.JsonObject{["maxTurns"]=1,["maxDynamicToolCalls"]=32,["turnTimeoutSeconds"]=90,["maxInputCharacters"]=65536,["maxDisplayedOutputBytes"]=32768,["maxModelRequests"]=null,["hardModelRequestCapEnforced"]=false}}.ToJsonString();
