return new System.Text.Json.Nodes.JsonObject{["requirements"]=permissions,["pins"]=new System.Text.Json.Nodes.JsonObject{["model"]=value["model"]!.DeepClone(),["executable"]=value["executable"]!.DeepClone(),["managedHome"]=value["managedHome"]!.DeepClone(),["protocolVerified"]=false},["supported"]=false,["blockedReason"]="No-environment startup is checked; read-only does not restrict file reads. Chosen-model tool filtering and managed account/service remain unverified. Consent cannot override this gate.",["service"]="Intended OpenAI Codex through the selected managed configuration; actual endpoint NOT VERIFIED",["authentication"]="codex:managed: existing user-owned ChatGPT sign-in, performed separately using the official CLI and selected CODEX_HOME. No in-app login, token import or API-key Codex path.",["disclosures"]=new System.Text.Json.Nodes.JsonArray("Settings and checkboxes neither sign in nor verify account ownership. Do not reuse this execution environment's account.","Selected executable and managedHome are reviewed below; permission lasts for this turn only. No secret values are stored in packs or consent logs.","Installed 0.159.0-alpha.3 startup was tested without account or inference. Empty environments and extension-disable requests are accepted; actual model-facing tool restrictions are NOT VERIFIED.","A single CLI turn can make multiple inference requests or retries. The existing stdio contract cannot enforce a hard model-request or monetary cap."),["verification"]=new System.Text.Json.Nodes.JsonObject{["installedStartupOnly"]=true,["liveVerified"]=false,["chosenModelToolPolicyVerified"]=false,["accountVerified"]=false,["serviceVerified"]=false},["limits"]=new System.Text.Json.Nodes.JsonObject{["maxTurns"]=1,["maxDynamicToolCalls"]=32,["turnTimeoutSeconds"]=90,["maxInputCharacters"]=65536,["maxDisplayedOutputBytes"]=32768,["maxModelRequests"]=null,["hardModelRequestCapEnforced"]=false}}.ToJsonString();
