 }
 if(operation=="approve"){
  string token=input["token"]?.ToString()??"";if(token.Length>0&&token==flow["lastToken"]?.ToString())return Result();if(Phase()!="consent"||token!=flow["view"]?["token"]?.ToString())throw new UnauthorizedAccessException("Stale CLI setup consent");flow["lastToken"]=token;string kind=flow["consentKind"]!.ToString();var request=new System.Text.Json.Nodes.JsonObject{["token"]=flow["plan"]!["token"]!.DeepClone(),["approvals"]=Approvals(kind)};if(kind=="install"){flow["installAttempted"]=true;calls.Preparation.Invoke(jobOwner,"start",request.ToJsonString());}else{flow["loginAttempted"]=true;calls.Login.Invoke(jobOwner,"start",request.ToJsonString());}Set(kind=="install"?"installing":"waiting-login",kind=="install"?"Codex를 설치하고 있어요.":"공식 로그인을 준비하고 있어요.");return Result();
 }
 if(operation=="new-login"){if(Phase()=="failed"&&flow["view"]?["retryable"]?.GetValue<bool>()==false)throw new InvalidOperationException("Owned cleanup must finish before another login");if(Busy())throw new InvalidOperationException("Cancel the current setup step before changing accounts");if(flow["executable"] is null)throw new InvalidOperationException("A supported CLI is required");flow.Remove("selected");flow["loginMethod"]="browser";Consent("login");return Result();}
 if(operation is "device-login" or "browser-login"){
  if(Phase()=="switching-login")return Result();string handle=flow["view"]?["openHandle"]?.ToString()??flow["view"]?["switchHandle"]?.ToString()??"";
  if(handle.Length==0||handle!=input["token"]?.ToString()||!(Phase()=="waiting-login"||Phase()=="failed"&&flow["view"]?["canSwitchLogin"]?.GetValue<bool>()==true))throw new UnauthorizedAccessException("Current login method choice required");
  if(System.Text.Json.Nodes.JsonNode.Parse(calls.Login.Invoke(jobOwner,"status","{}"))?["state"]?.ToString()=="login-complete")return Result();
  Stop();flow["loginMethod"]=operation=="device-login"?"device":"browser";Set("switching-login",operation=="device-login"?"브라우저 로그인을 취소하고 기기 코드 방식으로 전환하고 있어요.":"기기 코드 로그인을 취소하고 브라우저 방식으로 전환하고 있어요.");return Result();
 }
 if(operation is "choose-account" or "choose-model"){
  string token=input["token"]?.ToString()??"";if(token.Length>0&&token==flow["lastToken"]?.ToString())return Result();if(token!=flow["view"]?["token"]?.ToString())throw new UnauthorizedAccessException("Stale CLI setup choice");
  if(operation=="choose-account"){if(Phase()!="account-choice")throw new InvalidOperationException("Account selection is not active");flow["selected"]=System.Linq.Enumerable.Single(flow["accounts"]!.AsArray(),a=>a?["id"]?.ToString()==input["account"]?.ToString())!.DeepClone();flow["lastToken"]=token;flow["connectionAttempted"]=true;ModelOrCheck();}
  else{if(Phase()!="model-choice")throw new InvalidOperationException("Model selection is not active");string model=input["model"]?.ToString()??"";if(!System.Linq.Enumerable.Any(flow["selected"]!["catalogue"]!["models"]!.AsArray(),m=>m?["model"]?.ToString()==model))throw new ArgumentException("Choose a returned model");flow["lastToken"]=token;flow["connectionAttempted"]=true;StartCheck(Candidate(flow["selected"]!["home"]!.ToString(),model),false);}return Result();
 }
 if(operation is not ("poll" or "snapshot"))throw new ArgumentException("CLI onboarding operation");
 if(operation=="snapshot"){if(Phase()=="ready"&&System.Text.Json.Nodes.JsonNode.Parse(calls.Verification.Invoke(flow["config"]!.ToJsonString(),"status","{}"))?["supported"]?.GetValue<bool>()!=true)Set("idle","계정과 설정은 유지됩니다. 연결 상태를 다시 확인해 주세요.");return Result();}
 if(Phase()=="switching-login"&&!Retiring()){var retired=System.Text.Json.Nodes.JsonNode.Parse(calls.Login.Invoke(jobOwner,"status","{}"))!;if(retired["code"]?.ToString()=="login_cleanup_pending")Fail("login_cleanup_pending","이전 로그인 정리를 마치지 못했어요. 오류 정보를 확인하세요.","login");else Consent("login");}
 else if(Phase()=="cancelling"&&!Retiring()){Set("cancelled","정리를 마쳤어요. 다시 로그인할 수 있습니다.");}
 else if(Phase()=="probing"&&state[2] is System.Threading.Tasks.Task task&&task.IsCompleted){task.GetAwaiter().GetResult();var result=(System.Text.Json.Nodes.JsonObject)state[5];if(result["code"]?.ToString()=="runtime_cleanup_pending")Fail("runtime_cleanup_pending","임시 실행 정리를 확인하지 못했어요. 오류 정보를 확인하세요.","probe");else if(result["executable"] is null)Consent("install");else{flow["executable"]=result["executable"]!.DeepClone();CaptureInstallation();if(flow["homes"]!.AsArray().Count==0)Consent("login");else InspectNext();}}
 else if(Phase()=="installing"){
  var status=System.Text.Json.Nodes.JsonNode.Parse(calls.Preparation.Invoke(jobOwner,"status","{}"))!;
  if(status["state"]?.ToString()=="prepared"){flow["executable"]=status["executable"]!.DeepClone();CaptureInstallation();if(flow["homes"]!.AsArray().Count==0)Consent("login");else InspectNext();}
  else if(status["state"]?.ToString() is "failed" or "cancelled")Fail(status["code"]?.ToString()??"installation_failed",status["message"]?.ToString()??"설치하지 못했어요.","install");else{flow["view"]!["message"]=status["message"]?.DeepClone();flow["view"]!["percent"]=status["percent"]?.DeepClone();}
 }
 else if(Phase()=="waiting-login"){
  var status=System.Text.Json.Nodes.JsonNode.Parse(calls.Login.Invoke(jobOwner,"status","{}"))!;
  if(status["state"]?.ToString()=="login-complete"){flow["loginIdentity"]=status["accountIdentity"]?.DeepClone();flow["homes"]=new System.Text.Json.Nodes.JsonArray(new System.Text.Json.Nodes.JsonObject{["path"]=status["managedHome"]!.DeepClone()});flow["homeIndex"]=0;flow["accounts"]=new System.Text.Json.Nodes.JsonArray();flow["inspectionFailures"]=new System.Text.Json.Nodes.JsonArray();InspectNext();}
  else if(status["state"]?.ToString() is "failed" or "cancelled")Fail(status["code"]?.ToString()??"login_failed",status["message"]?.ToString()??"로그인을 확인하지 못했어요.","login",FailureInfo(status));else{flow["view"]!["message"]=status["message"]?.DeepClone();foreach(string field in new[]{"verificationUrl","userCode","expires","loginMethod","openHandle"})flow["view"]![field]=status[field]?.DeepClone();}
 }
 else if(Phase() is "inspecting" or "checking"){
  bool inspecting=Phase()=="inspecting";var status=System.Text.Json.Nodes.JsonNode.Parse(calls.Verification.Invoke(flow["checkConfig"]!.ToJsonString(),"status","{}"))!;string phase=status["state"]?.ToString()??"";
  if(inspecting&&phase=="models-found"){
   int index=flow["homeIndex"]!.GetValue<int>();string home=flow["homes"]![index]!["path"]!.ToString();var account=new System.Text.Json.Nodes.JsonObject{["id"]=Guid.NewGuid().ToString("N"),["identity"]=status["accountIdentity"]!.DeepClone(),["home"]=home,["catalogue"]=status.DeepClone()};flow["accounts"]!.AsArray().Add(account);var expected=flow["loginIdentity"]??flow["knownIdentity"];
   if(expected?["fingerprint"]?.ToString()==account["identity"]?["fingerprint"]?.ToString()&&(flow["loginIdentity"] is not null||home==flow["settings"]?["managedHome"]?.ToString())){flow["selected"]=account.DeepClone();ModelOrCheck();}
   else{flow["homeIndex"]=index+1;InspectNext();}
  }else if(!inspecting&&phase=="verified"){
   if(status["accountIdentity"]?["fingerprint"]?.ToString()!=flow["selected"]?["identity"]?["fingerprint"]?.ToString()){flow["selected"]!["identity"]=status["accountIdentity"]!.DeepClone();flow["accounts"]=new System.Text.Json.Nodes.JsonArray(flow["selected"]!.DeepClone());flow["homeIndex"]=flow["homes"]!.AsArray().Count;InspectNext();}
   else{flow["config"]=flow["checkConfig"]!.DeepClone();flow["completionId"]=Guid.NewGuid().ToString("N");Set("ready","Codex 연결 준비가 끝났어요. Helper를 만들고 대화할 수 있습니다.");flow["view"]!["model"]=flow["config"]!["model"]!.DeepClone();flow["view"]!["accountMetadataVerified"]=true;flow["view"]!["inferenceVerified"]=false;flow["view"]!["expires"]=status["expires"]?.DeepClone();}
  }else if(phase is "blocked" or "unauthenticated" or "unsupported" or "cancelled" or "stale"){
   string code=status["code"]?.ToString()??"connection_failed";var info=FailureInfo(status);if(inspecting){info["candidate"]=flow["homeIndex"]!.GetValue<int>()+1;flow["inspectionFailures"]!.AsArray().Add(info);flow["homeIndex"]=flow["homeIndex"]!.GetValue<int>()+1;InspectNext();}else FailCheck(info);
  }
 }
 return Result();
}
