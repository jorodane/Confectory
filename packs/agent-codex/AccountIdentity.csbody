// Display only official account metadata. Tokens and unknown fields are never projected.
if(account.Length>32768)throw new ArgumentException("Account metadata bound");var value=System.Text.Json.Nodes.JsonNode.Parse(account)!.AsObject();if(value["type"]?.ToString()!="chatgpt")throw new ArgumentException("Official ChatGPT account required");
System.Text.Json.Nodes.JsonNode? Stable(System.Text.Json.Nodes.JsonNode? node){if(node is System.Text.Json.Nodes.JsonObject obj){var result=new System.Text.Json.Nodes.JsonObject();foreach(var item in System.Linq.Enumerable.OrderBy(obj,p=>p.Key,StringComparer.Ordinal))result[item.Key]=Stable(item.Value);return result;}if(node is System.Text.Json.Nodes.JsonArray array){var result=new System.Text.Json.Nodes.JsonArray();foreach(var item in array)result.Add(Stable(item));return result;}return node?.DeepClone();}
string Text(string key,int bound){string text=value[key]?.GetValue<string>()??"";return text.Length<=bound&&!System.Linq.Enumerable.Any(text,c=>char.IsControl(c))?text:"";}
return new System.Text.Json.Nodes.JsonObject{["email"]=Text("email",256),["planType"]=Text("planType",64),["fingerprint"]=Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(Stable(value)!.ToJsonString()))).ToLowerInvariant()}.ToJsonString();
