object Confectory.Agent.Codex::Connection extends Confectory.AIConnection::Connection { value displayName = "Codex"; value configurationSchema = "Confectory.Agent.Codex::Settings"; use schema Confectory.Agent.Codex::Settings; value transport = "codex-app-server-stdio"; value connectionMethodField = "connectionMethod"; value connectionMethods = "[{\"id\":\"local-cli\",\"title\":\"로컬 CLI\",\"summary\":\"기존 Codex 실행 파일과 별도로 선택한 설정 디렉터리로 연결합니다.\",\"status\":\"로컬 stdio 시험 통과 · 실제 계정과 도구 범위 확인 필요\",\"fields\":[\"model\",\"executable\",\"managedHome\",\"credentialReference\"],\"steps\":[\"공식 CLI 버전과 실행 파일 경로를 확인하세요.\",\"선택한 설정 디렉터리의 계정이 본인 소유인지 확인하세요.\",\"실제 전송 전에 문맥·사용량·계정·저장소 권한을 별도로 검토합니다.\"],\"documentation\":\"https://learn.chatgpt.com/docs/app-server\"},{\"id\":\"desktop-ide\",\"title\":\"데스크톱 앱 · IDE\",\"summary\":\"공식 app-server 제어 소켓을 사용하는 연결 경로를 비교합니다. 앱의 사설 IPC나 열린 대화를 자동으로 가져오지 않습니다.\",\"status\":\"공식 제어 소켓 필요 · 앱·확장 자동 탐지와 실계정 연결 미검증\",\"fields\":[\"model\",\"sessionSocket\",\"managedHome\"],\"steps\":[\"앱·IDE가 공개하는 공식 app-server 소켓 또는 별도 준비한 소유한 소켓을 지정하세요.\",\"공개 소켓을 제공하지 않는 앱·확장에는 자동 요청을 전송할 수 없습니다.\",\"설치·로그인·소켓 시작은 사용자 환경에서 별도 진행합니다.\"],\"documentation\":\"https://learn.chatgpt.com/docs/codex/ide\"},{\"id\":\"chatgpt-work\",\"title\":\"ChatGPT Work\",\"summary\":\"Work 화면의 수동 전달과 공개 Workspace Agent API 채널을 구분해 실험합니다.\",\"status\":\"API 요청·상태 조회 경로 있음 · 응답 본문·원격 중지 API 없음\",\"fields\":[\"workspaceTriggerId\",\"workspaceCredentialReference\"],\"steps\":[\"Work 화면을 사용하는 경우 검토한 요청을 직접 전달합니다. 자동 UI 조작은 제공하지 않습니다.\",\"API 실험에는 관리자가 허용한 게시된 Workspace Agent API 채널과 별도 토큰 설정이 필요합니다.\",\"토큰 값은 이 설정에 저장하지 마세요. 자격 참조만 사용합니다.\",\"API 수락·완료 상태를 Helper 답변이나 Worker 목표 완료로 표시하지 않습니다.\"],\"documentation\":\"https://learn.chatgpt.com/workspace-agents/trigger-runs\"}]"; value configurationFunction = "Confectory.Agent.Codex::Configuration"; value providerFunction = "Confectory.Agent.Codex::Provider"; value providerImplementation = "Confectory.Agent.Codex::ProviderBody"; value transportImplemented = true; value permissionFunction = "Confectory.Agent.Codex::Permission"; value authentication = "codex-managed-user-sign-in"; value desktopSupported = false; value browserSupported = false; value androidSupported = false; value functionTools = false; value unsupportedReason = "No-environment startup is checked without authentication or inference; read-only does not restrict file reads. Native tool inventory, live dynamic tools and managed authentication remain unverified. Choosing settings never launches Codex."; value protocolDocument = "https://developers.openai.com/codex/app-server"; data connectionMethod = "local-cli"; data sessionSocket = ""; data workspaceTriggerId = ""; data workspaceCredentialReference = ""; data executable = "codex"; data managedHome = ""; }
