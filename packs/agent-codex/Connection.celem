object Confectory.Agent.Codex::Connection extends Confectory.AIConnection::Connection { value configurationSchema = "Confectory.Agent.Codex::Settings"; use schema Confectory.Agent.Codex::Settings; value transport = "codex-app-server-stdio"; value configurationFunction = "Confectory.Agent.Codex::Configuration"; value providerFunction = "Confectory.Agent.Codex::Provider"; value providerImplementation = "Confectory.Agent.Codex::ProviderBody"; value transportImplemented = true; value permissionFunction = "Confectory.Agent.Codex::Permission"; value authentication = "codex-managed-user-sign-in"; value desktopSupported = false; value browserSupported = false; value androidSupported = false; value functionTools = false; value unsupportedReason = "No-environment startup is checked without authentication or inference; read-only does not restrict file reads. Native tool inventory, live dynamic tools and managed authentication remain unverified. Choosing settings never launches Codex."; value protocolDocument = "https://developers.openai.com/codex/app-server"; data executable = "codex"; data managedHome = ""; }
