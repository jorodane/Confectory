{"title":"AI 준비 안내","defaultMethod":"local-cli","supportedVersions":["0.159.0-alpha.3"],"knownVersions":[{"version":"0.159.2","status":"unvalidated","reason":"이전 관리 설치에서 사용한 버전입니다. 실제 비호환이 입증된 것은 아니며 이 프로그램의 전체 연결 호환성은 아직 검증하지 않았습니다.","url":"https://github.com/openai/codex/releases/tag/rust-v0.159.2"}],"documentation":"https://learn.chatgpt.com/docs/codex/cli","release":"https://github.com/openai/codex/releases/tag/rust-v0.159.0-alpha.3","package":"@openai/codex@0.159.0-alpha.3","packageSource":"https://registry.npmjs.org/@openai/codex/0.159.0-alpha.3","targets":[{"id":"windows-x64","label":"Windows · x64","os":"windows","architecture":"x64","asset":"codex-x86_64-pc-windows-msvc.exe.zip","url":"https://github.com/openai/codex/releases/download/rust-v0.159.0-alpha.3/codex-x86_64-pc-windows-msvc.exe.zip","directory":"%LOCALAPPDATA%\\Confectory\\Codex-0.159.0-alpha.3"},{"id":"windows-arm64","label":"Windows · arm64","os":"windows","architecture":"arm64","asset":"codex-aarch64-pc-windows-msvc.exe.zip","url":"https://github.com/openai/codex/releases/download/rust-v0.159.0-alpha.3/codex-aarch64-pc-windows-msvc.exe.zip","directory":"%LOCALAPPDATA%\\Confectory\\Codex-0.159.0-alpha.3"},{"id":"macos-x64","label":"macOS · x64","os":"macos","architecture":"x64","asset":"codex-x86_64-apple-darwin.tar.gz","url":"https://github.com/openai/codex/releases/download/rust-v0.159.0-alpha.3/codex-x86_64-apple-darwin.tar.gz","directory":"~/.local/share/Confectory/Codex-0.159.0-alpha.3"},{"id":"macos-arm64","label":"macOS · arm64","os":"macos","architecture":"arm64","asset":"codex-aarch64-apple-darwin.tar.gz","url":"https://github.com/openai/codex/releases/download/rust-v0.159.0-alpha.3/codex-aarch64-apple-darwin.tar.gz","directory":"~/.local/share/Confectory/Codex-0.159.0-alpha.3"},{"id":"linux-x64","label":"Linux · x64","os":"linux","architecture":"x64","asset":"codex-x86_64-unknown-linux-musl.tar.gz","url":"https://github.com/openai/codex/releases/download/rust-v0.159.0-alpha.3/codex-x8