if(AppDomain.CurrentDomain.GetData("Confectory.Android.Window.Owner."+surfaces[0]) is Func<string,object[],object> adapter){adapter("Draw",new object[]{surfaces, view, rectangles, labels});return;}
if(surfaces.Length!=3)throw new ArgumentException("Invalid Android surface token.");
var context=AppDomain.CurrentDomain.GetData("Confectory.Android.Surface."+surfaces[0]) as object[];
if(context is null)throw new InvalidOperationException("Android app-owned surface session is unavailable.");
((Action<int,int[],string[]>)context[0])(view,rectangles,labels);
