[System.Runtime.InteropServices.DllImport("libX11.so.6")]
static extern IntPtr XOpenDisplay(IntPtr name);
[System.Runtime.InteropServices.DllImport("libX11.so.6")]
static extern nuint XDefaultRootWindow(IntPtr d);
[System.Runtime.InteropServices.DllImport("libX11.so.6")]
static extern nuint XCreateSimpleWindow(IntPtr d, nuint parent, int x, int y, uint w, uint h, uint border, nuint foreground, nuint background);
[System.Runtime.InteropServices.DllImport("libX11.so.6", CharSet = System.Runtime.InteropServices.CharSet.Ansi)]
static extern int XStoreName(IntPtr d, nuint w, string name);
[System.Runtime.InteropServices.DllImport("libX11.so.6", CharSet = System.Runtime.InteropServices.CharSet.Ansi)]
static extern nuint XInternAtom(IntPtr d, string name, bool only);
[System.Runtime.InteropServices.DllImport("libX11.so.6")]
static extern int XSetWMProtocols(IntPtr d, nuint w, ref nuint atom, int count);
[System.Runtime.InteropServices.DllImport("libX11.so.6")]
static extern int XSelectInput(IntPtr d, nuint w, nint mask);
[System.Runtime.InteropServices.DllImport("libX11.so.6")]
static extern int XMapWindow(IntPtr d, nuint w);
[System.Runtime.InteropServices.DllImport("libX11.so.6")]
static extern int XSync(IntPtr d,bool discard);
[System.Runtime.InteropServices.DllImport("libX11.so.6")]
static extern int XDestroyWindow(IntPtr d, nuint w);
[System.Runtime.InteropServices.DllImport("libX11.so.6")]
static extern int XCloseDisplay(IntPtr d);

if (titles.Length < 1 || titles.Length > 16 || width < 1 || height < 1) throw new ArgumentException("Invalid surface request.");
var surfaces = new long[titles.Length + 1];
try
{
 if (OperatingSystem.IsWindows())
 {
  for(int i=0;i<titles.Length;i++)calls.Win32Create.Invoke(surfaces,i,titles[i],width,height);
 }
 else if (OperatingSystem.IsLinux() && !OperatingSystem.IsAndroid())
 {
  var d = XOpenDisplay(IntPtr.Zero); if (d == IntPtr.Zero) throw new InvalidOperationException("Cannot open X11 display."); surfaces[0] = d.ToInt64();
  nuint close = XInternAtom(d,"WM_DELETE_WINDOW",false);
  for (int i = 0; i < titles.Length; i++)
  {
   nuint w = XCreateSimpleWindow(d,XDefaultRootWindow(d),20+i*(width+20),40,(uint)width,(uint)height,0,0,0x202020);
   if (w == 0) throw new InvalidOperationException("XCreateSimpleWindow failed."); surfaces[i+1] = (long)w;
   XStoreName(d,w,titles[i]); XSetWMProtocols(d,w,ref close,1);
   XSelectInput(d,w,(1<<0)|(1<<1)|(1<<2)|(1<<3)|(1<<6)|(1<<15)|(1<<17)|(1<<21)); XMapWindow(d,w);
  }
  XSync(d,false);
 }
 else throw new PlatformNotSupportedException("Desktop surface provider requires Win32 or X11; Android requires app-owned surface lifecycle.");
 return surfaces;
}
catch
{
 if(OperatingSystem.IsWindows())calls.Win32Close.Invoke(surfaces,-1);
 else
 {
  for(int i=1;i<surfaces.Length;i++)if(surfaces[i]!=0&&surfaces[0]!=0)XDestroyWindow((IntPtr)surfaces[0],(nuint)surfaces[i]);
  if(surfaces[0]!=0)XCloseDisplay((IntPtr)surfaces[0]);
 }
 throw;
}
