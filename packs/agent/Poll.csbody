var state=AppDomain.CurrentDomain.GetData("Confectory.Agent.Run."+execution) as object[]??throw new ObjectDisposedException("Agent execution");lock(state[0]){if((string)state[6]=="closed")throw new ObjectDisposedException("Agent execution");var events=new System.Text.Json.Nodes.JsonArray();var q=(System.Collections.Generic.Queue<string>)state[3];while(q.Count>0)events.Add(System.Text.Json.Nodes.JsonNode.Parse(q.Dequeue()));return new System.Text.Json.Nodes.JsonObject{["execution"]=execution,["requestID"]=(string)state[9],["state"]=(string)state[6],["events"]=events,["cleanupError"]=state[8] as string}.ToJsonString();}
