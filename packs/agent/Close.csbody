var owner=AppDomain.CurrentDomain.GetData("Confectory.Agent.Owner."+agent) as object[];if(owner is null)return;string[] runs;lock(owner[0]){owner[3]=true;runs=System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Select(((System.Collections.Generic.Dictionary<string,string[]>)owner[2]).Values,x=>x[1]));}foreach(string run in runs)calls.CloseRun.Invoke(run);AppDomain.CurrentDomain.SetData("Confectory.Agent.Owner."+agent,null);
