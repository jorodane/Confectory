if(!OperatingSystem.IsBrowser())throw new PlatformNotSupportedException("Browser runtime required");
if(AppDomain.CurrentDomain.GetData("Confectory.Browser.Request") is not null)throw new InvalidOperationException("Browser owner already initialized");
AppDomain.CurrentDomain.SetData("Confectory.Browser.Request",(Func<string,string,string>)((operation,payload)=>operation switch{
 "request"=>calls.Request.Invoke(owner,payload),
 "resource"=>System.Text.Json.JsonSerializer.Serialize(calls.Resource.Invoke(owner,payload)),
 _=>throw new ArgumentException("Unknown transport operation")
}));
AppDomain.CurrentDomain.SetData("Confectory.Browser.Close",(Action)(()=>{if(!calls.Close.Invoke(owner))throw new InvalidOperationException("Web UI cleanup pending");AppDomain.CurrentDomain.SetData("Confectory.Browser.Request",null);AppDomain.CurrentDomain.SetData("Confectory.Browser.Close",null);}));
return 0;
