var declared=System.Linq.Enumerable.SingleOrDefault(metadata["fields"]!.AsArray(),item=>item!["id"]!.ToString()==field)??throw new InvalidOperationException("Property field is not declared by the actual instance");
if(contractHash.Length>0&&declared["hash"]!.ToString()!=contractHash)throw new InvalidOperationException("Property field contract changed; preserve the actual instance and bind a compatible contract");
string kind=declared["kind"]!.ToString(),type=declared["type"]!.ToString();bool multiple=declared["cardinality"]!.ToString()=="multiple";
