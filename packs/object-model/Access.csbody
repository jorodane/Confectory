  }else data[field]=type switch{"bool"=>new System.Runtime.CompilerServices.StrongBox<bool>((bool)value),"int"=>new System.Runtime.CompilerServices.StrongBox<int>((int)value),_=>new System.Runtime.CompilerServices.StrongBox<long>((long)value)};
 }else data[field]=value;
 return value;
}
if(!data.TryGetValue(field,out var current))throw new InvalidOperationException("Property field is unset on the actual instance; no default is invented");
if(typedCell)current=type switch{"bool" when current is System.Runtime.CompilerServices.StrongBox<bool> b=>b.Value,"int" when current is System.Runtime.CompilerServices.StrongBox<int> i=>i.Value,"long" when current is System.Runtime.CompilerServices.StrongBox<long> l=>l.Value,_=>throw new InvalidOperationException("The actual typed field storage is incompatible")};
if(!Valid(current))throw new InvalidOperationException("Actual property value no longer matches its declared contract");
return current;
