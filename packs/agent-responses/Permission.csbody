var value=System.Text.Json.Nodes.JsonNode.Parse(calls.Validate.Invoke(config))!;var permissions=new System.Text.Json.Nodes.JsonArray();void Require(string id,string label){permissions.Add(new System.Text.Json.Nodes.JsonObject{["id"]=id,["label"]=label});}Require("contentApproved","Send reviewed project context and tool results");Require("usageApproved","Consume model usage / possible charges");
return new System.Text.Json.Nodes.JsonObject{["requirements"]=permissions,["pins"]=new System.Text.Json.Nodes.JsonObject{["model"]=value["model"]!.DeepClone(),["endpoint"]=value["endpoint"]!.DeepClone()},["supported"]=value["clientCredentialSupported"]!.DeepClone(),["blockedReason"]="Browser and Android need an approved credential relay; direct credentials are unsupported",["service"]=value["endpoint"]!.DeepClone(),["authentication"]="Named external environment binding only; no login or secret editing in this UI",["disclosures"]=new System.Text.Json.Nodes.JsonArray("Only the displayed project context and namespace tools are sent; drafts require separate human Review/Confirm.","No account or balance verification is performed. API usage is billed by the selected service."),["verification"]=new System.Text.Json.Nodes.JsonObject{["liveVerified"]=false},["limits"]=new System.Text.Json.Nodes.JsonObject{["maxModelRequests"]=value["maxRounds"]!.DeepClone(),["maxOutputTokensPerRequest"]=4096,["timeoutSecondsPerRequest"]=25,["retries"]=0,["maxInputCharacters"]=262144}}.ToJsonString();
