if(config.Length>16384)throw new ArgumentException("Bounded nonsecret provider configuration required");var value=System.Text.Json.Nodes.JsonNode.Parse(config)!.AsObject();foreach(var pair in value)if(pair.Key is not ("provider" or "protocol" or "endpoint" or "model" or "keyEnvironment" or "maxRounds"))throw new ArgumentException("Unknown provider setting; credentials must not be supplied as configuration values");if(value["protocol"]?.ToString()!="responses")throw new ArgumentException("Choose the supported Responses protocol explicitly");string model=value["model"]?.GetValue<string>()??"",endpoint=value["endpoint"]?.GetValue<string>()??"",key=value["keyEnvironment"]?.GetValue<string>()??"";if(string.IsNullOrWhiteSpace(model)||model.Length>128||!Uri.TryCreate(endpoint,UriKind.Absolute,out var uri)||uri.UserInfo.Length!=0||uri.Query.Length!=0||uri.Fragment.Length!=0||uri.Scheme!="https"&&!(uri.Scheme=="http"&&uri.IsLoopback))throw new ArgumentException("Explicit model and HTTPS endpoint (HTTP only for loopback) required");if(key.Length>0&&!System.Text.RegularExpressions.Regex.IsMatch(key,@"^(OPENAI_API_KEY|CONFECTORY_AI_[A-Z0-9_]+)$")||!uri.IsLoopback&&key.Length==0)throw new ArgumentException("Explicit approved credential environment binding required; no key value is stored");int rounds=value["maxRounds"]?.GetValue<int>()??4;if(rounds<1||rounds>8)throw new ArgumentException("Provider round budget1..8");return new System.Text.Json.Nodes.JsonObject{["protocol"]="responses",["endpoint"]=uri.AbsoluteUri,["model"]=model,["keyEnvironment"]=key,["maxRounds"]=rounds,["loopback"]=uri.IsLoopback,["networkContacted"]=false,["credentialRead"]=false,["clientCredentialSupported"]=!OperatingSystem.IsBrowser()&&!OperatingSystem.IsAndroid()}.ToJsonString();
