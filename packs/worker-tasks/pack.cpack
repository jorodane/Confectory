element Close function "Close.celem";
element CloseBody implementation "CloseBody.celem";
element ChiefJournal function "ChiefJournal.celem";
element ChiefJournalBody implementation "ChiefJournalBody.celem";
element VerifyCompletion function "VerifyCompletion.celem";
element VerifyCompletionBody implementation "VerifyCompletionBody.celem";
element Finish function "Finish.celem";
element FinishBody implementation "FinishBody.celem";
element Context function "Context.celem";
element ContextBody implementation "ContextBody.celem";
element List function "List.celem"; element ListBody implementation "ListBody.celem";
}
