element Open function "Open.celem";
element OpenBody implementation "OpenBody.celem";
element Command function "Command.celem";
element CommandBody implementation "CommandBody.celem";
element Assign function "Assign.celem";
element AssignBody implementation "AssignBody.celem";
element Start function "Start.celem";
element StartBody implementation "StartBody.celem";
element Inspect function "Inspect.celem";
element InspectBody implementation "InspectBody.celem";
element Journal function "Journal.celem";
element JournalBody implementation "JournalBody.celem";
element Lease function "Lease.celem";
element LeaseBody implementation "LeaseBody.celem";
element Authorize function "Authorize.celem";
element AuthorizeBody implementation "AuthorizeBody.celem";
element Detach function "Detach.celem";
element DetachBody implementation "DetachBody.celem";
element Recover function "Recover.celem";
element RecoverBody implementation "RecoverBody.celem";
element Handoff function "Handoff.celem";
element HandoffBody implementation "HandoffBody.celem";
element Checkpoint function "Checkpoint.celem";
element CheckpointBody implementation "CheckpointBody.celem";
element Pump function "Pump.celem";
element PumpBody implementation "PumpBody.celem";
element Cancel function "Cancel.celem";
