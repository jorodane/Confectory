if(OperatingSystem.IsBrowser()||OperatingSystem.IsAndroid())throw new PlatformNotSupportedException("Loopback host requires a desktop runtime");
int port=int.TryParse(Environment.GetEnvironmentVariable("CONFECTORY_WEB_PORT"),out int configured)?configured:0;
if(port==0){var probe=new System.Net.Sockets.TcpListener(System.Net.IPAddress.Loopback,0);probe.Start();port=((System.Net.IPEndPoint)probe.LocalEndpoint).Port;probe.Stop();}
if(port<1024||port>65535)throw new ArgumentException("Unprivileged loopback port required");
string origin="http://127.0.0.1:"+port,session=Guid.NewGuid().ToString("N"),loop=Guid.NewGuid().ToString("N");
var listener=new System.Net.HttpListener();listener.Prefixes.Add(origin+"/");listener.Start();
bool stopping=false,closed=false;System.Threading.Tasks.Task<System.Net.HttpListenerContext>? pending=null;
void Cleanup(){stopping=true;listener.Close();closed=calls.Close.Invoke(owner);}
bool Step(){
 if(stopping){Cleanup();return !closed;}
 pending??=listener.GetContextAsync();if(!pending.IsCompleted)return true;var context=pending.GetAwaiter().GetResult();pending=null;
 var request=context.Request;var response=context.Response;
 try{
  response.Headers["Cache-Control"]="no-store";response.Headers["X-Content-Type-Options"]="nosniff";
  response.Headers["Content-Security-Policy"]="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'";response.Headers["Referrer-Policy"]="no-referrer";
  if(request.Url!.Authority!=new Uri(origin).Authority)throw new UnauthorizedAccessException();
  byte[] bytes;
  if(request.Url.AbsolutePath=="/api/request"){
   if(request.Headers["X-Confectory-Session"]!=session||request.Headers["Origin"] is string sender&&sender!=origin)throw new UnauthorizedAccessException();
   if(request.HttpMethod!="POST"||request.ContentLength64<0||request.ContentLength64>2097152)throw new ArgumentException();
   using var reader=new System.IO.StreamReader(request.InputStream,System.Text.Encoding.UTF8);string envelope=reader.ReadToEnd();
   bytes=System.Text.Encoding.UTF8.GetBytes(calls.Request.Invoke(owner,envelope));response.ContentType="application/json";
  }else{
   if(request.HttpMethod!="GET")throw new ArgumentException();var asset=calls.Resource.Invoke(owner,request.Url.AbsolutePath);
   bytes=Convert.FromBase64String(asset[1]);response.ContentType=asset[0];response.Headers["ETag"]="\""+asset[2]+"\"";
  }
  response.ContentLength64=bytes.Length;response.OutputStream.Write(bytes);
 }catch(Exception e){response.StatusCode=e is UnauthorizedAccessException?403:400;response.ContentType="application/json";byte[] bytes=System.Text.Encoding.UTF8.GetBytes("{\"ok\":false,\"error\":{\"code\":\"transport_rejected\"}}");response.OutputStream.Write(bytes);}
 finally{response.Close();}return true;
}
AppContext.SetData("Confectory.HostLoop."+loop,new object[]{(Func<bool>)Step,(Action)Cleanup,(Action)(()=>stopping=true),(Func<bool>)(()=>closed)});
Console.WriteLine("CONFECTORY_WEB_UI "+origin+"/#"+session);Console.Out.Flush();
return calls.Run.Invoke(loop);
