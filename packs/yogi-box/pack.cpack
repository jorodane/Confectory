pack Confectory.YogiBox version "0.1.0" {
standalone false;
dependency Confectory.FileStream version "0.1.0";
element Clear function "Clear.celem";
element ClearBody implementation "ClearBody.celem";
element Open function "Open.celem";
element OpenBody implementation "OpenBody.celem";
element Save function "Save.celem";
element SaveBody implementation "SaveBody.celem";
element Close function "Close.celem";
element CloseBody implementation "CloseBody.celem";
element Revalidate function "Revalidate.celem";
element RevalidateBody implementation "RevalidateBody.celem";
element ValidateStorage function "ValidateStorage.celem";
element ValidateStorageBody implementation "ValidateStorageBody.celem";
dependency Confectory.EditWorkspace version "0.1.0";
dependency Confectory.SchemaEditing version "0.1.0";
element Create function "Create.celem";
element CreateBody implementation "CreateBody.celem";
element Exactly function "Exactly.celem";
element ExactlyBody implementation "ExactlyBody.celem";
element ReserveCapture function "ReserveCapture.celem";
element ReserveCaptureBody implementation "ReserveCaptureBody.celem";
element CompleteCapture function "CompleteCapture.celem";
element CompleteCaptureBody implementation "CompleteCaptureBody.celem";
element Remove function "Remove.celem";
element RemoveBody implementation "RemoveBody.celem";
element Text function "Text.celem";
element TextBody implementation "TextBody.celem";
element Seal function "Seal.celem";
element SealBody implementation "SealBody.celem";
element Snapshot function "Snapshot.celem";
element SnapshotBody implementation "SnapshotBody.celem";
element Receive function "Receive.celem";
element ReceiveBody implementation "ReceiveBody.celem";
element Handoff function "Handoff.celem";
element HandoffBody implementation "HandoffBody.celem";
element Discard function "Discard.celem";
element DiscardBody implementation "DiscardBody.celem";
}
