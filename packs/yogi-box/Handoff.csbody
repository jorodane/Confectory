if (string.IsNullOrWhiteSpace(recipient) || recipient.Length > 128)
    throw new ArgumentException("Explicit bounded recipient required");
var snapshot = System.Text.Json.Nodes.JsonNode.Parse(calls.Snapshot.Invoke(box, "", "", ""))!["package"]!;
var package = new System.Text.Json.Nodes.JsonObject
{
    ["schema"] = 1,
    ["attachment"] = Guid.NewGuid().ToString("N"),
    ["text"] = snapshot["text"]!.DeepClone(),
    ["items"] = snapshot["items"]!.DeepClone()
};
return calls.Receive.Invoke(recipient, package.ToJsonString());
