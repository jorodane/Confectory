var state=AppDomain.CurrentDomain.GetData("Confectory.YogiBox."+box) as object[];if(state is null)return false;if(image.Length>1100000)throw new ArgumentException("Capture payload exceeds bound");var capture=System.Text.Json.Nodes.JsonNode.Parse(image)!.AsObject();if(capture["encoding"]!.GetValue<string>()!="rgb24-base64"||capture["scope"]!.GetValue<string>()!="selected-owned-client-region")throw new ArgumentException("Only scoped local RGB capture supported");int width=capture["width"]!.GetValue<int>(),height=capture["height"]!.GetValue<int>();if(width<1||height<1||width>512||height>512)throw new ArgumentException("Capture dimensions invalid");byte[] pixels=Convert.FromBase64String(capture["pixels"]!.GetValue<string>());if(pixels.Length!=width*height*3||Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(pixels)).ToLowerInvariant()!=capture["hash"]!.GetValue<string>())throw new ArgumentException("Capture bytes/hash mismatch");lock(state[0]){if((bool)state[5])return false;var pending=(System.Collections.Generic.Dictionary<string,System.Text.Json.Nodes.JsonObject>)state[4];if(!pending.TryGetValue(ticket,out var scope))return false;foreach(string field in new[]{"source","view","x","y","width","height"})if(scope[field]!.ToJsonString()!=capture[field]!.ToJsonString())throw new ArgumentException("Capture outside reserved source/region");pending.Remove(ticket);((System.Text.Json.Nodes.JsonArray)state[1]).Add(new System.Text.Json.Nodes.JsonObject{["item"]=ticket,["kind"]="image",["capture"]=capture.DeepClone()});state[2]=false;return true;}
