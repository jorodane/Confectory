var data=System.Text.Json.Nodes.JsonNode.Parse(declaration)!;var values=data["values"]!;if(data["kind"]!.GetValue<string>()!="object"||values["concept"]!.GetValue<string>()!="recipe")throw new ArgumentException("Declared recipe required");var ingredients=System.Text.Json.Nodes.JsonNode.Parse(values["ingredients"]!.GetValue<string>())!.AsObject();int outputCount=values["outputCount"]!.GetValue<int>();string output=values["output"]!.GetValue<string>();if(ingredients.Count<1||ingredients.Count>16||outputCount<1||outputCount>100)throw new ArgumentException("Bounded recipe amounts required");var ids=new System.Collections.Generic.List<string>();var changes=new System.Collections.Generic.List<int>();foreach(var ingredient in ingredients){int amount=ingredient.Value!.GetValue<int>();if(amount<1||amount>100)throw new ArgumentException("Positive ingredient amounts required");ids.Add(ingredient.Key);changes.Add(-amount);}ids.Add(output);changes.Add(outputCount);string recipe=Guid.NewGuid().ToString("N");AppDomain.CurrentDomain.SetData("Confectory.Recipe."+recipe,new object[]{new object(),data["id"]!.GetValue<string>(),ids.ToArray(),changes.ToArray(),false});return recipe;
