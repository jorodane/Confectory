string client=calls.Connect.Invoke(endpoint,participant);try{string workspace=calls.WorkspaceOpen.Invoke(project,participant,context);lock(AppDomain.CurrentDomain){var refs=AppDomain.CurrentDomain.GetData("Confectory.Collaboration.WorkspaceRefs") as System.Collections.Generic.Dictionary<string,int>??new System.Collections.Generic.Dictionary<string,int>(StringComparer.Ordinal);AppDomain.CurrentDomain.SetData("Confectory.Collaboration.WorkspaceRefs",refs);if(!refs.TryGetValue(workspace,out int count)){calls.Restore.Invoke(workspace);count=0;}refs[workspace]=count+1;}string session=Guid.NewGuid().ToString("N");AppDomain.CurrentDomain.SetData("Confectory.Collaboration.Client."+session,new System.Text.Json.Nodes.JsonObject{["endpoint"]=endpoint,["participant"]=participant,["workspace"]=workspace,["transport"]=client,["intents"]=new System.Text.Json.Nodes.JsonArray(),["confirming"]=false,["polling"]=0,["closed"]=false});return session;}catch{calls.Drop.Invoke(client);throw;}
