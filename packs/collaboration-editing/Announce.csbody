var state=AppDomain.CurrentDomain.GetData("Confectory.Collaboration.Client."+session) as System.Text.Json.Nodes.JsonObject??throw new ObjectDisposedException("Collaboration client");
lock(state){if(state["closed"]!.GetValue<bool>())throw new ObjectDisposedException("Collaboration client");var units=new System.Text.Json.Nodes.JsonArray();foreach(string id in selected){var unit=calls.Read.Invoke(state["workspace"]!.GetValue<string>(),id);units.Add(new System.Text.Json.Nodes.JsonObject{["id"]=id,["baseline"]=unit[5],["revision"]=long.Parse(unit[4]),["dirty"]=unit[6]=="dirty"});if(!System.Linq.Enumerable.Any(state["intents"]!.AsArray(),x=>x!.GetValue<string>()==id))state["intents"]!.AsArray().Add(id);}if(state["transport"]!.GetValue<string>()=="")return "{\"state\":\"disconnected\"}";return calls.Exchange.Invoke(state["transport"]!.GetValue<string>(),new System.Text.Json.Nodes.JsonObject{["op"]="announce",["units"]=units}.ToJsonString());}
