project=System.IO.Path.GetFullPath(project);var description=System.Text.Json.Nodes.JsonNode.Parse(calls.Describe.Invoke(project))!;var units=new System.Text.Json.Nodes.JsonObject();foreach(var unit in description["units"]!.AsArray())if(unit!["kind"]!.GetValue<string>() is not ("project" or "pack"))units[unit["id"]!.GetValue<string>()]=unit["path"]!.GetValue<string>();
string room=Guid.NewGuid().ToString("N");AppDomain.CurrentDomain.SetData("Confectory.Collaboration.Room."+room,new System.Text.Json.Nodes.JsonObject{["project"]=project,["root"]=System.IO.Path.GetDirectoryName(project)!,["units"]=units,["participants"]=new System.Text.Json.Nodes.JsonObject(),["confirmed"]=new System.Text.Json.Nodes.JsonObject(),["revision"]=0L});return room;
