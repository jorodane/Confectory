var state=AppDomain.CurrentDomain.GetData("Confectory.Collaboration.Client."+session) as System.Text.Json.Nodes.JsonObject??throw new ObjectDisposedException("Collaboration client");
lock(state){if(state["closed"]!.GetValue<bool>())throw new ObjectDisposedException("Collaboration client");if(state["transport"]!.GetValue<string>()!="")return;state["transport"]=calls.Connect.Invoke(state["endpoint"]!.GetValue<string>(),state["participant"]!.GetValue<string>());}string[] intents;lock(state)intents=System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Select(state["intents"]!.AsArray(),x=>x!.GetValue<string>()));if(intents.Length>0)calls.Announce.Invoke(session,intents);
