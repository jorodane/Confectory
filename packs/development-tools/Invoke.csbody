if(string.IsNullOrWhiteSpace(callId)||callId.Length>128||arguments.Length>1048576)throw new ArgumentException("Bounded explicit tool call identity required");var args=System.Text.Json.Nodes.JsonNode.Parse(arguments)!.AsObject();var state=AppDomain.CurrentDomain.GetData("Confectory.DevelopmentTools."+capability) as object[]??throw new ObjectDisposedException("DevelopmentTools");lock(state[0]){if((bool)state[4])throw new ObjectDisposedException("DevelopmentTools");string draft=(string)state[2];var model=(System.Text.Json.Nodes.JsonObject)state[3];if(args["projectId"]?.ToString()!=model["projectId"]!.ToString())throw new UnauthorizedAccessException("Tool project identity differs from its assigned capability");string prefix=model["namespace"]!.ToString()+"::";string fingerprint=Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(operation+"\n"+arguments)));var callsDone=model["calls"]!.AsObject();if(callsDone[callId] is System.Text.Json.Nodes.JsonNode prior){if(prior["fingerprint"]!.ToString()!=fingerprint)throw new InvalidOperationException("Tool call identity reused with different arguments");return prior["result"]!.GetValue<string>();}if(callsDone.Count>=256)throw new InvalidOperationException("Tool call budget reached; explicit new capability required");
string[] Owned(){return System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Where(calls.List.Invoke(draft),id=>id.StartsWith(prefix,StringComparison.Ordinal)));}
string Id(){string id=args["id"]!.GetValue<string>();if(!id.StartsWith(prefix,StringComparison.Ordinal)||!System.Linq.Enumerable.Contains(Owned(),id,StringComparer.Ordinal))throw new UnauthorizedAccessException("Tool target is outside the owned project namespace");var status=calls.Status.Invoke(draft,id);string root=calls.Identity.Invoke(draft)[3],path=System.IO.Path.GetFullPath(System.IO.Path.Combine(root,status[2])),relative=System.IO.Path.GetRelativePath(root,path);if(relative==".."||relative.StartsWith(".."+System.IO.Path.DirectorySeparatorChar,StringComparison.Ordinal))throw new UnauthorizedAccessException("Tool target is outside owned source storage");for(System.IO.FileSystemInfo? node=new System.IO.FileInfo(path);node is not null;node=node is System.IO.FileInfo f?f.Directory:((System.IO.DirectoryInfo)node).Parent){if(node.LinkTarget is not null)throw new UnauthorizedAccessException("Tool source paths cannot traverse links");if(node.FullName==root)break;}return id;}
void Staged(string id){var status=calls.Status.Invoke(draft,id);model["staged"]![id]=new System.Text.Json.Nodes.JsonObject{["revision"]=long.Parse(status[4],System.Globalization.CultureInfo.InvariantCulture),["dirty"]=status[6]=="dirty"};}
string Hash(string text)=>Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(text))).ToLowerInvariant();
void SaveJournal(System.Text.Json.Nodes.JsonObject doc){string text=doc.ToJsonString();if(text.Length>1048576)throw new InvalidOperationException("Origin journal budget");var saved=calls.Commit.Invoke((string)state[5],new[]{(string)state[6]},new[]{(string)state[8]},new[]{text});if(saved[0]!="applied")throw new InvalidOperationException("Origin journal changed; reconcile before retrying, no tool replay");state[7]=doc;state[8]=Hash(text);}
System.Text.Json.Nodes.JsonObject Begin(string id){var doc=((System.Text.Json.Nodes.JsonObject)state[7]).DeepClone().AsObject();var rows=doc["changes"]!.AsArray();if(System.Linq.Enumerable.Any(rows,x=>x!["callId"]?.ToString()==callId))throw new InvalidOperationException("Prior mutation outcome requires reconciliation; this call will not replay");if(rows.Count>=256)throw new InvalidOperationException("Origin history retention required");var row=new System.Text.Json.Nodes.JsonObject{["callId"]=callId,["operation"]=operation,["id"]=id,["state"]="outcome-unknown",["origin"]=doc["origin"]!.DeepClone(),["fingerprint"]=fingerprint};if(operation=="workspace_stage"){var before=calls.Read.Invoke(draft,id);row["beforeHash"]=Hash(before[3]);row["expectedRevision"]=args["expectedRevision"]!.DeepClone();row["proposedHash"]=Hash(args["text"]!.ToString());}rows.Add(row);SaveJournal(doc);return row;}
void End(System.Text.Json.Nodes.JsonObject intent,string outcome,string[] ids){var doc=((System.Text.Json.Nodes.JsonObject)state[7]).DeepClone().AsObject();var row=System.Linq.Enumerable.First(doc["changes"]!.AsArray(),x=>x!["callId"]!.ToString()==callId)!;row["state"]=outcome;var observed=new System.Text.Json.Nodes.JsonArray();foreach(string id in ids){var unit=calls.Read.Invoke(draft,id);observed.Add(new System.Text.Json.Nodes.JsonObject{["id"]=id,["revision"]=long.Parse(unit[4],System.Globalization.CultureInfo.InvariantCulture),["observedHash"]=operation=="workspace_stage"?Hash(args["text"]!.ToString()):Hash(unit[3])});}row["observed"]=observed;SaveJournal(doc);}
System.Text.Json.Nodes.JsonNode result;
if(operation=="workspace_list"){string query=args["query"]?.GetValue<string>()??"";if(query.Length>256)throw new ArgumentException("Bounded semantic query required");var rows=new System.Text.Json.Nodes.JsonArray();foreach(string id in Owned()){if(!id.Contains(query,StringComparison.OrdinalIgnoreCase))continue;var u=calls.Status.Invoke(draft,id);rows.Add(new System.Text.Json.Nodes.JsonObject{["id"]=id,["kind"]=u[1],["revision"]=long.Parse(u[4],System.Globalization.CultureInfo.InvariantCulture),["dirty"]=u[6]=="dirty"});if(rows.Count>=256)break;}result=rows;}
else if(operation=="workspace_read"||operation=="workspace_inspect"){string id=Id();var u=calls.Read.Invoke(draft,id);result=operation=="workspace_inspect"?System.Text.Json.Nodes.JsonNode.Parse(calls.Inspect.Invoke(u[3]))!:new System.Text.Json.Nodes.JsonObject{["id"]=id,["kind"]=u[1],["revision"]=long.Parse(u[4],System.Globalization.CultureInfo.InvariantCulture),["text"]=u[3]};}
