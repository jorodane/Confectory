else if(operation=="workspace_create"){string id=args["id"]!.GetValue<string>(),kind=args["kind"]!.GetValue<string>();if(!id.StartsWith(prefix,StringComparison.Ordinal)||kind is not ("object" or "schema" or "concept" or "category" or "function" or "module"))throw new UnauthorizedAccessException("Creation requires an owned declaration identity/kind");var intent=Begin(id);calls.Create.Invoke(draft,kind,id);End(intent,"applied",new[]{id,model["manifest"]!.ToString()});Staged(id);Staged(model["manifest"]!.ToString());result=new System.Text.Json.Nodes.JsonObject{["id"]=id,["created"]=true,["finalSourceChanged"]=false};}
else if(operation=="workspace_changes")result=System.Text.Json.JsonSerializer.SerializeToNode(calls.Changes.Invoke(draft,Owned()))!;
else throw new UnauthorizedAccessException("Tool operation is not granted; Confirm, process/shell, external files and runtime invocation are unavailable");
string output=result.ToJsonString();if(System.Text.Encoding.UTF8.GetByteCount(output)>2097152)throw new ArgumentException("Tool result exceeds output budget");callsDone[callId]=new System.Text.Json.Nodes.JsonObject{["fingerprint"]=fingerprint,["result"]=output};model["log"]!.AsArray().Add(new System.Text.Json.Nodes.JsonObject{["callId"]=callId,["operation"]=operation,["projectId"]=model["projectId"]!.DeepClone()});return output;}
