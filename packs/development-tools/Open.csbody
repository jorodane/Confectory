if(string.IsNullOrWhiteSpace(projectId)||projectId.Length>128||string.IsNullOrWhiteSpace(owner)||string.IsNullOrWhiteSpace(context)||!System.Text.RegularExpressions.Regex.IsMatch(namespaceId,@"^[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)*$"))throw new ArgumentException("Explicit project identity, namespace, owner and edit context required");
string view=calls.OpenView.Invoke(project,owner,context);try{string draft=calls.Draft.Invoke(view);var ids=calls.List.Invoke(draft);string manifest=System.Linq.Enumerable.FirstOrDefault(ids,id=>id==namespaceId+"::ProjectManifest"||id==namespaceId+"::PackManifest")??throw new ArgumentException("Namespace does not identify the owned project manifest");var unit=calls.Read.Invoke(draft,manifest);if(unit[1] is not ("project" or "pack")||unit[2]!=System.IO.Path.GetFileName(project))throw new ArgumentException("Manifest does not identify this owned project");string capability=Guid.NewGuid().ToString("N");var model=new System.Text.Json.Nodes.JsonObject{["projectId"]=projectId,["namespace"]=namespaceId,["owner"]=owner,["manifest"]=manifest,["staged"]=new System.Text.Json.Nodes.JsonObject(),["calls"]=new System.Text.Json.Nodes.JsonObject(),["log"]=new System.Text.Json.Nodes.JsonArray(),["rights"]=new System.Text.Json.Nodes.JsonArray("workspace_list","workspace_read","workspace_inspect","workspace_stage","workspace_create","workspace_changes"),["canConfirm"]=false,["canExecute"]=false};AppDomain.CurrentDomain.SetData("Confectory.DevelopmentTools."+capability,new object[]{new object(),view,draft,model,false});return capability;}catch{calls.CloseView.Invoke(view);throw;}
