var state=AppDomain.CurrentDomain.GetData("Confectory.DevelopmentTools."+capability) as object[]??throw new ObjectDisposedException("DevelopmentTools");lock(state[0]){if((bool)state[4])throw new ObjectDisposedException("DevelopmentTools");var model=(System.Text.Json.Nodes.JsonObject)state[3];var output=new System.Text.Json.Nodes.JsonArray();foreach(var right in model["rights"]!.AsArray()){string name=right!.ToString();var properties=new System.Text.Json.Nodes.JsonObject{["projectId"]=new System.Text.Json.Nodes.JsonObject{["type"]="string",["enum"]=new System.Text.Json.Nodes.JsonArray(model["projectId"]!.DeepClone())}};var required=new System.Text.Json.Nodes.JsonArray("projectId");void Field(string field,string type){properties[field]=new System.Text.Json.Nodes.JsonObject{["type"]=type};required.Add(field);}if(name=="workspace_list")Field("query","string");if(name is "workspace_read" or "workspace_inspect" or "workspace_stage" or "workspace_create")Field("id","string");if(name=="workspace_stage"){Field("text","string");Field("expectedRevision","integer");properties["expectedRevision"]!["minimum"]=0;}if(name=="workspace_create"){Field("kind","string");properties["kind"]!["enum"]=new System.Text.Json.Nodes.JsonArray("object","schema","concept","category","function","module");}output.Add(new System.Text.Json.Nodes.JsonObject{["name"]=name,["description"]=name=="workspace_stage"?"Replace one owned draft at its exact revision; never writes final source":name=="workspace_create"?"Stage owned declaration and manifest registration; both require user Review/Confirm":name=="workspace_changes"?"Report proposed draft changes for explicit user review":"Query assigned owned project metadata or one explicit source; no external files",["parameters"]=new System.Text.Json.Nodes.JsonObject{["type"]="object",["properties"]=properties,["required"]=required,["additionalProperties"]=false}});}return output.ToJsonString();}
