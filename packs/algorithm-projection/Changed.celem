function Confectory.AlgorithmProjection::Changed (string view, string[] changedIDs, string origin, string changeKind, string batch) -> string { description "Consume existing EditWorkspace/ChangeSet changed IDs, select affected stored projections and notify the caller workspace. Human functional changes queue one latest request per qualified tuple; AI edits refresh their own selected projection.";provide Confectory.AlgorithmProjection::Changed with Confectory.AlgorithmProjection::ChangedBody;}
