var identity=calls.Identity.Invoke(workspace);var request=new System.Text.Json.Nodes.JsonObject{["project"]=identity[0],["function"]=function,["participant"]=identity[1],["context"]=identity[2],["channel"]="draft"};var draft=System.Text.Json.Nodes.JsonNode.Parse(calls.Call.Invoke("projectionList",request.ToJsonString()))!.AsArray();request["channel"]="confirmed";var confirmed=System.Text.Json.Nodes.JsonNode.Parse(calls.Call.Invoke("projectionList",request.ToJsonString()))!.AsArray();foreach(var item in confirmed){bool exists=false;foreach(var d in draft)if(d!["target"]!.ToString()==item!["target"]!.ToString()&&d["implementation"]!.ToString()==item["implementation"]!.ToString())exists=true;if(!exists)draft.Add(item!.DeepClone());}return draft.ToJsonString();
