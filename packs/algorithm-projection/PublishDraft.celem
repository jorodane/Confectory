function Confectory.AlgorithmProjection::PublishDraft (string workspace, string artifact, string sourceHashes, string versions, string publicContract) -> string { description "Publish author-generated outline to confirmed channel only for current source; otherwise to the same participant/context draft channel. Expected versions reject out-of-order completion.";provide Confectory.AlgorithmProjection::PublishDraft with Confectory.AlgorithmProjection::PublishDraftBody;}
