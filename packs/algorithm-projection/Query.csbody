try{return calls.Call.Invoke("projectionQuery",new System.Text.Json.Nodes.JsonObject{["project"]=project,["function"]=function,["implementation"]=implementation,["target"]=target}.ToJsonString());}catch(Exception ex){return new System.Text.Json.Nodes.JsonObject{["requiresRefresh"]=true,["status"]="unavailable",["freshness"]="unavailable",["reason"]=ex.GetType().Name,["function"]=function,["implementation"]=implementation,["target"]=target}.ToJsonString();}
