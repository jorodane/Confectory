var expected=System.Text.Json.Nodes.JsonNode.Parse(versions)!;var identity=calls.Identity.Invoke(workspace);var record=System.Text.Json.Nodes.JsonNode.Parse(artifact)!;var request=new System.Text.Json.Nodes.JsonObject{["publicContract"]=publicContract,["project"]=identity[0],["function"]=record["function"]!.DeepClone(),["implementation"]=record["provider"]!.DeepClone(),["target"]=record["bodyID"]!.DeepClone(),["artifact"]=record,["sourceHashes"]=System.Text.Json.Nodes.JsonNode.Parse(sourceHashes),["participant"]=identity[1],["context"]=identity[2],["channel"]="confirmed",["expectedVersion"]=expected["confirmed"]!.DeepClone()};string result=calls.Call.Invoke("projectionPublish",request.ToJsonString());if(System.Text.Json.Nodes.JsonNode.Parse(result)!["reason"]?.ToString()=="draft-cannot-publish-to-confirmed-channel"){request["channel"]="draft";request["expectedVersion"]=expected["draft"]!.DeepClone();return calls.Call.Invoke("projectionPublish",request.ToJsonString());}return result;
