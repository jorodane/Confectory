function Confectory.AlgorithmProjection::Publish (string project, string artifact, string sourceHashes) -> string { description "Publish a source-free schema2 syntactic artifact bound to public contract revision and exact qualified selection. Source hashes and expectedVersion provide stale/CAS rejection. Confirmed publication rejects draft contents.";provide Confectory.AlgorithmProjection::Publish with Confectory.AlgorithmProjection::PublishBody;}
