var current=System.Text.Json.Nodes.JsonNode.Parse(snapshot)!;var update=System.Text.Json.Nodes.JsonNode.Parse(delta)!;System.Text.Json.Nodes.JsonObject Result(bool applied,bool refresh,string reason,System.Text.Json.Nodes.JsonNode value)=>new(){["applied"]=applied,["requiresRefresh"]=refresh,["reason"]=reason,["snapshot"]=value.DeepClone()};if(update["status"]?.ToString()!="delta")return Result(false,true,update["status"]?.ToString()??"invalid-delta",current).ToJsonString();if(current["scope"]!.ToString()!=update["scope"]!.ToString())return Result(false,true,"scope-mismatch",current).ToJsonString();long version=current["version"]!.GetValue<long>();long baseline=update["baseVersion"]!.GetValue<long>(),next=update["newVersion"]!.GetValue<long>();if(next<baseline)return Result(false,true,"out-of-order",current).ToJsonString();var replacement=update["snapshot"]!.DeepClone().AsObject();string suppliedHash=replacement["viewHash"]!.ToString();replacement.Remove("viewHash");string actualHash=Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(replacement.ToJsonString()))).ToLowerInvariant();if(actualHash!=suppliedHash||suppliedHash!=update["newViewHash"]!.ToString()||replacement["version"]!.GetValue<long>()!=next||replacement["scope"]!.ToString()!=current["scope"]!.ToString())return Result(false,true,"replacement-mismatch",current).ToJsonString();if(version==update["newVersion"]!.GetValue<long>()&&current["viewHash"]!.ToString()==update["newViewHash"]!.ToString())return Result(false,false,"already-applied",current).ToJsonString();if(version!=update["baseVersion"]!.GetValue<long>()||current["viewHash"]!.ToString()!=update["baseViewHash"]!.ToString())return Result(false,true,"baseline-mismatch",current).ToJsonString();return Result(true,false,"replaced-bounded-selection",update["snapshot"]!).ToJsonString();
