function Confectory.AlgorithmProjection::Browse (string project, string function, string implementation, string target, string options) -> string { description "Read bounded confirmed-source root or selected subtree. JSON options: nodeID root default, depth 0..8, pageSize 1..64, offset >=0, nodeLimit 1..256, expectedVersion optional. UTF-8 response is limited to 32768 bytes. Bounds affect delivery, not whole selected-function parsing.";provide Confectory.AlgorithmProjection::Browse with Confectory.AlgorithmProjection::BrowseBody;}
