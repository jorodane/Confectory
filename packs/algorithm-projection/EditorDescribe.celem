function Confectory.AlgorithmProjection::EditorDescribe (string project, string element) -> string { description "Read current DSL public element description, editorTags, editorHelp/editorTag values and qualified schema origins/revisions. Inherited help is public metadata; no alternative declaration language.";provide Confectory.AlgorithmProjection::EditorDescribe with Confectory.AlgorithmProjection::EditorDescribeBody;}
