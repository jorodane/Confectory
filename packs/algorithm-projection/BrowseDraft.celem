function Confectory.AlgorithmProjection::BrowseDraft (string workspace, string function, string implementation, string target, string options) -> string { provide Confectory.AlgorithmProjection::BrowseDraft with Confectory.AlgorithmProjection::BrowseDraftBody; description "Bounded read of the same participant/context draft, falling back to confirmed source only when no draft exists. Options select nodeID/depth/pageSize/offset/nodeLimit/expectedVersion; whole-function analysis costs remain separate."; }
