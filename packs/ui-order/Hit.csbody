if(frame.Length>1048576)throw new ArgumentException("UI Order hit frame budget");
var snapshot=System.Text.Json.Nodes.JsonNode.Parse(frame)!;
bool Contains(System.Text.Json.Nodes.JsonNode regions){int[] boxes=System.Text.Json.JsonSerializer.Deserialize<int[]>(regions.ToJsonString())!;for(int n=0;n<boxes.Length;n+=4)if(x>=boxes[n]&&y>=boxes[n+1]&&(long)x<(long)boxes[n]+boxes[n+2]&&(long)y<(long)boxes[n+1]+boxes[n+3])return true;return false;}
var windows=snapshot["windows"]!.AsArray();for(int n=windows.Count-1;n>=0;n--){var row=windows[n]!;if(!Contains(row["regions"]!))continue;int id=row["id"]!.GetValue<int>();if(row["input"]!.GetValue<bool>()){var controls=row["controls"]!.AsArray();for(int c=controls.Count-1;c>=0;c--)if(controls[c]!["input"]!.GetValue<bool>()&&Contains(controls[c]!["regions"]!))return new[]{id,controls[c]!["id"]!.GetValue<int>(),0};if(row["opaque"]!.GetValue<bool>())return new[]{id,0,0};}else if(row["opaque"]!.GetValue<bool>())return new[]{id,0,1};}
int modal=snapshot["modal"]!.GetValue<int>();return new[]{modal,0,modal==0?0:1};
