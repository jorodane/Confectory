  var ordered=System.Linq.Enumerable.ToArray(System.Linq.Enumerable.ThenBy(System.Linq.Enumerable.OrderBy(System.Linq.Enumerable.Where(windows,x=>x!["visible"]!.GetValue<bool>()&&!x["minimized"]!.GetValue<bool>()),x=>x!["order"]!.GetValue<int>()),x=>x!["serial"]!.GetValue<long>()));
  var modal=System.Linq.Enumerable.LastOrDefault(ordered,x=>x!["modal"]!.GetValue<bool>());if(modal is not null&&Array.IndexOf(ordered,row)<Array.IndexOf(ordered,modal))throw new InvalidOperationException("Modal window blocks underlying activation");
