long Next(){long serial=checked(model["serial"]!.GetValue<long>()+1);model["serial"]=serial;return serial;}
var row=Row(id);
if(operation=="open"){
 if(id<1||row is not null||windows.Count==32)throw new ArgumentException("Unique positive window ID and available lifetime slot required");
 var bounds=System.Text.Json.JsonSerializer.Deserialize<int[]>(args["bounds"]!.ToJsonString())!;Bounds(bounds);var controls=Controls(args["controls"]);
 row=new System.Text.Json.Nodes.JsonObject{["id"]=id,["order"]=args["order"]?.GetValue<int>()??0,["serial"]=Next(),["bounds"]=System.Text.Json.JsonSerializer.SerializeToNode(bounds),["visible"]=true,["minimized"]=false,["enabled"]=args["enabled"]?.GetValue<bool>()??true,["opaque"]=args["opaque"]?.GetValue<bool>()??true,["modal"]=args["modal"]?.GetValue<bool>()??false,["focus"]=0,["controls"]=controls};windows.Add(row);if(row["enabled"]!.GetValue<bool>())model["active"]=id;
}else if(operation=="clear"){windows.Clear();model["active"]=0;
}else{
 if(row is null)throw new ArgumentException("Unknown UI window");
 if(operation=="close"){windows.Remove(row);if(model["active"]!.GetValue<int>()==id)model["active"]=0;}
 else if(operation=="move"){var b=System.Text.Json.JsonSerializer.Deserialize<int[]>(args["bounds"]!.ToJsonString())!;Bounds(b);row["bounds"]=System.Text.Json.JsonSerializer.SerializeToNode(b);}
 else if(operation=="controls"){row["controls"]=Controls(args["controls"]);if(!System.Linq.Enumerable.Any(row["controls"]!.AsArray(),c=>c!["id"]!.GetValue<int>()==row["focus"]!.GetValue<int>()&&c["enabled"]!.GetValue<bool>()&&c["visible"]!.GetValue<bool>()))row["focus"]=0;}
 else if(operation=="order")row["order"]=args["order"]!.GetValue<int>();
 else if(operation=="minimize")row["minimized"]=true;
