int active=model["active"]!.GetValue<int>();bool Eligible(int i)=>i>=modal&&ordered[i]!["enabled"]!.GetValue<bool>();int activeIndex=Array.FindIndex(ordered,x=>x!["id"]!.GetValue<int>()==active);if(activeIndex<0||!Eligible(activeIndex)){activeIndex=-1;for(int i=ordered.Length-1;i>=0;i--)if(Eligible(i)){activeIndex=i;break;}active=activeIndex<0?0:ordered[activeIndex]!["id"]!.GetValue<int>();}
int[] Intersect(int[] a,int[] b){long x=Math.Max((long)a[0],b[0]),y=Math.Max((long)a[1],b[1]),r=Math.Min((long)a[0]+a[2],(long)b[0]+b[2]),d=Math.Min((long)a[1]+a[3],(long)b[1]+b[3]);return r>x&&d>y?new[]{checked((int)x),checked((int)y),checked((int)(r-x)),checked((int)(d-y))}:Array.Empty<int>();}
int[] Surface(System.Text.Json.Nodes.JsonNode row){int[] b=System.Text.Json.JsonSerializer.Deserialize<int[]>(row["bounds"]!.ToJsonString())!;if(row["shape"] is null)return b;int[] local=System.Text.Json.JsonSerializer.Deserialize<int[]>(row["shape"]!.ToJsonString())!;var visible=new System.Collections.Generic.List<int>();for(int n=0;n<local.Length;n+=4)visible.AddRange(new[]{checked(b[0]+local[n]),checked(b[1]+local[n+1]),local[n+2],local[n+3]});return visible.ToArray();}
int[] Subtract(int[] clip,int[] masks){var fragments=new System.Collections.Generic.List<int[]> {clip};for(int offset=0;offset<masks.Length;offset+=128){var next=new System.Collections.Generic.List<int[]>();int[] chunk=masks[offset..Math.Min(masks.Length,offset+128)];foreach(var part in fragments){int[] output=calls.ClipRegions.Invoke(part,chunk);for(int n=0;n<output.Length;n+=4)next.Add(output[n..(n+4)]);}if(next.Count>256)throw new ArgumentException("UI Order fragment budget");fragments=next;}return System.Linq.Enumerable.ToArray(System.Linq.Enumerable.SelectMany(fragments,b=>b));}
var result=new System.Text.Json.Nodes.JsonArray();
for(int i=0;i<ordered.Length;i++){
