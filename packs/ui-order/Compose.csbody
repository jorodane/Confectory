if(state.Length>262144||viewport.Length!=4||viewport[2]<1||viewport[3]<1||viewport[2]>8192||viewport[3]>8192)throw new ArgumentException("UI Order frame budget");
var model=System.Text.Json.Nodes.JsonNode.Parse(state)!;var all=model["windows"]!.AsArray();if(all.Count>32)throw new ArgumentException("UI Order window budget");
