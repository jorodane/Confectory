 var pieces=new System.Collections.Generic.List<int>();int[] surface=Surface(row);for(int s=0;s<surface.Length;s+=4){int[] part=Intersect(surface[s..(s+4)],viewport);if(part.Length>0)pieces.AddRange(Subtract(part,masks.ToArray()));}if(pieces.Count>1024)throw new ArgumentException("UI Order visible surface fragment budget");int[] regions=pieces.ToArray();var controls=new System.Text.Json.Nodes.JsonArray();foreach(var c in row["controls"]!.AsArray()){int[] local=System.Text.Json.JsonSerializer.Deserialize<int[]>(c!["bounds"]!.ToJsonString())!,global=new[]{checked(bounds[0]+local[0]),checked(bounds[1]+local[1]),local[2],local[3]};var visible=new System.Collections.Generic.List<int>();if(c["visible"]!.GetValue<bool>())for(int n=0;n<regions.Length;n+=4)visible.AddRange(Intersect(global,regions[n..(n+4)]));controls.Add(new System.Text.Json.Nodes.JsonObject{["id"]=c["id"]!.DeepClone(),["bounds"]=System.Text.Json.JsonSerializer.SerializeToNode(global),["radius"]=c["radius"]?.GetValue<int>()??0,["regions"]=System.Text.Json.JsonSerializer.SerializeToNode(visible),["input"]=Eligible(i)&&c["enabled"]!.GetValue<bool>()&&visible.Count>0});}
 result.Add(new System.Text.Json.Nodes.JsonObject{["id"]=row["id"]!.DeepClone(),["order"]=row["order"]!.DeepClone(),["bounds"]=System.Text.Json.JsonSerializer.SerializeToNode(bounds),["regions"]=System.Text.Json.JsonSerializer.SerializeToNode(regions),["opaque"]=row["opaque"]!.DeepClone(),["input"]=Eligible(i),["active"]=row["id"]!.GetValue<int>()==active,["focus"]=row["focus"]!.DeepClone(),["controls"]=controls});
}
return new System.Text.Json.Nodes.JsonObject{["revision"]=model["revision"]!.DeepClone(),["active"]=active,["modal"]=modal<0?0:ordered[modal]!["id"]!.GetValue<int>(),["windows"]=result}.ToJsonString();
