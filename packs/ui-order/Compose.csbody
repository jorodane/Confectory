if(state.Length>262144||viewport.Length!=4||viewport[2]<1||viewport[3]<1||viewport[2]>8192||viewport[3]>8192)throw new ArgumentException("UI Order frame budget");
var model=System.Text.Json.Nodes.JsonNode.Parse(state)!;var all=model["windows"]!.AsArray();if(all.Count>32)throw new ArgumentException("UI Order window budget");
var ordered=System.Linq.Enumerable.ToArray(System.Linq.Enumerable.ThenBy(System.Linq.Enumerable.OrderBy(System.Linq.Enumerable.Where(all,x=>x!["visible"]!.GetValue<bool>()&&!x["minimized"]!.GetValue<bool>()),x=>x!["order"]!.GetValue<int>()),x=>x!["serial"]!.GetValue<long>()));
int modal=-1;for(int i=0;i<ordered.Length;i++)if(ordered[i]!["modal"]!.GetValue<bool>())modal=i;
int active=model["active"]!.GetValue<int>();bool Eligible(int i)=>i>=modal&&ordered[i]!["enabled"]!.GetValue<bool>();int activeIndex=Array.FindIndex(ordered,x=>x!["id"]!.GetValue<int>()==active);if(activeIndex<0||!Eligible(activeIndex)){activeIndex=-1;for(int i=ordered.Length-1;i>=0;i--)if(Eligible(i)){activeIndex=i;break;}active=activeIndex<0?0:ordered[activeIndex]!["id"]!.GetValue<int>();}
int[] Intersect(int[] a,int[] b){long x=Math.Max((long)a[0],b[0]),y=Math.Max((long)a[1],b[1]),r=Math.Min((long)a[0]+a[2],(long)b[0]+b[2]),d=Math.Min((long)a[1]+a[3],(long)b[1]+b[3]);return r>x&&d>y?new[]{checked((int)x),checked((int)y),checked((int)(r-x)),checked((int)(d-y))}:Array.Empty<int>();}
var result=new System.Text.Json.Nodes.JsonArray();
for(int i=0;i<ordered.Length;i++){
 var row=ordered[i]!;int[] bounds=System.Text.Json.JsonSerializer.Deserialize<int[]>(row["bounds"]!.ToJsonString())!,clipped=Intersect(bounds,viewport);var masks=new System.Collections.Generic.List<int>();for(int n=i+1;n<ordered.Length;n++)if(ordered[n]!["opaque"]!.GetValue<bool>())masks.AddRange(System.Text.Json.JsonSerializer.Deserialize<int[]>(ordered[n]!["bounds"]!.ToJsonString())!);
 int[] regions=clipped.Length==0?Array.Empty<int>():calls.ClipRegions.Invoke(clipped,masks.ToArray());var controls=new System.Text.Json.Nodes.JsonArray();foreach(var c in row["controls"]!.AsArray()){int[] local=System.Text.Json.JsonSerializer.Deserialize<int[]>(c!["bounds"]!.ToJsonString())!,global=new[]{checked(bounds[0]+local[0]),checked(bounds[1]+local[1]),local[2],local[3]};var visible=new System.Collections.Generic.List<int>();if(c["visible"]!.GetValue<bool>())for(int n=0;n<regions.Length;n+=4)visible.AddRange(Intersect(global,regions[n..(n+4)]));controls.Add(new System.Text.Json.Nodes.JsonObject{["id"]=c["id"]!.DeepClone(),["bounds"]=System.Text.Json.JsonSerializer.SerializeToNode(global),["regions"]=System.Text.Json.JsonSerializer.SerializeToNode(visible),["input"]=Eligible(i)&&c["enabled"]!.GetValue<bool>()&&visible.Count>0});}
 result.Add(new System.Text.Json.Nodes.JsonObject{["id"]=row["id"]!.DeepClone(),["order"]=row["order"]!.DeepClone(),["bounds"]=System.Text.Json.JsonSerializer.SerializeToNode(bounds),["regions"]=System.Text.Json.JsonSerializer.SerializeToNode(regions),["opaque"]=row["opaque"]!.DeepClone(),["input"]=Eligible(i),["active"]=row["id"]!.GetValue<int>()==active,["focus"]=row["focus"]!.DeepClone(),["controls"]=controls});
}
return new System.Text.Json.Nodes.JsonObject{["revision"]=model["revision"]!.DeepClone(),["active"]=active,["modal"]=modal<0?0:ordered[modal]!["id"]!.GetValue<int>(),["windows"]=result}.ToJsonString();
