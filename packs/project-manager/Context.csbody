if(manager.Length<5||manager[1]!="active")throw new InvalidOperationException("Manager is disposed.");
if(context==""){context=manager[2];if(context=="")return Array.Empty<string>();}
for(int i=4;i<manager.Length;i++)if(manager[i] is not null){var value=System.Text.Json.JsonSerializer.Deserialize<string[]>(manager[i])!;if(value[0]==context)return value;}
throw new ArgumentException("Unknown context in this manager.");
