element CreationTemplate function "CreationTemplate.celem";
element CreationTemplateBody implementation "CreationTemplateBody.celem";
element CreateProject function "CreateProject.celem";
element CreateProjectBody implementation "CreateProjectBody.celem";
element Open function "Open.celem";
element OpenBody implementation "OpenBody.celem";
element Select function "Select.celem";
element SelectBody implementation "SelectBody.celem";
element Context function "Context.celem";
element ContextBody implementation "ContextBody.celem";
element Close function "Close.celem";
element CloseBody implementation "CloseBody.celem";
element Executions function "Executions.celem";
element ExecutionsBody implementation "ExecutionsBody.celem";
element Launch function "Launch.celem";
element LaunchBody implementation "LaunchBody.celem";
element Dispose function "Dispose.celem";
