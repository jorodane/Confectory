if(manager.Length<5||manager[1]!="active")throw new InvalidOperationException("Manager is disposed.");
if(!System.Text.RegularExpressions.Regex.IsMatch(name,"^[A-Za-z_][A-Za-z0-9_]*$"))throw new ArgumentException("Project name must be an identifier.");
if(string.IsNullOrWhiteSpace(directory)||string.IsNullOrWhiteSpace(targetPack))throw new ArgumentException("Explicit directory and target pack required.");
string root=System.IO.Path.GetFullPath(directory),tool=System.IO.Path.GetFullPath(targetPack);
if(System.IO.Directory.Exists(root)||System.IO.File.Exists(root))throw new InvalidOperationException("New project directory must not exist.");
if(!System.IO.File.Exists(tool)||tool.Contains('"')||tool.Contains('\n')||tool.Contains('\r'))throw new ArgumentException("Invalid target pack path.");
string ns="Project."+name;string stage=root+".creating-"+Guid.NewGuid().ToString("N");System.IO.Directory.CreateDirectory(stage);bool committed=false;
try
{
 System.IO.File.WriteAllText(System.IO.Path.Combine(stage,"main.celem"),"function "+ns+"::Main () -> int { provide "+ns+"::Main with "+ns+"::MainBody; }\n");
 System.IO.File.WriteAllText(System.IO.Path.Combine(stage,"main_body.celem"),"implementation "+ns+"::MainBody for "+ns+"::Main () -> int { body common \"main.csbody\"; }\n");
 System.IO.File.WriteAllText(System.IO.Path.Combine(stage,"main.csbody"),"return 0;\n");
 string manifest="project "+ns+" version \"0.1.0\" {\nentry "+ns+"::Main;\nregistry Confectory.Build.DotNet \""+tool.Replace("\\","/")+"\";\ndependency Confectory.Build.DotNet version \"0.1.0\";\ntarget portable Confectory.Build.DotNet::Portable;\ntarget windows Confectory.Build.DotNet::Portable;\ntarget linux Confectory.Build.DotNet::Linux;\nelement Main function \"main.celem\";\nelement MainBody implementation \"main_body.celem\";\n}\n";
 System.IO.File.WriteAllText(System.IO.Path.Combine(stage,"project.cpack"),manifest);System.IO.Directory.Move(stage,root);committed=true;return calls.Open.Invoke(manager,System.IO.Path.Combine(root,"project.cpack"));
}
catch{if(System.IO.Directory.Exists(stage))System.IO.Directory.Delete(stage,true);if(committed)System.IO.Directory.Delete(root,true);throw;}
