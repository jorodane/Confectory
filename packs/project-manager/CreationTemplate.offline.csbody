if(!System.Text.RegularExpressions.Regex.IsMatch(projectNamespace,"^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"))throw new ArgumentException("Invalid project namespace.");
// Source creation works without a runtime compiler. The owned target pack is portable
// source metadata; its compiler must be provisioned explicitly on a desktop before build.
string ns=projectNamespace;
string manifest="project "+ns+" version \"0.1.0\" {\nstandalone true;\nentry "+ns+"::Main;\nregistry Confectory.Build.DotNet \"build/pack.cpack\";\ndependency Confectory.Build.DotNet version \"0.1.0\";\ntarget portable Confectory.Build.DotNet::Portable;\ntarget windows Confectory.Build.DotNet::Portable;\ntarget linux Confectory.Build.DotNet::Linux;\nelement Main function \"main.celem\";\nelement MainBody implementation \"main_body.celem\";\n}\n";
string pack="pack Confectory.Build.DotNet version \"0.1.0\" { standalone false; element Portable buildtarget \"portable.celem\"; element Linux buildtarget \"linux.celem\"; }\n";
string portable="buildtarget Confectory.Build.DotNet::Portable { description \"Desktop .NET 10 compiler must be explicitly provisioned\"; tool \"tools/Confectory.Build.DotNet.dll\"; option mode \"portable\"; }\n";
string linux="buildtarget Confectory.Build.DotNet::Linux { description \"Linux .NET 10 compiler must be explicitly provisioned\"; tool \"tools/Confectory.Build.DotNet.dll\"; option mode \"linux\"; }\n";
return new[]{"project.cproj",manifest,"build/pack.cpack",pack,"build/portable.celem",portable,"build/linux.celem",linux,"BUILDING.txt","This standalone source project is editable without a compiler. Android/browser cannot compile or launch it locally. On a desktop with .NET 10, explicitly copy the complete installed Confectory.Build.DotNet tool directory (DLL, dependencies and runtime files) into build/tools, or explicitly replace the build pack registry with an installed compatible target pack. Declared targets: portable, windows, linux. No APK/browser build or installed compiler is implied.\n"};
