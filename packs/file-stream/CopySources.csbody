root=System.IO.Path.GetFullPath(root);destination=System.IO.Path.GetFullPath(destination);
if(!System.IO.Directory.Exists(root)||System.IO.Directory.Exists(destination)||System.IO.File.Exists(destination))throw new ArgumentException("Existing source and new destination required.");
if((System.IO.File.GetAttributes(root)&System.IO.FileAttributes.ReparsePoint)!=0)throw new ArgumentException("Source root symlinks are not copied.");
if(destination.StartsWith(root.TrimEnd(System.IO.Path.DirectorySeparatorChar)+System.IO.Path.DirectorySeparatorChar,OperatingSystem.IsWindows()?StringComparison.OrdinalIgnoreCase:StringComparison.Ordinal)&&!destination.Contains(System.IO.Path.DirectorySeparatorChar+".confectory"+System.IO.Path.DirectorySeparatorChar))throw new ArgumentException("Nested copies require generated workspace scope.");
void Copy(string source,string target)
{
 System.IO.Directory.CreateDirectory(target);
 foreach(string file in System.IO.Directory.GetFiles(source))
 {
  if((System.IO.File.GetAttributes(file)&System.IO.FileAttributes.ReparsePoint)!=0)throw new ArgumentException("Source symlinks are not copied.");
  string extension=System.IO.Path.GetExtension(file).ToLowerInvariant();if(extension is ".dll" or ".exe" or ".apk" or ".pdb")continue;
  System.IO.File.Copy(file,System.IO.Path.Combine(target,System.IO.Path.GetFileName(file)),false);
 }
 foreach(string directory in System.IO.Directory.GetDirectories(source))
 {
  string name=System.IO.Path.GetFileName(directory);if(name is ".git" or ".confectory" or "bin" or "obj")continue;
  if((System.IO.File.GetAttributes(directory)&System.IO.FileAttributes.ReparsePoint)!=0)throw new ArgumentException("Source symlinks are not copied.");
  Copy(directory,System.IO.Path.Combine(target,name));
 }
}
string leasePath=calls.LeasePath.Invoke(root);
for(string? current=leasePath;current is not null&&current.Length>=root.Length;current=System.IO.Path.GetDirectoryName(current))if((System.IO.File.Exists(current)||System.IO.Directory.Exists(current))&&(System.IO.File.GetAttributes(current)&System.IO.FileAttributes.ReparsePoint)!=0)throw new ArgumentException("Source lease must remain in owned storage.");
System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(leasePath)!);System.IO.FileStream? lease=null;var watch=System.Diagnostics.Stopwatch.StartNew();while(lease is null)try{lease=new System.IO.FileStream(leasePath,System.IO.FileMode.OpenOrCreate,System.IO.FileAccess.ReadWrite,System.IO.FileShare.None);}catch(System.IO.IOException){if(watch.ElapsedMilliseconds>=5000)throw new TimeoutException("Source lease busy; retain drafts and retry.");System.Threading.Thread.Sleep(10);}
using(lease)try{Copy(root,destination);}catch{if(System.IO.Directory.Exists(destination))System.IO.Directory.Delete(destination,true);throw;}
