if(string.IsNullOrWhiteSpace(root)||relativePaths is null||relativePaths.Length<1||relativePaths.Length>512)throw new ArgumentException("Archive needs an owned root and 1..512 selected sources.");
root=System.IO.Path.GetFullPath(root);if(!System.IO.Directory.Exists(root))throw new System.IO.DirectoryNotFoundException(root);
for(var ancestor=new System.IO.DirectoryInfo(root);ancestor is not null;ancestor=ancestor.Parent)if((ancestor.Attributes&System.IO.FileAttributes.ReparsePoint)!=0)throw new System.IO.IOException("Archive root cannot traverse links.");
var selected=new System.Collections.Generic.SortedDictionary<string,byte[]>(StringComparer.Ordinal);long total=0;
foreach(var relative in relativePaths){
 if(string.IsNullOrWhiteSpace(relative)||System.IO.Path.IsPathRooted(relative)||relative.Contains('\\'))throw new ArgumentException("Archive requires normalized relative source paths.");
 var parts=relative.Split('/');if(System.Linq.Enumerable.Any(parts,x=>x.Length==0||x=="."||x==".."||x.StartsWith('.')||System.Linq.Enumerable.Contains(new[]{"bin","obj","node_modules","Generated"},x,StringComparer.OrdinalIgnoreCase)))throw new ArgumentException("Generated, hidden or escaping source path rejected.");
 var extension=System.IO.Path.GetExtension(relative);if(!System.Linq.Enumerable.Contains(new[]{".cpack",".celem",".csbody",".cs",".json",".md",".txt"},extension,StringComparer.OrdinalIgnoreCase))throw new ArgumentException("Only explicit text source formats may be archived.");
 if(System.Linq.Enumerable.Any(parts,x=>x.Contains("secret",StringComparison.OrdinalIgnoreCase)||x.Contains("password",StringComparison.OrdinalIgnoreCase)||x.EndsWith(".keystore",StringComparison.OrdinalIgnoreCase)))throw new ArgumentException("Credential source names rejected.");
 string path=root;foreach(var part in parts){path=System.IO.Path.Combine(path,part);if((System.IO.File.GetAttributes(path)&System.IO.FileAttributes.ReparsePoint)!=0)throw new System.IO.IOException("Archive source cannot traverse links.");}
 long length=new System.IO.FileInfo(path).Length;if(length>1024*1024||(total+=length)>8*1024*1024)throw new System.IO.IOException("Source archive byte budget exceeded.");
 byte[] bytes=System.IO.File.ReadAllBytes(path);if(bytes.Length!=length)throw new System.IO.IOException("Source changed while archiving.");new System.Text.UTF8Encoding(false,true).GetString(bytes);if(Array.IndexOf(bytes,(byte)0)>=0)throw new System.IO.IOException("Binary source rejected.");if(selected.ContainsKey(relative))throw new ArgumentException("Duplicate archive source.");selected.Add(relative,bytes);
}
using var output=new System.IO.MemoryStream();using(var zip=new System.IO.Compression.ZipArchive(output,System.IO.Compression.ZipArchiveMode.Create,true))foreach(var item in selected){var entry=zip.CreateEntry(item.Key,System.IO.Compression.CompressionLevel.Fastest);entry.LastWriteTime=new DateTimeOffset(2000,1,1,0,0,0,TimeSpan.Zero);using var destination=entry.Open();destination.Write(item.Value);}
byte[] archive=output.ToArray();if(archive.Length>9*1024*1024)throw new System.IO.IOException("Archive output budget exceeded.");return new[]{"sources.zip",Convert.ToBase64String(archive),Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(archive)).ToLowerInvariant()};
