if (Environment.GetEnvironmentVariable("CONFECTORY_DEV_PUBLIC_CHAT_LOOPBACK") != "1" || port is < 1 or > 65535)
    throw new InvalidOperationException("Protected chat loopback is disabled or no port was supplied.");

System.IO.Stream OpenTransport(System.Threading.CancellationToken cancel)
{
    var socket = new System.Net.Sockets.Socket(System.Net.Sockets.AddressFamily.InterNetwork,
        System.Net.Sockets.SocketType.Stream, System.Net.Sockets.ProtocolType.Tcp);
    try
    {
        socket.ConnectAsync(System.Net.IPAddress.Loopback, port, cancel).AsTask().GetAwaiter().GetResult();
        return new System.Net.Sockets.NetworkStream(socket, ownsSocket: true);
    }
    catch { socket.Dispose(); throw; }
}

return calls.Connect.Invoke("localhost", trustedCertificate,
    (Func<System.Threading.CancellationToken, System.IO.Stream>)OpenTransport, project, invitation, displayName);
