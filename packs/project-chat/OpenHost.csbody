var (join, send, read, close, _, _) =
    ((Func<string, object>, Func<string, string, bool>, Func<string>, Action,
      Func<string, string, string, bool>, Func<string, string>))calls.Open.Invoke(hostStorage, projectId, hostParticipant, "");

object JoinText(string participant)
{
    var (sendHere, readHere, leave, _, _) =
        ((Func<string, string, bool>, Func<string>, Action, Func<string, string, string, bool>, Func<string, string>))join(participant);
    return (sendHere, readHere, leave);
}

return ((Func<string, object>)JoinText, send, read, close);
