const int MaxRequest = 16 * 1024;
const int MaxUpload = 2 * 1024 * 1024 + 32 * 1024;
const int MaxResponse = 4 * 1024 * 1024 + 4096;
var (openTransport, lifetime, relayed) = transport switch
{
    (Func<System.Threading.CancellationToken, System.IO.Stream> open, System.Threading.CancellationToken life, bool relay) => (open, life, relay),
    (Func<System.Threading.CancellationToken, System.IO.Stream> open, System.Threading.CancellationToken life) => (open, life, false),
    Func<System.Threading.CancellationToken, System.IO.Stream> open => (open, System.Threading.CancellationToken.None, false),
    _ => throw new ArgumentException("An authorized native transport is required.")
};
var (read, write) = ((Func<System.IO.Stream, int, System.Threading.CancellationToken,
    System.Threading.Tasks.Task<System.Text.Json.Nodes.JsonObject>>,
    Func<System.IO.Stream, System.Text.Json.Nodes.JsonObject, int, System.Threading.CancellationToken,
    System.Threading.Tasks.Task>))calls.Frames.Invoke();

var tlsOptions = (System.Net.Security.SslClientAuthenticationOptions)calls.PinTls.Invoke(tlsName, trustedCertificate, relayed);
System.IO.Stream? ownedTransport = null;
System.Net.Security.SslStream? stream = null;
var gate = new object();
try
{
    using var opening = System.Threading.CancellationTokenSource.CreateLinkedTokenSource(lifetime);
    opening.CancelAfter(TimeSpan.FromSeconds(10));
    ownedTransport = openTransport(opening.Token);
    stream = new System.Net.Security.SslStream(ownedTransport, leaveInnerStreamOpen: true);
    stream.AuthenticateAsClientAsync(tlsOptions, opening.Token).GetAwaiter().GetResult();
    // No application bytes containing the invitation are written before TLS authenticates.
    opening.Token.ThrowIfCancellationRequested();
    write(stream, new() { ["op"] = "join", ["project"] = project, ["invitation"] = invitation, ["display"] = displayName },
        MaxRequest, opening.Token).GetAwaiter().GetResult();
    if (read(stream, MaxResponse, opening.Token).GetAwaiter().GetResult()["status"]?.GetValue<string>() != "joined")
        throw new UnauthorizedAccessException("The project chat invitation was refused.");

    System.Text.Json.Nodes.JsonObject Request(System.Text.Json.Nodes.JsonObject input)
    {
        lock (gate)
        {
            if (stream is null) throw new ObjectDisposedException("Protected chat connection");
            using var deadline = new System.Threading.CancellationTokenSource(TimeSpan.FromSeconds(10));
            try
            {
                if (input.Count == 4 && input["op"]?.GetValue<string>() == "send-attachment" &&
                    input["attachment"] is System.Text.Json.Nodes.JsonObject box)
                {
                    var header = new System.Text.Json.Nodes.JsonObject
                    {
                        ["op"] = "send-attachment", ["id"] = input["id"]?.DeepClone(), ["text"] = input["text"]?.DeepClone()
                    };
                    write(stream, header, MaxRequest, deadline.Token).GetAwaiter().GetResult();
                    write(stream, box, MaxUpload, deadline.Token).GetAwaiter().GetResult();
                }
                else write(stream, input, MaxRequest, deadline.Token).GetAwaiter().GetResult();
                return read(stream, MaxResponse, deadline.Token).GetAwaiter().GetResult();
            }
            catch { Close(); throw; }
        }
    }

    void Close()
    {
        System.Threading.Interlocked.Exchange(ref ownedTransport, null)?.Dispose();
        lock (gate)
        {
            stream?.Dispose();
            stream = null;
        }
    }

    return ((Func<System.Text.Json.Nodes.JsonObject, System.Text.Json.Nodes.JsonObject>)Request, (Action)Close);
}
catch
{
    ownedTransport?.Dispose();
    stream?.Dispose();
    throw;
}
