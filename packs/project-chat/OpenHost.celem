function Confectory.ProjectChat::OpenHost (string hostStorage, string projectId, string hostParticipant) -> object {
provide Confectory.ProjectChat::OpenHost with Confectory.ProjectChat::OpenHostBody;
description "Open the optional local project chat owner using host-local storage and an existing project identity. The trusted composer keeps the host capability and grants one in-memory participant capability per admitted connection.";
}
