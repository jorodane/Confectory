if (Environment.GetEnvironmentVariable("CONFECTORY_DEV_PUBLIC_CHAT_LOOPBACK") != "1")
    throw new InvalidOperationException("Protected chat loopback is disabled.");

var (certificate, accept, active, lifetime) =
    ((System.Security.Cryptography.X509Certificates.X509Certificate2, Func<string, string, string, object>,
      Func<bool>, System.Threading.CancellationToken))options;
int port = 0;
(Func<System.Threading.CancellationToken, System.Threading.Tasks.Task<System.IO.Stream>>, Action) OpenTransport(int backlog)
{
    var listener = new System.Net.Sockets.TcpListener(System.Net.IPAddress.Loopback, 0);
    listener.Start(backlog);
    port = ((System.Net.IPEndPoint)listener.LocalEndpoint).Port;

    async System.Threading.Tasks.Task<System.IO.Stream> Accept(System.Threading.CancellationToken cancel)
    {
        var socket = await listener.AcceptSocketAsync(cancel).ConfigureAwait(false);
        return new System.Net.Sockets.NetworkStream(socket, ownsSocket: true);
    }

    return (Accept, listener.Stop);
}

var (stop, completion) = ((Action, System.Threading.Tasks.Task))calls.Open.Invoke((certificate, accept, active, lifetime,
    (Func<int, (Func<System.Threading.CancellationToken, System.Threading.Tasks.Task<System.IO.Stream>>, Action)>)OpenTransport));
return (port, stop, completion);
