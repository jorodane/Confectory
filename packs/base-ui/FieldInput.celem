function Confectory.BaseUI::FieldInput (string surface, int control, string buffer, string frame, int type, int x, int y, int code, int flags, string mode) -> int { description "Shared focused Field keyboard/pointer/drag/cancel input; singleline or multiline policy, domain format/validation is caller-owned."; provide Confectory.BaseUI::FieldInput with Confectory.BaseUI::FieldInputBody; }
