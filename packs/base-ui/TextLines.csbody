var measured=System.Text.Json.Nodes.JsonNode.Parse(metrics)??throw new ArgumentException("Text metrics required");if(bounds.Length!=4||bounds[2]<1||bounds[3]<1||color<0||color>0xFFFFFF||firstLine<0||scrollX<0)throw new ArgumentException("Text lines configuration");var lines=measured["lines"]!.AsArray();int insetX=measured["insetX"]!.GetValue<int>(),insetY=measured["insetY"]!.GetValue<int>(),lineHeight=measured["lineHeight"]!.GetValue<int>(),fontHeight=measured["height"]!.GetValue<int>();if(lineHeight<1||fontHeight<1||insetX<0||insetY<0||lines.Count>2048)throw new ArgumentException("Invalid measured text geometry");
