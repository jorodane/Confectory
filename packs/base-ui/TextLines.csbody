for(int index=firstLine;index<lines.Count;index++){int row=index-firstLine,y=bounds[1]+row*lineHeight;if(y>=bounds[1]+bounds[3])break;int rowHeight=Math.Min(lineHeight,bounds[1]+bounds[3]-y);draw.AddRange(new[]{bounds[0],y,bounds[2],rowHeight,color});labels.Add("");int clipWidth=Math.Max(0,bounds[2]-insetX-2),clipHeight=Math.Min(fontHeight,bounds[1]+bounds[3]-y-insetY);if(clipWidth<1||clipHeight<1)continue;int[] clip={bounds[0]+insetX,y+insetY,clipWidth,clipHeight};int[] origin={bounds[0]+insetX-scrollX,y+insetY};clips.AddRange(clip);origins.AddRange(origin);texts.Add(lines[index]!["text"]!.ToString().Replace("\r",""));var entry=lines[index]!.DeepClone();entry!["line"]=index;entry["clip"]=System.Text.Json.JsonSerializer.SerializeToNode(clip);entry["origin"]=System.Text.Json.JsonSerializer.SerializeToNode(origin);rows.Add(entry);}
