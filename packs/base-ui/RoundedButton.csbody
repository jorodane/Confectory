if(radius<0||radius>128)throw new ArgumentException("Rounded button radius budget");var frame=System.Text.Json.Nodes.JsonNode.Parse(calls.Button.Invoke(surface,control,bounds,label,palette,visible,enabled))!.AsObject();var original=System.Text.Json.JsonSerializer.Deserialize<int[]>(frame["rectangles"]!.ToJsonString())!;var paint=visible?calls.RoundedBox.Invoke(bounds,radius,original[4]):Array.Empty<int>();frame["rectangles"]=System.Text.Json.JsonSerializer.SerializeToNode(paint);frame["labels"]=System.Text.Json.JsonSerializer.SerializeToNode(System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Repeat("",paint.Length/5)));frame["text"]=label;frame["bounds"]=System.Text.Json.JsonSerializer.SerializeToNode(bounds);frame["radius"]=Math.Min(radius,Math.Min(bounds[2],bounds[3])/2);return frame.ToJsonString();
