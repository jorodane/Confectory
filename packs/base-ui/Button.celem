function Confectory.BaseUI::Button (string surface, int control, int[] bounds, string label, int[] palette, bool visible, bool enabled) -> string { description "Reusable button presentation/state: bounds x,y,width,height; palette normal,hover,pressed,focus,disabled; returns render/hit frame. Caller owns position/text/style/action."; provide Confectory.BaseUI::Button with Confectory.BaseUI::ButtonBody; }
