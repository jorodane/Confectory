
if(controls.Length<1||controls.Length>128)throw new ArgumentException("Control surface budget1..128");var ids=new System.Collections.Generic.HashSet<int>();foreach(int id in controls)if(id<1||!ids.Add(id))throw new ArgumentException("Positive unique logical controls required");string token=Guid.NewGuid().ToString("N");var state=new System.Collections.Generic.Dictionary<int,int>();foreach(int id in controls)state[id]=3;AppDomain.CurrentDomain.SetData("Confectory.BaseUI.Controls."+token,new object[]{Environment.CurrentManagedThreadId,state,0,0,0});return token;

