if(bounds.Length!=4||bounds[2]<1||bounds[3]<1||bounds[2]>8192||bounds[3]>8192||radius<0||radius>128||color<0||color>0xFFFFFF)throw new ArgumentException("Rounded paint bounds/radius/color budget");int r=Math.Min(radius,Math.Min(bounds[2],bounds[3])/2);if(r==0)return new[]{bounds[0],bounds[1],bounds[2],bounds[3],color};var result=new System.Collections.Generic.List<int>();int previous=-1,start=0;
void Emit(int end){if(previous<0||end<=start)return;result.AddRange(new[]{checked(bounds[0]+previous),checked(bounds[1]+start),bounds[2]-2*previous,end-start,color});}
for(int row=0;row<bounds[3];row++){double py=row+.5,dy=Math.Max(0,Math.Max(r-py,py-(bounds[3]-r)));int inset=dy==0?0:(int)Math.Ceiling(r-Math.Sqrt(Math.Max(0,(double)r*r-dy*dy))-.5);inset=Math.Clamp(inset,0,(bounds[2]-1)/2);if(inset!=previous){Emit(row);start=row;previous=inset;}}Emit(bounds[3]);return result.ToArray();
