if(view.Length!=12||camera.Length!=3) throw new ArgumentException("Invalid presentation state.");
var labels=new[]{"Confectory BaseUI", "Count: "+view[4],(view[1]==1?"> ":"")+"Increment (press and release)",(view[1]==2?"> ":"")+"Enabled: "+(view[8]!=0?"yes":"no"),FormattableString.Invariant($"Camera: {camera[0]:F1}, {camera[1]:F1}  zoom {camera[2]:F2}")};

for(int control=1;control<=2;control++)if((view[11]&(1L<<control))!=0)labels[control+1]="";
return labels;
