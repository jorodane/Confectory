if(rectangles.Length%5!=0||rectangles.Length>640||radii.Length!=rectangles.Length/5)throw new ArgumentException("Rounded hit records/radii budget");var filtered=new System.Collections.Generic.List<int>();for(int n=0;n<radii.Length;n++){if(radii[n]<0||radii[n]>128)throw new ArgumentException("Rounded hit radius");int k=n*5;if(type is 1 or 2 or 3&&radii[n]>0&&!calls.RoundedHit.Invoke(new[]{rectangles[k+1],rectangles[k+2],rectangles[k+3],rectangles[k+4]},radii[n],x,y))continue;filtered.AddRange(rectangles[k..(k+5)]);}return calls.ButtonInput.Invoke(surface,eventID,filtered.ToArray(),buttons,type,x,y,activation);
