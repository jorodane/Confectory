if(bounds.Length!=4||bounds[2]<1||bounds[3]<1||bounds[2]>8192||bounds[3]>8192||axis is not (0 or 1)||gap<0||gap>8192||extents.Length<1||extents.Length>128)throw new ArgumentException("Stack bounds/axis/gap/child budget");
long fixedTotal=0;int flexible=0;foreach(int extent in extents){if(extent<0||extent>8192)throw new ArgumentException("Stack child extent");if(extent==0)flexible++;else fixedTotal+=extent;}
int size=bounds[axis+2],cross=bounds[3-axis],spacing=Math.Min(gap,extents.Length==1?0:size/(extents.Length-1));long available=Math.Max(0,(long)size-spacing*(extents.Length-1));long remainder=Math.Max(0,available-fixedTotal);int resultLength=extents.Length*4;var result=new int[resultLength];int cursor=0,flexIndex=0;
