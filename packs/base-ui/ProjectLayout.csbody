if(view.Length!=3)throw new ArgumentException("Invalid project View.");int w=(int)view[0],h=(int)view[1];int inset=Math.Min(20,Math.Max(0,w/20)),y=Math.Max(0,h-150),width=Math.Max(1,w-2*inset),row=Math.Max(1,Math.Min(30,h/10));var result=new int[30];
for(int i=0;i<6;i++){int j=i*5;result[j]=i<2?inset:inset+(i-2)*width/4;result[j+1]=y+(i<2?i*row:2*row+4);result[j+2]=i<2?width:Math.Max(1,width/4-3);result[j+3]=row;result[j+4]=i<2?0x242838:0x344878;}
return result;
