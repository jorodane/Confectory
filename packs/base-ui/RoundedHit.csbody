if(bounds.Length!=4||bounds[2]<1||bounds[3]<1||bounds[2]>8192||bounds[3]>8192||radius<0||radius>128)throw new ArgumentException("Rounded geometry bounds/radius budget");long localX=(long)x-bounds[0],localY=(long)y-bounds[1];if(localX<0||localY<0||localX>=bounds[2]||localY>=bounds[3])return false;int r=Math.Min(radius,Math.Min(bounds[2],bounds[3])/2);if(r==0)return true;double px=localX+.5,py=localY+.5,dx=Math.Max(0,Math.Max(r-px,px-(bounds[2]-r))),dy=Math.Max(0,Math.Max(r-py,py-(bounds[3]-r)));return dx*dx+dy*dy<=r*r;
