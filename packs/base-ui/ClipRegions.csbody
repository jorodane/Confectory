if(clip.Length!=4||clip[2]<1||clip[3]<1||clip[2]>8192||clip[3]>8192||masks.Length%4!=0||masks.Length>128)throw new ArgumentException("Clip/mask budget");var regions=new System.Collections.Generic.List<int[]>{clip};
for(int m=0;m<masks.Length;m+=4){if(masks[m+2]<1||masks[m+3]<1||masks[m+2]>8192||masks[m+3]>8192)throw new ArgumentException("Opaque mask bounds");long mx=masks[m],my=masks[m+1],mr=mx+masks[m+2],mb=my+masks[m+3];var next=new System.Collections.Generic.List<int[]>();foreach(var box in regions){long x=box[0],y=box[1],right=x+box[2],bottom=y+box[3],ix=Math.Max(x,mx),iy=Math.Max(y,my),ir=Math.Min(right,mr),ib=Math.Min(bottom,mb);if(ix>=ir||iy>=ib){next.Add(box);continue;}void Add(long a,long b,long w,long h){if(w>0&&h>0)next.Add(new[]{checked((int)a),checked((int)b),checked((int)w),checked((int)h)});}Add(x,y,box[2],iy-y);Add(x,ib,box[2],bottom-ib);Add(x,iy,ix-x,ib-iy);Add(ir,iy,right-ir,ib-iy);}if(next.Count>256)throw new ArgumentException("Visible clip fragment budget");regions=next;}
return System.Linq.Enumerable.ToArray(System.Linq.Enumerable.SelectMany(regions,b=>b));
