function Confectory.BaseUI::ButtonInput (string surface, long eventID, int[] rectangles, int[] buttons, int type, int x, int y, int activation) -> int { description "Shared button dispatch: all-control hit records plus button IDs; pointer/native cancel and semantic keyboard press(-ID)/release(+ID), at most one activation per monotonically increasing event ID. Two phases may share one ID."; provide Confectory.BaseUI::ButtonInput with Confectory.BaseUI::ButtonInputBody; }
