if(string.IsNullOrWhiteSpace(project))throw new ArgumentException("Explicit ProjectPack required.");project=System.IO.Path.GetFullPath(project);if(calls.Snapshot.Invoke(project)[0]!="exists")throw new System.IO.FileNotFoundException("ProjectPack missing.",project);
string session=Guid.NewGuid().ToString("N");AppDomain.CurrentDomain.SetData("Confectory.PackManager."+session,new System.Text.Json.Nodes.JsonObject{["project"]=project,["root"]=System.IO.Path.GetDirectoryName(project)!,["hooks"]=new System.Text.Json.Nodes.JsonArray(),["transactions"]=new System.Text.Json.Nodes.JsonObject(),["snapshots"]=new System.Text.Json.Nodes.JsonObject(),["active"]=true});return session;
