var state=AppDomain.CurrentDomain.GetData("Confectory.PackManager."+session) as System.Text.Json.Nodes.JsonObject??throw new ObjectDisposedException("PackManager");
var record=state["transactions"]![transaction] as System.Text.Json.Nodes.JsonObject??throw new ArgumentException("Unknown transaction.");
lock(record)
{
 if(record["state"]!.GetValue<string>()=="applied")return new[]{"applied",transaction};
 string root=state["root"]!.GetValue<string>(),project=state["project"]!.GetValue<string>();string candidate=System.IO.Path.Combine(root,".confectory","pin-validation",transaction);
 bool Active(){lock(state)return state["active"]!.GetValue<bool>();}
 void Journal(){string snapshot=record.ToJsonString();lock(state)state["snapshots"]![transaction]=snapshot;calls.WriteAtomic.Invoke(System.IO.Path.Combine(root,".confectory","pack-manager",transaction+".json"),snapshot);}
 calls.BeginScope.Invoke(session+":"+transaction);
 try
 {
  if(!Active())throw new OperationCanceledException("Pack session canceled.");
  record["state"]="validating";record["error"]="";Journal();calls.CopySources.Invoke(root,candidate);string copied=System.IO.Path.Combine(candidate,System.IO.Path.GetFileName(project));calls.WriteAtomic.Invoke(copied,record["manifest"]!.GetValue<string>());calls.WriteAtomic.Invoke(copied,calls.Prepare.Invoke(project,copied));calls.Validate.Invoke(copied,target);
  if(!Active())throw new OperationCanceledException("Pack session canceled.");
  if(calls.Snapshot.Invoke(project)[2]!=record["baseline"]!.GetValue<string>()||calls.Snapshot.Invoke(System.IO.Path.Combine(root,".pack-lock.json"))[2]!=record["lockBaseline"]!.GetValue<string>()){record["state"]="conflict";record["error"]="Registration changed before hooks; no hooks dispatched.";Journal();return new[]{"conflict",transaction,record["error"]!.GetValue<string>()};}
  var hooks=new System.Collections.Generic.List<System.Text.Json.Nodes.JsonObject>();lock(state)foreach(var item in state["hooks"]!.AsArray())if(item!["operation"]!.GetValue<string>()==record["operation"]!.GetValue<string>())hooks.Add(item.AsObject());
  hooks.Sort((a,b)=>{int priority=a["priority"]!.GetValue<int>().CompareTo(b["priority"]!.GetValue<int>());return priority!=0?priority:StringComparer.Ordinal.Compare(a["id"]!.GetValue<string>(),b["id"]!.GetValue<string>());});
  record["state"]="hooks";Journal();
  foreach(var hook in hooks)
  {
   if(!Active())throw new OperationCanceledException("Pack session canceled before hook dispatch.");
   string id=hook["id"]!.GetValue<string>();bool completed=false;foreach(var done in record["completed"]!.AsArray())if(done!.GetValue<string>()==id)completed=true;if(completed)continue;
   string response=calls.Dispatch.Invoke(id,record["operation"]!.GetValue<string>(),record.ToJsonString());if(response!="accepted")throw new InvalidOperationException("Hook rejected transaction: "+id+" / "+response);
   record["completed"]!.AsArray().Add(id);Journal();
  }
  if(!Active())throw new OperationCanceledException("Pack session canceled before activation.");
  var result=calls.Commit.Invoke(root,new[]{System.IO.Path.GetFileName(project),".pack-lock.json"},new[]{record["baseline"]!.GetValue<string>(),record["lockBaseline"]!.GetValue<string>()},new[]{record["manifest"]!.GetValue<string>(),record["catalog"]!.GetValue<string>()});
  if(result[0]!="applied"){record["state"]="conflict";record["error"]=string.Join("|",result);Journal();return result;}
  record["state"]="applied";try{Journal();return new[]{"applied",transaction};}catch(Exception journal){return new[]{"applied",transaction,"Journal warning: "+journal.Message};}
 }
 catch(Exception error){record["state"]="failed";record["error"]=error.Message;try{Journal();}catch(Exception){}return new[]{"failed",transaction,error.Message};}
 finally{calls.EndScope.Invoke();if(System.IO.Directory.Exists(candidate))System.IO.Directory.Delete(candidate,true);}
}
