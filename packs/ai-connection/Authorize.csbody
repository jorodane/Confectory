if(policy.Length>32768||approvals.Length>8192||string.IsNullOrWhiteSpace(projectId)||projectId.Length>128)throw new ArgumentException("Bounded explicit consent required");
var declaration=System.Text.Json.Nodes.JsonNode.Parse(policy)!.AsObject();var choices=System.Text.Json.Nodes.JsonNode.Parse(approvals)!.AsObject();var requirements=declaration["requirements"]!.AsArray();if(requirements.Count is <2 or >12)throw new ArgumentException("Bounded declared permissions required");var ids=new System.Collections.Generic.HashSet<string>(StringComparer.Ordinal);foreach(var item in requirements){string id=item!["id"]!.ToString();if(!ids.Add(id)||!System.Text.RegularExpressions.Regex.IsMatch(id,@"^[a-zA-Z][a-zA-Z0-9]{0,63}$"))throw new ArgumentException("Unique declared permission IDs required");if(choices[id]?.GetValue<bool>()!=true)throw new UnauthorizedAccessException("Explicit permission required: "+id);}foreach(var item in choices)if(!ids.Contains(item.Key))throw new ArgumentException("Undeclared consent field");
if(declaration["supported"]?.GetValue<bool>()!=true)throw new PlatformNotSupportedException(declaration["blockedReason"]?.ToString()??"Provider execution is unverified");
var grant=declaration["pins"]!.DeepClone().AsObject();if(grant.ContainsKey("projectId"))throw new ArgumentException("Project is pinned by the consumer");foreach(string id in ids){if(grant.ContainsKey(id))throw new ArgumentException("Consent cannot be preapproved by a declaration");grant[id]=true;}grant["projectId"]=projectId;return grant.ToJsonString();
