// The scoped parser is only a transport choice; the policy below is shared
// by both entry points and executes on every newly parsed candidate.
bool owned=false;
if(!string.IsNullOrEmpty(project)){
 try{string full=System.IO.Path.GetFullPath(project),folder=System.IO.Path.GetDirectoryName(full)!;owned=System.IO.Path.GetFileName(full).Equals("project.cpack",StringComparison.OrdinalIgnoreCase)&&string.Equals(System.IO.Path.GetFileName(System.IO.Path.GetDirectoryName(folder)),"ai-settings",StringComparison.OrdinalIgnoreCase)&&System.Text.RegularExpressions.Regex.IsMatch(System.IO.Path.GetFileName(folder),"^[0-9a-fA-F]{16}$");}catch{owned=false;}
}
var metadata=System.Text.Json.Nodes.JsonNode.Parse(owned?calls.Metadata.Invoke("inspect",System.Text.Json.JsonSerializer.Serialize(new{text,_streamProject=project})):calls.Inspect.Invoke(text))!;
if(owned&&(metadata["id"]?.ToString()!="Confectory.AISettings::Settings"||metadata["kind"]?.ToString()!="object"))throw new ArgumentException("Owned connection settings object required");
foreach(string section in new[]{"data","values"})if(metadata[section] is System.Text.Json.Nodes.JsonObject fields)foreach(var field in fields){if(System.Text.RegularExpressions.Regex.IsMatch(field.Key,"apiKey|password|accessToken|refreshToken|secret",System.Text.RegularExpressions.RegexOptions.IgnoreCase))throw new ArgumentException("Secrets cannot be ordinary connection setting fields");if(field.Key=="credentialReference"||field.Key.EndsWith("CredentialReference",StringComparison.Ordinal)){if(section!="data"||field.Value?["Kind"]?.ToString()!="general"||field.Value["Scalar"] is not System.Text.Json.Nodes.JsonValue value||!value.TryGetValue<string>(out var reference))throw new ArgumentException("Credential reference requires a binding name");calls.Reference.Invoke(reference);}}
