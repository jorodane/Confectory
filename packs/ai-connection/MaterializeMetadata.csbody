// Consumer-local declaration projection, never executable pack installation.
string root=System.IO.Path.GetFullPath(directory);System.IO.Directory.CreateDirectory(root);System.Text.Json.Nodes.JsonNode? catalog=null;
foreach(var assembly in AppDomain.CurrentDomain.GetAssemblies()){if(!System.Linq.Enumerable.Contains(assembly.GetManifestResourceNames(),"public-linkage.json",StringComparer.Ordinal))continue;using var stream=assembly.GetManifestResourceStream("public-linkage.json")!;using var reader=new System.IO.StreamReader(stream);var candidate=System.Text.Json.Nodes.JsonNode.Parse(reader.ReadToEnd())!;if(candidate["elements"] is System.Text.Json.Nodes.JsonArray candidates&&System.Linq.Enumerable.Any(candidates,e=>e?["metadataValues"]?["role"]?["value"]?.ToString()=="ai-connection")){catalog=candidate;break;}}
if(catalog is null&&!OperatingSystem.IsBrowser()){string location=System.Reflection.Assembly.GetEntryAssembly()?.Location??"";if(location.Length>0){string sidecar=System.IO.Path.Combine(System.IO.Path.GetDirectoryName(location)!,"public-linkage.json");if(System.IO.File.Exists(sidecar)){if(new System.IO.FileInfo(sidecar).Length>2097152)throw new InvalidOperationException("Public linkage metadata bound");catalog=System.Text.Json.Nodes.JsonNode.Parse(System.IO.File.ReadAllText(sidecar));}}}
if(catalog is null)throw new PlatformNotSupportedException("Linked connection declarations are unavailable in this target; no source repository or provider is guessed");
var elements=catalog["elements"]!.AsArray();var chosen=new System.Collections.Generic.Dictionary<string,System.Text.Json.Nodes.JsonNode>(StringComparer.Ordinal);
void Add(string id){if(chosen.ContainsKey(id))return;var element=System.Linq.Enumerable.FirstOrDefault(elements,e=>e!["id"]!.ToString()==id)??throw new InvalidOperationException("Linked connection declaration missing");if(element["kind"]!.ToString() is not ("object" or "schema"))throw new InvalidOperationException("Metadata projection excludes executable elements");chosen.Add(id,element);if(element["parent"] is System.Text.Json.Nodes.JsonNode parent)Add(parent.ToString());if(element["kind"]!.ToString()=="object")Add(element["metadataValues"]!["configurationSchema"]!["value"]!.GetValue<string>());}
foreach(var element in elements)if(element?["metadataValues"]?["role"]?["value"]?.ToString()=="ai-connection")Add(element!["id"]!.ToString());if(chosen.Count>64)throw new InvalidOperationException("Connection metadata projection bound");
var dependencies=new System.Collections.Generic.Dictionary<string,System.Collections.Generic.HashSet<string>>(StringComparer.Ordinal);var versions=new System.Collections.Generic.Dictionary<string,string>(StringComparer.Ordinal);foreach(var pack in catalog["packs"]!.AsArray())versions[pack!["namespace"]!.ToString()]=pack["version"]!.ToString();foreach(var item in chosen.Values)foreach(string section in new[]{"schemaFields","typedData","metadataValues"})if(item[section] is System.Text.Json.Nodes.JsonObject fields&&System.Linq.Enumerable.Any(fields,key=>System.Text.RegularExpressions.Regex.IsMatch(key.Key,"apiKey|password|accessToken|refreshToken|secret",System.Text.RegularExpressions.RegexOptions.IgnoreCase)))throw new InvalidOperationException("Secrets cannot be ordinary connection declarations");
var packs=new System.Collections.Generic.Dictionary<string,System.Text.StringBuilder>(StringComparer.Ordinal);foreach(var pair in System.Linq.Enumerable.OrderBy(chosen,p=>p.Key,StringComparer.Ordinal)){
 string id=pair.Key,ns=id.Split("::")[0],local=id.Split("::")[1],kind=pair.Value["kind"]!.ToString();if(!System.Text.RegularExpressions.Regex.IsMatch(id,@"\A[A-Za-z_][A-Za-z_0-9.]*::[A-Za-z_][A-Za-z_0-9]*\z"))throw new InvalidOperationException("Linked metadata ID");if(!packs.TryGetValue(ns,out var pack)){packs[ns]=pack=new System.Text.StringBuilder("pack "+ns+" version "+System.Text.Json.JsonSerializer.Serialize(versions[ns])+" { standalone false;\n");System.IO.Directory.CreateDirectory(System.IO.Path.Combine(root,ns));dependencies[ns]=new(StringComparer.Ordinal);}
 foreach(string dependency in new[]{pair.Value["parent"]?.ToString()??id,kind=="object"?pair.Value["metadataValues"]!["configurationSchema"]!["value"]!.GetValue<string>():id}){string target=dependency.Split("::")[0];if(target!=ns)dependencies[ns].Add(target);}
 var text=new System.Text.StringBuilder(kind+" "+id+(pair.Value["parent"] is null?"":" extends "+pair.Value["parent"])+" {\n");if(kind=="object")text.Append("use schema ").Append(pair.Value["metadataValues"]!["configurationSchema"]!["value"]!.GetValue<string>()).Append(";\n");
 if(pair.Value["schemaFields"] is System.Text.Json.Nodes.JsonObject fields)foreach(var field in fields){if(field.Value!["origin"]!.ToString()!=id)continue;if(field.Value["kind"]!.ToString()!="general")throw new InvalidOperationException("Connection credential-safe primitive schema required");text.Append("field ").Append(field.Key).Append(' ').Append(field.Value["cardinality"]).Append(" general ").Append(field.Value["type"]).Append(";\n");}
 if(pair.Value["metadataValues"] is System.Text.Json.Nodes.JsonObject values)foreach(var value in values)if(value.Value!["origin"]!.ToString()==id)text.Append("value ").Append(value.Key).Append(" = ").Append(value.Value["value"]!.ToJsonString()).Append(";\n");
 if(pair.Value["typedData"] is System.Text.Json.Nodes.JsonObject data)foreach(var field in data){if(field.Value!["origin"]!.ToString()!=id)continue;if(field.Value["kind"]!.ToString()!="general")throw new InvalidOperationException("Connection projection supports primitive configuration only");text.Append("data ").Append(field.Key).Append(" = ").Append(field.Value["scalar"]!.ToJsonString()).Append(";\n");}
 text.Append("}\n");string file=System.IO.Path.Combine(root,ns,local+".celem");System.IO.File.WriteAllText(file,text.ToString());pack.Append("element ").Append(local).Append(' ').Append(kind).Append(" ").Append(System.Text.Json.JsonSerializer.Serialize(local+".celem")).Append(";\n");
}
var manifest=new System.Text.StringBuilder("project Confectory.ConnectionMetadata version \"0.1.0\" { standalone false;\n");foreach(var pair in System.Linq.Enumerable.OrderBy(packs,p=>p.Key,StringComparer.Ordinal)){foreach(string dependency in System.Linq.Enumerable.OrderBy(dependencies[pair.Key],s=>s,StringComparer.Ordinal))pair.Value.Append("dependency ").Append(dependency).Append(" version ").Append(System.Text.Json.JsonSerializer.Serialize(versions[dependency])).Append(";\n");System.IO.File.WriteAllText(System.IO.Path.Combine(root,pair.Key,"pack.cpack"),pair.Value.Append("}\n").ToString());manifest.Append("registry ").Append(pair.Key).Append(' ').Append(System.Text.Json.JsonSerializer.Serialize(pair.Key+"/pack.cpack")).Append("; dependency ").Append(pair.Key).Append(" version \"0.1.0\";\n");}manifest.Append("}\n");string project=System.IO.Path.Combine(root,"project.cpack");System.IO.File.WriteAllText(project,manifest.ToString());return project;
