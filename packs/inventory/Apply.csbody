var state=AppDomain.CurrentDomain.GetData("Confectory.Inventory."+inventory) as object[]??throw new ObjectDisposedException("Inventory");if(resources.Length<1||resources.Length>64||resources.Length!=changes.Length)throw new ArgumentException("Bounded atomic resource deltas required");lock(state[0]){if((bool)state[3])throw new ObjectDisposedException("Inventory");var current=(System.Collections.Generic.Dictionary<string,int>)state[1];var next=new System.Collections.Generic.Dictionary<string,int>(current,StringComparer.Ordinal);for(int i=0;i<resources.Length;i++){if(!next.TryGetValue(resources[i],out int value))throw new ArgumentException("Resource not registered in this inventory");long amount=(long)value+changes[i];if(amount<0)return false;if(amount>int.MaxValue)throw new OverflowException("Resource quantity overflow");next[resources[i]]=(int)amount;}state[1]=next;state[2]=(long)state[2]+1;return true;}
