var state=AppDomain.CurrentDomain.GetData("Confectory.Inventory."+inventory) as object[]??throw new ObjectDisposedException("Inventory");lock(state[0]){if((bool)state[3])throw new ObjectDisposedException("Inventory");var quantities=new System.Text.Json.Nodes.JsonObject();foreach(var item in (System.Collections.Generic.Dictionary<string,int>)state[1])quantities[item.Key]=item.Value;return new System.Text.Json.Nodes.JsonObject{["instance"]=inventory,["revision"]=(long)state[2],["quantities"]=quantities}.ToJsonString();}
