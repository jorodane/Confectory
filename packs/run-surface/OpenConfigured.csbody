Action close=()=>{if(Environment.CurrentManagedThreadId!=thread)throw new InvalidOperationException("Output retirement belongs to its frame owner thread");lock(gate){if(closed)return;}if(sized)calls.DetachCommand.Invoke(frameOwner,command);calls.Detach.Invoke(frameOwner,read);lock(gate){closed=true;latest=null;held=null;}};
