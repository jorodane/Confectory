int maxAxis=hd?1280:640,maxPixels=hd?921600:262144;
// An explicit local reader on the caller-owned cooperative frame loop; no new socket or process grant.
string key="Confectory.RunSurface."+Guid.NewGuid().ToString("N"),runtime=Guid.NewGuid().ToString("N");object gate=new();bool closed=false;long revision=0;int thread=Environment.CurrentManagedThreadId;System.Text.Json.Nodes.JsonObject? latest=null;
// Count successful software publications, never reads, cooperative ACKs or GPU
// presentation. Ten fixed buckets bound memory even if Present is very frequent.
var rateClock=System.Diagnostics.Stopwatch.StartNew();var rateBuckets=new long[10];var rateCounts=new long[10];Array.Fill(rateBuckets,-1L);long rateObservation=0;
System.Text.Json.Nodes.JsonObject Rate(){
 long now=rateClock.ElapsedMilliseconds,bucket=now/100,count=0;bool ready=now>=1000;
 if(ready)for(int i=0;i<10;i++)if(rateBuckets[i]>=bucket-9&&rateBuckets[i]<=bucket)count=checked(count+rateCounts[i]);
 return new(){["basis"]="software-present-v1",["observation"]=checked(++rateObservation).ToString(System.Globalization.CultureInfo.InvariantCulture),["ready"]=ready,["frames"]=count.ToString(System.Globalization.CultureInfo.InvariantCulture),["windowMs"]=ready?(int)(now-(bucket-9)*100):0};
}
bool sized=false;int requestedWidth=0,requestedHeight=0,sizeSequence=0,sizeAck=0,lastExpected=-1;string sizeCommand="";
System.Text.Json.Nodes.JsonObject Size()=>new(){["sequence"]=sizeSequence,["ack"]=sizeAck,["command"]=sizeCommand,["width"]=requestedWidth,["height"]=requestedHeight,["min"]=240,["max"]=maxAxis,["maxPixels"]=maxPixels};
Func<string,string> command=text=>{if(text.Length>4096)throw new ArgumentException("Size command budget");var q=(System.Text.Json.Nodes.JsonNode.Parse(text)as System.Text.Json.Nodes.JsonObject??throw new ArgumentException("Size request object required"));foreach(var field in q)if(field.Key is not("runtime"or"sequence"or"command"or"width"or"height"))throw new ArgumentException("Explicit size command fields required");string epoch=q["runtime"]?.GetValue<string>()??"",id=q["command"]?.GetValue<string>()??"";int sequence=q["sequence"]?.GetValue<int>()??-1,width=q["width"]?.GetValue<int>()??-1,height=q["height"]?.GetValue<int>()??-1;if(epoch!=runtime||!System.Text.RegularExpressions.Regex.IsMatch(id,@"\A[a-f0-9]{32}\z")||width<240||width>maxAxis||height<240||height>maxAxis||(long)width*height>maxPixels)throw new ArgumentException("Owned runtime and configured axis/pixel budget required");lock(gate){if(closed||!sized||latest is null)throw new InvalidOperationException("No configurable live output");if(id==sizeCommand){if(sequence!=lastExpected||width!=requestedWidth||height!=requestedHeight)throw new InvalidOperationException("Size command identity changed");}else{if(sequence!=sizeSequence||sizeSequence!=sizeAck||sizeSequence>=64)throw new InvalidOperationException("Size request changed or still pending");lastExpected=sequence;sizeSequence++;requestedWidth=width;requestedHeight=height;sizeCommand=id;}return new System.Text.Json.Nodes.JsonObject{["available"]=true,["runtime"]=runtime,["resize"]=Size()}.ToJsonString();}};
Action<int,int> configure=(width,height)=>{if(Environment.CurrentManagedThreadId!=thread)throw new InvalidOperationException("Configure on the frame owner thread");if(width<1||width>maxAxis||height<1||height>maxAxis||(long)width*height>maxPixels)throw new ArgumentException("Initial output size budget");lock(gate){if(closed)throw new ObjectDisposedException("Software surface");if(sized||revision!=0)throw new InvalidOperationException("Configure explicitly once before first pixels");calls.AttachCommand.Invoke(frameOwner,command);requestedWidth=width;requestedHeight=height;sized=true;}};
Func<int[]> requested=()=>{if(Environment.CurrentManagedThreadId!=thread)throw new InvalidOperationException("Consume size on the frame owner thread");lock(gate){if(closed)throw new ObjectDisposedException("Software surface");if(!sized)throw new InvalidOperationException("Output did not opt into resizing");return new[]{requestedWidth,requestedHeight};}};
System.Text.Json.Nodes.JsonObject? held=null;
Func<string,string> read=cursor=>{if(cursor.Length>64)throw new ArgumentException("Surface cursor budget");lock(gate){
 if(closed||latest is null)return "{\"available\":false}";
 System.Text.Json.Nodes.JsonObject result;int part=0;
 if(cursor.StartsWith("part:",StringComparison.Ordinal)){
  int split=cursor.LastIndexOf(':');if(held is null||split<0||!int.TryParse(cursor[(split+1)..],out part)||part<1||cursor!="part:"+held["cursor"]!.ToString()+":"+part.ToString(System.Globalization.CultureInfo.InvariantCulture))throw new ArgumentException("Exact held software frame part required");result=held.DeepClone().AsObject();
 }else{
  result=latest.DeepClone().AsObject();result["renderRate"]=Rate();if(sized)result["resize"]=Size();bool same=cursor==latest["cursor"]!.ToString();result["unchanged"]=same;
  if(same){result.Remove("pixels");return result.ToJsonString();}
  held=null;if(result["pixels"]!.GetValue<string>().Length>1398102){if(!hd)throw new InvalidOperationException("HD output must be explicitly opened");held=result.DeepClone().AsObject();}
 }
 string encoded=result["pixels"]!.GetValue<string>();if(encoded.Length>1398102){int parts=(encoded.Length+1048575)/1048576;if(part>=parts)throw new ArgumentException("Software frame part range");result["encoding"]="base64url-parts-v1";result["part"]=part;result["parts"]=parts;result["pixels"]=encoded.Substring(part*1048576,Math.Min(1048576,encoded.Length-part*1048576));if(part==parts-1)held=null;}
 return result.ToJsonString();
}};
calls.Attach.Invoke(frameOwner,read);
Func<int,int,string,int[]?,long> publish=(width,height,rgba,rectangles)=>{
 lock(gate){if(hd&&!sized)throw new InvalidOperationException("Configure the explicit HD output before publishing pixels");}
 if(rectangles is not null&&(rectangles.Length>64||rectangles.Length%4!=0))throw new ArgumentException("At most16 flat xywh bounds required");
