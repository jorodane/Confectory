 if(bounds is not null){for(int i=0;i<bounds.Length;i+=4)if(bounds[i]<0||bounds[i+1]<0||bounds[i+2]<1||bounds[i+3]<1||(long)bounds[i]+bounds[i+2]>width||(long)bounds[i+1]+bounds[i+3]>height)throw new ArgumentException("Visible pixel bounds must fit the actual frame");}
if(width<1||width>maxAxis||height<1||height>maxAxis||(long)width*height>maxPixels||rgba.Length>(hd?4915200:1398104))throw new ArgumentException("Exact configured RGBA8 axis, pixel and byte budget required");byte[] pixels=Convert.FromBase64String(rgba);if(pixels.Length!=checked(width*height*4)||Convert.ToBase64String(pixels)!=rgba)throw new ArgumentException("Exact canonical top-down straight-alpha sRGB RGBA8 pixels required");string sha=Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(pixels)).ToLowerInvariant();lock(gate){if(closed)throw new ObjectDisposedException("Software surface");long next=checked(revision+1);latest=new System.Text.Json.Nodes.JsonObject{["available"]=true,["runtime"]=runtime,["revision"]=next.ToString(System.Globalization.CultureInfo.InvariantCulture),["cursor"]=runtime+":"+next.ToString(System.Globalization.CultureInfo.InvariantCulture),["format"]="rgba8",["width"]=width,["height"]=height,["sha256"]=sha,["encoding"]="base64url",["pixels"]=rgba.TrimEnd('=').Replace('+','-').Replace('/','_')};if(bounds is not null)latest["bounds"]=new System.Text.Json.Nodes.JsonObject{["space"]="rgba8-pixels-v1",["rectangles"]=System.Text.Json.JsonSerializer.SerializeToNode(bounds)};if(sized&&width==requestedWidth&&height==requestedHeight)sizeAck=sizeSequence;long rateBucket=rateClock.ElapsedMilliseconds/100;int rateSlot=(int)(rateBucket%10);if(rateBuckets[rateSlot]!=rateBucket){rateBuckets[rateSlot]=rateBucket;rateCounts[rateSlot]=0;}rateCounts[rateSlot]=checked(rateCounts[rateSlot]+1);return revision=next;}};
