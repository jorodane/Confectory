// An explicit local reader on the caller-owned cooperative frame loop; no new socket or process grant.
string key="Confectory.RunSurface."+Guid.NewGuid().ToString("N"),runtime=Guid.NewGuid().ToString("N");object gate=new();bool closed=false;long revision=0;int thread=Environment.CurrentManagedThreadId;System.Text.Json.Nodes.JsonObject? latest=null;
// Count successful software publications, never reads, cooperative ACKs or GPU
// presentation. Ten fixed buckets bound memory even if Present is very frequent.
var rateClock=System.Diagnostics.Stopwatch.StartNew();var rateBuckets=new long[10];var rateCounts=new long[10];Array.Fill(rateBuckets,-1L);long rateObservation=0;
System.Text.Json.Nodes.JsonObject Rate(){
 long now=rateClock.ElapsedMilliseconds,bucket=now/100,count=0;bool ready=now>=1000;
 if(ready)for(int i=0;i<10;i++)if(rateBuckets[i]>=bucket-9&&rateBuckets[i]<=bucket)count=checked(count+rateCounts[i]);
 return new(){["basis"]="software-present-v1",["observation"]=checked(++rateObservation).ToString(System.Globalization.CultureInfo.InvariantCulture),["ready"]=ready,["frames"]=count.ToString(System.Globalization.CultureInfo.InvariantCulture),["windowMs"]=ready?(int)(now-(bucket-9)*100):0};
}
bool sized=false;int requestedWidth=0,requestedHeight=0,sizeSequence=0,sizeAck=0,lastExpected=-1;string sizeCommand="";
System.Text.Json.Nodes.JsonObject Size()=>new(){["sequence"]=sizeSequence,["ack"]=sizeAck,["command"]=sizeCommand,["width"]=requestedWidth,["height"]=requestedHeight,["min"]=240,["max"]=640,["maxPixels"]=262144};
Func<string,string> command=text=>{if(text.Length>4096)throw new ArgumentException("Size command budget");var q=(System.Text.Json.Nodes.JsonNode.Parse(text)as System.Text.Json.Nodes.JsonObject??throw new ArgumentException("Size request object required"));foreach(var field in q)if(field.Key is not("runtime"or"sequence"or"command"or"width"or"height"))throw new ArgumentException("Explicit size command fields required");string epoch=q["runtime"]?.GetValue<string>()??"",id=q["command"]?.GetValue<string>()??"";int sequence=q["sequence"]?.GetValue<int>()??-1,width=q["width"]?.GetValue<int>()??-1,height=q["height"]?.GetValue<int>()??-1;if(epoch!=runtime||!System.Text.RegularExpressions.Regex.IsMatch(id,@"\A[a-f0-9]{32}\z")||width is <240 or >640||height is <240 or >640||(long)width*height>262144)throw new ArgumentException("Owned runtime, 240..640 dimensions and 262144-pixel budget required");lock(gate){if(closed||!sized||latest is null)throw new InvalidOperationException("No configurable live output");if(id==sizeCommand){if(sequence!=lastExpected||width!=requestedWidth||height!=requestedHeight)throw new InvalidOperationException("Size command identity changed");}else{if(sequence!=sizeSequence||sizeSequence!=sizeAck||sizeSequence>=64)throw new InvalidOperationException("Size request changed or still pending");lastExpected=sequence;sizeSequence++;requestedWidth=width;requestedHeight=height;sizeCommand=id;}return new System.Text.Json.Nodes.JsonObject{["available"]=true,["runtime"]=runtime,["resize"]=Size()}.ToJsonString();}};
Action<int,int> configure=(width,height)=>{if(Environment.CurrentManagedThreadId!=thread)throw new InvalidOperationException("Configure on the frame owner thread");if(width is <1 or >640||height is <1 or >640||(long)width*height>262144)throw new ArgumentException("Initial output size budget");lock(gate){if(closed)throw new ObjectDisposedException("Software surface");if(sized||revision!=0)throw new InvalidOperationException("Configure explicitly once before first pixels");calls.AttachCommand.Invoke(frameOwner,command);requestedWidth=width;requestedHeight=height;sized=true;}};
Func<int[]> requested=()=>{if(Environment.CurrentManagedThreadId!=thread)throw new InvalidOperationException("Consume size on the frame owner thread");lock(gate){if(closed)throw new ObjectDisposedException("Software surface");if(!sized)throw new InvalidOperationException("Output did not opt into resizing");return new[]{requestedWidth,requestedHeight};}};
Func<string,string> read=cursor=>{if(cursor.Length>52)throw new ArgumentException("Surface cursor budget");lock(gate){if(closed||latest is null)return "{\"available\":false}";var result=latest.DeepClone().AsObject();result["renderRate"]=Rate();if(sized)result["resize"]=Size();bool same=cursor==latest["cursor"]!.ToString();result["unchanged"]=same;if(same)result.Remove("pixels");return result.ToJsonString();}};
calls.Attach.Invoke(frameOwner,read);
Func<int,int,string,long> present=(width,height,rgba)=>{if(width is <1 or >640||height is <1 or >640||(long)width*height>262144||rgba.Length>1398104)throw new ArgumentException("RGBA8 surface budget: 1..640 per dimension, 262144 pixels and 1MiB bytes");byte[] pixels=Convert.FromBase64String(rgba);if(pixels.Length!=checked(width*height*4)||Convert.ToBase64String(pixels)!=rgba)throw new ArgumentException("Exact canonical top-down straight-alpha sRGB RGBA8 pixels required");string sha=Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(pixels)).ToLowerInvariant();lock(gate){if(closed)throw new ObjectDisposedException("Software surface");long next=checked(revision+1);latest=new System.Text.Json.Nodes.JsonObject{["available"]=true,["runtime"]=runtime,["revision"]=next.ToString(System.Globalization.CultureInfo.InvariantCulture),["cursor"]=runtime+":"+next.ToString(System.Globalization.CultureInfo.InvariantCulture),["format"]="rgba8",["width"]=width,["height"]=height,["sha256"]=sha,["encoding"]="base64url",["pixels"]=rgba.TrimEnd('=').Replace('+','-').Replace('/','_')};if(sized&&width==requestedWidth&&height==requestedHeight)sizeAck=sizeSequence;long rateBucket=rateClock.ElapsedMilliseconds/100;int rateSlot=(int)(rateBucket%10);if(rateBuckets[rateSlot]!=rateBucket){rateBuckets[rateSlot]=rateBucket;rateCounts[rateSlot]=0;}rateCounts[rateSlot]=checked(rateCounts[rateSlot]+1);return revision=next;}};
Action close=()=>{if(Environment.CurrentManagedThreadId!=thread)throw new InvalidOperationException("Output retirement belongs to its frame owner thread");lock(gate){if(closed)return;}if(sized)calls.DetachCommand.Invoke(frameOwner,command);calls.Detach.Invoke(frameOwner,read);lock(gate){closed=true;latest=null;}};
try{AppDomain.CurrentDomain.SetData(key,new object[]{present,close,configure,requested});return key;}catch{calls.Detach.Invoke(frameOwner,read);throw;}
