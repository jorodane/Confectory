// An explicit local reader on the caller-owned cooperative frame loop; no new socket or process grant.
string key="Confectory.RunSurface."+Guid.NewGuid().ToString("N"),runtime=Guid.NewGuid().ToString("N");object gate=new();bool closed=false;long revision=0;int thread=Environment.CurrentManagedThreadId;System.Text.Json.Nodes.JsonObject? latest=null;
Func<string,string> read=cursor=>{if(cursor.Length>52)throw new ArgumentException("Surface cursor budget");lock(gate){if(closed||latest is null)return "{\"available\":false}";var result=latest.DeepClone().AsObject();bool same=cursor==latest["cursor"]!.ToString();result["unchanged"]=same;if(same)result.Remove("pixels");return result.ToJsonString();}};
calls.Attach.Invoke(frameOwner,read);
Func<int,int,string,long> present=(width,height,rgba)=>{if(width is <1 or >512||height is <1 or >512||rgba.Length>1398104)throw new ArgumentException("RGBA8 surface budget: 1..512 per dimension and 1MiB pixels");byte[] pixels=Convert.FromBase64String(rgba);if(pixels.Length!=checked(width*height*4)||Convert.ToBase64String(pixels)!=rgba)throw new ArgumentException("Exact canonical top-down straight-alpha sRGB RGBA8 pixels required");string sha=Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(pixels)).ToLowerInvariant();lock(gate){if(closed)throw new ObjectDisposedException("Software surface");long next=checked(revision+1);latest=new System.Text.Json.Nodes.JsonObject{["available"]=true,["runtime"]=runtime,["revision"]=next.ToString(System.Globalization.CultureInfo.InvariantCulture),["cursor"]=runtime+":"+next.ToString(System.Globalization.CultureInfo.InvariantCulture),["format"]="rgba8",["width"]=width,["height"]=height,["sha256"]=sha,["encoding"]="base64url",["pixels"]=rgba.TrimEnd('=').Replace('+','-').Replace('/','_')};return revision=next;}};
Action close=()=>{if(Environment.CurrentManagedThreadId!=thread)throw new InvalidOperationException("Output retirement belongs to its frame owner thread");lock(gate){if(closed)return;}calls.Detach.Invoke(frameOwner,read);lock(gate){closed=true;latest=null;}};
try{AppDomain.CurrentDomain.SetData(key,new object[]{present,close});return key;}catch{calls.Detach.Invoke(frameOwner,read);throw;}
