if(selected.Length==0)return new[]{"empty"};
selected=(string[])selected.Clone();reviewed=(string[])reviewed.Clone();
var chosen=calls.Changes.Invoke(handle,selected);if(!System.Linq.Enumerable.SequenceEqual(reviewed,chosen))return new[]{"stale","Selected draft differs from the reviewed changes; review again."};
try{calls.ValidateSelection.Invoke(handle,selected);}catch(Exception error){return new[]{"invalid",error.Message};}
var identity=calls.Identity.Invoke(handle);string root=identity[3];var changes=reviewed;
string candidate=System.IO.Path.Combine(root,".confectory","candidates",Guid.NewGuid().ToString("N"));
bool committed=false;
try
{
 calls.CopySources.Invoke(root,candidate);
 for(int i=0;i<changes.Length;i+=4)calls.WriteAtomic.Invoke(System.IO.Path.Combine(candidate,changes[i+1]),changes[i+3]);
 string project=System.IO.Path.Combine(candidate,System.IO.Path.GetFileName(identity[0]));calls.WriteAtomic.Invoke(project,calls.Prepare.Invoke(identity[0],project));
 calls.Validate.Invoke(project,target);

 if(!System.Linq.Enumerable.SequenceEqual(changes,calls.Changes.Invoke(handle,selected)))return new[]{"stale","Selected draft changed during validation; review again."};
 calls.ValidateSelection.Invoke(handle,selected);
 var paths=new string[changes.Length/4];var hashes=new string[paths.Length];var texts=new string[paths.Length];var accepted=new string[paths.Length];for(int i=0;i<paths.Length;i++){accepted[i]=changes[i*4];paths[i]=changes[i*4+1];hashes[i]=changes[i*4+2];texts[i]=changes[i*4+3];}
 if(paths.Length>0){var activity=calls.Activity.Invoke(identity[0],"confirm");paths=System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Append(paths,activity[0]));hashes=System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Append(hashes,activity[1]));texts=System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Append(texts,activity[2]));}
 var draftState=AppDomain.CurrentDomain.GetData("Confectory.EditWorkspace."+handle) as System.Text.Json.Nodes.JsonObject;var writes=new System.Text.Json.Nodes.JsonArray();var checks=new System.Text.Json.Nodes.JsonArray();for(int n=0;n<paths.Length;n++){bool retained=n<accepted.Length&&draftState?["units"]?[accepted[n]]?["hierarchyGroup"] is not null&&draftState["units"]![accepted[n]]!["draft"]!.ToString()==draftState["units"]![accepted[n]]!["original"]!.ToString();if(n<accepted.Length)foreach(var operation in draftState?["retirements"]?.AsObject()??new System.Text.Json.Nodes.JsonObject()){var receipt=operation.Value!;if(receipt["entries"]?[accepted[n]] is null)continue;retained=receipt["state"]?.ToString()=="pending"||receipt["state"]?.ToString()=="restoring"&&draftState?["units"]?[accepted[n]]?["draft"]?.ToString()==draftState?["units"]?[accepted[n]]?["original"]?.ToString();}var row=new System.Text.Json.Nodes.JsonObject{["path"]=paths[n],["hash"]=hashes[n]};if(retained)checks.Add(row);else{row["text"]=texts[n];writes.Add(row);}}
 // Read-only owned target/manifest/record dependencies participate in the same
 // final file CAS as the changed caller and graphs; they are never rewritten.
 var guardedPaths=new System.Collections.Generic.HashSet<string>(paths,OperatingSystem.IsWindows()?StringComparer.OrdinalIgnoreCase:StringComparer.Ordinal);foreach(var check in checks)guardedPaths.Add(check!["path"]!.ToString());foreach(string id in selected)if(draftState?["units"]?[id]?["rootAbiContracts"] is not null)foreach(var member in draftState["units"]![id]!["rootContractGroup"]!.AsArray()){var unit=draftState["units"]![member!.ToString()]!;string path=unit["path"]!.ToString();if(guardedPaths.Add(path))checks.Add(new System.Text.Json.Nodes.JsonObject{["path"]=path,["hash"]=unit["baseline"]!.DeepClone()});}
 // Single-node C# wrapping retains its old source and all observed contracts.
 // Check unchanged members under the final source lease, without writing them.
 foreach(string id in selected)if(draftState?["units"]?[id]?["nodeFlowOrigin"] is not null)
  foreach(var member in draftState["units"]![id]!["atomicEditGroup"]!.AsArray()){
   var unit=draftState["units"]![member!.ToString()]!;string path=unit["path"]!.ToString();if(guardedPaths.Add(path))checks.Add(new System.Text.Json.Nodes.JsonObject{["path"]=path,["hash"]=unit["baseline"]!.DeepClone()});
  }
 // Recheck saved copy assignment/provenance reads under the same source lease
 // as every write, closing the gap after compiler validation and Review.
 foreach(string id in selected)if(draftState?["units"]?[id]?["atomicEditGroup"] is not null)
  foreach(var guard in draftState["units"]![id]?["slotSaveReceipt"]?["readGuards"]?.AsObject()??new System.Text.Json.Nodes.JsonObject()){
   string path=guard.Value!["path"]!.ToString();if(guardedPaths.Add(path))checks.Add(guard.Value.DeepClone());
  }
 var result=checks.Count>0?calls.CommitPlan.Invoke(root,new System.Text.Json.Nodes.JsonObject{["writes"]=writes,["checks"]=checks}.ToJsonString()):calls.Commit.Invoke(root,paths,hashes,texts);if(result[0]!="applied")return result;committed=true;calls.Accept.Invoke(handle,accepted);calls.Acknowledge.Invoke(handle,accepted);return new[]{"confirmed"};
}
catch(Exception error){return new[]{committed?"confirmed-with-warning":"invalid",error.Message};}
finally{if(System.IO.Directory.Exists(candidate))System.IO.Directory.Delete(candidate,true);}
