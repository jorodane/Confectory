pack Confectory.ChangeSet version "0.1.0" {
standalone false;
dependency Confectory.Save version "0.1.0";
dependency Confectory.EditWorkspace version "0.1.0";
dependency Confectory.FileStream version "0.1.0";
dependency Confectory.SchemaEditing version "0.1.0";
element Review function "Review.celem";
element ReviewBody implementation "ReviewBody.celem";
element Confirm function "Confirm.celem";
element ConfirmBody implementation "ConfirmBody.celem";
element Preview function "Preview.celem";
element PreviewBody implementation "PreviewBody.celem";
}
