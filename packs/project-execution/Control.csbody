if(session.Length!=2||session[1]!="active"||AppDomain.CurrentDomain.GetData(session[0]) is not System.Collections.Generic.Dictionary<string,object[]> records)throw new InvalidOperationException("Execution session is disposed");
object[] record;lock(records){if(!records.TryGetValue(handle,out record!))throw new ArgumentException("Unknown execution handle for this session");}
if(record.Length<5||record[4] is not Func<string,string> control)return new System.Text.Json.Nodes.JsonObject{["available"]=false,["connected"]=false,["handle"]=handle,["reason"]="This execution provider has no cooperative frame control"}.ToJsonString();
return control(operation);
