if(session.Length!=2||session[1]!="active"||AppDomain.CurrentDomain.GetData(session[0]) is not System.Collections.Generic.Dictionary<string,object[]> records)throw new InvalidOperationException("Execution session is disposed");
string[] jobs;lock(records)jobs=System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Select(System.Linq.Enumerable.Where(records,pair=>pair.Value.Length>4&&pair.Value[4] is System.Text.Json.Nodes.JsonObject meta&&meta["kind"]?.ToString()=="build-only"),pair=>pair.Key));
var failures=new System.Collections.Generic.List<Exception>();foreach(string job in jobs)try{calls.Stop.Invoke(session,job);}catch(Exception error){failures.Add(error);}if(failures.Count>0)throw new AggregateException("Owned build jobs remain closing; retry",failures);
