}else if(operation=="info"){query["job"]=job;query["verify"]=args["verify"]?.DeepClone()??System.Text.Json.Nodes.JsonValue.Create(false);}else query["page"]=args["page"]?.DeepClone()??System.Text.Json.Nodes.JsonValue.Create(0);
