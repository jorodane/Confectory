if(session.Length!=2||session[1]!="active"||AppDomain.CurrentDomain.GetData(session[0]) is not System.Collections.Generic.Dictionary<string,object[]> records)throw new InvalidOperationException("Execution session is disposed.");
string[] snapshot;bool journal;lock(records){if(!records.TryGetValue(handle,out var record))throw new ArgumentException("Unknown execution handle for this session.");snapshot=(string[])((string[])record[0]).Clone();journal=record.Length>5&&record[5] is object[];}if(journal)try{calls.RunHistory.Invoke(session,snapshot[2],"checkpoint",new System.Text.Json.Nodes.JsonObject{["execution"]=handle}.ToJsonString());}catch{}return snapshot;
