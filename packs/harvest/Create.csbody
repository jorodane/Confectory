var data=System.Text.Json.Nodes.JsonNode.Parse(declaration)!;var values=data["values"]!;if(data["kind"]!.GetValue<string>()!="object"||values["concept"]!.GetValue<string>()!="harvest-plant")throw new ArgumentException("Declared harvest plant required");string resource=values["resource"]!.GetValue<string>();int yield=values["yield"]!.GetValue<int>();double regrow=values["regrowSeconds"]!.GetValue<double>();if(yield<1||yield>100||!double.IsFinite(regrow)||regrow<0.1||regrow>3600)throw new ArgumentException("Plant yield/regrow constraints invalid");string plant=Guid.NewGuid().ToString("N");AppDomain.CurrentDomain.SetData("Confectory.Harvest."+plant,new object[]{new object(),data["id"]!.GetValue<string>(),resource,yield,regrow,0.0,false});return plant;
