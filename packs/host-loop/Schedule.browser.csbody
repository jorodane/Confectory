string key="Confectory.HostLoop.Job."+token;var state=(object[])(AppContext.GetData(key)??throw new InvalidOperationException("Unknown host job"));var action=(Func<string>)state[0];var completion=(System.Threading.Tasks.TaskCompletionSource<string>)state[1];AppContext.SetData(key,null);try{completion.TrySetResult(action());}catch(Exception error){completion.TrySetException(error);}
