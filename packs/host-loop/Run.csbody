string key="Confectory.HostLoop."+token;var state=(object[])(AppContext.GetData(key)??throw new InvalidOperationException("Unknown host loop"));var step=(Func<bool>)state[0];var dispose=(Action)state[1];ConsoleCancelEventHandler interrupt=(_,e)=>{e.Cancel=true;if(state.Length>2)((Action)state[2])();};Console.CancelKeyPress+=interrupt;try{while(step())System.Threading.Thread.Sleep(2);}finally{Console.CancelKeyPress-=interrupt;try{dispose();}finally{AppContext.SetData(key,null);}}return 0;
