 var candidateNames=savedNames.DeepClone().AsObject();var items=candidateNames["items"]!.AsArray();var previous=System.Linq.Enumerable.SingleOrDefault(items,row=>Text(row!["id"])==id);if(previous is not null)items.Remove(previous);items.Add(new System.Text.Json.Nodes.JsonObject{["id"]=id,["name"]=intent["name"]!.DeepClone(),["rename"]=new System.Text.Json.Nodes.JsonObject{["intent"]=intent.DeepClone(),["digest"]=digest}});ValidateNames(candidateNames,saved);string namesText=candidateNames.ToJsonString();
 var namesPlan=new System.Text.Json.Nodes.JsonObject{["writes"]=new System.Text.Json.Nodes.JsonArray(new System.Text.Json.Nodes.JsonObject{["path"]=namesRelative,["hash"]=namesSnapshot[2],["text"]=namesText}),["checks"]=new System.Text.Json.Nodes.JsonArray(new System.Text.Json.Nodes.JsonObject{["path"]=".confectory/resource-deletions.v1.json",["hash"]=deletionsSnapshot[2]},new System.Text.Json.Nodes.JsonObject{["path"]=System.IO.Path.GetFileName(manifest),["hash"]=manifestSnapshot[2]},new System.Text.Json.Nodes.JsonObject{["path"]=".confectory/project-identity.json",["hash"]=identitySnapshot[2]},new System.Text.Json.Nodes.JsonObject{["path"]=".confectory/resources.v1.json",["hash"]=resourceRevision},new System.Text.Json.Nodes.JsonObject{["path"]=relative,["hash"]=snapshot[2]},new System.Text.Json.Nodes.JsonObject{["path"]=fileNamesRelative,["hash"]=fileNamesSnapshot[2]})};
 if(calls.CommitPlan.Invoke(root,namesPlan.ToJsonString())[0]!="applied")throw new InvalidOperationException("resource_layout_changed");namesSnapshot[2]=Hash(namesText);return Reply(saved,snapshot[2],command,id);
}
var candidate=saved.DeepClone().AsObject();var categoryIds=new System.Collections.Generic.HashSet<string>(System.Linq.Enumerable.Select(candidate["folders"]!.AsArray(),p=>Text(p!["id"])),StringComparer.Ordinal);string? destination=Parent(intent["parent"]);if(destination is not null&&!categoryIds.Contains(destination))throw new InvalidOperationException("resource_folder_missing");
var receipt=new System.Text.Json.Nodes.JsonObject{["intent"]=intent.DeepClone(),["digest"]=digest};string selected;
if(operation=="create-folder"){
 string id=Text(intent["id"]);if(categoryIds.Contains(id)||fileIds.Contains(id))throw new InvalidOperationException("resource_folder_id_in_use");candidate["folders"]!.AsArray().Add(new System.Text.Json.Nodes.JsonObject{["id"]=id,["name"]=intent["name"]!.DeepClone(),["parent"]=destination,["createdAt"]=DateTimeOffset.UtcNow.ToString("O",System.Globalization.CultureInfo.InvariantCulture),["create"]=receipt,["move"]=null});selected=id;
}else{
 var ids=new System.Collections.Generic.HashSet<string>(System.Linq.Enumerable.Select(intent["ids"]!.AsArray(),Text),StringComparer.Ordinal);var all=new System.Collections.Generic.Dictionary<string,System.Text.Json.Nodes.JsonObject>(StringComparer.Ordinal);foreach(var item in candidate["folders"]!.AsArray())all[Text(item!["id"])]=item.AsObject();foreach(var file in files){string id=Text(file!["id"]);var place=System.Linq.Enumerable.SingleOrDefault(candidate["placements"]!.AsArray(),p=>Text(p!["id"])==id)?.AsObject();all[id]=place??new System.Text.Json.Nodes.JsonObject{["id"]=id,["parent"]=null,["move"]=null};}foreach(string id in ids)if(!all.ContainsKey(id))throw new InvalidOperationException("resource_move_missing");
 foreach(string id in ids){string? cursor=destination;while(cursor is not null){if(cursor==id)throw new InvalidOperationException("resource_folder_cycle");cursor=Parent(all[cursor]["parent"]);}}
 var roots=System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Where(ids,id=>Parent(all[id]["parent"])is not string parent||!ids.Contains(parent)));if(roots.Length==0)throw new InvalidOperationException("resource_move_roots");
 foreach(string id in roots){var row=all[id];row["parent"]=destination;row["move"]=receipt.DeepClone();if(fileIds.Contains(id)&&row.Parent is null)candidate["placements"]!.AsArray().Add(row);}selected=roots[0];
}
Validate(candidate);ValidateNames(savedNames,candidate);ValidateFileNames(savedFileNames);string text=candidate.ToJsonString();var plan=new System.Text.Json.Nodes.JsonObject{["writes"]=new System.Text.Json.Nodes.JsonArray(new System.Text.Json.Nodes.JsonObject{["path"]=relative,["hash"]=snapshot[2],["text"]=text}),["checks"]=new System.Text.Json.Nodes.JsonArray(new System.Text.Json.Nodes.JsonObject{["path"]=".confectory/resource-deletions.v1.json",["hash"]=deletionsSnapshot[2]},new System.Text.Json.Nodes.JsonObject{["path"]=System.IO.Path.GetFileName(manifest),["hash"]=manifestSnapshot[2]},new System.Text.Json.Nodes.JsonObject{["path"]=".confectory/project-identity.json",["hash"]=identitySnapshot[2]},new System.Text.Json.Nodes.JsonObject{["path"]=".confectory/resources.v1.json",["hash"]=resourceRevision},new System.Text.Json.Nodes.JsonObject{["path"]=namesRelative,["hash"]=namesSnapshot[2]},new System.Text.Json.Nodes.JsonObject{["path"]=fileNamesRelative,["hash"]=fileNamesSnapshot[2]})};
if(calls.CommitPlan.Invoke(root,plan.ToJsonString())[0]!="applied")throw new InvalidOperationException("resource_layout_changed");return Reply(candidate,Hash(text),command,selected);
