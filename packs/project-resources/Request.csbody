System.Text.Json.Nodes.JsonObject Validate(string raw){
 if(System.Text.Encoding.UTF8.GetByteCount(raw)>storeLimit)throw new InvalidOperationException("resource_storage_budget");
 var saved=System.Text.Json.Nodes.JsonNode.Parse(raw)!.AsObject();Keys(saved,"version","project","manifest","items","receipt");
 if(saved["version"]?.GetValue<int>()!=1||Text(saved["project"])!=project||Text(saved["manifest"])!=manifest||saved["items"]is not System.Text.Json.Nodes.JsonArray items||items.Count>countLimit)throw new UnauthorizedAccessException("resource_storage_identity");
 var ids=new System.Collections.Generic.HashSet<string>(StringComparer.Ordinal);var commands=new System.Collections.Generic.HashSet<string>(StringComparer.Ordinal);long total=0;foreach(var value in items){var row=Item(value,true);if(!ids.Add(Text(row["id"]))||!commands.Add(Text(value!["import"]!["command"])))throw new InvalidOperationException("resource_duplicate_identity");total+=row["size"]!.GetValue<int>();}if(total>totalLimit)throw new InvalidOperationException("resource_total_budget");
 if(saved["receipt"]is not null){var receipt=saved["receipt"]!.AsObject();Keys(receipt,"command","digest","base","id");if(!IsId(Text(receipt["command"]))||!IsHash(Text(receipt["digest"]))||Text(receipt["base"])!="missing"&&!IsHash(Text(receipt["base"]))||!ids.Contains(Text(receipt["id"])))throw new InvalidOperationException("resource_receipt_integrity");var item=System.Linq.Enumerable.Single(items,p=>p!["id"]!.ToString()==Text(receipt["id"]))!;foreach(string field in new[]{"command","digest","base"})if(Text(item["import"]![field])!=Text(receipt[field]))throw new InvalidOperationException("resource_receipt_integrity");}
