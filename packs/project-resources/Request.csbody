string Kind(string name,string type){string ext=name.Substring(name.LastIndexOf('.')+1).ToLowerInvariant();return type.StartsWith("image/",StringComparison.OrdinalIgnoreCase)||Array.IndexOf(new[]{"png","jpg","jpeg","webp","gif","svg","bmp","avif"},ext)>=0?"image":Array.IndexOf(new[]{"glb","gltf","obj","fbx","stl","ply","blend","dae","3ds","usd","usdz"},ext)>=0?"mesh":type.StartsWith("text/",StringComparison.OrdinalIgnoreCase)||Array.IndexOf(new[]{"pdf","txt","md","json","csv","doc","docx","ppt","pptx","xls","xlsx","odt","rtf","yaml","yml"},ext)>=0?"document":"file";}
System.Text.Json.Nodes.JsonObject Item(System.Text.Json.Nodes.JsonNode? value,bool stored){
 var row=value?.AsObject()??throw new ArgumentException("resource_item");
 if(stored)Keys(row,"id","name","type","size","hash","modifiedAt","data","kind","createdAt","import");else Keys(row,"id","name","type","size","hash","modifiedAt","data");
 string id=Text(row["id"]),name=Text(row["name"]),type=Text(row["type"]),hash=Text(row["hash"]),data=Text(row["data"]);
 int size=row["size"]!.GetValue<int>();long modified=row["modifiedAt"]!.GetValue<long>();
 if(!IsId(id)||name.Length is <1 or >180||name!=name.Trim()||string.IsNullOrWhiteSpace(name)||name.IndexOfAny(new[]{'/','\\'})>=0||System.Linq.Enumerable.Any(name,char.IsControl)||type.Length>128||System.Linq.Enumerable.Any(type,char.IsControl)||size is <0 or >fileLimit||modified is <0 or >9007199254740991||!IsHash(hash)||data.Length>1398104)throw new ArgumentException("resource_item_budget");
 byte[] bytes;try{bytes=Convert.FromBase64String(data.Replace('-','+').Replace('_','/'));}catch(FormatException){throw new ArgumentException("resource_bytes");}
 if(bytes.Length!=size||Convert.ToBase64String(bytes).Replace('+','-').Replace('/','_')!=data||Hash(bytes)!=hash)throw new ArgumentException("resource_content_integrity");
 string kind=Kind(name,type);
 if(stored&&(Text(row["kind"])!=kind||!DateTimeOffset.TryParseExact(Text(row["createdAt"]),"O",System.Globalization.CultureInfo.InvariantCulture,System.Globalization.DateTimeStyles.None,out _)))throw new ArgumentException("resource_stored_item");
 var result=new System.Text.Json.Nodes.JsonObject{["id"]=id,["name"]=name,["type"]=type,["size"]=size,["hash"]=hash,["modifiedAt"]=modified,["data"]=data};
 if(stored){var proof=row["import"]!.AsObject();Keys(proof,"command","digest","base");if(!IsId(Text(proof["command"]))||!IsHash(Text(proof["digest"]))||Text(proof["base"])!="missing"&&!IsHash(Text(proof["base"])))throw new InvalidOperationException("resource_import_receipt");var original=new System.Text.Json.Nodes.JsonObject{["revision"]=proof["base"]!.DeepClone(),["command"]=proof["command"]!.DeepClone(),["item"]=result.DeepClone()};if(TextHash(original.ToJsonString())!=Text(proof["digest"]))throw new InvalidOperationException("resource_import_receipt_changed");}
