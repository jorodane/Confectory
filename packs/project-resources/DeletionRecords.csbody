var rows=saved["items"]!.AsArray();if(rows.Count>4096)throw new InvalidOperationException("resource_deletions_budget");var commands=new System.Collections.Generic.HashSet<string>(StringComparer.Ordinal);var imports=new System.Collections.Generic.HashSet<string>(StringComparer.Ordinal);
