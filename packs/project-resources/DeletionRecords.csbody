 var canonical=new System.Text.Json.Nodes.JsonObject{["operation"]=operation,["revision"]=Text(intent["revision"]),["command"]=Text(intent["command"]),["id"]=Text(intent["id"]),["hash"]=Text(intent["hash"])};System.Text.Json.Nodes.JsonObject proof;
