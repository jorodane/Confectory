pack Confectory.Helper version "0.1.0" {
standalone false;
dependency Confectory.Agent version "0.1.0";
dependency Confectory.FileStream version "0.1.0";
element Open function "Open.celem";
element OpenBody implementation "OpenBody.celem";
element Command function "Command.celem";
element CommandBody implementation "CommandBody.celem";
element Recruit function "Recruit.celem";
element RecruitBody implementation "RecruitBody.celem";
element Remember function "Remember.celem";
element RememberBody implementation "RememberBody.celem";
element Inspect function "Inspect.celem";
element InspectBody implementation "InspectBody.celem";
element Profile function "Profile.celem";
element ProfileBody implementation "ProfileBody.celem";
element Close function "Close.celem";
element CloseBody implementation "CloseBody.celem";
element Talk function "Talk.celem";
element TalkBody implementation "TalkBody.celem";
element ProjectContext function "ProjectContext.celem"; element ProjectContextBody implementation "ProjectContextBody.celem";
element RememberScoped function "RememberScoped.celem"; element RememberScopedBody implementation "RememberScopedBody.celem";
element Membership function "Membership.celem"; element MembershipBody implementation "MembershipBody.celem";
element List function "List.celem"; element ListBody implementation "ListBody.celem";
}
