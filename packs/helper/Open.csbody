directory=System.IO.Path.GetFullPath(directory);if(!System.IO.Directory.Exists(directory))throw new ArgumentException("Existing explicit Helper storage directory required");string key=OperatingSystem.IsWindows()?directory.ToUpperInvariant():directory;lock(AppDomain.CurrentDomain){var store=AppDomain.CurrentDomain.GetData("Confectory.Helper.Storage."+key) as object[];if(store is null){string path=System.IO.Path.Combine(directory,"helpers.json");var snapshot=calls.Snapshot.Invoke(path);var document=snapshot[0]=="exists"?System.Text.Json.Nodes.JsonNode.Parse(snapshot[1])!.AsObject():new System.Text.Json.Nodes.JsonObject{["schema"]=1,["helpers"]=new System.Text.Json.Nodes.JsonObject()};if(document["schema"]!.GetValue<int>()!=1)throw new InvalidOperationException("Unsupported Helper storage schema");store=new object[]{new object(),directory,document,snapshot[2],0,key};AppDomain.CurrentDomain.SetData("Confectory.Helper.Storage."+key,store);}store[4]=(int)store[4]+1;string handle=Guid.NewGuid().ToString("N");AppDomain.CurrentDomain.SetData("Confectory.Helper.Owner."+handle,store);return handle;}
