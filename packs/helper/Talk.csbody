if(string.IsNullOrWhiteSpace(conversationID)||conversationID.Length>128||string.IsNullOrWhiteSpace(message)||message.Length>16384)throw new ArgumentException("Explicit bounded Helper conversation/message required");var profile=System.Text.Json.Nodes.JsonNode.Parse(calls.Inspect.Invoke(store,helper,owner))!;string request=new System.Text.Json.Nodes.JsonObject{["kind"]="helper-chat",["helper"]=helper,["message"]=message,["template"]=System.Text.Json.Nodes.JsonNode.Parse(profile["template"]!.GetValue<string>()),["memory"]=profile["memory"]!.DeepClone()}.ToJsonString();return calls.AgentStart.Invoke(agent,"helper:"+helper+":"+conversationID,request);
