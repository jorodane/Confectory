return """
export function connectLocal() {
 if(globalThis.confectoryWebUI?.send)return envelope=>globalThis.confectoryWebUI.send(envelope);
 const key='confectory.webui.session',token=location.hash.slice(1)||sessionStorage.getItem(key)||'';
 if(location.hash){sessionStorage.setItem(key,token);history.replaceState(null,'',location.pathname);}
 return localTransport(token);
}
// Transport is an injected function: no model names, files, globals or engine dispatcher.
export function localTransport(token) {
 return async (envelope,options={}) => {
  const reply=await fetch('/api/request',{method:'POST',signal:options.signal,keepalive:envelope.op==='dispose',headers:{'Content-Type':'application/json','X-Confectory-Session':token},body:JSON.stringify(envelope)});
  if(!reply.ok)throw new Error('transport_rejected');return reply.json();
 };
}
export class WebView {
 constructor(transport,onState){this.transport=transport;this.onState=onState;this.pending=new Map();this.observations=new Set();this.generation=0;this.active=false;this.onPageHide=()=>{void this.dispose().catch(()=>{});};}
 trace(stage,start,detail={}){const rows=globalThis.confectoryWebUITrace;if(Array.isArray(rows)){rows.push({stage,elapsedMs:performance.now()-start,...detail});if(rows.length>512)rows.shift();}}
 check(reply){if(!reply.ok)throw new Error(reply.error?.code||'request_failed');return reply;}
 async mount(){const generation=++this.generation;const reply=this.check(await this.transport({op:'mount'}));if(generation!==this.generation){await this.transport({op:'dispose',view:reply.view});return;}
  this.view=reply.view;this.scope=reply.scope;this.active=true;globalThis.addEventListener?.('pagehide',this.onPageHide,{once:true});this.revision=undefined;this.receive(reply);return reply;
 }
 receive(reply){if(this.revision!==undefined&&reply.revision<this.revision)return;const changed=this.revision!==reply.revision;this.revision=reply.revision;this.state=reply.state;if(changed){const start=performance.now();this.onState?.(reply.state,reply.revision);this.trace('render',start);}}
 update(){if(!this.active)return Promise.resolve();if(this.updating?.generation===this.generation)return this.updating.promise;
  const generation=this.generation,start=performance.now();
  const promise=(async()=>{const reply=this.check(await this.transport({op:'update',view:this.view,scope:this.scope}));if(!this.active||generation!==this.generation||reply.busy)return;
   this.receive(reply);for(const row of reply.results||[]){const pending=this.pending.get(row.requestId);if(pending){this.pending.delete(row.requestId);this.trace('call',pending.start,{endpoint:pending.endpoint,code:row.error?.code||'completed'});row.ok?pending.resolve(row.result):pending.reject(new Error(row.error?.code||'request_failed'));}}
  })().finally(()=>{this.trace('update',start);if(this.updating?.promise===promise)this.updating=null;});this.updating={generation,promise};return promise;
 }
 // Wake the coalesced result read after acknowledgement; the regular poll owns recovery.
 // This sends no second invoke and avoids a polling interval for already completed work.
 call(endpoint,input={}){if(!this.active)return Promise.reject(new Error('view_closed'));const requestId=crypto.randomUUID(),generation=this.generation;
  const promise=new Promise((resolve,reject)=>{this.pending.set(requestId,{resolve,reject,start:performance.now(),endpoint});this.transport({op:'invoke',view:this.view,scope:this.scope,requestId,endpoint,input,expectedRevision:this.revision}).then(reply=>{if(generation!==this.generation)return;if(!reply.ok){this.pending.delete(requestId);reject(new Error(reply.error?.code));}else{void this.update().catch(()=>{});}}).catch(error=>{this.pending.delete(requestId);reject(error);});});
  promise.requestId=requestId;return promise;
 }
 // Explicit bundle-declared read-only observations: no request ID, replay row or retained result.
 observe(endpoint,input={},signal){if(!this.active)return Promise.reject(new Error('view_closed'));if(signal?.aborted)return Promise.reject(new Error('observation_cancelled'));if(this.observations.size>=32)return Promise.reject(new Error('busy'));const generation=this.generation;
  return new Promise((resolve,reject)=>{const row={reject:error=>finish(error)},abort=()=>finish(new Error('observation_cancelled'));let done=false;const finish=(error,value)=>{if(done)return;done=true;this.observations.delete(row);signal?.removeEventListener('abort',abort);error?reject(error):resolve(value);};this.observations.add(row);signal?.addEventListener('abort',abort,{once:true});
   Promise.resolve().then(()=>{if(done)return;return this.transport({op:'observe',view:this.view,scope:this.scope,endpoint,input},{signal});}).then(reply=>{if(done)return;if(!this.active||generation!==this.generation){finish(new Error('view_closed'));return;}try{this.check(reply);finish(null,reply.result);}catch(error){finish(error);}},error=>finish(error));
  });
 }
 async cancel(requestId){return this.check(await this.transport({op:'cancel',view:this.view,scope:this.scope,requestId}));}
 async dispose(){globalThis.removeEventListener?.('pagehide',this.onPageHide);const view=this.view;++this.generation;this.active=false;for(const row of [...this.observations])row.reject(new Error('view_closed'));for(const p of this.pending.values())p.reject(new Error('view_closed'));this.pending.clear();if(view)this.check(await this.transport({op:'dispose',view}));}
}
""";
