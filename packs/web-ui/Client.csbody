return """
export function connectLocal() {
 if(globalThis.confectoryWebUI?.send)return envelope=>globalThis.confectoryWebUI.send(envelope);
 const key='confectory.webui.session',token=location.hash.slice(1)||sessionStorage.getItem(key)||'';
 if(location.hash){sessionStorage.setItem(key,token);history.replaceState(null,'',location.pathname);}
 return localTransport(token);
}
// Transport is an injected function: no model names, files, globals or engine dispatcher.
export function localTransport(token) {
 return async (envelope,options={}) => {
  const reply=await fetch('/api/request',{method:'POST',signal:options.signal,keepalive:envelope.op==='dispose',headers:{'Content-Type':'application/json','X-Confectory-Session':token},body:JSON.stringify(envelope)});
  if(!reply.ok)throw new Error('transport_rejected');return reply.json();
 };
}
export class WebView {
 constructor(transport,onState){this.transport=transport;this.onState=onState;this.pending=new Map();this.completionWaiting=new Map();this.observations=new Set();this.generation=0;this.active=false;this.performanceEnabled=false;this.performanceRows=[];this.performanceTimer=null;this.performanceInput=null;this.performanceSending=false;this.performanceLastUpdate=-Infinity;this.onPageHide=()=>{void this.dispose().catch(()=>{});};}
 trace(stage,start,detail={}){const rows=globalThis.confectoryWebUITrace;if(Array.isArray(rows)){rows.push({stage,elapsedMs:performance.now()-start,...detail});if(rows.length>512)rows.shift();}if(this.performanceEnabled&&['call','render','update'].includes(stage))this.performanceMark('renderer-'+stage,detail.endpoint||'',start);}
 // A diagnostic batch is deliberately independent of revision/command state.
 // Only fixed operation names and numbers reach the host; no DOM text or input.
 performanceMark(stage,operation,start){if(!this.performanceEnabled||!this.active)return;const now=performance.now(),elapsedMs=now-start;if(!Number.isFinite(elapsedMs)||elapsedMs<0||elapsedMs>3600000)return;// Frequent idle polls must not displace click, command, or ready events.
 if(stage==='renderer-update'){if(elapsedMs<20&&now-this.performanceLastUpdate<500)return;this.performanceLastUpdate=now;}
 if(this.performanceRows.length>=32){
  if(stage==='renderer-update')return;
  // A burst of renderer/status rows must not erase the few measurements
  // that tell whether an actual window, restoration or direct save finished.
  const priority=name=>['window-ready','property-save-ready','restore-view','restore-total','restore-layout','workspace-attach','restore-workspace-ready','restore-first-editable','restore-last-editable','restore-commands-ready','browser-open-ready','browser-search-ready'].includes(name)?2:name==='input-delay'||name==='input-frame'?1:0;
  const idle=this.performanceRows.findIndex(row=>row.stage==='renderer-update');let replace=idle;
  if(replace<0){replace=0;for(let i=1;i<this.performanceRows.length;i++)if(priority(this.performanceRows[i].stage)<priority(this.performanceRows[replace].stage))replace=i;if(priority(stage)<priority(this.performanceRows[replace].stage))return;}
  this.performanceRows.splice(replace,1);
 }
 this.performanceRows.push({stage,operation,elapsedMs,pageMs:now});this.schedulePerformance();}
 schedulePerformance(){if(this.performanceTimer===null&&this.performanceEnabled)this.performanceTimer=setTimeout(()=>{this.performanceTimer=null;this.flushPerformance();},500);}
 flushPerformance(){if(!this.performanceEnabled||!this.active||!this.performanceRows.length)return;if(this.performanceSending||this.pending.size||this.updating){this.schedulePerformance();return;}const rows=this.performanceRows.splice(0,32),generation=this.generation;this.performanceSending=true;void this.transport({op:'performance',view:this.view,scope:this.scope,rows}).catch(()=>{}).finally(()=>{if(this.generation===generation){this.performanceSending=false;if(this.performanceRows.length)this.schedulePerformance();}});}
 startPerformanceInput(){if(!this.performanceEnabled||!this.onState||!globalThis.document)return;const generation=this.generation;this.performanceInput=event=>{if(!event.isTrusted||!this.active||generation!==this.generation)return;const op=event.type==='drop'?'object-drop':event.target?.closest?.('[data-enter]')?'project-open':'click',start=performance.now(),stamp=Number(event.timeStamp);if(Number.isFinite(stamp)&&stamp>=0&&stamp<=start)this.performanceMark('input-delay',op,stamp);if(globalThis.requestAnimationFrame)requestAnimationFrame(()=>requestAnimationFrame(()=>{if(this.active&&generation===this.generation)this.performanceMark('input-frame',op,start);}));};document.addEventListener('click',this.performanceInput,true);document.addEventListener('drop',this.performanceInput,true);}
 stopPerformance(){if(this.performanceTimer!==null)clearTimeout(this.performanceTimer);this.performanceTimer=null;this.flushPerformance();if(this.performanceInput&&globalThis.document){document.removeEventListener('click',this.performanceInput,true);document.removeEventListener('drop',this.performanceInput,true);}this.performanceInput=null;this.performanceRows.length=0;this.performanceEnabled=false;if(this.performanceTimer!==null)clearTimeout(this.performanceTimer);this.performanceTimer=null;}
 check(reply){if(!reply.ok)throw new Error(reply.error?.code||'request_failed');return reply;}
 async mount(){const generation=++this.generation;const reply=this.check(await this.transport({op:'mount'}));if(generation!==this.generation){await this.transport({op:'dispose',view:reply.view});return;}
  this.view=reply.view;this.scope=reply.scope;this.receivedResultSelection=reply.receivedResultSelection===true;this.receivedResults=new Set();this.stateReuseFields=Array.isArray(reply.stateReuseFields)?reply.stateReuseFields:[];this.stateFieldHashes={};this.active=true;this.performanceEnabled=reply.performance===true;this.performanceSending=false;this.performanceLastUpdate=-Infinity;this.startPerformanceInput();globalThis.addEventListener?.('pagehide',this.onPageHide,{once:true});this.revision=undefined;this.receive(reply);return reply;
 }
 stateReuseBasis(){const known={},values={};for(const key of this.stateReuseFields||[]){const hash=this.stateFieldHashes?.[key];if(typeof hash==='string'&&this.state?.[key]!=null){known[key]=hash;values[key]=this.state[key];}}return {known,values};}
 receive(reply,basis){if(this.revision!==undefined&&reply.revision<this.revision)return;for(const [key,hash] of Object.entries(reply.reusedStateFields||{})){if(!this.stateReuseFields?.includes(key)||basis?.known[key]!==hash||!Object.hasOwn(basis.values,key)||Object.hasOwn(reply.state,key))throw new Error('state_reference_mismatch');reply.state[key]=basis.values[key];}this.stateFieldHashes=reply.stateFieldHashes||{};for(const key of Object.keys(this.stateFieldHashes)){const stack=[reply.state[key]];while(stack.length){const value=stack.pop();if(!value||typeof value!=='object'||Object.isFrozen(value))continue;for(const child of Object.values(value))if(child&&typeof child==='object')stack.push(child);Object.freeze(value);}}const changed=this.revision!==reply.revision;this.revision=reply.revision;this.state=reply.state;if(changed){const start=performance.now();this.onState?.(reply.state,reply.revision);this.trace('render',start);}}
 // An acknowledged completion carries the same revisioned update. Leave the
 // ordinary idle poll paused only during its bounded transport wait.
 poll(){const now=performance.now();return [...this.completionWaiting.values()].some(deadline=>deadline>now)?Promise.resolve():this.update();}
 update(){if(!this.active)return Promise.resolve();if(this.updating?.generation===this.generation)return this.updating.promise;
  const generation=this.generation,start=performance.now(),basis=this.stateReuseBasis(),receivedIds=this.receivedResultSelection&&this.receivedResults.size<=1024?[...this.receivedResults]:null;
  const promise=(async()=>{const reply=this.check(await this.transport({op:'update',view:this.view,scope:this.scope,...(receivedIds?{receivedRequestIds:receivedIds}:{}),...(Object.keys(basis.known).length?{knownStateFields:basis.known}:{})}));if(!this.active||generation!==this.generation||reply.busy)return;
   this.consumeUpdate(reply,basis);
  })().finally(()=>{this.trace('update',start);if(this.updating?.promise===promise)this.updating=null;});this.updating={generation,promise};return promise;
 }
 consumeUpdate(reply,basis){this.receive(reply,basis);for(const row of reply.results||[]){if(this.receivedResultSelection&&typeof row.requestId==="string")this.receivedResults.add(row.requestId);const pending=this.pending.get(row.requestId);if(pending){this.pending.delete(row.requestId);this.trace('call',pending.start,{endpoint:pending.endpoint,code:row.error?.code||'completed'});row.ok?pending.resolve(row.result):pending.reject(new Error(row.error?.code||'request_failed'));}}}
 // Wake the coalesced result read after acknowledgement; the regular poll owns recovery.
 // This sends no second invoke and avoids a polling interval for already completed work.
 call(endpoint,input={},options={}){if(!this.active)return Promise.reject(new Error('view_closed'));const requestId=crypto.randomUUID(),generation=this.generation,basis=this.stateReuseBasis();
  const promise=new Promise((resolve,reject)=>{this.pending.set(requestId,{resolve,reject,start:performance.now(),endpoint});if(options.completion===true)this.completionWaiting.set(requestId,performance.now()+160);this.transport({op:'invoke',view:this.view,scope:this.scope,requestId,endpoint,input,expectedRevision:this.revision,...(options.completion===true?{completion:true}:{}),...(Object.keys(basis.known).length?{knownStateFields:basis.known}:{})}).then(reply=>{this.completionWaiting.delete(requestId);if(generation!==this.generation)return;if(!reply.ok){this.pending.delete(requestId);reject(new Error(reply.error?.code));}else if(reply.completion){this.consumeUpdate(this.check(reply.completion),basis);if(this.pending.has(requestId))void this.update().catch(()=>{});}else{void this.update().catch(()=>{});}}).catch(error=>{this.completionWaiting.delete(requestId);this.pending.delete(requestId);reject(error);});});
  promise.requestId=requestId;return promise;
 }
 // Explicit bundle-declared read-only observations: no request ID, replay row or retained result.
 observe(endpoint,input={},signal){return this.immediate('observe',endpoint,input,signal);}
 transient(endpoint,input={},signal){return this.immediate('transient',endpoint,input,signal);}
 immediate(op,endpoint,input,signal){if(!this.active)return Promise.reject(new Error('view_closed'));if(signal?.aborted)return Promise.reject(new Error('observation_cancelled'));if(this.observations.size>=32)return Promise.reject(new Error('busy'));const generation=this.generation;
  return new Promise((resolve,reject)=>{const row={reject:error=>finish(error)},abort=()=>finish(new Error('observation_cancelled'));let done=false;const finish=(error,value)=>{if(done)return;done=true;this.observations.delete(row);signal?.removeEventListener('abort',abort);error?reject(error):resolve(value);};this.observations.add(row);signal?.addEventListener('abort',abort,{once:true});
   Promise.resolve().then(()=>{if(done)return;return this.transport({op,view:this.view,scope:this.scope,endpoint,input},{signal});}).then(reply=>{if(done)return;if(!this.active||generation!==this.generation){finish(new Error('view_closed'));return;}try{this.check(reply);finish(null,reply.result);}catch(error){finish(error);}},error=>finish(error));
  });
 }
 async cancel(requestId){return this.check(await this.transport({op:'cancel',view:this.view,scope:this.scope,requestId}));}
 async dispose(){this.stopPerformance();globalThis.removeEventListener?.('pagehide',this.onPageHide);const view=this.view;++this.generation;this.active=false;for(const row of [...this.observations])row.reject(new Error('view_closed'));for(const p of this.pending.values())p.reject(new Error('view_closed'));this.pending.clear();this.completionWaiting.clear();if(view)this.check(await this.transport({op:'dispose',view}));}
}
""";
