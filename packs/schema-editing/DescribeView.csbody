 if(multiple){if(datum is null)return;if(datum["kind"]?.ToString()!="multiple"){row["state"]="invalid";return;}var items=datum["items"]!.AsArray();for(int i=0;i<items.Count;i++){var child=path.DeepClone().AsArray();child.Add(i);Field(name+"["+i+"]",declaration,items[i],child,depth+1,true,parentWritable&&datum["origin"]!.ToString()==source["id"]!.ToString());}return;}
