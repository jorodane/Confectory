var source=System.Text.Json.Nodes.JsonNode.Parse(metadata)!.AsObject();var rows=new System.Text.Json.Nodes.JsonArray();var schemas=source["schemas"]!.AsObject();var functions=source["functions"]!.AsObject();var implementations=source["implementations"]!.AsObject();
