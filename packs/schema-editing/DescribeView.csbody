var data=source["data"]!.AsObject();foreach(var declaration in System.Linq.Enumerable.OrderBy(source["fields"]!.AsObject(),p=>p.Key,StringComparer.Ordinal))Field(declaration.Key,declaration.Value!,data[declaration.Key],new System.Text.Json.Nodes.JsonArray(declaration.Key),0);
return new System.Text.Json.Nodes.JsonObject{["id"]=source["id"]!.DeepClone(),["kind"]=source["kind"]!.DeepClone(),["validation"]=source["validation"]!.DeepClone(),["rows"]=rows,["targets"]=source["targets"]!.DeepClone(),["executionAuthorized"]=false}.ToJsonString();
