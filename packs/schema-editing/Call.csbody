string dotnet=Environment.GetEnvironmentVariable("CONFECTORY_DOTNET")??"dotnet";
var request=System.Text.Json.Nodes.JsonNode.Parse(payload)!.AsObject();request["operation"]=operation;
var start=new System.Diagnostics.ProcessStartInfo(dotnet){UseShellExecute=false,RedirectStandardInput=true,RedirectStandardOutput=true,RedirectStandardError=true};start.ArgumentList.Add(System.IO.Path.GetFullPath(host));
object[] registry;
lock(AppDomain.CurrentDomain)
{
 registry=AppDomain.CurrentDomain.GetData("Confectory.SchemaEditing.Jobs") as object[]??new object[]{new System.Threading.AsyncLocal<string?>(),new System.Collections.Generic.Dictionary<string,System.Collections.Generic.HashSet<System.Diagnostics.Process>>(StringComparer.Ordinal),new System.Collections.Generic.HashSet<string>(StringComparer.Ordinal)};
 AppDomain.CurrentDomain.SetData("Confectory.SchemaEditing.Jobs",registry);
}
string owner=((System.Threading.AsyncLocal<string?>)registry[0]).Value??"unscoped";using var process=new System.Diagnostics.Process{StartInfo=start};
