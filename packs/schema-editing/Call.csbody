int timeout=300000;string? timeoutText=Environment.GetEnvironmentVariable("CONFECTORY_AUTHORING_TIMEOUT_MS");if(timeoutText is not null&&(!int.TryParse(timeoutText,out timeout)||timeout<1000||timeout>900000))throw new ArgumentException("CONFECTORY_AUTHORING_TIMEOUT_MS must be between 1000 and 900000.");
