if(signature.Length>65536)throw new ArgumentException("Signature budget exceeded");
var contract=System.Text.Json.Nodes.JsonNode.Parse(signature)!.AsObject();var parameters=contract["args"]!.AsArray();if(parameters.Count>64)throw new ArgumentException("Parameter budget exceeded");
var inputs=new System.Text.Json.Nodes.JsonArray();var names=new System.Collections.Generic.HashSet<string>(StringComparer.Ordinal);
System.Text.Json.Nodes.JsonObject Type(string type,bool output){bool multiple=type.EndsWith("[]",StringComparison.Ordinal);string item=multiple?type[..^2]:type;if(item is not ("void" or "bool" or "int" or "long" or "float" or "double" or "string")||item=="void"&&(!output||multiple))throw new ArgumentException("Unsupported declared contract type: "+type);return new System.Text.Json.Nodes.JsonObject{["type"]=type,["cardinality"]=multiple?"multiple":item=="void"?"none":"single",["itemType"]=item,["inputKind"]=item=="bool"?"boolean":item=="string"?"text":item=="void"?"none":"number"};}
for(int i=0;i<parameters.Count;i++){var parameter=parameters[i]!;string name=parameter["name"]!.GetValue<string>();if(name.Length==0||!names.Add(name))throw new ArgumentException("Duplicate/empty parameter name");var input=Type(parameter["type"]!.GetValue<string>(),false);input["index"]=i;input["name"]=name;inputs.Add(input);}
return new System.Text.Json.Nodes.JsonObject{["inputs"]=inputs,["return"]=Type(contract["return"]!.GetValue<string>(),true),["executionAuthorized"]=false}.ToJsonString();
