var descriptor=System.Text.Json.Nodes.JsonNode.Parse(calls.DescribeInputs.Invoke(signature))!.AsObject();
var result=new System.Text.Json.Nodes.JsonObject{["status"]="invalid",["executionAuthorized"]=false,["inputs"]=descriptor["inputs"]!.DeepClone(),["return"]=descriptor["return"]!.DeepClone()};
try{
 if(arguments.Length>1048576)throw new ArgumentException("Argument budget exceeded");using var parsed=System.Text.Json.JsonDocument.Parse(arguments);if(parsed.RootElement.ValueKind!=System.Text.Json.JsonValueKind.Array)throw new ArgumentException("Explicit positional argument array required");var values=System.Linq.Enumerable.ToArray(parsed.RootElement.EnumerateArray());var inputs=descriptor["inputs"]!.AsArray();if(values.Length!=inputs.Count)throw new ArgumentException("Argument count does not match the signature");
 bool Atom(string type,System.Text.Json.JsonElement value)=>type switch{"string"=>value.ValueKind==System.Text.Json.JsonValueKind.String,"bool"=>value.ValueKind is System.Text.Json.JsonValueKind.True or System.Text.Json.JsonValueKind.False,"int"=>value.ValueKind==System.Text.Json.JsonValueKind.Number&&value.TryGetInt32(out _),"long"=>value.ValueKind==System.Text.Json.JsonValueKind.Number&&value.TryGetInt64(out _),"float"=>value.ValueKind==System.Text.Json.JsonValueKind.Number&&value.TryGetSingle(out float f)&&float.IsFinite(f),"double"=>value.ValueKind==System.Text.Json.JsonValueKind.Number&&value.TryGetDouble(out double d)&&double.IsFinite(d),_=>false};
 for(int i=0;i<values.Length;i++){var input=inputs[i]!;string item=input["itemType"]!.GetValue<string>();bool valid=input["cardinality"]!.GetValue<string>()=="multiple"?values[i].ValueKind==System.Text.Json.JsonValueKind.Array&&System.Linq.Enumerable.All(values[i].EnumerateArray(),v=>Atom(item,v)):Atom(item,values[i]);if(!valid){result["argumentIndex"]=i;throw new ArgumentException("Argument "+input["name"]!.GetValue<string>()+" does not match "+input["type"]!.GetValue<string>());}}
 result["status"]="valid";result["arguments"]=System.Text.Json.Nodes.JsonNode.Parse(arguments);
}catch(Exception error)when(error is ArgumentException or System.Text.Json.JsonException){result["code"]="CALL_ARGUMENTS";result["message"]=error.Message;}
return result.ToJsonString();
