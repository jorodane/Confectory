foreach(double value in new[]{x,y,targetX,targetY,flightSeconds,fuseSeconds,gravity})if(!double.IsFinite(value))throw new ArgumentException("Finite trajectory parameters required");if(Math.Abs(x)>1000000||Math.Abs(y)>1000000||Math.Abs(targetX)>1000000||Math.Abs(targetY)>1000000||flightSeconds<0.1||flightSeconds>10||fuseSeconds<0.05||fuseSeconds>30||gravity<0||gravity>10000)throw new ArgumentException("Scoped 2D trajectory limits exceeded");double vx=(targetX-x)/flightSeconds,vy=(targetY-y-0.5*gravity*flightSeconds*flightSeconds)/flightSeconds;string projectile=Guid.NewGuid().ToString("N");AppDomain.CurrentDomain.SetData("Confectory.Ballistic2D."+projectile,new object[]{new object(),new double[]{x,y,x,y,x,y,targetX,targetY,vx,vy,flightSeconds,fuseSeconds,gravity,0,0},"flying",false});return projectile;
