if(!double.IsFinite(interpolation)||interpolation<0||interpolation>1)throw new ArgumentException("Display interpolation must be within 0..1 and is separate from fixed-step accumulation");var state=AppDomain.CurrentDomain.GetData("Confectory.Ballistic2D."+projectile) as object[]??throw new ObjectDisposedException("Projectile");lock(state[0]){if((bool)state[3])throw new ObjectDisposedException("Projectile");var data=(double[])state[1];return new System.Text.Json.Nodes.JsonObject{["instance"]=projectile,["phase"]=(string)state[2],["previousX"]=data[2],["previousY"]=data[3],["x"]=data[4],["y"]=data[5],["displayX"]=data[2]+(data[4]-data[2])*interpolation,["displayY"]=data[3]+(data[5]-data[3])*interpolation,["flightAge"]=data[13],["phaseAge"]=data[14],["effectRadius"]=(string)state[2]=="burst"?8+data[14]*80:0}.ToJsonString();}
