var config=System.Text.Json.Nodes.JsonNode.Parse(endpoint)!;if(config["host"]!.GetValue<string>()!="127.0.0.1")throw new ArgumentException("Remote endpoints are not supported by this local provider.");
if(string.IsNullOrWhiteSpace(participant)||participant.Length>64)throw new ArgumentException("Explicit bounded participant required.");
int maxBytes=config["maxBytes"]!.GetValue<int>(),timeout=config["timeoutMs"]!.GetValue<int>(),port=config["port"]!.GetValue<int>();if(maxBytes<256||maxBytes>65536||timeout<100||timeout>60000||port<1||port>65535)throw new ArgumentException("Invalid endpoint bounds.");
string Read(System.IO.Stream stream){byte[] header=new byte[4];stream.ReadExactly(header);int size=System.Buffers.Binary.BinaryPrimitives.ReadInt32BigEndian(header);if(size<=0||size>maxBytes)throw new System.IO.InvalidDataException("Message bound exceeded.");byte[] bytes=new byte[size];stream.ReadExactly(bytes);return new System.Text.UTF8Encoding(false,true).GetString(bytes);}
void Write(System.IO.Stream stream,string text){byte[] bytes=System.Text.Encoding.UTF8.GetBytes(text);if(bytes.Length==0||bytes.Length>maxBytes)throw new System.IO.InvalidDataException("Message bound exceeded.");byte[] header=new byte[4];System.Buffers.Binary.BinaryPrimitives.WriteInt32BigEndian(header,bytes.Length);stream.Write(header);stream.Write(bytes);stream.Flush();}

var socket=new System.Net.Sockets.TcpClient();try{if(!socket.ConnectAsync(System.Net.IPAddress.Loopback,port).Wait(timeout))throw new TimeoutException("Local connect timeout.");socket.ReceiveTimeout=timeout;socket.SendTimeout=timeout;var stream=socket.GetStream();Write(stream,new System.Text.Json.Nodes.JsonObject{["room"]=config["room"]!.GetValue<string>(),["secret"]=config["secret"]!.GetValue<string>(),["participant"]=participant}.ToJsonString());var reply=System.Text.Json.Nodes.JsonNode.Parse(Read(stream))!;if(reply["state"]!.GetValue<string>()!="joined")throw new InvalidOperationException("Room rejected local participant.");string token=Guid.NewGuid().ToString("N");AppDomain.CurrentDomain.SetData("Confectory.MultiPlay.Client."+token,new object[]{socket,stream,new object(),maxBytes});return token;}catch{socket.Dispose();throw;}
