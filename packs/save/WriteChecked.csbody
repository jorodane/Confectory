string path=calls.Location.Invoke(handle);var identity=calls.Identity.Invoke(handle);string saved=calls.Export.Invoke(handle);var baseline=calls.Snapshot.Invoke(path);if(expected!="*"&&baseline[2]!=expected)throw new InvalidOperationException("Checkpoint changed before Save; existing drafts retained");
string Content(string value){var rows=System.Text.Json.Nodes.JsonNode.Parse(value)!["changes"]!.AsArray();var content=new System.Text.Json.Nodes.JsonArray();foreach(var row in System.Linq.Enumerable.OrderBy(rows,x=>x!["id"]!.ToString(),StringComparer.Ordinal))content.Add(new System.Text.Json.Nodes.JsonObject{["id"]=row!["id"]!.DeepClone(),["path"]=row["path"]!.DeepClone(),["baseline"]=row["baseline"]!.DeepClone(),["draft"]=row["draft"]!.DeepClone()});return content.ToJsonString();}
string current=Content(saved);string prior=baseline[0]=="missing"?"[]":Content(baseline[1]);bool edited=current!=prior;
var paths=new System.Collections.Generic.List<string>{System.IO.Path.GetRelativePath(identity[3],path)};var hashes=new System.Collections.Generic.List<string>{baseline[2]};var texts=new System.Collections.Generic.List<string>{saved};
if(edited){var activity=calls.Activity.Invoke(identity[0],"save");paths.Add(activity[0]);hashes.Add(activity[1]);texts.Add(activity[2]);}
var workspace=AppDomain.CurrentDomain.GetData("Confectory.EditWorkspace."+handle) as System.Text.Json.Nodes.JsonObject;
var reads=!System.Linq.Enumerable.Any(workspace!["units"]!.AsObject(),u=>u.Value?["nodeFlowOrigin"] is not null)?new System.Text.Json.Nodes.JsonArray():System.Text.Json.Nodes.JsonNode.Parse(calls.Metadata.Invoke("blueprintOverrideContracts",new System.Text.Json.Nodes.JsonObject{["action"]="verifyGroup",["project"]=identity[0],["units"]=workspace!["units"]!.DeepClone()}.ToJsonString()))!["reads"]!.AsArray();
var writes=new System.Text.Json.Nodes.JsonArray();for(int i=0;i<paths.Count;i++)writes.Add(new System.Text.Json.Nodes.JsonObject{["path"]=paths[i],["hash"]=hashes[i],["text"]=texts[i]});
var result=reads.Count==0?calls.Commit.Invoke(identity[3],paths.ToArray(),hashes.ToArray(),texts.ToArray()):calls.CommitPlan.Invoke(identity[3],new System.Text.Json.Nodes.JsonObject{["writes"]=writes,["checks"]=new System.Text.Json.Nodes.JsonArray(),["reads"]=reads.DeepClone()}.ToJsonString());if(result[0]!="applied")throw new InvalidOperationException("Concurrent Save changed local draft/activity; retry with live draft retained.");var state=AppDomain.CurrentDomain.GetData("Confectory.EditWorkspace."+handle) as System.Text.Json.Nodes.JsonObject;if(state is not null)lock(state)state["checkpointVersion"]=Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(saved))).ToLowerInvariant();return path;
