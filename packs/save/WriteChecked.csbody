string current=Content(saved);string prior=baseline[0]=="missing"?"[]":Content(baseline[1]);bool edited=current!=prior;
var paths=new System.Collections.Generic.List<string>{System.IO.Path.GetRelativePath(identity[3],path)};var hashes=new System.Collections.Generic.List<string>{baseline[2]};var texts=new System.Collections.Generic.List<string>{saved};
if(edited){var activity=calls.Activity.Invoke(identity[0],"save");paths.Add(activity[0]);hashes.Add(activity[1]);texts.Add(activity[2]);}
var workspace=AppDomain.CurrentDomain.GetData("Confectory.EditWorkspace."+handle) as System.Text.Json.Nodes.JsonObject;
var reads=!System.Linq.Enumerable.Any(workspace!["units"]!.AsObject(),u=>u.Value?["nodeFlowOrigin"] is not null||u.Value?["kind"]?.ToString()=="blueprint"&&u.Value?["draft"]?.ToString().Contains("\"executionExitMode\"",StringComparison.Ordinal)==true)?new System.Text.Json.Nodes.JsonArray():System.Text.Json.Nodes.JsonNode.Parse(calls.Metadata.Invoke("blueprintOverrideContracts",new System.Text.Json.Nodes.JsonObject{["action"]="verifyGroup",["project"]=identity[0],["units"]=workspace!["units"]!.DeepClone()}.ToJsonString()))!["reads"]!.AsArray();
var writes=new System.Text.Json.Nodes.JsonArray();for(int i=0;i<paths.Count;i++)writes.Add(new System.Text.Json.Nodes.JsonObject{["path"]=paths[i],["hash"]=hashes[i],["text"]=texts[i]});
// The M12 root/caller group includes unchanged C# and headers. Verify those
// reads under the checkpoint commit lease, never rewriting the originals.
var checks=System.Linq.Enumerable.Any(workspace!["units"]!.AsObject(),u=>(u.Value?["kind"]?.ToString()=="function"&&u.Value?["rootContractGroup"] is not null&&u.Value?["draft"]?.ToString().Contains("blueprintExecutionBranches",StringComparison.Ordinal)==true)||u.Value?["kind"]?.ToString()=="blueprint"&&(u.Value?["authorSaveReceipt"]?["publicWrapper"]?.GetValue<bool>()==true||u.Value?["draft"]?.ToString().Contains("\"originalExecution\"",StringComparison.Ordinal)==true))?System.Text.Json.Nodes.JsonNode.Parse(calls.Metadata.Invoke("blueprintRootExecutionGuards",new System.Text.Json.Nodes.JsonObject{["namespace"]=workspace["namespace"]!.DeepClone(),["units"]=workspace["units"]!.DeepClone()}.ToJsonString()))!["checks"]!.AsArray():new System.Text.Json.Nodes.JsonArray();
