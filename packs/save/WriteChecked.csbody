// Published copy returns retain their observed owner, contract and code reads.
if(System.Linq.Enumerable.Any(workspace["units"]!.AsObject(),u=>u.Value?["kind"]?.ToString()=="blueprint"&&u.Value?["draft"] is System.Text.Json.Nodes.JsonValue sourceText&&System.Text.Json.Nodes.JsonNode.Parse(sourceText.GetValue<string>()) is System.Text.Json.Nodes.JsonObject sourceGraph&&sourceGraph["executionExitMode"]?.GetValue<bool>()==true&&(sourceGraph["copySource"] is not null||u.Value?["baseline"]?.ToString()=="missing"&&sourceGraph["feature"]?.ToString().StartsWith(workspace!["namespace"]!.ToString()+"::",StringComparison.Ordinal)==true)))foreach(var guard in System.Text.Json.Nodes.JsonNode.Parse(calls.Metadata.Invoke("blueprintPublicCopyReturnGuards",new System.Text.Json.Nodes.JsonObject{["namespace"]=workspace["namespace"]!.DeepClone(),["units"]=workspace["units"]!.DeepClone()}.ToJsonString()))!["checks"]!.AsArray())checks.Add(guard!.DeepClone());
if(System.Linq.Enumerable.Any(workspace["units"]!.AsObject(),u=>u.Value?["publicBodyOrigin"] is not null))foreach(var guard in System.Text.Json.Nodes.JsonNode.Parse(calls.Metadata.Invoke("blueprintOverrideContracts",new System.Text.Json.Nodes.JsonObject{["action"]="validateGroup",["units"]=workspace["units"]!.DeepClone()}.ToJsonString()))!["checks"]!.AsArray())if(!System.Linq.Enumerable.Any(checks,c=>c!["path"]!.ToString()==guard!["path"]!.ToString()))checks.Add(guard!.DeepClone());
var checkPaths=new System.Collections.Generic.HashSet<string>(System.Linq.Enumerable.Select(checks,c=>System.IO.Path.GetFullPath(System.IO.Path.Combine(identity[3],c!["path"]!.ToString()))),OperatingSystem.IsWindows()?StringComparer.OrdinalIgnoreCase:StringComparer.Ordinal);for(int i=reads.Count-1;i>=0;i--)if(checkPaths.Contains(reads[i]!["path"]!.ToString()))reads.RemoveAt(i);
var result=reads.Count==0&&checks.Count==0?calls.Commit.Invoke(identity[3],paths.ToArray(),hashes.ToArray(),texts.ToArray()):calls.CommitPlan.Invoke(identity[3],new System.Text.Json.Nodes.JsonObject{["writes"]=writes,["checks"]=checks.DeepClone(),["reads"]=reads.DeepClone()}.ToJsonString());if(result[0]!="applied")throw new InvalidOperationException("Concurrent Save changed local draft/activity; retry with live draft retained.");var state=AppDomain.CurrentDomain.GetData("Confectory.EditWorkspace."+handle) as System.Text.Json.Nodes.JsonObject;if(state is not null)lock(state)state["checkpointVersion"]=Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(saved))).ToLowerInvariant();return path;
