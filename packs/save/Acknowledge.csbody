string path=calls.Location.Invoke(handle);var snapshot=calls.Snapshot.Invoke(path);if(snapshot[0]=="missing")return;
var saved=System.Text.Json.Nodes.JsonNode.Parse(snapshot[1])!.AsObject();var changes=saved["changes"]!.AsArray();bool changed=false;
// Root Save checkpoints include unchanged function/implementation support rows.
// Confirm commits only actual changes. Retire a fully clean, byte-identical
// saved group together; never leave its support rows pointing at a removed graph.
// If any member has changed, preserve the COMPLETE saved group for explicit review.
var grouped=new System.Collections.Generic.HashSet<string>(StringComparer.Ordinal);
var settled=new System.Collections.Generic.HashSet<string>(StringComparer.Ordinal);
var closedExecutionGroups=new System.Collections.Generic.List<System.Text.Json.Nodes.JsonArray>();
foreach(var unit in changes){
 string groupField=unit?["retirementGroup"] is System.Text.Json.Nodes.JsonArray?"retirementGroup":unit?["hierarchyGroup"] is System.Text.Json.Nodes.JsonArray?"hierarchyGroup":unit?["atomicEditGroup"] is System.Text.Json.Nodes.JsonArray?"atomicEditGroup":"rootContractGroup";if(unit?[groupField] is not System.Text.Json.Nodes.JsonArray group)continue;
 var members=System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Select(group,id=>id!.GetValue<string>()));foreach(string id in members)grouped.Add(id);
 if((groupField=="retirementGroup"?members.Length is <2 or >33:groupField=="hierarchyGroup"?members.Length is <2 or >32:groupField=="atomicEditGroup"?members.Length is <1 or >64:members.Length is <3 or >64)||System.Linq.Enumerable.Count(System.Linq.Enumerable.Distinct(members,StringComparer.Ordinal))!=members.Length||!System.Linq.Enumerable.Any(members,id=>Array.IndexOf(selected,id)>=0))continue;
 bool complete=true;foreach(string id in members){
  var row=System.Linq.Enumerable.SingleOrDefault(changes,item=>item!["id"]!.ToString()==id);
  if(row is null||!System.Text.Json.Nodes.JsonNode.DeepEquals(row[groupField],group)){complete=false;break;}
  var current=calls.Read.Invoke(handle,id);
  if(current[6]!="clean"||current[3]!=row["draft"]!.GetValue<string>()||current[1]!=row["kind"]!.ToString()||current[2]!=row["path"]!.ToString()){complete=false;break;}
 }
 // The shared validator distinguishes public execution groups from legacy
 // whole-body groups. Member count alone cannot identify their semantics.
 if(complete&&groupField=="rootContractGroup"){try{calls.RootGroup.Invoke(handle,members[0]);}catch{complete=false;}}
 if(complete){
  if(groupField=="rootContractGroup"&&members.Length>=3){var root=calls.Read.Invoke(handle,members[2]);if(root[1]=="blueprint"){var graph=System.Text.Json.Nodes.JsonNode.Parse(root[3]);if(graph?["schema"]?.GetValue<int>()==2&&graph["executionExitMode"]?.GetValue<bool>()==true&&graph["feature"]?.ToString()==members[0])closedExecutionGroups.Add(group.DeepClone().AsArray());}}
  foreach(string id in members)settled.Add(id);
 }
}
for(int i=changes.Count-1;i>=0;i--)
{
 var unit=changes[i]!;string id=unit["id"]!.GetValue<string>();if(grouped.Contains(id)?!settled.Contains(id):Array.IndexOf(selected,id)<0)continue;
 var current=calls.Read.Invoke(handle,id);if(current[6]=="clean"&&current[3]==unit["draft"]!.GetValue<string>()){changes.RemoveAt(i);changed=true;}
}
var workspaceState=AppDomain.CurrentDomain.GetData("Confectory.EditWorkspace."+handle) as System.Text.Json.Nodes.JsonObject;if(saved["retirements"] is System.Text.Json.Nodes.JsonObject archivedRows&&workspaceState is not null)lock(workspaceState){foreach(var operation in System.Linq.Enumerable.ToArray(archivedRows)){if(Array.IndexOf(selected,operation.Value!["manifest"]!.ToString())<0)continue;var actual=workspaceState["retirements"]?[operation.Key];if(actual is null)archivedRows.Remove(operation.Key);else archivedRows[operation.Key]=actual.DeepClone();changed=true;}}
if(!changed)return;var identity=calls.Identity.Invoke(handle);var result=calls.Commit.Invoke(identity[3],new[]{System.IO.Path.GetRelativePath(identity[3],path)},new[]{snapshot[2]},new[]{saved.ToJsonString()});if(result[0]!="applied")throw new InvalidOperationException("Concurrent saved-draft change; final source already confirmed, saved bookkeeping needs review.");

string confirmedSaved=saved.ToJsonString();var state=AppDomain.CurrentDomain.GetData("Confectory.EditWorkspace."+handle) as System.Text.Json.Nodes.JsonObject;if(state is not null)lock(state){
 string confirmedHash=Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(confirmedSaved))).ToLowerInvariant();if(state["checkpointVersion"]?.ToString()==snapshot[2])state["checkpointVersion"]=confirmedHash;
 // Once the durable checkpoint and every public execution member are settled,
 // retire that transaction's live metadata too. Otherwise a later copy is
 // mistaken for an unreviewed public-contract provider in the same session.
 if(state["checkpointVersion"]?.ToString()==confirmedHash)foreach(var group in closedExecutionGroups){
  if(!System.Linq.Enumerable.All(group,m=>settled.Contains(m!.ToString())&&state["units"]?[m.ToString()] is System.Text.Json.Nodes.JsonObject unit&&System.Text.Json.Nodes.JsonNode.DeepEquals(unit["rootContractGroup"],group)&&unit["baseline"]?.ToString()!="missing"&&unit["draft"]?.ToString()==unit["original"]?.ToString()))continue;
  foreach(var member in group){var unit=state["units"]![member!.ToString()]!.AsObject();unit.Remove("rootContractGroup");unit.Remove("rootAbiContracts");}
 }
}
