var identity=calls.Identity.Invoke(handle);string hash=Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(System.Text.Json.JsonSerializer.Serialize(new[]{identity[0],identity[1],identity[2]})))).ToLowerInvariant();return System.IO.Path.Combine(identity[3],".confectory","edit-workspaces",hash,"draft.json");
