bool readOnly=action.StartsWith("status-",StringComparison.Ordinal);if(readOnly)action=action[7..];
if(action is not ("apply" or "recover" or "cancel")||!System.Text.RegularExpressions.Regex.IsMatch(token,"\\A[a-f0-9]{64}\\z"))throw new ArgumentException("Exact archive action/token required");
var live=AppDomain.CurrentDomain.GetData("Confectory.EditWorkspace."+handle) as System.Text.Json.Nodes.JsonObject??throw new ObjectDisposedException("EditWorkspace");
lock(live){
 var evidence=action=="apply"?live["browserRemovalPlan"]:live["retirements"]?[token];var archived=live["retirements"]?[token];string outcomeKey=token+":"+action;var outcome=live["retirementOutcomes"]?[outcomeKey];bool information=evidence?["version"]?.GetValue<int>()==2||archived?["version"]?.GetValue<int>()==2||outcome is not null;
 if(!information&&readOnly)return "{\"settled\":false,\"unapplied\":false}";
 if(!information)return calls.Retirement.Invoke(handle,action,new System.Text.Json.Nodes.JsonObject{["token"]=token}.ToJsonString());
 string checkpoint=action=="apply"&&evidence is not null?evidence["checkpointHash"]!.ToString():live["checkpointVersion"]?.ToString()??"missing";
 if(calls.Snapshot.Invoke(calls.Location.Invoke(handle))[2]!=checkpoint||(live["checkpointVersion"]?.ToString()??"missing")!=checkpoint)throw new InvalidOperationException("Information archive checkpoint changed; retain all input");
