 if(outcome is not null){var check=MetadataRequest("settled");check["outcome"]=outcome.DeepClone();if(System.Text.Json.Nodes.JsonNode.Parse(calls.Metadata.Invoke("informationFunctionRetirement",check.ToJsonString()))!["settled"]?.GetValue<bool>()==true){var settled=outcome["result"]!.DeepClone();settled["checkpointSaved"]=true;settled["settled"]=true;return settled.ToJsonString();}if(!readOnly&&evidence is null&&archived is null)throw new InvalidOperationException("Archive result has newer input; preserve it and inspect the current sources");}
 if(action=="apply"&&archived is not null){if(archived["state"]?.ToString() is not ("pending" or "confirmed"))throw new InvalidOperationException("Information recovery is in progress");var check=MetadataRequest("validate");check["receipt"]=archived.DeepClone();calls.Metadata.Invoke("informationFunctionRetirement",check.ToJsonString());return new System.Text.Json.Nodes.JsonObject{["state"]="staged",["owner"]=archived["owner"]!.DeepClone(),["manifest"]=archived["manifest"]!.DeepClone(),["ids"]=archived["ids"]!.DeepClone(),["checkpointSaved"]=true,["settled"]=true,["physicalSourceRemoved"]=false,["sourceConfirmed"]=false}.ToJsonString();}
 if(readOnly){bool unchanged=false;if(outcome is null&&evidence?["version"]?.GetValue<int>()==2&&evidence["token"]?.ToString()==token){var check=MetadataRequest("unapplied");check["transition"]=action;check["evidence"]=evidence.DeepClone();unchanged=System.Text.Json.Nodes.JsonNode.Parse(calls.Metadata.Invoke("informationFunctionRetirement",check.ToJsonString()))!["unapplied"]!.GetValue<bool>();}return new System.Text.Json.Nodes.JsonObject{["settled"]=false,["unapplied"]=unchanged}.ToJsonString();}
 if(evidence?["version"]?.GetValue<int>()!=2)throw new InvalidOperationException("Read the current information archive first");
 var beforeUnits=live["units"]!.DeepClone();var beforeArchives=live["retirements"]?.DeepClone();var beforeOutcomes=live["retirementOutcomes"]?.DeepClone();var candidate=live.DeepClone().AsObject();string temporary="information-retirement-"+Guid.NewGuid().ToString("N"),temporaryKey="Confectory.EditWorkspace."+temporary;AppDomain.CurrentDomain.SetData(temporaryKey,candidate);
 try{
  var result=System.Text.Json.Nodes.JsonNode.Parse(calls.Retirement.Invoke(temporary,action,new System.Text.Json.Nodes.JsonObject{["token"]=token}.ToJsonString()))!;result["checkpointSaved"]=true;
  var proof=new System.Text.Json.Nodes.JsonObject();var absent=new System.Text.Json.Nodes.JsonArray();var members=new System.Collections.Generic.HashSet<string>(System.Linq.Enumerable.Select(result["ids"]!.AsArray(),v=>v!.ToString()),StringComparer.Ordinal){result["owner"]!.ToString(),result["manifest"]!.ToString()};
  foreach(string member in System.Linq.Enumerable.Order(members,StringComparer.Ordinal)){var unit=candidate["units"]?[member];if(unit is null){absent.Add(member);continue;}string text=unit["draft"]!.ToString();proof[member]=new System.Text.Json.Nodes.JsonObject{["path"]=unit["path"]!.DeepClone(),["kind"]=unit["kind"]!.DeepClone(),["hash"]=Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(text))).ToLowerInvariant()};}
  var outcomes=candidate["retirementOutcomes"]?.DeepClone().AsObject()??new System.Text.Json.Nodes.JsonObject();while(outcomes.Count>=96)outcomes.Remove(System.Linq.Enumerable.First(outcomes).Key);outcomes[outcomeKey]=new System.Text.Json.Nodes.JsonObject{["version"]=1,["token"]=token,["action"]=action,["workspace"]=evidence["workspace"]!.DeepClone(),["phase"]=candidate["retirements"]?[token]?["state"]?.DeepClone()??System.Text.Json.Nodes.JsonValue.Create(""),["result"]=result.DeepClone(),["sources"]=proof,["absent"]=absent};if(System.Text.Encoding.UTF8.GetByteCount(outcomes.ToJsonString())>2097152)throw new ArgumentException("Archive outcome budget");candidate["retirementOutcomes"]=outcomes;
