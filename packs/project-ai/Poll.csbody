var state=AppDomain.CurrentDomain.GetData("Confectory.ProjectAI."+session) as object[]??throw new ObjectDisposedException("Project AI");lock(state[0]){if((bool)state[8])throw new ObjectDisposedException("Project AI closing");var model=(System.Text.Json.Nodes.JsonObject)state[7];if(((string)state[6]).Length>0){var update=System.Text.Json.Nodes.JsonNode.Parse(calls.AgentPoll.Invoke((string)state[6]))!;foreach(var item in update["events"]!.AsArray())if(item!["kind"]?.ToString()=="delta"){string text=model["output"]!.ToString()+item["text"]!.ToString();if(text.Length>65536)throw new InvalidOperationException("Project output budget");model["output"]=text;}model["state"]=update["state"]!.DeepClone();model["cleanupError"]=update["cleanupError"]?.DeepClone();}if(state[10] is object[] features){model["augment"]=System.Text.Json.Nodes.JsonNode.Parse(calls.AugmentSnapshot.Invoke((string)features[1]));var workers=new System.Text.Json.Nodes.JsonObject();foreach(var item in (System.Collections.Generic.Dictionary<string,string>)state[12]){calls.Pump.Invoke((string)features[0],item.Key);workers[item.Key]=System.Text.Json.Nodes.JsonNode.Parse(calls.InspectTask.Invoke((string)features[0],item.Key));}model["workers"]=workers;if(model["proposalState"]?.ToString()=="running"||System.Linq.Enumerable.Any(workers,w=>w.Value?["status"]?.ToString() is "running" or "dispatching"))model["state"]="running";else if(((string)state[6]).Length==0)model["state"]="idle";}model["tools"]=System.Text.Json.Nodes.JsonNode.Parse(calls.ToolsSnapshot.Invoke((string)state[4]));return model.ToJsonString();}
