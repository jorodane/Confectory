var state=AppDomain.CurrentDomain.GetData("Confectory.ProjectAI."+session) as object[]??throw new ObjectDisposedException("Project AI");lock(state[0]){if((bool)state[8])throw new ObjectDisposedException("Project AI closing");var model=(System.Text.Json.Nodes.JsonObject)state[7];if(((string)state[6]).Length>0){var update=System.Text.Json.Nodes.JsonNode.Parse(calls.AgentPoll.Invoke((string)state[6]))!;foreach(var item in update["events"]!.AsArray())if(item!["kind"]?.ToString()=="delta"){string text=model["output"]!.ToString()+item["text"]!.ToString();if(text.Length>65536)throw new InvalidOperationException("Project output budget");model["output"]=text;}model["state"]=update["state"]!.DeepClone();model["errorCode"]=update["errorCode"]?.DeepClone();model["cleanupError"]=update["cleanupError"]?.DeepClone();}if(state[10] is object[] features){model["augment"]=System.Text.Json.Nodes.JsonNode.Parse(calls.AugmentSnapshot.Invoke((string)features[1]));if(model["proposalState"] is null&&System.Linq.Enumerable.LastOrDefault(model["augment"]!["batches"]!.AsArray()) is System.Text.Json.Nodes.JsonNode latest&&latest["state"]?.ToString()=="failed"){model["proposalErrorCode"]=latest["errorCode"]?.DeepClone()??System.Text.Json.Nodes.JsonValue.Create("provider-error");model["proposalState"]=model["proposalErrorCode"]!.ToString()=="provider-cancelled"?"cancelled":"error";}var workers=new System.Text.Json.Nodes.JsonObject();foreach(var task in System.Text.Json.Nodes.JsonNode.Parse(calls.ListTasks.Invoke((string)features[0]))!.AsArray()){string id=task!.ToString();if(((System.Collections.Generic.Dictionary<string,string>)state[12]).ContainsKey(id))calls.Pump.Invoke((string)features[0],id);workers[id]=System.Text.Json.Nodes.JsonNode.Parse(calls.InspectTask.Invoke((string)features[0],id));}model["workers"]=workers;if(model["proposalState"]?.ToString()=="running"||System.Linq.Enumerable.Any(workers,w=>w.Value?["status"]?.ToString() is "running" or "dispatching"))model["state"]="running";else