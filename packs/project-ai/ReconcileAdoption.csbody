var state=AppDomain.CurrentDomain.GetData("Confectory.ProjectAI."+session) as object[]??throw new ObjectDisposedException("Project AI");lock(state[0]){if((bool)state[8])throw new ObjectDisposedException("Project AI closing");var status=System.Text.Json.Nodes.JsonNode.Parse(calls.AdoptionStatus.Invoke(session,task))!;if(status["canReconcile"]?.GetValue<bool>()!=true||status["receipt"]?.ToString()!=receipt||status["fingerprint"]?.ToString()!=fingerprint)throw new InvalidOperationException("Adoption evidence changed or cannot be resolved; preserve and inspect it");var features=(object[])state[10];string filename=Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(task))).ToLowerInvariant()+".json",directory=System.IO.Path.Combine((string)features[5],"adoption-records");var saved=calls.FileSnapshot.Invoke(System.IO.Path.Combine(directory,filename));if(saved[2]!=status["ledgerHash"]?.ToString())throw new InvalidOperationException("Adoption record changed after evidence observation");var ledger=System.Text.Json.Nodes.JsonNode.Parse(saved[1])!;var record=ledger["records"]!.AsArray()[^1]!.AsObject();if(status["completedProof"]?.GetValue<bool>()!=true&&status["sourceState"]?.ToString()=="matches-original"){record["state"]="not-applied-reviewed";record["reconciliation"]="User acknowledged originals currently present; interrupted call outcome remains unknown. No source application performed.";}else{if(status["completedProof"]?.GetValue<bool>()!=true){calls.Validate.Invoke((string)state[9],record["target"]!.ToString());var checkedAgain=System.Text.Json.Nodes.JsonNode.Parse(calls.AdoptionStatus.Invoke(session,task))!;if(checkedAgain["fingerprint"]?.ToString()!=fingerprint)throw new InvalidOperationException("Evidence changed during compiler validation");record["confirmed"]=true;record["compilerStatus"]="confirmed-by-current-source-review";}record["state"]="confirmed";record["reconciliation"]="User explicitly accepted durable review