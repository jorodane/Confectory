var state=AppDomain.CurrentDomain.GetData("Confectory.ProjectAI."+session) as object[]??throw new ObjectDisposedException("Project AI");lock(state[0]){if((bool)state[8])throw new ObjectDisposedException("Project AI closing");var features=state[10] as object[]??throw new InvalidOperationException("Task owner required");var grant=System.Text.Json.Nodes.JsonNode.Parse(authorization)!;var config=System.Text.Json.Nodes.JsonNode.Parse((string)state[3])!;if(grant["projectId"]?.ToString()!=(string)state[1]||grant["contentApproved"]?.GetValue<bool>()!=true||grant["usageApproved"]?.GetValue<bool>()!=true||grant["model"]?.ToString()!=config["model"]?.ToString()||grant["endpoint"]?.ToString()!=config["endpoint"]?.ToString())throw new UnauthorizedAccessException("Explicit exact Worker content and usage approval required");var worker=System.Text.Json.Nodes.JsonNode.Parse(calls.InspectTask.Invoke((string)features[0],task))!;var caps=(System.Collections.Generic.Dictionary<string,string>)state[19];if(!caps.TryGetValue(task,out string? tools)){if(worker["status"]?.ToString()!="ready")throw new InvalidOperationException("Prior execution outcome retained; no replay");tools=calls.ToolsOpen.Invoke((string)state[9],(string)state[1],((System.Text.Json.Nodes.JsonObject)state[7])["namespace"]!.ToString(),"local-user","editor");try{calls.BindOrigin.Invoke(tools,task,worker["worker"]!.ToString(),commandID);caps.Add(task,tools);}catch{calls.ToolsClose.Invoke(tools);throw;}}var agents=(System.Collections.Generic.Dictionary<string,string>)state[12];if(!agents.TryGetValue(task,out string? agent)){agent=calls.AgentOpen.Invoke((string)state[3]);agents.Add(task,agent);}var lease=System.Text.Json.Nodes.JsonNode.Parse(calls.Lease.Invoke((string)features[0],(string)features[4]))!;string request=new System.Text.Json.Nodes.JsonObject{["context"]=System.Text.Json.Nodes.JsonNode.Parse((string)state[2]),["authorization"]=grant,["toolCapability"]=tools,["message"]="Implement only the selected ordinary task using scoped draft tools. No Confirm or task completion authority."}.ToJsonString();return calls.WorkerStart.Invoke((string)features[0],(string)features[4],lease["epoch"]!.GetValue<long>(),commandID,task,agent,request);}
