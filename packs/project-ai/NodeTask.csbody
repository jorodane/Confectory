if(operation is not ("inspect" or "assign" or "work" or "cancel")||payload.Length>16384)throw new ArgumentException("Explicit bounded node Task operation required");
var state=AppDomain.CurrentDomain.GetData("Confectory.ProjectAI."+session) as object[]??throw new ObjectDisposedException("Project AI");
lock(state[0]){
 if((bool)state[8])throw new ObjectDisposedException("Project AI closing");
 var features=state[10] as object[]??throw new InvalidOperationException("Explicit project task owner required");
 var input=System.Text.Json.Nodes.JsonNode.Parse(payload)!.AsObject();var model=(System.Text.Json.Nodes.JsonObject)state[7];
 string Hash(string text)=>Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(text))).ToLowerInvariant();
 string Field(string name,int budget){string value=input[name]!.GetValue<string>();if(string.IsNullOrWhiteSpace(value)||value.Length>budget)throw new ArgumentException("Bounded explicit "+name+" required");return value;}
 string Open(string node)=>calls.OpenNode.Invoke((string)state[9],(string)state[1],model["namespace"]!.ToString(),"local-user","editor",node);
 System.Text.Json.Nodes.JsonObject Plan(string capability,string node){
  var scope=System.Text.Json.Nodes.JsonNode.Parse(calls.ToolsSnapshot.Invoke(capability))!["nodeScope"]??throw new InvalidOperationException("Node-only capability required");
  var source=calls.Read.Invoke((string)features[3],node);if(source[1]!="blueprint-node")throw new ArgumentException("Owned node source required");if(scope["sourceHash"]?.ToString()!=Hash(source[3]))throw new InvalidOperationException("Node source changed during inspection; inspect again");
  var assignment=new System.Text.Json.Nodes.JsonObject{["schema"]=1,["id"]=node,["definitionHash"]=scope["definitionHash"]!.DeepClone(),["sourceHash"]=Hash(source[3])};
  var plan=new System.Text.Json.Nodes.JsonObject{["assignment"]=assignment,["assignmentHash"]=Hash(assignment.ToJsonString()),["sourceRevision"]=source[4],["definition"]=scope["definition"]!.DeepClone(),["imports"]=scope["imports"]!.DeepClone(),["supportingSources"]=new System.Text.Json.Nodes.JsonArray(System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Select(System.Linq.Enumerable.OrderBy(System.Linq.Enumerable.Where(scope["observations"]!.AsObject(),entry=>entry.Key.StartsWith(model["namespace"]!.ToString()+"::",StringComparison.Ordinal)),entry=>entry.Key,StringComparer.Ordinal),entry=>(System.Text.Json.Nodes.JsonNode?)System.Text.Json.Nodes.JsonValue.Create(entry.Key)))),["state"]="inspected"};
  if(plan.ToJsonString().Length>24576)throw new InvalidOperationException("Node Task definition exceeds the explicit planning budget");return plan;
 }
 if(operation is "inspect" or "assign"){
  string node=Field("node",1024),capability=Open(node);
  try{
   var plan=Plan(capability,node);if(operation=="inspect")return plan.ToJsonString();
   if(Field("assignmentHash",64)!=plan["assignmentHash"]!.ToString())throw new InvalidOperationException("Node definition or source changed; inspect the current assignment");
   string command=Field("commandID",128),reason=Field("rationale",4096),task="node-"+Hash((string)state[1]+"\n"+command)[..24];
   var specification=new System.Text.Json.Nodes.JsonObject{["kind"]="blueprint-node",["goal"]=plan["definition"]!["intent"]!.DeepClone(),["stage"]="node implementation",["completion"]="Implement only the assigned node; compiler-backed source Review/Confirm and explicit user goal acceptance remain required.",["rationale"]=reason,["blueprintNode"]=plan};
   string worker=calls.Assign.Invoke((string)features[0],(string)features[4],0,command,(string)features[4],task,specification.ToJsonString());
   return new System.Text.Json.Nodes.JsonObject{["task"]=task,["worker"]=worker,["state"]="ready",["assignmentHash"]=plan["assignmentHash"]!.DeepClone()}.ToJsonString();
  }finally{calls.ToolsClose.Invoke(capability);}
 }
 string taskId=Field("task",128),commandId=Field("commandID",128);var workerState=System.Text.Json.Nodes.JsonNode.Parse(calls.Inspect.Invoke((string)features[0],taskId))!;
 var retained=workerState["specification"]?["blueprintNode"]??throw new ArgumentException("Explicit node Task required");
 if(workerState["project"]?.ToString()!=(string)state[1]||workerState["specification"]?["kind"]?.ToString()!="blueprint-node")throw new UnauthorizedAccessException("Assigned project node Task required");
 if(operation=="cancel"){
  var controller=calls.Lease.Invoke((string)features[0],(string)features[4]);long epoch=System.Text.Json.Nodes.JsonNode.Parse(controller)!["epoch"]!.GetValue<long>();
  calls.CancelReady.Invoke((string)features[0],(string)features[4],epoch,commandId,taskId);return calls.Inspect.Invoke((string)features[0],taskId);
 }
 if(model["providerBound"]?.GetValue<bool>()==false)throw new InvalidOperationException("Local planning owner has no model execution authority; prepare a configured owner and fresh explicit approval");
 if(workerState["status"]?.ToString()!="ready")throw new InvalidOperationException("Prior node execution outcome retained; no replay");
 var grant=input["authorization"]??throw new UnauthorizedAccessException("Exact node content and usage approval required");var config=System.Text.Json.Nodes.JsonNode.Parse((string)state[3])!;
 if(grant["projectId"]?.ToString()!=(string)state[1]||grant["task"]?.ToString()!=taskId||grant["assignmentHash"]?.ToString()!=retained["assignmentHash"]?.ToString()||grant["contentApproved"]?.GetValue<bool>()!=true||grant["usageApproved"]?.GetValue<bool>()!=true||grant["model"]?.ToString()!=config["model"]?.ToString()||grant["endpoint"]?.ToString()!=config["endpoint"]?.ToString())throw new UnauthorizedAccessException("Exact node Task, assignment, model, content and usage approval required");
 string assignedNode=retained["assignment"]!["id"]!.ToString(),tools=Open(assignedNode);bool transferred=false;
 try{
  var current=Plan(tools,assignedNode);if(current["assignmentHash"]?.ToString()!=retained["assignmentHash"]?.ToString())throw new InvalidOperationException("Assigned node definition or source changed; prepare a fresh node Task");
  var caps=(System.Collections.Generic.Dictionary<string,string>)state[19];
  if(caps.TryGetValue(taskId,out string? old)){
   var oldScope=System.Text.Json.Nodes.JsonNode.Parse(calls.ToolsSnapshot.Invoke(old))!["nodeScope"];
   if(oldScope?["id"]?.ToString()!=assignedNode||oldScope?["definitionHash"]?.ToString()!=retained["assignment"]?["definitionHash"]?.ToString())throw new UnauthorizedAccessException("Existing task capability is outside the assigned node");
   calls.ToolsClose.Invoke(old);caps.Remove(taskId);
  }
  calls.BindOrigin.Invoke(tools,taskId,workerState["worker"]!.ToString(),commandId);caps.Add(taskId,tools);transferred=true;
  var agents=(System.Collections.Generic.Dictionary<string,string>)state[12];if(!agents.TryGetValue(taskId,out string? agent)){agent=calls.AgentOpen.Invoke((string)state[3]);agents.Add(taskId,agent);}
  var lease=System.Text.Json.Nodes.JsonNode.Parse(calls.Lease.Invoke((string)features[0],(string)features[4]))!;
  string request=new System.Text.Json.Nodes.JsonObject{["authorization"]=grant.DeepClone(),["toolCapability"]=tools,["nodeAssignment"]=retained["assignment"]!.DeepClone(),["assignmentHash"]=retained["assignmentHash"]!.DeepClone(),["message"]="Implement only this assigned Blueprint node through its four scoped draft tools. Read its current text first. Graph, other nodes, declarations, derived C#, source Confirm, execution and task completion are outside this capability."}.ToJsonString();
  return calls.WorkerStart.Invoke((string)features[0],(string)features[4],lease["epoch"]!.GetValue<long>(),commandId,taskId,agent,request);
 }finally{if(!transferred)calls.ToolsClose.Invoke(tools);}
}
