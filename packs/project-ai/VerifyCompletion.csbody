try{var proof=System.Text.Json.Nodes.JsonNode.Parse(evidence)!;var receipt=AppDomain.CurrentDomain.GetData("Confectory.ProjectAI.Receipt."+proof["receipt"]!.ToString()) as System.Text.Json.Nodes.JsonObject;if(receipt is null||receipt["confirmed"]?.GetValue<bool>()!=true||string.IsNullOrWhiteSpace(receipt["goalEvidence"]?.ToString())||receipt["specification"]?.ToString()!=specification||receipt["progress"]?.ToString()!=progress||receipt["projectId"]?.ToString()!=proof["projectId"]?.ToString()||receipt["task"]?.ToString()!=proof["task"]?.ToString())return false;foreach(var file in receipt["files"]!.AsArray()){var current=calls.FileSnapshot.Invoke(file!["path"]!.ToString());if(current[0]!="exists"||current[2]!=file["sha256"]!.ToString())return false;}return true;}catch{return false;}
