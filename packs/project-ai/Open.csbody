if(config.Length>16384)throw new ArgumentException("Project AI configuration budget");var configuration=System.Text.Json.Nodes.JsonNode.Parse(config)!.AsObject();if(configuration["provider"]?.ToString() is not ("responses" or "codex")||string.IsNullOrWhiteSpace(configuration["model"]?.GetValue<string>()))throw new ArgumentException("Selected provider and model required");string token=calls.OpenLocal.Invoke(project,projectId,namespaceId,helperContext);var state=(object[])AppDomain.CurrentDomain.GetData("Confectory.ProjectAI."+token)!;lock(state[0]){state[3]=config;var snapshot=(System.Text.Json.Nodes.JsonObject)state[7];snapshot["provider"]=configuration["provider"]!.DeepClone();snapshot["model"]=configuration["model"]!.DeepClone();snapshot["providerBound"]=true;snapshot["planningOnly"]=false;}return token;
