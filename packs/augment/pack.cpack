pack Confectory.Augment version "0.1.0" {
standalone false;
dependency Confectory.WorkerTasks version "0.1.0";
dependency Confectory.EditWorkspace version "0.1.0";
dependency Confectory.SchemaEditing version "0.1.0";
dependency Confectory.FileStream version "0.1.0";
dependency Confectory.ChangeSet version "0.1.0";
dependency Confectory.YogiBox version "0.1.0";
element Provider function "Provider.celem";
element ProviderBody implementation "ProviderBody.celem";
element Open function "Open.celem";
element OpenBody implementation "OpenBody.celem";
element Command function "Command.celem";
element CommandBody implementation "CommandBody.celem";
element Reroll function "Reroll.celem";
element RerollBody implementation "RerollBody.celem";
element Custom function "Custom.celem";
element CustomBody implementation "CustomBody.celem";
element Skip function "Skip.celem";
element SkipBody implementation "SkipBody.celem";
element Select function "Select.celem";
element SelectBody implementation "SelectBody.celem";
element CancelSelection function "CancelSelection.celem";
element CancelSelectionBody implementation "CancelSelectionBody.celem";
element Stage function "Stage.celem";
element StageBody implementation "StageBody.celem";
element Review function "Review.celem";
element ReviewBody implementation "ReviewBody.celem";
element Confirm function "Confirm.celem";
element ConfirmBody implementation "ConfirmBody.celem";
element Exactly function "Exactly.celem";
element ExactlyBody implementation "ExactlyBody.celem";
element Snapshot function "Snapshot.celem";
element SnapshotBody implementation "SnapshotBody.celem";
element Close function "Close.celem";
element CloseBody implementation "CloseBody.celem";
element BindProvider function "BindProvider.celem"; element BindProviderBody implementation "BindProviderBody.celem";
}
