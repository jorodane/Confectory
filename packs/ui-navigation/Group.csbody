
if(state.Length>65536||eligible.Length>256)throw new ArgumentException("Navigation state budget");var result=System.Text.Json.Nodes.JsonNode.Parse(state)!.AsObject();var config=result["config"]!;var target=System.Linq.Enumerable.SingleOrDefault(config["groups"]!.AsArray(),x=>x!["id"]!.GetValue<string>()==group)??throw new ArgumentException("Unknown configured focus group");var remembered=result["groupFocus"] as System.Text.Json.Nodes.JsonObject??new System.Text.Json.Nodes.JsonObject();string previous=result["active"]!.GetValue<string>();remembered[previous]=previous==group?currentFocus:result["focus"]!.GetValue<int>();int wanted=remembered[group]?.GetValue<int>()??0;var available=new System.Collections.Generic.HashSet<int>(eligible);var order=System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Select(target["controls"]!.AsArray(),x=>x!.GetValue<int>()));int chosen=Array.IndexOf(order,currentFocus)>=0&&available.Contains(currentFocus)?currentFocus:Array.IndexOf(order,wanted)>=0&&available.Contains(wanted)?wanted:0;if(chosen==0)foreach(int id in order)if(available.Contains(id)){chosen=id;break;}result["groupFocus"]=remembered;result["active"]=group;result["focus"]=chosen;result["heldKey"]=0;result["heldControl"]=0;result["heldText"]=false;result["activate"]=0;result["action"]="group";return result.ToJsonString();

