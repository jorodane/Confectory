foreach(var group in groups){string id=group!["id"]!.GetValue<string>();if(string.IsNullOrWhiteSpace(id)||id.Length>64||!ids.Add(id))throw new ArgumentException("Unique bounded group ID");var controls=group["controls"]!.AsArray();if(controls.Count>256)throw new ArgumentException("Control budget");var seen=new System.Collections.Generic.HashSet<int>();foreach(var control in controls){int c=control!.GetValue<int>();if(c<1||!seen.Add(c))throw new ArgumentException("Unique positive controls");}}
