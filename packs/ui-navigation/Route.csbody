
if(state.Length>65536||eligible.Length>256||eventID<0)throw new ArgumentException("Navigation input budget");var result=System.Text.Json.Nodes.JsonNode.Parse(state)!.AsObject();long last=result["lastEvent"]!.GetValue<long>();if(eventID==last){result["activate"]=0;result["action"]="";return result.ToJsonString();}if(eventID<last)throw new ArgumentException("Event identity must increase within this View");result["lastEvent"]=eventID;result["consumed"]=false;result["focus"]=currentFocus;result["activate"]=0;result["action"]="";
var config=result["config"]!;string active=result["active"]!.GetValue<string>();var available=new System.Collections.Generic.HashSet<int>(eligible);int[] Controls(string group)=>System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Select(System.Linq.Enumerable.Single(config["groups"]!.AsArray(),x=>x!["id"]!.GetValue<string>()==group)!["controls"]!.AsArray(),x=>x!.GetValue<int>()));int Fallback(string group,int wanted){var order=Controls(group);if(available.Contains(wanted)&&Array.IndexOf(order,wanted)>=0)return wanted;foreach(int control in order)if(available.Contains(control))return control;return 0;}
void ClearHeld(){result["heldKey"]=0;result["heldControl"]=0;result["heldText"]=false;}
var consumedKeys=result["consumedKeys"]!.AsArray();int reservedIndex=-1;for(int n=0;n<consumedKeys.Count;n++)if(consumedKeys[n]!.GetValue<int>()==key)reservedIndex=n;
if(type==9){ClearHeld();consumedKeys.Clear();return result.ToJsonString();}
if(type==6&&result["heldKey"]!.GetValue<int>()==key){if(reservedIndex>=0)consumedKeys.RemoveAt(reservedIndex);int held=result["heldControl"]!.GetValue<int>();bool textAllowed=result["heldText"]!.GetValue<bool>();ClearHeld();result["consumed"]=true;if((!textEditing||textAllowed)&&held==currentFocus&&Fallback(active,held)==held)result["activate"]=held;return result.ToJsonString();}
if(type==6){if(reservedIndex>=0){consumedKeys.RemoveAt(reservedIndex);result["consumed"]=true;}return result.ToJsonString();}if(type!=5)return result.ToJsonString();
var candidates=System.Linq.Enumerable.Where(config["bindings"]!.AsArray(),b=>b!["key"]!.GetValue<int>()==key&&(flags&14)==(b["modifiers"]?.GetValue<int>()??0)&&(b["group"]!.GetValue<string>()=="*"||b["group"]!.GetValue<string>()==active)&&(!textEditing||b["text"]!.GetValue<bool>()));var binding=System.Linq.Enumerable.FirstOrDefault(System.Linq.Enumerable.ThenBy(System.Linq.Enumerable.OrderByDescending(candidates,b=>b!["priority"]!.GetValue<int>()),b=>b!["id"]!.GetValue<string>(),StringComparer.Ordinal));if(binding is null)return result.ToJsonString();result["consumed"]=true;if(reservedIndex<0)consumedKeys.Add(key);if((flags&1)!=0)return result.ToJsonString();string action=binding["action"]!.GetValue<string>();result["action"]=action;
if(action=="toggle"){ClearHeld();string target=binding["target"]!.GetValue<string>();if(active==target){string restore=result["savedGroup"]!.GetValue<string>();if(restore=="")restore=config["initial"]!.GetValue<string>();result["active"]=restore;result["focus"]=Fallback(restore,result["savedFocus"]!.GetValue<int>());result["savedGroup"]="";}else{result["savedGroup"]=active;result["savedFocus"]=currentFocus;result["active"]=target;result["focus"]=Fallback(target,0);}}
else if(action=="next"||action=="previous"){ClearHeld();var controls=System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Where(Controls(active),available.Contains));int index=Array.IndexOf(controls,currentFocus);if(controls.Length==0)result["focus"]=0;else result["focus"]=controls[index<0?(action=="next"?0:controls.Length-1):(index+(action=="next"?1:controls.Length-1))%controls.Length];}
else if(action=="activate"&&result["heldKey"]!.GetValue<int>()==0&&Fallback(active,currentFocus)==currentFocus&&currentFocus!=0){result["heldKey"]=key;result["heldControl"]=currentFocus;result["heldText"]=binding["text"]!.GetValue<bool>();}
return result.ToJsonString();

