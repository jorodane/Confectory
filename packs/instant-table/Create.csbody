if(ids.Length<1||ids.Length>64||columns.Length<1||columns.Length>16||request.Length>2048)throw new ArgumentException("Bounded table definition required");
if(System.Linq.Enumerable.Any(ids,id=>id.Length>512)||System.Linq.Enumerable.Any(columns,column=>column.Length<1||column.Length>1024))throw new ArgumentException("Bounded table identities required");
foreach(string column in columns){
 if(column.StartsWith("value:",StringComparison.Ordinal)){if(System.Text.Json.Nodes.JsonNode.Parse(column[6..]) is not System.Text.Json.Nodes.JsonValue name||!name.TryGetValue<string>(out string? decoded)||string.IsNullOrEmpty(decoded))throw new ArgumentException("Explicit metadata name required");continue;}
 if(!column.StartsWith("data:",StringComparison.Ordinal))continue;
 var path=System.Text.Json.Nodes.JsonNode.Parse(column[5..])?.AsArray()??throw new ArgumentException("Explicit data path required");if(path.Count<1||path.Count>64||path[0] is not System.Text.Json.Nodes.JsonValue first||!first.TryGetValue<string>(out _))throw new ArgumentException("Root field path required");
 foreach(var segment in path)if(segment is not System.Text.Json.Nodes.JsonValue item||(!item.TryGetValue<string>(out _)&&(!item.TryGetValue<int>(out int n)||n<0)))throw new ArgumentException("Data path strings or nonnegative indexes required");}
var unique=new System.Collections.Generic.HashSet<string>(ids,StringComparer.Ordinal);var fields=new System.Collections.Generic.HashSet<string>(columns,StringComparer.Ordinal);if(unique.Count!=ids.Length||fields.Count!=columns.Length)throw new ArgumentException("Duplicate row or column");var tokens=new System.Collections.Generic.List<string[]>();try{foreach(string id in ids){var snapshot=calls.Read.Invoke(workspace,id);if(snapshot[1]!="object")throw new ArgumentException("Instant table rows select existing object elements");calls.Inspect.Invoke(snapshot[3]);tokens.Add(calls.Subscribe.Invoke(workspace,id));}string handle=Guid.NewGuid().ToString("N");AppDomain.CurrentDomain.SetData("Confectory.InstantTable."+handle,new object[]{new object(),workspace,(string[])ids.Clone(),(string[])columns.Clone(),request,tokens,false});return handle;}catch{foreach(var token in tokens)calls.Unsubscribe.Invoke(token);throw;}
