if(ids.Length<1||ids.Length>64||columns.Length<1||columns.Length>16||request.Length>2048)throw new ArgumentException("Bounded table definition required");var unique=new System.Collections.Generic.HashSet<string>(ids,StringComparer.Ordinal);var fields=new System.Collections.Generic.HashSet<string>(columns,StringComparer.Ordinal);if(unique.Count!=ids.Length||fields.Count!=columns.Length)throw new ArgumentException("Duplicate row or column");var tokens=new System.Collections.Generic.List<string[]>();try{foreach(string id in ids){var snapshot=calls.Read.Invoke(workspace,id);if(snapshot[1]!="object")throw new ArgumentException("Instant table rows select existing object elements");calls.Inspect.Invoke(snapshot[3]);tokens.Add(calls.Subscribe.Invoke(workspace,id));}string handle=Guid.NewGuid().ToString("N");AppDomain.CurrentDomain.SetData("Confectory.InstantTable."+handle,new object[]{new object(),workspace,(string[])ids.Clone(),(string[])columns.Clone(),request,tokens,false});return handle;}catch{foreach(var token in tokens)calls.Unsubscribe.Invoke(token);throw;}
