 var union=Discover(new[]{"App::Many"});Check(union["fields"]!.AsArray().Count==16&&Render(union)["text"]!.ToString().Contains("LIMIT: fieldsLimited"),"field union limits retained");var next=Discover(new[]{"App::Many"},page:1);Check(next["fieldPage"]!.GetValue<int>()==1,"native field page");
