 value["queryInput"]="unapplied input";var saved=View("save",new(){["revision"]=loaded["revision"]!.DeepClone(),["value"]=value.DeepClone()});Check(System.Text.Json.Nodes.JsonNode.DeepEquals(View("load",new())["value"],value),"explicit settings cold");Check(View("load",new(),"another-project")["value"]!["ids"]!.AsArray().Count==0,"project separation");string path=System.Linq.Enumerable.Single(System.IO.Directory.GetFiles(System.IO.Path.Combine(storage,"native-field-unions")));string bytes=System.IO.File.ReadAllText(path);Check(value.Count==8&&!bytes.Contains("result")&&!bytes.Contains("revision")&&!bytes.Contains(context),"only settings persisted");
 System.IO.File.WriteAllText(path,bytes+"\n");Refused(()=>View("save",new(){["revision"]=saved["revision"]!.DeepClone(),["value"]=value.DeepClone()}),"stale private CAS");Check(System.IO.File.ReadAllText(path)==bytes+"\n","private stale bytes retained");System.IO.File.WriteAllText(path,"{broken");bool corrupt=false;try{View("load",new());}catch(System.Text.Json.JsonException){corrupt=true;}Check(corrupt&&System.IO.File.ReadAllText(path)=="{broken","corrupt settings preserved");System.IO.File.WriteAllText(path,bytes);
 if(!OperatingSystem.IsWindows()){string outside=System.IO.Path.Combine(storage,"outside.json");System.IO.File.WriteAllText(outside,bytes);System.IO.File.Delete(path);System.IO.File.CreateSymbolicLink(path,outside);Refused(()=>View("load",new()),"linked read");Refused(()=>View("save",new(){["revision"]=saved["revision"]!.DeepClone(),["value"]=value.DeepClone()}),"linked save");Check(System.IO.File.ReadAllText(outside)==bytes,"linked referent unchanged");System.IO.File.Delete(path);System.IO.File.WriteAllText(path,bytes);}
 foreach(string key in new[]{"rowOffset","fieldPage","projectId","ids"}){var bad=value.DeepClone().AsObject();bad[key]=key=="rowOffset"?System.Text.Json.Nodes.JsonValue.Create(64):key=="fieldPage"?System.Text.Json.Nodes.JsonValue.Create(32):key=="projectId"?System.Text.Json.Nodes.JsonValue.Create("other-project"):System.Text.Json.JsonSerializer.SerializeToNode(System.Linq.Enumerable.Repeat("App::One",65));Refused(()=>View("save",new(){["revision"]=saved["revision"]!.DeepClone(),["value"]=bad}),"state bound "+key);}
