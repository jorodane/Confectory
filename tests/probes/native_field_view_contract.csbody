 var large=next.DeepClone();large["fields"]![0]!["variants"]![0]=new string('x',500000);var displayLimit=Render(large);Check(displayLimit["nativeDisplayLimited"]!.GetValue<bool>()&&displayLimit["text"]!.ToString().Length<=524288&&displayLimit["text"]!.ToString().Contains("defined=true"),"bounded metadata display retains cell presence states");
