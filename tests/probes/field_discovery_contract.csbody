void Check(bool ok,string message){if(!ok)throw new Exception(message);}
System.Text.Json.Nodes.JsonNode Parse(string text)=>System.Text.Json.Nodes.JsonNode.Parse(text)!;
string session=calls.Create.Invoke(repo,storage);try{
 var opened=Parse(calls.Command.Invoke(session,"open",System.Text.Json.JsonSerializer.Serialize(new{path=project})));string context=opened["selected"]!["context"]!.ToString(),projectId=opened["selected"]!["projectId"]!.ToString();
 var originals=System.Linq.Enumerable.ToDictionary(System.IO.Directory.GetFiles(System.IO.Path.GetDirectoryName(project)!,"*.celem",System.IO.SearchOption.AllDirectories),p=>p,p=>System.IO.File.ReadAllBytes(p));string untouched=calls.Snapshot.Invoke(session);
 System.Text.Json.Nodes.JsonObject Args(string[] ids,string query="",int offset=0,int page=0)=>new(){["action"]="union",["projectId"]=projectId,["request"]=Guid.NewGuid().ToString("N"),["ids"]=System.Text.Json.JsonSerializer.SerializeToNode(ids),["query"]=query,["rowOffset"]=offset,["fieldPage"]=page};
 System.Text.Json.Nodes.JsonNode Read(System.Text.Json.Nodes.JsonObject input,string cancel="")=>Parse(calls.Discover.Invoke(session,context,input.ToJsonString(),cancel));
 void Refused(Action action,string label){try{action();}catch(ArgumentException){return;}catch(InvalidOperationException){return;}throw new Exception("Accepted "+label);}
 System.Text.Json.Nodes.JsonNode Row(System.Text.Json.Nodes.JsonNode result,string id)=>System.Linq.Enumerable.Single(result["rows"]!.AsArray(),r=>r!["id"]!.ToString()==id)!;
 System.Text.Json.Nodes.JsonNode Cell(System.Text.Json.Nodes.JsonNode result,string id,string field)=>Row(result,id)["cells"]![field]!;
 var targets=new[]{"App::One","App::Two","App::Bare","App::Broken"};var first=Read(Args(targets));Check(first["status"]!.ToString()=="partial"&&first["failedRows"]!.GetValue<int>()==1,"partial read isolated: "+first.ToJsonString());string amount="data:[\"amount\"]",zero="data:[\"zero\"]",unset="data:[\"unsetText\"]";
 Check(Cell(first,"App::One",amount)["valueJson"]!.ToString()=="9223372036854775807","exact Int64");Check(Cell(first,"App::Two",amount)["valueJson"]!.ToString()=="\"variant\"","actual string");Check(Cell(first,"App::Bare",amount)["state"]!.ToString()=="missing"&&!Cell(first,"App::Bare",amount).AsObject().ContainsKey("valueJson"),"missing is not null");Check(Cell(first,"App::One",unset)["state"]!.ToString()=="unset"&&!Cell(first,"App::One",unset).AsObject().ContainsKey("valueJson"),"unset not invented default");Check(Cell(first,"App::One",zero)["valueJson"]!.ToString()=="0","real zero");Check(Cell(first,"App::One","nullish")["hasValue"]!.GetValue<bool>()&&Cell(first,"App::One","nullish")["valueJson"]!.ToString()=="null","actual JSON null");Check(Cell(first,"App::Two","nullish")["valueJson"]!.ToString()=="0","metadata zero");Check(Cell(first,"App::One","falsey")["valueJson"]!.ToString()=="false"&&Cell(first,"App::One","empty")["valueJson"]!.ToString()=="\"\"","false and empty string");Check(Cell(first,"App::Bare","description")["state"]!.ToString()=="default"&&Cell(first,"App::Bare","description")["valueJson"]!.ToString()=="\"\"","description API fallback labeled");Check(Cell(first,"App::Broken",amount)["state"]!.ToString()=="row-unavailable"&&Cell(first,"App::Broken",amount)["defined"] is null,"failed does not mean missing");
 Check(System.Linq.Enumerable.Single(first["fields"]!.AsArray(),f=>f!["id"]!.ToString()==amount)!["variants"]!.AsArray().Count==2,"different declared types retained");foreach(var row in first["rows"]!.AsArray())foreach(var cell in row!["cells"]!.AsObject())Check(!cell.Value!["writable"]!.GetValue<bool>(),"all discovered fields read-only");Check(calls.Snapshot.Invoke(session)==untouched,"discovery does not publish model/table state");
 var options=Read(new(){["action"]="objects",["projectId"]=projectId,["request"]="options",["page"]=0});Check(System.Linq.Enumerable.All(options["objects"]!.AsArray(),o=>o!["id"]!.ToString().StartsWith("App::",StringComparison.Ordinal)),"owned object choices");
 Refused(()=>Read(Args(new[]{"App::One","Api::Value"})),"external scope");Refused(()=>Read(Args(new[]{"App::Stats"})),"schema is not row");Refused(()=>Read(Args(new[]{"App::One","App::One"})),"duplicate IDs");Refused(()=>Read(Args(new string[0])),"empty selection");Refused(()=>Read(Args(System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Repeat("App::One",65)))),"row ceiling");Refused(()=>Read(Args(new[]{"App::One"},new string('x',257))),"query ceiling");Refused(()=>Read(Args(new[]{"App::One"},page:32)),"field page ceiling");var foreign=Args(new[]{"App::One"});foreign["projectId"]="other";Refused(()=>Read(foreign),"project ID");Refused(()=>calls.Discover.Invoke(session,"other",Args(new[]{"App::One"}).ToJsonString(),""),"context");
 var limited=Read(Args(new[]{"App::Many","App::Tail"},"field1049"));Check(limited["rowFieldsLimited"]!.GetValue<bool>()&&Cell(limited,"App::Many","field1049")["state"]!.ToString()=="unobserved-limit"&&Cell(limited,"App::Many","field1049")["defined"] is null,"unobserved limited field not missing");var union=Read(Args(new[]{"App::Many"}));Check(union["fieldsLimited"]!.GetValue<bool>()&&union["boundedFieldCount"]!.GetValue<int>()==512&&union["fields"]!.AsArray().Count==16,"union/page cap");var narrowed=Read(Args(new[]{"App::Many"},"field0900"));Check(narrowed["fields"]!.AsArray().Count==1&&Cell(narrowed,"App::Many","field0900")["valueJson"]!.ToString()=="900","filter before union cap");var huge=Read(Args(new[]{"App::Huge"},"blob"));Check(huge["valuesLimited"]!.GetValue<bool>()&&System.Linq.Enumerable.Any(Row(huge,"App::Huge")["cells"]!.AsObject(),c=>c.Value!["state"]!.ToString()=="value-limit"&&!c.Value.AsObject().ContainsKey("valueJson")),"value byte ceiling explicit");Check(System.Text.Encoding.UTF8.GetByteCount(huge.ToJsonString())<=1048576,"response ceiling");
 if(System.IO.File.Exists(probe))System.IO.File.Delete(probe);string token=Guid.NewGuid().ToString("N");AppDomain.CurrentDomain.SetData("Confectory.WebUI.Cancel."+token,(Func<bool>)(()=>System.IO.File.Exists(probe)));bool cancelled=false;try{Read(Args(targets),token);}catch(OperationCanceledException){cancelled=true;}finally{AppDomain.CurrentDomain.SetData("Confectory.WebUI.Cancel."+token,null);}Check(cancelled&&calls.Snapshot.Invoke(session)==untouched,"cooperative cancellation no publication");
 string originalSchema=System.IO.File.ReadAllText(schema);System.IO.File.WriteAllText(drift,"once");bool changed=false;try{Read(Args(new[]{"App::One","App::Two"}));}catch(InvalidOperationException){changed=true;}finally{System.IO.File.WriteAllText(schema,originalSchema);}Check(changed,"mid-read schema drift rejects mixed snapshot");
 foreach(var file in originals)Check(System.Linq.Enumerable.SequenceEqual(file.Value,System.IO.File.ReadAllBytes(file.Key)),"confirmed source preserved "+file.Key);
 Console.WriteLine("PASS owned field discovery: exact JSON/missing/null/default, partial rows, type union, scope/bounds/cancel/drift, no table or write authority");
}finally{calls.Close.Invoke(session);}return 0;
