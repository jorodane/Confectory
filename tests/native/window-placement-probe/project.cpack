project Example.PlacementProbe version "0.1.0" {
entry Example.PlacementProbe::Main;
registry Confectory.WindowPlacement "../../../packs/window-placement/pack.cpack"; dependency Confectory.WindowPlacement version "0.1.0";
registry Confectory.RenderInput "../../../packs/render-input/pack.cpack"; dependency Confectory.RenderInput version "0.1.0";
registry Confectory.Window "../../../packs/window/pack.cpack"; dependency Confectory.Window version "0.1.0";
registry Confectory.Build.DotNet "../../../targets/dotnet/pack.cpack"; dependency Confectory.Build.DotNet version "0.1.0";
target linux Confectory.Build.DotNet::Linux;
element Main function "main.celem"; element MainBody implementation "main_body.celem";
}
