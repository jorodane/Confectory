// Independent public geometry consumer: no editor, UIOrder internals or native handles.
string state=calls.Create.Invoke();void Apply(string op,object value)=>state=calls.Update.Invoke(state,op,System.Text.Json.JsonSerializer.Serialize(value));
System.Text.Json.Nodes.JsonNode Items()=>System.Text.Json.Nodes.JsonNode.Parse(state)!["items"]!;
int[] Bounds(System.Text.Json.Nodes.JsonNode row)=>System.Text.Json.JsonSerializer.Deserialize<int[]>(row["bounds"]!.ToJsonString())!;
Apply("viewport",new{bounds=new[]{0,0,800,600}});
foreach(var item in new[]{new{key="reference",bounds=new[]{200,0,200,160}},new{key="pane",bounds=new[]{500,200,200,100}},new{key="free",bounds=new[]{650,400,100,80}}})Apply("open",new{item.key,item.bounds,handle=new[]{8,4,item.bounds[2]-16,32},minimum=new[]{48,24}});
Apply("move",new{key="reference",bounds=new[]{200,0,200,160}});
var surfaces=calls.Surfaces.Invoke(new[]{"Confectory - Placement probe"},800,600);string drag="";int ox=0,oy=0;bool stop=false;var limit=System.Diagnostics.Stopwatch.StartNew();
try{while(!stop&&limit.Elapsed.TotalSeconds<30){var events=calls.Pump.Invoke(surfaces);for(int n=0;n<events.Length;n+=6){int kind=events[n+1],x=events[n+2],y=events[n+3];if(kind==8){stop=true;break;}if(kind==7){var size=calls.Dimensions.Invoke(surfaces,0);if(size[0]>0&&size[1]>0)Apply("viewport",new{bounds=new[]{0,0,size[0],size[1]}});drag="";}else if(kind==1){foreach(string key in new[]{"free","pane","reference"}){int[] b=Bounds(Items()[key]!);if(x>=b[0]&&x<b[0]+b[2]&&y>=b[1]&&y<b[1]+32){drag=key;ox=x-b[0];oy=y-b[1];break;}}}else if(kind==3&&drag.Length>0){int[] b=Bounds(Items()[drag]!);Apply("move",new{key=drag,bounds=new[]{x-ox,y-oy,b[2],b[3]}});}else if(kind is 2 or 9 or 11)drag="";}
var boxes=new System.Collections.Generic.List<int>();void Box(int[] b,int color)=>boxes.AddRange(new[]{b[0],b[1],b[2],b[3],color});
foreach(string key in new[]{"reference","pane","free"}){var row=Items()[key]!;int[] b=Bounds(row);Box(b,key=="reference"?0x555555:0x29475B);if(drag==key&&row["contact"] is System.Text.Json.Nodes.JsonNode contact){int[] edges=System.Text.Json.JsonSerializer.Deserialize<int[]>(contact["edges"]!.ToJsonString())!;var bars=new[]{new[]{b[0],b[1],5,b[3]},new[]{b[0],b[1],b[2],5},new[]{b[0]+b[2]-5,b[1],5,b[3]},new[]{b[0],b[1]+b[3]-5,b[2],5}};for(int edge=0;edge<4;edge++)if(edges[edge]==1)Box(bars[edge],0x3388FF);}}
calls.Draw.Invoke(surfaces,0,boxes.ToArray(),System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Repeat("",boxes.Count/5)));Console.WriteLine("PLACEMENT_UI "+System.Text.Json.JsonSerializer.Serialize(new{state,drag}));System.Threading.Thread.Sleep(10);
}if(!stop)throw new Exception("Placement GUI probe timed out");}finally{calls.Close.Invoke(surfaces,-1);}Console.WriteLine("Placement GUI cleanup PASS");return 0;
