void Check(bool value,string message){if(!value)throw new Exception(message);}string scope=System.IO.Path.Combine(System.IO.Path.GetTempPath(),"entry-"+Guid.NewGuid().ToString("N"));Environment.SetEnvironmentVariable("CONFECTORY_ENTRY_STORAGE",scope+"-inboxes");
string canonical=System.IO.Path.GetFullPath(scope);if(OperatingSystem.IsWindows())canonical=canonical.ToUpperInvariant();string key=Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(canonical+"\n"+Environment.UserName))),token=calls.Request.Invoke(scope,"listen","{}");
async System.Threading.Tasks.Task<string> Send(string id,string path){using var pipe=new System.IO.Pipes.NamedPipeClientStream(".","Confectory.Entry."+key,System.IO.Pipes.PipeDirection.InOut,System.IO.Pipes.PipeOptions.Asynchronous|System.IO.Pipes.PipeOptions.CurrentUserOnly);await pipe.ConnectAsync(2000);using var timeout=new System.Threading.CancellationTokenSource(5000);var bytes=System.Text.Encoding.UTF8.GetBytes(System.Text.Json.JsonSerializer.Serialize(new{version=1,id,path}));var header=new byte[4];System.Buffers.Binary.BinaryPrimitives.WriteInt32LittleEndian(header,bytes.Length);await pipe.WriteAsync(header,timeout.Token);await pipe.WriteAsync(bytes,timeout.Token);await pipe.FlushAsync(timeout.Token);await pipe.ReadExactlyAsync(header,timeout.Token);int n=System.Buffers.Binary.BinaryPrimitives.ReadInt32LittleEndian(header);Check(n>0&&n<=16384,"Response budget");bytes=new byte[n];await pipe.ReadExactlyAsync(bytes,timeout.Token);return System.Text.Encoding.UTF8.GetString(bytes);}
async System.Threading.Tasks.Task<string> Malformed(string json){using var pipe=new System.IO.Pipes.NamedPipeClientStream(".","Confectory.Entry."+key,System.IO.Pipes.PipeDirection.InOut,System.IO.Pipes.PipeOptions.Asynchronous);await pipe.ConnectAsync(2000);using var cancel=new System.Threading.CancellationTokenSource(3000);var bytes=System.Text.Encoding.UTF8.GetBytes(json);var header=new byte[4];System.Buffers.Binary.BinaryPrimitives.WriteInt32LittleEndian(header,bytes.Length);await pipe.WriteAsync(header,cancel.Token);await pipe.WriteAsync(bytes,cancel.Token);await pipe.FlushAsync(cancel.Token);await pipe.ReadExactlyAsync(header,cancel.Token);int length=System.Buffers.Binary.BinaryPrimitives.ReadInt32LittleEndian(header);Check(length>0&&length<=16384,"Malformed response budget");bytes=new byte[length];await pipe.ReadExactlyAsync(bytes,cancel.Token);return System.Text.Encoding.UTF8.GetString(bytes);}
System.Text.Json.Nodes.JsonNode Take(){var watch=System.Diagnostics.Stopwatch.StartNew();while(watch.Elapsed.TotalSeconds<5){var row=System.Text.Json.Nodes.JsonNode.Parse(calls.Request.Invoke(token,"poll","{}"))!;if(row["id"] is not null)return row;System.Threading.Thread.Sleep(1);}throw new TimeoutException("Inbox receive");}
void Reply(string id,string status)=>calls.Request.Invoke(token,"reply",System.Text.Json.JsonSerializer.Serialize(new{id,status,message="retained"}));
try{bool duplicate=false;try{calls.Request.Invoke(scope,"listen","{}");}catch(System.IO.IOException){duplicate=true;}Check(duplicate,"Only one owner can bind an installation scope");
 foreach(string invalid in new[]{"null","[]","{}","{\"version\":1,\"id\":42}","{broken"})Check(Malformed(invalid).GetAwaiter().GetResult().Contains("failed"),"Malformed request cannot retire listener");
 string id=Guid.NewGuid().ToString("N"),path=System.IO.Path.Combine(scope,"공백 한글","project.cproj");var request=Send(id,path);var received=Take();Check(received["path"]!.ToString()==path,"Unicode/space request preserved exactly");Reply(id,"opened");Check(request.GetAwaiter().GetResult().Contains("opened"),"UI acknowledgment returned");
 var repeated=Send(id,path).GetAwaiter().GetResult();Check(repeated.Contains("opened")&&calls.Request.Invoke(token,"poll","{}")=="{}","Duplicate ID never opens twice");Check(Send(id,path+"x").GetAwaiter().GetResult().Contains("failed"),"ID cannot be reused for another file");
 string second=Guid.NewGuid().ToString("N");var busy=Send(second,path+"2");Take();Reply(second,"busy");Check(busy.GetAwaiter().GetResult().Contains("busy"),"Busy refusal reaches caller without replacing work");
 bool foreign=System.Threading.Tasks.Task.Run(()=>{try{calls.Request.Invoke(token,"poll","{}");return false;}catch(InvalidOperationException){return true;}}).GetAwaiter().GetResult();Check(foreign,"Only the creating UI thread consumes inbox");
 // Abrupt sender disconnect must not poison the listener.
 using(var lost=new System.IO.Pipes.NamedPipeClientStream(".","Confectory.Entry."+key,System.IO.Pipes.PipeDirection.InOut)){lost.Connect(2000);var b=System.Text.Encoding.UTF8.GetBytes(System.Text.Json.JsonSerializer.Serialize(new{version=1,id=Guid.NewGuid().ToString("N"),path}));var h=new byte[4];System.Buffers.Binary.BinaryPrimitives.WriteInt32LittleEndian(h,b.Length);lost.Write(h);lost.Write(b);lost.Flush();var row=Take();Reply(row["id"]!.ToString(),"opened");}
 System.Threading.Thread.Sleep(20);string last=Guid.NewGuid().ToString("N");var fresh=Send(last,path);Take();Reply(last,"already-open");Check(fresh.GetAwaiter().GetResult().Contains("already-open"),"Listener survives disconnected sender");
}finally{calls.Request.Invoke(token,"close","{}");calls.Request.Invoke(token,"close","{}");}
bool retired=false;try{calls.Request.Invoke(token,"poll","{}");}catch(ObjectDisposedException){retired=true;}Check(retired,"Retired owner cannot poll");token=calls.Request.Invoke(scope,"listen","{}");calls.Request.Invoke(token,"close","{}");System.IO.Directory.Delete(scope+"-inboxes",true);Console.WriteLine("ProjectEntry public inbox PASS");return 0;
