 Check(calls.Pump.Invoke(surfaces).Length==0,"Cached paint must not cause invalidation feedback");Check(SimCounter(6)==1&&SimCounter(7)==1&&SimCounter(8)==1&&SimCounter(11)==0,"Single balanced backbuffer paint without erase");
 calls.Draw.Invoke(surfaces,0,rectangles,labels);calls.Pump.Invoke(surfaces);Check(SimCounter(12)==1,"Value update recreated backbuffer");
