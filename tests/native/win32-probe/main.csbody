 SimSend((IntPtr)surfaces[2],0x201,IntPtr.Zero,(IntPtr)((120<<16)|30));SimKey(32);events=calls.Pump.Invoke(surfaces);bool cancelled=false,right=false;for(int i=0;i<events.Length;i+=6){if(events[i]==0&&events[i+1]==9)cancelled=true;if(events[i]==1&&events[i+1]==5)right=true;}Check(cancelled&&right,"Focus transfers and keyboard follows focused HWND");
 SimSend((IntPtr)surfaces[2],0x20A,(IntPtr)(120<<16),(IntPtr)((250<<16)|150));events=calls.Pump.Invoke(surfaces);Check(events.Length==6&&events[0]==1&&events[1]==4&&events[2]==50&&events[3]==150&&events[4]==120,"Wheel screen-to-client conversion");
