void Check(bool value,string message){if(!value){string evidence=System.IO.Path.Combine(System.IO.Path.GetDirectoryName(Environment.GetEnvironmentVariable("CONFECTORY_TEST_CONNECTION_PROJECT")!)!,"records.json");if(System.IO.File.Exists(evidence))Console.Error.WriteLine("OWNED FIXTURE EVIDENCE: "+System.IO.File.ReadAllText(evidence));throw new Exception(message);}}
System.Text.Json.Nodes.JsonNode J(string text)=>System.Text.Json.Nodes.JsonNode.Parse(text)!;
string project=Environment.GetEnvironmentVariable("CONFECTORY_TEST_CONNECTION_PROJECT")!,root=System.IO.Path.GetDirectoryName(project)!,fixture=Environment.GetEnvironmentVariable("CONFECTORY_CODEX_METHOD_FIXTURE")!;
var start=new System.Diagnostics.ProcessStartInfo("/usr/bin/python3"){UseShellExecute=false,RedirectStandardOutput=true,RedirectStandardError=true};start.ArgumentList.Add(fixture);start.ArgumentList.Add(root);using var server=System.Diagnostics.Process.Start(start)!;
var endpoint=J(server.StandardOutput.ReadLineAsync().WaitAsync(TimeSpan.FromSeconds(10)).GetAwaiter().GetResult()!);var errors=server.StandardError.ReadToEndAsync();
string managed=System.IO.Path.Combine(root,"managed-empty");System.IO.Directory.CreateDirectory(managed);
var context=new System.Text.Json.Nodes.JsonObject{["projectId"]="owned-project",["helper"]="owned-helper"};
try{
 var config=new System.Text.Json.Nodes.JsonObject{["provider"]="codex",["connectionMethod"]="desktop-ide",["protocol"]="app-server-unix",["model"]="owned-no-model",["sessionSocket"]=endpoint["socket"]!.DeepClone(),["managedHome"]=managed};
 var grant=new System.Text.Json.Nodes.JsonObject{["projectId"]="owned-project",["connectionMethod"]="desktop-ide",["sessionSocket"]=endpoint["socket"]!.DeepClone(),["model"]="owned-no-model",["executable"]="",["managedHome"]=managed,["contentApproved"]=true,["usageApproved"]=true,["processApproved"]=true,["managedCredentialApproved"]=true,["managedConfigurationApproved"]=true,["managedStorageApproved"]=true,["protocolVerified"]=true};
 var boundary=J(calls.Verification.Invoke(config.ToJsonString(),"start","{\"checkProcessApproved\":true,\"checkAccountApproved\":true,\"checkConfigurationApproved\":true,\"checkStorageApproved\":true}"));Check(boundary["code"]!.ToString()=="shared_policy_unpinned"&&!boundary["supported"]!.GetValue<bool>(),"Shared socket policy was falsely pinned");
 bool forged=false;string forgedRun=Guid.NewGuid().ToString("N");try{calls.Provider.Invoke(config.ToJsonString(),forgedRun,"open",new System.Text.Json.Nodes.JsonObject{["message"]="must-not-send",["context"]=context.DeepClone(),["authorization"]=grant.DeepClone()}.ToJsonString());}catch(UnauthorizedAccessException){forged=true;}finally{calls.Provider.Invoke(config.ToJsonString(),forgedRun,"close","");}Check(forged&&!server.HasExited,"A caller-supplied verification flag bypassed the shared socket fence");
 var work=new System.Text.Json.Nodes.JsonObject{["provider"]="codex",["connectionMethod"]="chatgpt-work",["protocol"]="workspace-agent-api",["workspaceTriggerId"]="agtch_owned",["workspaceCredentialReference"]="",["workspaceEndpoint"]=endpoint["endpoint"]!.DeepClone()};
 var authorization=new System.Text.Json.Nodes.JsonObject{["projectId"]="owned-project",["contentApproved"]=true,["usageApproved"]=true,["workspaceCredentialApproved"]=true,["protocolVerified"]=true,["workspaceTriggerId"]="agtch_owned",["workspaceEndpoint"]=endpoint["endpoint"]!.DeepClone()};
 string execution=Guid.NewGuid().ToString("N"),request=new System.Text.Json.Nodes.JsonObject{["message"]="OWNED LOOPBACK WORKSPACE FIXTURE",["context"]=context.DeepClone(),["authorization"]=authorization}.ToJsonString();
 bool refused=false;try{calls.Workspace.Invoke(work.ToJsonString(),"unapproved","open","{}");}catch(UnauthorizedAccessException){refused=true;}Check(refused,"Unapproved Workspace request sent");
 var accepted=J(calls.Workspace.Invoke(work.ToJsonString(),execution,"open",request));Check(accepted["kind"]!.ToString()=="receipt"&&accepted["status"]!.ToString()=="queued"&&!accepted["replyAvailable"]!.GetValue<bool>(),"Workspace acceptance faked a Helper reply");Check(J(calls.Workspace.Invoke(work.ToJsonString(),execution,"open",request)).ToJsonString()==accepted.ToJsonString(),"Workspace repeated open changed accepted outcome");
 var done=J(calls.Workspace.Invoke(work.ToJsonString(),execution,"poll",""));Check(done["status"]!.ToString()=="completed"&&done["kind"]!.ToString()=="receipt"&&!done.ToJsonString().Contains("IGNORED FIXTURE"),"Remote status interpreted as a reply");var stopped=J(calls.Workspace.Invoke(work.ToJsonString(),execution,"stop",""));Check(stopped["pollingStopped"]!.GetValue<bool>()&&!stopped["remoteCancelSupported"]!.GetValue<bool>()&&stopped["status"]!.ToString()=="completed","Stop claimed unsupported remote cancellation");calls.Workspace.Invoke(work.ToJsonString(),execution,"open",request);
 System.Threading.Thread.Sleep(100);var records=J(System.IO.File.ReadAllText(System.IO.Path.Combine(root,"records.json"))).AsArray();Check(System.Linq.Enumerable.Count(records,row=>row!["kind"]!.ToString()=="workspace-post")==1&&System.Linq.Enumerable.Count(records,row=>row!["kind"]!.ToString()=="workspace-poll")==1&&!System.Linq.Enumerable.Any(records,row=>row!["kind"]!.ToString()=="fixture-error"),"Owned protocols duplicated requests or violated scope");Check(System.Linq.Enumerable.Count(records,row=>row!["kind"]!.ToString()=="socket"&&row["value"]?["method"]?.ToString()=="turn/interrupt")==0,"Unsupported shared socket was contacted");
 Console.WriteLine("Owned Codex control socket and Workspace API receipt/status PASS; no real account, reply retrieval or remote cancel");return 0;
}finally{if(!server.HasExited)server.Kill(true);server.WaitForExit(5000);}
