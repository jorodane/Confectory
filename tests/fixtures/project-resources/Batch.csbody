string root=Environment.GetEnvironmentVariable("CONFECTORY_RESOURCE_CASE")??throw new InvalidOperationException("owned fixture required");System.IO.Directory.CreateDirectory(System.IO.Path.Combine(root,".confectory"));
string manifest=System.IO.Path.Combine(root,"project.cproj"),identityPath=System.IO.Path.Combine(root,".confectory/project-identity.json"),store=System.IO.Path.Combine(root,".confectory/resources.v1.json"),project=Guid.NewGuid().ToString("N");System.IO.File.WriteAllText(manifest,"project Probe.Assets version \"1\" {standalone true;}");System.IO.File.WriteAllText(identityPath,new System.Text.Json.Nodes.JsonObject{["version"]=1,["manifest"]=manifest,["namespace"]="Probe.Assets",["projectId"]=project}.ToJsonString());byte[] source=System.IO.File.ReadAllBytes(manifest),identity=System.IO.File.ReadAllBytes(identityPath);
var checks=new System.Text.Json.Nodes.JsonArray();void Check(bool valid,string label){if(!valid)throw new InvalidOperationException(label);checks.Add(label);}
System.Text.Json.Nodes.JsonObject Call(string operation,System.Text.Json.Nodes.JsonObject? input=null)=>System.Text.Json.Nodes.JsonNode.Parse(calls.Request.Invoke(manifest,project,operation,(input??new()).ToJsonString()))!.AsObject();
System.Text.Json.Nodes.JsonObject Entry(string name,byte[] raw)=>new(){["command"]=Guid.NewGuid().ToString("N"),["item"]=new System.Text.Json.Nodes.JsonObject{["id"]=Guid.NewGuid().ToString("N"),["name"]=name,["type"]="application/octet-stream",["size"]=raw.Length,["hash"]=Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(raw)).ToLowerInvariant(),["modifiedAt"]=0,["data"]=Convert.ToBase64String(raw).Replace('+','-').Replace('/','_')}};
System.Text.Json.Nodes.JsonObject Batch(params System.Text.Json.Nodes.JsonObject[] entries){var rows=new System.Text.Json.Nodes.JsonArray();foreach(var row in entries)rows.Add(row.DeepClone());return new(){["revision"]=Call("load")["revision"]!.DeepClone(),["imports"]=rows};}
void Reject(System.Text.Json.Nodes.JsonObject input,string label){byte[]? before=System.IO.File.Exists(store)?System.IO.File.ReadAllBytes(store):null;bool rejected=false;try{Call("import-many",input);}catch{rejected=true;}Check(rejected,label);Check(before is null?!System.IO.File.Exists(store):System.Linq.Enumerable.SequenceEqual(before,System.IO.File.ReadAllBytes(store)),label+" retains complete prior store");}
var empty=Call("load");Check(!System.IO.File.Exists(store)&&empty["limits"]!["importBatch"]!.GetValue<int>()==64&&empty["limits"]!["importBytes"]!.GetValue<int>()==4194304,"batch capability is explicit without storage creation");
var first=Entry("한글 <동일 이름>.bin",new byte[]{0,251,255,0});var second=Entry("한글 <동일 이름>.bin",System.Text.Encoding.UTF8.GetBytes("original\r\nbytes 🧪"));var input=Batch(first,second);var bad=input.DeepClone().AsObject();bad["imports"]![1]!["item"]!["hash"]=new string('0',64);Reject(bad,"invalid second member cannot append first member");
bad=Batch(first,first);Reject(bad,"duplicate command and identity are rejected together");bad=Batch(first,second);bad["imports"]![1]!["item"]!["id"]=first["item"]!["id"]!.DeepClone();Reject(bad,"distinct commands cannot share an identity");Reject(Batch(),"empty selection is not a mutation");
var result=Call("import-many",input);Check(result["items"]!.AsArray().Count==2&&result["selectedIds"]!.AsArray().Count==2,"same-name distinct resources append as one group");byte[] saved=System.IO.File.ReadAllBytes(store);var replay=Call("import-many",input);Check(replay["replayed"]!.GetValue<bool>()&&System.Linq.Enumerable.SequenceEqual(saved,System.IO.File.ReadAllBytes(store)),"exact replay performs no second write");
foreach(var entry in new[]{first,second}){var item=entry["item"]!;var read=Call("read",new(){["id"]=item["id"]!.DeepClone(),["hash"]=item["hash"]!.DeepClone()});Check(read["data"]!.ToString()==item["data"]!.ToString(),"batch read preserves exact bytes and original ID");var single=entry.DeepClone().AsObject();single["revision"]=input["revision"]!.DeepClone();Check(Call("import",single)["replayed"]!.GetValue<bool>(),"v1 single-import receipt remains compatible");}
bad=input.DeepClone().AsObject();bad["imports"]![1]!["item"]!["name"]="changed.bin";Reject(bad,"same command cannot change selected metadata");Reject(Batch(first,Entry("new.bin",new byte[]{1})),"old/new intent mixture cannot append a partial group");
var stale=Batch(Entry("stale one.bin",new byte[]{3}),Entry("stale two.bin",new byte[]{4}));var third=Entry("peer.bin",new byte[]{5});var peer=third.DeepClone().AsObject();peer["revision"]=result["revision"]!.DeepClone();Call("import",peer);Reject(stale,"stale batch never silently rebases");Check(Call("import-many",input)["replayed"]!.GetValue<bool>(),"later append does not expire exact batch member receipts");
Reject(Batch(Entry("one.bin",new byte[1048576]),Entry("two.bin",new byte[1048576]),Entry("three.bin",new byte[1048576]),Entry("four.bin",new byte[1048576]),Entry("too much.bin",new byte[1])),"aggregate selection budget applies before write");var entries=new System.Collections.Generic.List<System.Text.Json.Nodes.JsonObject>();for(int i=0;i<65;i++)entries.Add(Entry("zero.bin",Array.Empty<byte>()));Reject(Batch(entries.ToArray()),"batch identity count is bounded");
var maximum=Batch(Entry("half one.bin",new byte[524288]),Entry("half two.bin",new byte[524288]));var full=Call("import-many",maximum);Check(full["items"]!.AsArray().Count==5,"one MiB aggregate real batch succeeds within IPC payload budget");
saved=System.IO.File.ReadAllBytes(store);System.IO.File.SetAttributes(store,System.IO.File.GetAttributes(store)|System.IO.FileAttributes.ReadOnly);try{Reject(Batch(Entry("unwritten one.bin",new byte[]{9}),Entry("unwritten two.bin",new byte[]{10})),"write refusal preserves entire selected group");}finally{System.IO.File.SetAttributes(store,System.IO.File.GetAttributes(store)&~System.IO.FileAttributes.ReadOnly);}
Check(System.Linq.Enumerable.SequenceEqual(source,System.IO.File.ReadAllBytes(manifest))&&System.Linq.Enumerable.SequenceEqual(identity,System.IO.File.ReadAllBytes(identityPath)),"manifest and original identity bytes unchanged");Check(Call("load")["items"]!.AsArray().Count==5,"cold provider invocation retains exactly five stable resources");System.IO.File.WriteAllText(System.IO.Path.Combine(root,"checks.json"),checks.ToJsonString());Console.WriteLine(checks.ToJsonString());return 0;
