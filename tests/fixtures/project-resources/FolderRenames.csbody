string root=Environment.GetEnvironmentVariable("CONFECTORY_RESOURCE_CASE")!;System.IO.Directory.CreateDirectory(System.IO.Path.Combine(root,".confectory"));string manifest=System.IO.Path.Combine(root,"project.cproj"),identity=System.IO.Path.Combine(root,".confectory/project-identity.json"),store=System.IO.Path.Combine(root,".confectory/resources.v1.json"),layout=System.IO.Path.Combine(root,".confectory/resource-layout.v1.json"),names=System.IO.Path.Combine(root,".confectory/resource-folder-names.v1.json"),project=Guid.NewGuid().ToString("N");
System.IO.File.WriteAllText(manifest,"project Probe.Assets version \"1\" {standalone true;}");System.IO.File.WriteAllText(identity,new System.Text.Json.Nodes.JsonObject{["version"]=1,["manifest"]=manifest,["namespace"]="Probe.Assets",["projectId"]=project}.ToJsonString());string original=System.IO.File.ReadAllText(manifest),originalIdentity=System.IO.File.ReadAllText(identity);
var checks=new System.Text.Json.Nodes.JsonArray();void Check(bool ok,string text){if(!ok)throw new Exception(text);checks.Add(text);}
string Id()=>Guid.NewGuid().ToString("N");System.Text.Json.Nodes.JsonObject Call(string op,System.Text.Json.Nodes.JsonObject? input=null,string? owner=null)=>System.Text.Json.Nodes.JsonNode.Parse(calls.Layout.Invoke(manifest,owner??project,op,(input??new()).ToJsonString()))!.AsObject();
System.Text.Json.Nodes.JsonObject Folder(string id,string name,string? parent=null)=>new(){["revision"]=Call("load")["revision"]!.DeepClone(),["command"]=Id(),["id"]=id,["name"]=name,["parent"]=parent};System.Text.Json.Nodes.JsonObject Rename(string id,string name)=>new(){["revision"]=Call("load")["revision"]!.DeepClone(),["command"]=Id(),["id"]=id,["name"]=name};
string Name(string id)=>System.Linq.Enumerable.Single(Call("load")["items"]!.AsArray(),x=>x!["id"]!.ToString()==id)!["name"]!.ToString();
void Reject(string op,System.Text.Json.Nodes.JsonObject input,string text,string? owner=null){string before=System.IO.File.Exists(names)?System.IO.File.ReadAllText(names):"missing";bool failed=false;try{Call(op,input,owner);}catch{failed=true;}Check(failed,text);Check((System.IO.File.Exists(names)?System.IO.File.ReadAllText(names):"missing")==before,text+" preserves exact names");}
Call("load");Check(!System.IO.File.Exists(names),"load never creates name metadata");string a=Id(),b=Id();Call("create-folder",Folder(a,"원래 카테고리"));Call("create-folder",Folder(b,"중첩",a));string topology=System.IO.File.ReadAllText(layout);Check(!System.IO.File.Exists(names),"ordinary create retains original v1 format without name storage");
var rename=Rename(a,"새 이름 <안전> 🧪");Call("rename-folder",rename);Check(Name(a)=="새 이름 <안전> 🧪","explicit rename publishes literal Unicode name with same identity");Check(System.IO.File.ReadAllText(layout)==topology,"rename never rewrites folder topology or original create receipts");Check(Call("rename-folder",rename)["replayed"]!.GetValue<bool>(),"lost reply exact rename receipt confirms once");
var stale=Rename(b,"old");var next=Rename(a,"두 번째 이름");Call("rename-folder",next);Reject("rename-folder",stale,"peer name change invalidates composite revision");Reject("rename-folder",rename,"superseded rename receipt cannot revert current name");Check(Name(a)=="두 번째 이름","superseded rejection leaves newest name");
var same=next.DeepClone().AsObject();same["name"]="다른 요청";Reject("rename-folder",same,"same command cannot mutate its intent");Reject("rename-folder",Rename(Id(),"없는 폴더"),"missing folder refused");Reject("rename-folder",Rename(a,"../path"),"logical name path refused");Reject("rename-folder",Rename(a,new string('x',181)),"name budget refused");Reject("rename-folder",Rename(a,"외부"),"foreign project refused",Id());
var retry=Rename(b,"다시 확인할 이름");var before=System.IO.File.ReadAllText(names);System.IO.File.SetAttributes(names,System.IO.File.GetAttributes(names)|System.IO.FileAttributes.ReadOnly);try{Reject("rename-folder",retry,"write refusal retains exact input");}finally{System.IO.File.SetAttributes(names,System.IO.File.GetAttributes(names)&~System.IO.FileAttributes.ReadOnly);}Check(System.IO.File.ReadAllText(names)==before,"write failure has no partial name save");Call("rename-folder",retry);Check(Name(b)=="다시 확인할 이름","same input recovers after actual permission refusal");
var move=new System.Text.Json.Nodes.JsonObject{["revision"]=Call("load")["revision"]!.DeepClone(),["command"]=Id(),["ids"]=new System.Text.Json.Nodes.JsonArray(b),["parent"]=null};Call("move",move);Check(Name(b)=="다시 확인할 이름"&&Call("rename-folder",retry)["replayed"]!.GetValue<bool>(),"move preserves name and surviving receipt does not restore an old parent");
var valid=System.IO.File.ReadAllText(names);var corrupt=System.Text.Json.Nodes.JsonNode.Parse(valid)!;corrupt["items"]![0]!["name"]="변조";System.IO.File.WriteAllText(names,corrupt.ToJsonString());try{Reject("load",new(),"tampered name/receipt fails closed");}finally{System.IO.File.WriteAllText(names,valid);}Check(Name(a)=="두 번째 이름","fresh invocation restores current metadata only");Check(!System.IO.File.Exists(store),"folder rename never creates a file byte store");Check(System.IO.File.ReadAllText(manifest)==original&&System.IO.File.ReadAllText(identity)==originalIdentity,"source and project identity bytes remain exact");System.IO.File.WriteAllText(System.IO.Path.Combine(root,"checks.json"),checks.ToJsonString());Console.WriteLine(checks.ToJsonString());return 0;
