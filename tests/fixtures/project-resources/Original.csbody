string root=Environment.GetEnvironmentVariable("CONFECTORY_RESOURCE_CASE")!;System.IO.Directory.CreateDirectory(System.IO.Path.Combine(root,".confectory"));string manifest=System.IO.Path.Combine(root,"project.cproj"),project=Guid.NewGuid().ToString("N"),store=System.IO.Path.Combine(root,".confectory/resources.v1.json");System.IO.File.WriteAllText(manifest,"source");System.IO.File.WriteAllText(System.IO.Path.Combine(root,".confectory/project-identity.json"),new System.Text.Json.Nodes.JsonObject{["version"]=1,["manifest"]=manifest,["projectId"]=project}.ToJsonString());
var checks=new System.Text.Json.Nodes.JsonArray();void Check(bool value,string text){if(!value)throw new Exception(text);checks.Add(text);}string Id()=>Guid.NewGuid().ToString("N");string Hash(byte[] value)=>Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(value)).ToLowerInvariant();
System.Text.Json.Nodes.JsonObject Call(string action,System.Text.Json.Nodes.JsonObject? value=null)=>System.Text.Json.Nodes.JsonNode.Parse(calls.Layout.Invoke(manifest,project,action,(value??new()).ToJsonString()))!.AsObject();
System.Text.Json.Nodes.JsonObject Files(string action,System.Text.Json.Nodes.JsonObject? value=null)=>System.Text.Json.Nodes.JsonNode.Parse(calls.Request.Invoke(manifest,project,action,(value??new()).ToJsonString()))!.AsObject();
bool Refused(string action,System.Text.Json.Nodes.JsonObject value){try{Call(action,value);return false;}catch{return true;}}
string Add(string name,byte[] bytes,string type="text/plain"){string id=Id();Files("import",new(){["revision"]=Files("load")["revision"]!.DeepClone(),["command"]=Id(),["item"]=new System.Text.Json.Nodes.JsonObject{["id"]=id,["name"]=name,["type"]=type,["size"]=bytes.Length,["hash"]=Hash(bytes),["modifiedAt"]=0,["data"]=Convert.ToBase64String(bytes).Replace('+','-').Replace('/','_')}});return id;}
System.Text.Json.Nodes.JsonObject Item(string id)=>System.Linq.Enumerable.Single(Call("load")["items"]!.AsArray(),row=>row!["id"]!.ToString()==id)!.AsObject();
System.Text.Json.Nodes.JsonObject Input(string id,byte[]? data=null){var input=new System.Text.Json.Nodes.JsonObject{["revision"]=Call("load")["revision"]!.DeepClone(),["command"]=Id(),["id"]=id,["hash"]=Item(id)["hash"]!.DeepClone()};if(data is not null){input["type"]=Item(id)["type"]!.DeepClone();input["size"]=data.Length;input["data"]=Convert.ToBase64String(data).Replace('+','-').Replace('/','_');}return input;}

byte[] ReadFile(string id){var row=Item(id);var header=Call("read-file",new(){["id"]=id,["hash"]=row["hash"]!.DeepClone()});int size=header["item"]!["size"]!.GetValue<int>();var all=new byte[size];for(int part=0;part<(size+1048575)/1048576;part++){var piece=Call("read-file-part",new(){["id"]=id,["hash"]=row["hash"]!.DeepClone(),["generation"]=header["item"]!["contentGeneration"]!.DeepClone(),["revision"]=header["displayRevision"]!.DeepClone(),["part"]=part});var data=Convert.FromBase64String(piece["data"]!.ToString().Replace('-','+').Replace('_','/'));Check(Hash(data)==piece["transfer"]!["sha256"]!.ToString(),"bounded part hash");data.CopyTo(all,part*1048576);}Check(Hash(all)==row["hash"]!.ToString(),"whole saved-file hash");return all;}
string empty=Add("empty.txt",Array.Empty<byte>());Check(ReadFile(empty).Length==0,"empty original file reads without a part");Check(Refused("read-file-part",new(){["id"]=empty,["hash"]=Item(empty)["hash"]!.DeepClone(),["generation"]=Item(empty)["contentGeneration"]!.DeepClone(),["revision"]=Call("load")["revision"]!.DeepClone(),["part"]=0}),"empty file has no invented part");
string id=Add("saved.txt",System.Text.Encoding.UTF8.GetBytes("import\r\n"));byte[] storeBefore=System.IO.File.ReadAllBytes(store);Check(System.Text.Encoding.UTF8.GetString(ReadFile(id))=="import\r\n","initial saved file equals import");Call("save-content",Input(id,System.Text.Encoding.UTF8.GetBytes("committed\r\n🧪")));Check(System.Text.Encoding.UTF8.GetString(ReadFile(id))=="committed\r\n🧪","explicit saved current bytes rather than immutable import");Check(System.Linq.Enumerable.SequenceEqual(System.IO.File.ReadAllBytes(store),storeBefore),"reading/saving retain immutable import");Call("restore-content",Input(id));Check(System.Text.Encoding.UTF8.GetString(ReadFile(id))=="import\r\n","restored content opens exact backup");
Call("rename-file",new(){["revision"]=Call("load")["revision"]!.DeepClone(),["command"]=Id(),["id"]=id,["name"]="current name.txt"});var h=Call("read-file",new(){["id"]=id,["hash"]=Item(id)["hash"]!.DeepClone()});Check(h["item"]!["name"]!.ToString()=="current name.txt"&&h["item"]!["id"]!.ToString()==id,"current alias with stable ID");
var full=new byte[4194304];for(int n=0;n<full.Length;n++)full[n]=(byte)(n*37+19);string large=Add("unknown.bin",full,"application/octet-stream");Check(System.Linq.Enumerable.SequenceEqual(ReadFile(large),full),"all four native parts for opaque4MiB");Check(System.Text.Json.Nodes.JsonNode.Parse(System.IO.File.ReadAllText(store))!["version"]!.GetValue<int>()==2,"generic reads support existing accumulated v2 without migration");
Check(Refused("read-file",new(){["id"]=id,["hash"]=new string('0',64)}),"stale hash refused");Check(Refused("read-file",new(){["id"]=Id(),["hash"]=Item(id)["hash"]!.DeepClone()}),"foreign item refused");Check(Refused("read-file",new(){["id"]=id,["hash"]=Item(id)["hash"]!.DeepClone(),["path"]="/private"}),"path grant refused");
Check(System.IO.File.ReadAllText(manifest)=="source","source and contracts untouched");System.IO.File.WriteAllText(System.IO.Path.Combine(root,"checks.json"),checks.ToJsonString());Console.WriteLine(checks.ToJsonString());return 0;
