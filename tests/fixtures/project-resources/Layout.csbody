string root=Environment.GetEnvironmentVariable("CONFECTORY_RESOURCE_CASE")!;System.IO.Directory.CreateDirectory(System.IO.Path.Combine(root,".confectory"));string manifest=System.IO.Path.Combine(root,"project.cproj"),identity=System.IO.Path.Combine(root,".confectory/project-identity.json"),store=System.IO.Path.Combine(root,".confectory/resources.v1.json"),layout=System.IO.Path.Combine(root,".confectory/resource-layout.v1.json"),project=Guid.NewGuid().ToString("N");
System.IO.File.WriteAllText(manifest,"project Probe.Assets version \"1\" {standalone true;}");System.IO.File.WriteAllText(identity,new System.Text.Json.Nodes.JsonObject{["version"]=1,["manifest"]=manifest,["namespace"]="Probe.Assets",["projectId"]=project}.ToJsonString());string original=System.IO.File.ReadAllText(manifest),originalIdentity=System.IO.File.ReadAllText(identity);
var checks=new System.Text.Json.Nodes.JsonArray();void Check(bool ok,string text){if(!ok)throw new Exception(text);checks.Add(text);}
System.Text.Json.Nodes.JsonObject Call(string op,System.Text.Json.Nodes.JsonObject? input=null,string? owner=null)=>System.Text.Json.Nodes.JsonNode.Parse(calls.Layout.Invoke(manifest,owner??project,op,(input??new()).ToJsonString()))!.AsObject();
System.Text.Json.Nodes.JsonObject File(string op,System.Text.Json.Nodes.JsonObject? input=null)=>System.Text.Json.Nodes.JsonNode.Parse(calls.Request.Invoke(manifest,project,op,(input??new()).ToJsonString()))!.AsObject();
string Id()=>Guid.NewGuid().ToString("N");System.Text.Json.Nodes.JsonObject Folder(string id,string name,string? parent=null)=>new(){["revision"]=Call("load")["revision"]!.DeepClone(),["command"]=Id(),["id"]=id,["name"]=name,["parent"]=parent};
System.Text.Json.Nodes.JsonObject Move(string? parent,params string[] ids){var list=new System.Text.Json.Nodes.JsonArray();foreach(var id in ids)list.Add(id);return new(){["revision"]=Call("load")["revision"]!.DeepClone(),["command"]=Id(),["ids"]=list,["parent"]=parent};}
void Reject(string op,System.Text.Json.Nodes.JsonObject input,string text,string? owner=null){string before=System.IO.File.Exists(layout)?System.IO.File.ReadAllText(layout):"missing";bool failed=false;try{Call(op,input,owner);}catch{failed=true;}Check(failed,text);Check((System.IO.File.Exists(layout)?System.IO.File.ReadAllText(layout):"missing")==before,text+" leaves exact layout");}
Check(Call("load")["items"]!.AsArray().Count==0&&!System.IO.File.Exists(layout)&&!System.IO.File.Exists(store),"empty layout observation has no creation side effect");
string file=Id();File("import",new(){["revision"]="missing",["command"]=Id(),["item"]=new System.Text.Json.Nodes.JsonObject{["id"]=file,["name"]="원본.txt",["type"]="text/plain",["size"]=3,["hash"]=Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes("abc"))).ToLowerInvariant(),["modifiedAt"]=0,["data"]="YWJj"}});string originalStore=System.IO.File.ReadAllText(store);
string a=Id(),b=Id(),c=Id();var create=Folder(a,"작업 <A>");Call("create-folder",create);Call("create-folder",Folder(b,"중첩 B",a));Call("create-folder",Folder(c,"C"));Check(Call("load")["items"]!.AsArray().Count==4,"files and nested folder identities are one project catalogue");
var move=Move(b,file);Call("move",move);Check(Call("move",move)["replayed"]!.GetValue<bool>(),"lost move reply replays exact command");Call("move",Move(c,b));Check(Call("create-folder",create)["replayed"]!.GetValue<bool>(),"create proof survives independent folder moves");
var both=Move(null,b,file);Call("move",both);var value=Call("load");Check(System.Linq.Enumerable.Single(value["items"]!.AsArray(),x=>x!["id"]!.ToString()==file)!["parent"]!.ToString()==b,"moving selected parent and child moves only selected roots");Check(Call("move",move)["replayed"]!.GetValue<bool>(),"surviving receipt confirms current state without moving back");
Reject("move",Move(b,b),"self cycle refused");Call("move",Move(b,c));Reject("move",Move(c,b),"descendant cycle refused");Reject("move",Move(Id(),file),"missing target refused");Reject("move",Move(null,Id()),"unknown source refused");Reject("load",new(),"foreign project refused",Id());Reject("create-folder",Folder(Id(),"../outside"),"logical names cannot be paths");
var stale=Folder(Id(),"stale");Call("create-folder",Folder(Id(),"peer"));Reject("create-folder",stale,"stale layout basis never rebases");var reused=create.DeepClone().AsObject();reused["name"]="different";Reject("create-folder",reused,"command identity cannot change intent");
var retry=Folder(Id(),"쓰기 복구");System.IO.File.SetAttributes(layout,System.IO.File.GetAttributes(layout)|System.IO.FileAttributes.ReadOnly);try{Reject("create-folder",retry,"write refusal preserves input");}finally{System.IO.File.SetAttributes(layout,System.IO.File.GetAttributes(layout)&~System.IO.FileAttributes.ReadOnly);}Call("create-folder",retry);Check(Call("create-folder",retry)["replayed"]!.GetValue<bool>(),"retry after actual write refusal and fresh invocation restores exact identity");
string saved=System.IO.File.ReadAllText(layout);var corrupt=System.Text.Json.Nodes.JsonNode.Parse(saved)!;corrupt["folders"]![0]!["parent"]=a;System.IO.File.WriteAllText(layout,corrupt.ToJsonString());try{Reject("load",new(),"corrupt topology fails closed without repair");}finally{System.IO.File.WriteAllText(layout,saved);}
Check(System.IO.File.ReadAllText(store)==originalStore&&File("load")["items"]!.AsArray().Count==1,"layout never rewrites immutable file store or breaks old flat reader");Check(System.IO.File.ReadAllText(manifest)==original&&System.IO.File.ReadAllText(identity)==originalIdentity,"source and owner identity bytes unchanged");System.IO.File.WriteAllText(System.IO.Path.Combine(root,"checks.json"),checks.ToJsonString());Console.WriteLine(checks.ToJsonString());return 0;
