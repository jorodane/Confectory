var checks=new System.Text.Json.Nodes.JsonArray();void Check(bool ok,string text){if(!ok)throw new Exception(text);checks.Add(text);}string Id()=>Guid.NewGuid().ToString("N");string Hash(string text)=>Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(text))).ToLowerInvariant();
System.Text.Json.Nodes.JsonObject Call(string op,System.Text.Json.Nodes.JsonObject? input=null,string? p=null)=>System.Text.Json.Nodes.JsonNode.Parse(calls.Layout.Invoke(manifest,p??project,op,(input??new()).ToJsonString()))!.AsObject();System.Text.Json.Nodes.JsonObject File(string op,System.Text.Json.Nodes.JsonObject? input=null)=>System.Text.Json.Nodes.JsonNode.Parse(calls.Request.Invoke(manifest,project,op,(input??new()).ToJsonString()))!.AsObject();
System.Text.Json.Nodes.JsonObject Input(string id)=>new(){["revision"]=Call("load")["revision"]!.DeepClone(),["command"]=Id(),["id"]=id};
System.Text.Json.Nodes.JsonObject Select(string id)=>System.Linq.Enumerable.Single(Call("load")["items"]!.AsArray(),x=>x!["id"]!.ToString()==id)!.AsObject();
System.Text.Json.Nodes.JsonObject Delete(string id){var value=Input(id);value["hash"]=Select(id)["hash"]!.DeepClone();return value;}
string Folder(string name,string? parent=null,string? id=null){id??=Id();var value=Input(id);value["name"]=name;value["parent"]=parent;Call("create-folder",value);return id;}
void Move(string[] ids,string? parent){var value=new System.Text.Json.Nodes.JsonObject{["revision"]=Call("load")["revision"]!.DeepClone(),["command"]=Id(),["ids"]=new System.Text.Json.Nodes.JsonArray(System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Select(ids,x=>(System.Text.Json.Nodes.JsonNode?)System.Text.Json.Nodes.JsonValue.Create(x)))),["parent"]=parent};Call("move",value);}
System.Text.Json.Nodes.JsonObject Import(string id){var input=new System.Text.Json.Nodes.JsonObject{["revision"]=File("load")["revision"]!.DeepClone(),["command"]=Id(),["item"]=new System.Text.Json.Nodes.JsonObject{["id"]=id,["name"]="original <safe>.txt",["type"]="text/plain",["size"]=3,["hash"]=Hash("abc"),["modifiedAt"]=0,["data"]="YWJj"}};File("import",input);return input;}
void Rename(string op,string id,string name){var value=Input(id);value["name"]=name;Call(op,value);}
string[] paths={"project.cproj",".confectory/project-identity.json",".confectory/resources.v1.json",".confectory/resource-layout.v1.json",".confectory/resource-file-names.v1.json",".confectory/resource-folder-names.v1.json",".confectory/resource-deletions.v1.json"};
string[] Snapshot()=>System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Select(paths,p=>System.IO.File.Exists(System.IO.Path.Combine(root,p))?System.IO.File.ReadAllText(System.IO.Path.Combine(root,p)):"missing"));
void Reject(Action action,string text){var before=Snapshot();bool rejected=false;try{action();}catch{rejected=true;}Check(rejected,text);Check(System.Linq.Enumerable.SequenceEqual(before,Snapshot()),text+" preserves all seven observed files");}

