string root=Environment.GetEnvironmentVariable("CONFECTORY_RESOURCE_CASE")!;System.IO.Directory.CreateDirectory(System.IO.Path.Combine(root,".confectory"));string manifest=System.IO.Path.Combine(root,"project.cproj"),project=Guid.NewGuid().ToString("N"),store=System.IO.Path.Combine(root,".confectory/resources.v1.json");System.IO.File.WriteAllText(manifest,"source");System.IO.File.WriteAllText(System.IO.Path.Combine(root,".confectory/project-identity.json"),new System.Text.Json.Nodes.JsonObject{["version"]=1,["manifest"]=manifest,["projectId"]=project}.ToJsonString());
var checks=new System.Text.Json.Nodes.JsonArray();void Check(bool value,string text){if(!value)throw new Exception(text);checks.Add(text);}string Id()=>Guid.NewGuid().ToString("N");string Hash(byte[] value)=>Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(value)).ToLowerInvariant();
System.Text.Json.Nodes.JsonObject Call(string action,System.Text.Json.Nodes.JsonObject? value=null)=>System.Text.Json.Nodes.JsonNode.Parse(calls.Layout.Invoke(manifest,project,action,(value??new()).ToJsonString()))!.AsObject();
System.Text.Json.Nodes.JsonObject Files(string action,System.Text.Json.Nodes.JsonObject? value=null)=>System.Text.Json.Nodes.JsonNode.Parse(calls.Request.Invoke(manifest,project,action,(value??new()).ToJsonString()))!.AsObject();
bool Refused(string action,System.Text.Json.Nodes.JsonObject value){try{Call(action,value);return false;}catch{return true;}}
string Add(string name,byte[] bytes,string type="text/plain"){string id=Id();Files("import",new(){["revision"]=Files("load")["revision"]!.DeepClone(),["command"]=Id(),["item"]=new System.Text.Json.Nodes.JsonObject{["id"]=id,["name"]=name,["type"]=type,["size"]=bytes.Length,["hash"]=Hash(bytes),["modifiedAt"]=0,["data"]=Convert.ToBase64String(bytes).Replace('+','-').Replace('/','_')}});return id;}
System.Text.Json.Nodes.JsonObject Item(string id)=>System.Linq.Enumerable.Single(Call("load")["items"]!.AsArray(),row=>row!["id"]!.ToString()==id)!.AsObject();


string a=Id(),b=Id();Call("create-folder",new(){["revision"]=Call("load")["revision"]!.DeepClone(),["command"]=Id(),["id"]=a,["name"]="상위 A 🧪",["parent"]=null});Call("create-folder",new(){["revision"]=Call("load")["revision"]!.DeepClone(),["command"]=Id(),["id"]=b,["name"]="B",["parent"]=a});string file=Add("file.txt",System.Text.Encoding.UTF8.GetBytes("source"));Call("move",new(){["revision"]=Call("load")["revision"]!.DeepClone(),["command"]=Id(),["ids"]=new System.Text.Json.Nodes.JsonArray(file),["parent"]=b});
foreach(string selected in new[]{file,b,a}){var current=Call("load");var row=Item(selected);var input=new System.Text.Json.Nodes.JsonObject{["id"]=selected,["hash"]=row["hash"]!.DeepClone(),["revision"]=current["revision"]!.DeepClone()};var result=Call("locate",input);Check(result["format"]!.ToString()=="resource-location-v1"&&System.Text.Json.Nodes.JsonNode.DeepEquals(result["item"],row),"exact located row");Check(System.Text.Json.Nodes.JsonNode.DeepEquals(result["parent"]?["id"],row["parent"]),"actual containing category or project root");Check(result.ToJsonString().Length<16384&&!result.ContainsKey("data"),"metadata only bounded response");var wrong=input.DeepClone().AsObject();wrong["revision"]=new string('0',64);Check(Refused("locate",wrong),"stale complete revision refused");wrong=input.DeepClone().AsObject();wrong["hash"]=new string('0',64);Check(Refused("locate",wrong),"stale item hash refused");wrong=input.DeepClone().AsObject();wrong["path"]="/outside";Check(Refused("locate",wrong),"path field refused");}
Check(System.IO.File.ReadAllText(manifest)=="source","original source preserved");System.IO.File.WriteAllText(System.IO.Path.Combine(root,"checks.json"),checks.ToJsonString());Console.WriteLine(checks.ToJsonString());return 0;
