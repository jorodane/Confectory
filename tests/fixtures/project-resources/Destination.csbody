string root=Environment.GetEnvironmentVariable("CONFECTORY_RESOURCE_CASE")!;System.IO.Directory.CreateDirectory(System.IO.Path.Combine(root,".confectory"));string manifest=System.IO.Path.Combine(root,"project.cproj"),identity=System.IO.Path.Combine(root,".confectory/project-identity.json"),store=System.IO.Path.Combine(root,".confectory/resources.v1.json"),layout=System.IO.Path.Combine(root,".confectory/resource-layout.v1.json"),project=Guid.NewGuid().ToString("N");
System.IO.File.WriteAllText(manifest,"project Probe.Assets version \"1\" {standalone true;}");System.IO.File.WriteAllText(identity,new System.Text.Json.Nodes.JsonObject{["version"]=1,["manifest"]=manifest,["namespace"]="Probe.Assets",["projectId"]=project}.ToJsonString());string original=System.IO.File.ReadAllText(manifest),originalIdentity=System.IO.File.ReadAllText(identity);
var checks=new System.Text.Json.Nodes.JsonArray();void Check(bool ok,string text){if(!ok)throw new Exception(text);checks.Add(text);}
System.Text.Json.Nodes.JsonObject Call(string op,System.Text.Json.Nodes.JsonObject? input=null,string? owner=null)=>System.Text.Json.Nodes.JsonNode.Parse(calls.Layout.Invoke(manifest,owner??project,op,(input??new()).ToJsonString()))!.AsObject();
System.Text.Json.Nodes.JsonObject File(string op,System.Text.Json.Nodes.JsonObject? input=null)=>System.Text.Json.Nodes.JsonNode.Parse(calls.Request.Invoke(manifest,project,op,(input??new()).ToJsonString()))!.AsObject();
string Id()=>Guid.NewGuid().ToString("N");System.Text.Json.Nodes.JsonObject Folder(string id,string name,string? parent=null)=>new(){["revision"]=Call("load")["revision"]!.DeepClone(),["command"]=Id(),["id"]=id,["name"]=name,["parent"]=parent};
System.Text.Json.Nodes.JsonObject Move(string? parent,params string[] ids){var list=new System.Text.Json.Nodes.JsonArray();foreach(var id in ids)list.Add(id);return new(){["revision"]=Call("load")["revision"]!.DeepClone(),["command"]=Id(),["ids"]=list,["parent"]=parent};}
void Reject(string op,System.Text.Json.Nodes.JsonObject input,string text,string? owner=null){string before=System.IO.File.Exists(layout)?System.IO.File.ReadAllText(layout):"missing";bool failed=false;try{Call(op,input,owner);}catch{failed=true;}Check(failed,text);Check((System.IO.File.Exists(layout)?System.IO.File.ReadAllText(layout):"missing")==before,text+" leaves exact layout");}
System.Text.Json.Nodes.JsonObject Entry(string name,string text="abc")=>new(){["command"]=Id(),["item"]=new System.Text.Json.Nodes.JsonObject{["id"]=Id(),["name"]=name,["type"]="text/plain",["size"]=System.Text.Encoding.UTF8.GetByteCount(text),["hash"]=Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(text))).ToLowerInvariant(),["modifiedAt"]=0,["data"]=Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(text)).Replace('+','-').Replace('/','_')}};
System.Text.Json.Nodes.JsonObject Into(string? parent,params System.Text.Json.Nodes.JsonObject[] entries){var value=Call("load");var rows=new System.Text.Json.Nodes.JsonArray();foreach(var entry in entries)rows.Add(entry.DeepClone());return new(){["revision"]=value["revision"]!.DeepClone(),["resourceRevision"]=value["resourceRevision"]!.DeepClone(),["command"]=Id(),["parent"]=parent,["imports"]=rows};}
void RejectAll(System.Text.Json.Nodes.JsonObject input,string label,string? owner=null){byte[]? before=System.IO.File.Exists(store)?System.IO.File.ReadAllBytes(store):null;string serialized=input.ToJsonString();Reject("import-files",input,label,owner);Check(before is null?!System.IO.File.Exists(store):System.Linq.Enumerable.SequenceEqual(before,System.IO.File.ReadAllBytes(store)),label+" leaves exact file store");Check(input.ToJsonString()==serialized,label+" preserves submitted input");}
Check(Call("load")["items"]!.AsArray().Count==0&&!System.IO.File.Exists(layout)&&!System.IO.File.Exists(store),"empty read has no side effect");string a=Id(),b=Id(),c=Id();Call("create-folder",Folder(a,"A"));Call("create-folder",Folder(b,"중첩 <B>",a));Call("create-folder",Folder(c,"C"));Check(!System.IO.File.Exists(store),"creating nested categories does not create a file store");
var first=Entry("한글.txt","원래\r\nbytes" );var second=Entry("한글.txt");var input=Into(b,first,second);var bad=input.DeepClone().AsObject();bad["imports"]![1]!["item"]!["hash"]=new string('0',64);RejectAll(bad,"bad second file rejects the complete first save");RejectAll(Into(Id(),Entry("missing.txt")),"missing destination never falls back to root");RejectAll(Into(null,Entry("root.txt")),"this API does not silently choose a root destination");
var result=Call("import-files",input);Check(File("load")["items"]!.AsArray().Count==2&&result["selectedIds"]!.AsArray().Count==2,"first import and two placements are one group");foreach(var entry in new[]{first,second})Check(System.Linq.Enumerable.Single(result["items"]!.AsArray(),x=>x!["id"]!.ToString()==entry["item"]!["id"]!.ToString())!["parent"]!.ToString()==b,"new file is visible only in its chosen nested category");string bytes=System.IO.File.ReadAllText(store),topology=System.IO.File.ReadAllText(layout);Check(Call("import-files",input)["replayed"]!.GetValue<bool>()&&System.IO.File.ReadAllText(store)==bytes&&System.IO.File.ReadAllText(layout)==topology,"exact lost-response retry does not rewrite either file");
bad=input.DeepClone().AsObject();bad["parent"]=c;RejectAll(bad,"same layout command cannot retarget the selection");bad=input.DeepClone().AsObject();bad["imports"]![0]!["item"]!["name"]="changed.txt";RejectAll(bad,"same import command cannot change a selected file");RejectAll(Into(c,first,second),"confirmed root or folder imports require an explicit move rather than reimport placement");
var stale=Into(c,Entry("stale one.txt"),Entry("stale two.txt"));Call("rename-folder",new(){["revision"]=Call("load")["revision"]!.DeepClone(),["command"]=Id(),["id"]=c,["name"]="renamed C"});RejectAll(stale,"folder name changes invalidate the observed complete basis");
var retry=Into(c,Entry("retry one.txt"),Entry("retry two.txt"));System.IO.File.SetAttributes(layout,System.IO.File.GetAttributes(layout)|System.IO.FileAttributes.ReadOnly);try{RejectAll(retry,"second-file write refusal rolls back the resource append");}finally{System.IO.File.SetAttributes(layout,System.IO.File.GetAttributes(layout)&~System.IO.FileAttributes.ReadOnly);}Call("import-files",retry);Check(Call("import-files",retry)["replayed"]!.GetValue<bool>(),"explicit retry after write refusal restores the whole group once");
string firstId=first["item"]!["id"]!.ToString();Call("rename-file",new(){["revision"]=Call("load")["revision"]!.DeepClone(),["command"]=Id(),["id"]=firstId,["name"]="renamed file.txt"});Call("rename-folder",new(){["revision"]=Call("load")["revision"]!.DeepClone(),["command"]=Id(),["id"]=b,["name"]="renamed B"});string aliases=System.IO.File.ReadAllText(System.IO.Path.Combine(root,".confectory/resource-folder-names.v1.json")),fileAliases=System.IO.File.ReadAllText(System.IO.Path.Combine(root,".confectory/resource-file-names.v1.json"));Call("save-content",new(){["revision"]=Call("load")["revision"]!.DeepClone(),["command"]=Id(),["id"]=firstId,["hash"]=first["item"]!["hash"]!.DeepClone(),["type"]="text/plain",["size"]=3,["data"]="WFla"});string content=System.IO.File.ReadAllText(System.IO.Path.Combine(root,".confectory/resource-content/"+firstId+".v1.json"));var more=Call("import-files",Into(c,Entry("third group.txt")));var firstMetadata=System.Linq.Enumerable.Single(more["items"]!.AsArray(),x=>x!["id"]!.ToString()==firstId)!;Check(firstMetadata["name"]!.ToString()=="renamed file.txt"&&System.IO.File.ReadAllText(System.IO.Path.Combine(root,".confectory/resource-folder-names.v1.json"))==aliases&&System.IO.File.ReadAllText(System.IO.Path.Combine(root,".confectory/resource-file-names.v1.json"))==fileAliases&&firstMetadata["hash"]!.ToString()==Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes("XYZ"))).ToLowerInvariant()&&System.IO.File.ReadAllText(System.IO.Path.Combine(root,".confectory/resource-content/"+firstId+".v1.json"))==content,"new import preserves existing current content, backup and metadata");
Call("move",Move(c,firstId));var replay=Call("import-files",input);Check(replay["replayed"]!.GetValue<bool>()&&System.Linq.Enumerable.Single(replay["items"]!.AsArray(),x=>x!["id"]!.ToString()==firstId)!["parent"]!.ToString()==c,"reconfirming old import cannot undo a later explicit move");var current=System.Linq.Enumerable.Single(Call("load")["items"]!.AsArray(),x=>x!["id"]!.ToString()==firstId)!;Call("delete-file",new(){["revision"]=Call("load")["revision"]!.DeepClone(),["command"]=Id(),["id"]=firstId,["hash"]=current["hash"]!.DeepClone()});RejectAll(input,"deleted member cannot be resurrected by import replay");
var replacement=Entry("new generation.txt","new bytes");replacement["item"]!["id"]=firstId;var recreated=Call("import-files",Into(c,replacement));var read=Call("read",new(){["id"]=firstId,["hash"]=replacement["item"]!["hash"]!.DeepClone()});Check(read["data"]!.ToString()==replacement["item"]!["data"]!.ToString(),"explicit new generation never adopts deleted content or backup bytes");
string d=Id();Call("create-folder",Folder(d,"temporary"));var retired=Into(d,Entry("never root.txt"));var folder=System.Linq.Enumerable.Single(Call("load")["items"]!.AsArray(),x=>x!["id"]!.ToString()==d)!;Call("delete-folder",new(){["revision"]=Call("load")["revision"]!.DeepClone(),["command"]=Id(),["id"]=d,["hash"]=folder["hash"]!.DeepClone()});RejectAll(retired,"destination removed before first save is not silently replaced");RejectAll(Into(c,Entry("foreign.txt")),"foreign project identity cannot adopt the destination",Id());
Check(System.IO.File.ReadAllText(manifest)==original&&System.IO.File.ReadAllText(identity)==originalIdentity,"original source and project identity are unchanged");Check(File("load")["items"]!.AsArray().Count==5,"flat v1 native reader retains exactly the confirmed files");System.IO.File.WriteAllText(System.IO.Path.Combine(root,"checks.json"),checks.ToJsonString());Console.WriteLine(checks.ToJsonString());return 0;
