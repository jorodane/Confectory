string root=Environment.GetEnvironmentVariable("CONFECTORY_RESOURCE_CASE")!;System.IO.Directory.CreateDirectory(System.IO.Path.Combine(root,".confectory"));string manifest=System.IO.Path.Combine(root,"project.cproj"),project=Guid.NewGuid().ToString("N"),store=System.IO.Path.Combine(root,".confectory/resources.v1.json"),ledger=System.IO.Path.Combine(root,".confectory/resource-deletions.v1.json"),identity=System.IO.Path.Combine(root,".confectory/project-identity.json");
System.IO.File.WriteAllText(manifest,"original source");System.IO.File.WriteAllText(identity,new System.Text.Json.Nodes.JsonObject{["version"]=1,["manifest"]=manifest,["projectId"]=project}.ToJsonString());string source=System.IO.File.ReadAllText(manifest),owner=System.IO.File.ReadAllText(identity);
var checks=new System.Text.Json.Nodes.JsonArray();void Check(bool ok,string text){if(!ok)throw new Exception(text);checks.Add(text);}string Id()=>Guid.NewGuid().ToString("N");string Hash(string text)=>Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(text))).ToLowerInvariant();
System.Text.Json.Nodes.JsonObject Call(string op,System.Text.Json.Nodes.JsonObject? input=null,string? p=null)=>System.Text.Json.Nodes.JsonNode.Parse(calls.Layout.Invoke(manifest,p??project,op,(input??new()).ToJsonString()))!.AsObject();System.Text.Json.Nodes.JsonObject File(string op,System.Text.Json.Nodes.JsonObject? input=null)=>System.Text.Json.Nodes.JsonNode.Parse(calls.Request.Invoke(manifest,project,op,(input??new()).ToJsonString()))!.AsObject();
System.Text.Json.Nodes.JsonObject Import(string id)=>new(){["revision"]=File("load")["revision"]!.DeepClone(),["command"]=Id(),["item"]=new System.Text.Json.Nodes.JsonObject{["id"]=id,["name"]="copy <safe>.txt",["type"]="text/plain",["size"]=3,["hash"]=Hash("abc"),["modifiedAt"]=0,["data"]="YWJj"}};
System.Text.Json.Nodes.JsonObject Delete(string id)=>new(){["revision"]=Call("load")["revision"]!.DeepClone(),["command"]=Id(),["id"]=id,["hash"]=Hash("abc")};
void Reject(Action action,string text){string a=System.IO.File.ReadAllText(store),b=System.IO.File.Exists(ledger)?System.IO.File.ReadAllText(ledger):"missing";bool rejected=false;try{action();}catch{rejected=true;}Check(rejected,text);Check(System.IO.File.ReadAllText(store)==a&&(System.IO.File.Exists(ledger)?System.IO.File.ReadAllText(ledger):"missing")==b,text+" preserves exact source records");}
Call("load");Check(!System.IO.File.Exists(ledger),"loading does not create deletion data");string id=Id(),peer=Id(),folder=Id();var original=Import(id);File("import",original);var peerImport=Import(peer);File("import",peerImport);string peerStored=System.Linq.Enumerable.Single(System.Text.Json.Nodes.JsonNode.Parse(System.IO.File.ReadAllText(store))!["items"]!.AsArray(),row=>row!["id"]!.ToString()==peer)!.ToJsonString();
Call("create-folder",new(){["revision"]=Call("load")["revision"]!.DeepClone(),["command"]=Id(),["id"]=folder,["name"]="folder",["parent"]=null});Call("move",new(){["revision"]=Call("load")["revision"]!.DeepClone(),["command"]=Id(),["ids"]=new System.Text.Json.Nodes.JsonArray(id,peer),["parent"]=folder});Call("rename-file",new(){["revision"]=Call("load")["revision"]!.DeepClone(),["command"]=Id(),["id"]=id,["name"]="display name.md"});
var request=Delete(id);var stale=request.DeepClone().AsObject();stale["hash"]=Hash("wrong");Reject(()=>Call("delete-file",stale),"wrong bytes refused");Reject(()=>Call("delete-file",Delete(folder)),"folder cannot enter file deletion");Reject(()=>Call("delete-file",request,Id()),"foreign owner refused");var injected=request.DeepClone().AsObject();injected["path"]="outside";Reject(()=>Call("delete-file",injected),"path injection refused");
string names=System.IO.Path.Combine(root,".confectory/resource-file-names.v1.json"),topology=System.IO.Path.Combine(root,".confectory/resource-layout.v1.json");var mode=System.IO.File.GetAttributes(names);System.IO.File.SetAttributes(names,mode|System.IO.FileAttributes.ReadOnly);try{Reject(()=>Call("delete-file",request),"write refusal retains exact deletion intent");}finally{System.IO.File.SetAttributes(names,mode);}string pending=request.ToJsonString();var result=Call("delete-file",request);Check(request.ToJsonString()==pending,"caller input remains exact");Check(!System.Linq.Enumerable.Any(result["items"]!.AsArray(),row=>row!["id"]!.ToString()==id)&&result["items"]!.AsArray().Count==2,"selected copy only removed; peer and category survive");Check(System.Text.Json.Nodes.JsonNode.Parse(System.IO.File.ReadAllText(names))!["items"]!.AsArray().Count==0,"display-name alias removed atomically");Check(System.Text.Json.Nodes.JsonNode.Parse(System.IO.File.ReadAllText(topology))!["placements"]!.AsArray().Count==1,"selected placement removed; peer batch-move history remains valid");Check(System.Linq.Enumerable.Single(System.Text.Json.Nodes.JsonNode.Parse(System.IO.File.ReadAllText(store))!["items"]!.AsArray(),row=>row!["id"]!.ToString()==peer)!.ToJsonString()==peerStored,"survivor bytes and original import proof remain exact");
string receipt=System.IO.File.ReadAllText(ledger);Check(!receipt.Contains("YWJj")&&!receipt.Contains("display name")&&!receipt.Contains("copy <safe>"),"receipt has no file content/name/backup");Check(Call("delete-file",request)["replayed"]!.GetValue<bool>()&&System.IO.File.ReadAllText(ledger)==receipt,"exact lost response replay does not append or delete again");Reject(()=>File("import",original),"retired original import command cannot resurrect deleted copy");Reject(()=>Call("read",new(){["id"]=id,["hash"]=Hash("abc")}),"deleted bytes unavailable to current preview");var reused=request.DeepClone().AsObject();reused["id"]=peer;Reject(()=>Call("delete-file",reused),"delete command cannot be reused for another file");
var fresh=Import(id);File("import",fresh);Check(Call("delete-file",request)["replayed"]!.GetValue<bool>()&&System.Linq.Enumerable.Any(Call("load")["items"]!.AsArray(),row=>row!["id"]!.ToString()==id),"old delete replay never deletes a newer explicitly imported generation");var current=Delete(id);Call("delete-file",current);Check(System.Text.Json.Nodes.JsonNode.Parse(System.IO.File.ReadAllText(ledger))!["items"]!.AsArray().Count==2,"separate generations retain separate receipts");Reject(()=>Call("delete-file",Delete(Id())),"missing ID is not implicit success");
string good=System.IO.File.ReadAllText(ledger);var corrupt=System.Text.Json.Nodes.JsonNode.Parse(good)!;corrupt["items"]![0]!["import"]=Id();System.IO.File.WriteAllText(ledger,corrupt.ToJsonString());try{Reject(()=>Call("load"),"corrupt receipt fails closed");Reject(()=>File("import",Import(Id())),"import cannot ignore corrupt receipt history");}finally{System.IO.File.WriteAllText(ledger,good);}Check(Call("load")["items"]!.AsArray().Count==2,"verified receipt restoration recovers current catalogue");
Call("delete-file",Delete(peer));string empty=File("load")["revision"]!.ToString();string next=Id();var delayed=Import(next);File("import",delayed);Call("delete-file",Delete(next));Check(File("load")["revision"]!.ToString()==empty,"empty store revision ABA is reproduced exactly");Reject(()=>File("import",delayed),"retired delayed import cannot resurrect through empty-store ABA");Check(File("load")["items"]!.AsArray().Count==0&&Call("load")["items"]!.AsArray().Count==1,"empty files and retained category remain readable");
string bounded=System.IO.File.ReadAllText(ledger);var oversized=System.Text.Json.Nodes.JsonNode.Parse(bounded)!.AsObject();var many=oversized["items"]!.AsArray();while(many.Count<4097)many.Add(many[0]!.DeepClone());System.IO.File.WriteAllText(ledger,oversized.ToJsonString());try{Reject(()=>Call("load"),"receipt count limit fails closed without pruning");}finally{System.IO.File.WriteAllText(ledger,bounded);}Check(System.IO.File.ReadAllText(ledger)==bounded,"receipt limit refusal preserves complete history");
Check(System.IO.File.ReadAllText(manifest)==source&&System.IO.File.ReadAllText(identity)==owner,"project source/identity unchanged");System.IO.File.WriteAllText(System.IO.Path.Combine(root,"checks.json"),checks.ToJsonString());Console.WriteLine(checks.ToJsonString());return 0;
