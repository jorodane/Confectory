string root=Environment.GetEnvironmentVariable("CONFECTORY_RESOURCE_CASE")!;System.IO.Directory.CreateDirectory(System.IO.Path.Combine(root,".confectory"));string manifest=System.IO.Path.Combine(root,"project.cproj"),project=Guid.NewGuid().ToString("N"),store=System.IO.Path.Combine(root,".confectory/resources.v1.json");System.IO.File.WriteAllText(manifest,"source");System.IO.File.WriteAllText(System.IO.Path.Combine(root,".confectory/project-identity.json"),new System.Text.Json.Nodes.JsonObject{["version"]=1,["manifest"]=manifest,["projectId"]=project}.ToJsonString());
var checks=new System.Text.Json.Nodes.JsonArray();void Check(bool value,string text){if(!value)throw new Exception(text);checks.Add(text);}string Id()=>Guid.NewGuid().ToString("N");string Hash(byte[] value)=>Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(value)).ToLowerInvariant();
System.Text.Json.Nodes.JsonObject Call(string action,System.Text.Json.Nodes.JsonObject? value=null)=>System.Text.Json.Nodes.JsonNode.Parse(calls.Layout.Invoke(manifest,project,action,(value??new()).ToJsonString()))!.AsObject();
System.Text.Json.Nodes.JsonObject Files(string action,System.Text.Json.Nodes.JsonObject? value=null)=>System.Text.Json.Nodes.JsonNode.Parse(calls.Request.Invoke(manifest,project,action,(value??new()).ToJsonString()))!.AsObject();
bool Refused(string action,System.Text.Json.Nodes.JsonObject value){try{Call(action,value);return false;}catch{return true;}}
string Add(string name,byte[] bytes,string type="text/plain"){string id=Id();Files("import",new(){["revision"]=Files("load")["revision"]!.DeepClone(),["command"]=Id(),["item"]=new System.Text.Json.Nodes.JsonObject{["id"]=id,["name"]=name,["type"]=type,["size"]=bytes.Length,["hash"]=Hash(bytes),["modifiedAt"]=0,["data"]=Convert.ToBase64String(bytes).Replace('+','-').Replace('/','_')}});return id;}
System.Text.Json.Nodes.JsonObject Item(string id)=>System.Linq.Enumerable.Single(Call("load")["items"]!.AsArray(),row=>row!["id"]!.ToString()==id)!.AsObject();
System.Text.Json.Nodes.JsonObject Input(string id,byte[]? data=null){var input=new System.Text.Json.Nodes.JsonObject{["revision"]=Call("load")["revision"]!.DeepClone(),["command"]=Id(),["id"]=id,["hash"]=Item(id)["hash"]!.DeepClone()};if(data is not null){input["type"]=Item(id)["type"]!.DeepClone();input["size"]=data.Length;input["data"]=Convert.ToBase64String(data).Replace('+','-').Replace('/','_');}return input;}
byte[] Read(string id)=>Convert.FromBase64String(Call("read",new(){["id"]=id,["hash"]=Item(id)["hash"]!.DeepClone()})["data"]!.ToString().Replace('-','+').Replace('_','/'));
string id=Add("생성 텍스트.txt",System.Text.Encoding.UTF8.GetBytes("원문\r\n")),peer=Add("peer.txt",new byte[]{97,98,99}),image=Add("picture.svg",System.Text.Encoding.UTF8.GetBytes("<svg/>"),"image/svg+xml");byte[] original=System.IO.File.ReadAllBytes(store);var next=System.Text.Encoding.UTF8.GetBytes("수정 🧪\r\n<script>literal</script>\r\n");var intent=Input(id,next);var changed=Call("save-content",intent);Check(System.Linq.Enumerable.SequenceEqual(Read(id),next),"actual provider edits selected copy bytes");Check(System.Linq.Enumerable.SequenceEqual(System.IO.File.ReadAllBytes(store),original),"immutable imported data and receipts unchanged");Check(System.Linq.Enumerable.SequenceEqual(Read(peer),new byte[]{97,98,99}),"unselected peer unchanged");Check(Call("save-content",intent)["replayed"]!.GetValue<bool>(),"exact lost response save replays without another backup");
var restore=Input(id);Call("restore-content",restore);Check(System.Text.Encoding.UTF8.GetString(Read(id))=="원문\r\n","one-save backup restores original bytes");Check(Call("restore-content",restore)["replayed"]!.GetValue<bool>(),"lost restore reply does not toggle again");Call("restore-content",Input(id));Check(System.Linq.Enumerable.SequenceEqual(Read(id),next),"restore cancel swaps backup and current");Check(Refused("save-content",intent),"superseded command never overwrites later generation");Check(Refused("save-content",Input(image,next)),"image editing unsupported and unchanged");
var renamed=new System.Text.Json.Nodes.JsonObject{["revision"]=Call("load")["revision"]!.DeepClone(),["command"]=Id(),["id"]=id,["name"]="이름 변경.txt"};Call("rename-file",renamed);Check(System.Linq.Enumerable.SequenceEqual(Read(id),next)&&Item(id)["name"]!.ToString()=="이름 변경.txt","display rename retains edited bytes and original identity");
var stale=Input(id,System.Text.Encoding.UTF8.GetBytes("stale"));Call("save-content",Input(peer,System.Text.Encoding.UTF8.GetBytes("peer edit")));Check(Refused("save-content",stale),"peer content participates in final composite revision");var full=new byte[1048576];Array.Fill(full,(byte)65);Call("save-content",Input(id,full));Check(Read(id).Length==1048576,"authored full 1MiB editing boundary");var oversized=Input(id,new byte[1048577]);Check(Refused("save-content",oversized),"oversized request preserves existing contents");
var selected=new System.Text.Json.Nodes.JsonArray(new System.Text.Json.Nodes.JsonObject{["id"]=id,["hash"]=Item(id)["hash"]!.DeepClone()},new System.Text.Json.Nodes.JsonObject{["id"]=peer,["hash"]=Item(peer)["hash"]!.DeepClone()});Call("delete-selected",new(){["revision"]=Call("load")["revision"]!.DeepClone(),["command"]=Id(),["targets"]=selected});Check(Call("load")["items"]!.AsArray().Count==1,"selected deletion removes edited descendants without affecting outside image");foreach(string deleted in new[]{id,peer}){var tombstone=System.Text.Json.Nodes.JsonNode.Parse(System.IO.File.ReadAllText(System.IO.Path.Combine(root,".confectory/resource-content/"+deleted+".v1.json")))!;Check(tombstone["deleted"]!.GetValue<bool>()&&tombstone["current"]is null&&tombstone["backup"]is null,"deleted current and backup scrubbed");}Check(System.IO.File.ReadAllText(manifest)=="source","source/ABI untouched");System.IO.File.WriteAllText(System.IO.Path.Combine(root,"checks.json"),checks.ToJsonString());Console.WriteLine(checks.ToJsonString());return 0;
