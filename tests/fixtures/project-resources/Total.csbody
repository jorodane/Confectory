string root=Environment.GetEnvironmentVariable("CONFECTORY_RESOURCE_CASE")??throw new InvalidOperationException("owned fixture root required");System.IO.Directory.CreateDirectory(System.IO.Path.Combine(root,".confectory"));
string manifest=System.IO.Path.Combine(root,"project.cproj"),identityPath=System.IO.Path.Combine(root,".confectory/project-identity.json"),store=System.IO.Path.Combine(root,".confectory/resources.v1.json"),project=Guid.NewGuid().ToString("N");System.IO.File.WriteAllText(manifest,"original owned source");System.IO.File.WriteAllText(identityPath,new System.Text.Json.Nodes.JsonObject{["version"]=1,["manifest"]=manifest,["namespace"]="Probe.Total",["projectId"]=project}.ToJsonString());byte[] source=System.IO.File.ReadAllBytes(manifest),identity=System.IO.File.ReadAllBytes(identityPath);
var checks=new System.Text.Json.Nodes.JsonArray();void Check(bool ok,string label){if(!ok)throw new InvalidOperationException(label);checks.Add(label);}
System.Text.Json.Nodes.JsonObject Call(string op,System.Text.Json.Nodes.JsonObject? value=null,string? owner=null)=>System.Text.Json.Nodes.JsonNode.Parse(calls.Request.Invoke(manifest,owner??project,op,(value??new()).ToJsonString()))!.AsObject();
string Hash(byte[] data)=>Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(data)).ToLowerInvariant();
void Reject(string op,System.Text.Json.Nodes.JsonObject value,string label,string? owner=null){byte[]? prior=System.IO.File.Exists(store)?System.IO.File.ReadAllBytes(store):null;bool rejected=false;try{Call(op,value,owner);}catch{rejected=true;}Check(rejected,label);Check(prior is null?!System.IO.File.Exists(store):System.Linq.Enumerable.SequenceEqual(prior,System.IO.File.ReadAllBytes(store)),label+" retains exact store");}
var empty=Call("load");Check(!System.IO.File.Exists(store)&&empty["revision"]!.ToString()=="missing","read does not create storage");Check(empty["limits"]!["fileBytes"]!.GetValue<int>()==4194304&&empty["limits"]!["totalBytes"]!.GetValue<int>()==8388608&&empty["limits"]!["readFileBytes"]!.GetValue<int>()==1048576,"independent explicit copy/read/total budgets");
byte[] bytes=new byte[4194304];uint noise=0x1730489Du;for(int i=0;i<bytes.Length;i++){noise^=noise<<13;noise^=noise>>17;noise^=noise<<5;bytes[i]=(byte)noise;}
var item=new System.Text.Json.Nodes.JsonObject{["id"]=Guid.NewGuid().ToString("N"),["name"]="최대 원본 🧪.bin",["type"]="application/octet-stream",["size"]=bytes.Length,["hash"]=Hash(bytes),["modifiedAt"]=0,["data"]=Convert.ToBase64String(bytes).Replace('+','-').Replace('/','_')};
var input=new System.Text.Json.Nodes.JsonObject{["revision"]="missing",["command"]=Guid.NewGuid().ToString("N"),["item"]=item.DeepClone()};var bad=input.DeepClone().AsObject();bad["item"]!["size"]=4194305;Reject("import",bad,"oversized file refused before decode/write");bad=input.DeepClone().AsObject();bad["item"]!["hash"]=new string('0',64);Reject("import",bad,"large content SHA is checked");bad=input.DeepClone().AsObject();bad["item"]!["data"]=item["data"]!.ToString().TrimEnd('=');Reject("import",bad,"large base64 remains canonical");
var added=Call("import",input);Check(added["items"]!.AsArray().Count==1&&added["selected"]!.ToString()==item["id"]!.ToString(),"one full4MiB copy preserves identity");Check(added.ToJsonString().Length<16384&&added["items"]![0]!["data"]is null,"large listing has metadata only");byte[] saved=System.IO.File.ReadAllBytes(store);Check(saved.Length<6291456,"same6MiB store ceiling");var stored=System.Text.Json.Nodes.JsonNode.Parse(saved)!;Check(stored["version"]!.GetValue<int>()==1&&stored["items"]![0]!["data"]!.ToString()==item["data"]!.ToString(),"same v1 fields preserve every high-entropy byte");
Check(Call("import",input)["replayed"]!.GetValue<bool>()&&System.Linq.Enumerable.SequenceEqual(saved,System.IO.File.ReadAllBytes(store)),"lost reply replay performs no second write");
var read=Call("read",new(){["id"]=item["id"]!.DeepClone(),["hash"]=item["hash"]!.DeepClone()});Check(read["encoding"]!.ToString()=="unavailable"&&read["reason"]!.ToString()=="resource_preview_file_budget"&&read["data"]is null&&read.ToJsonString().Length<16384,"large preview publishes bounded honest metadata without raw data");
Reject("read",new(){["id"]=item["id"]!.DeepClone(),["hash"]=new string('0',64)},"large stale hash refused");Reject("read",new(){["id"]=Guid.NewGuid().ToString("N"),["hash"]=item["hash"]!.DeepClone()},"unknown large identity refused");Reject("load",new(),"foreign project refused",Guid.NewGuid().ToString("N"));Reject("load",new(){["path"]="/etc/passwd"},"client path refused");
Check(empty["limits"]!["importBytes"]!.GetValue<int>()==4194304,"selection budget remains4MiB");
var second=item.DeepClone().AsObject();second["id"]=Guid.NewGuid().ToString("N");second["name"]="두 번째 최대 🧪.bin";Array.Reverse(bytes);second["hash"]=Hash(bytes);second["data"]=Convert.ToBase64String(bytes).Replace('+','-').Replace('/','_');var append=new System.Text.Json.Nodes.JsonObject{["revision"]=added["revision"]!.DeepClone(),["command"]=Guid.NewGuid().ToString("N"),["item"]=second};var full=Call("import",append);var complete=System.IO.File.ReadAllBytes(store);Check(full["items"]!.AsArray().Count==2&&complete.Length<12582912,"two exact4MiB files fit bounded12MiB catalog");var current=System.Text.Json.Nodes.JsonNode.Parse(complete)!;Check(current["version"]!.GetValue<int>()==2,"only explicit crossing import promotes catalog version2");Check(current["items"]![0]!["data"]!.ToString()==stored["items"]![0]!["data"]!.ToString()&&current["items"]![1]!["data"]!.ToString()==second["data"]!.ToString(),"all8MiB high entropy bytes and first receipt remain exact");Check(Call("import",append)["replayed"]!.GetValue<bool>()&&System.Linq.Enumerable.SequenceEqual(complete,System.IO.File.ReadAllBytes(store)),"v2 exact replay has no second write");
var one=new System.Text.Json.Nodes.JsonObject{["id"]=Guid.NewGuid().ToString("N"),["name"]="one.bin",["type"]="",["size"]=1,["hash"]=Hash(new byte[]{1}),["modifiedAt"]=0,["data"]="AQ=="};Reject("import",new(){["revision"]=full["revision"]!.DeepClone(),["command"]=Guid.NewGuid().ToString("N"),["item"]=one.DeepClone()},"8MiB plus one fails before writing");Reject("import",new(){["revision"]=added["revision"]!.DeepClone(),["command"]=Guid.NewGuid().ToString("N"),["item"]=one.DeepClone()},"stale v1 basis cannot overwrite promoted v2");var collision=append.DeepClone().AsObject();collision["item"]!["name"]="changed";Reject("import",collision,"promoted exact command cannot change input");
foreach(var row in current["items"]!.AsArray()){var result=Call("read",new(){["id"]=row!["id"]!.DeepClone(),["hash"]=row["hash"]!.DeepClone()});Check(result["encoding"]!.ToString()=="unavailable"&&result["data"]is null,"large items still use bounded metadata read");}
Check(Call("load")["revision"]!.ToString()==full["revision"]!.ToString()&&System.Linq.Enumerable.SequenceEqual(complete,System.IO.File.ReadAllBytes(store)),"cold provider validates8MiB without rewriting");
var forged=current.DeepClone();forged["version"]=1;System.IO.File.WriteAllText(store,forged.ToJsonString());Reject("load",new(),"legacy v1 cannot smuggle enlarged aggregate");System.IO.File.WriteAllBytes(store,complete);Check(System.Linq.Enumerable.SequenceEqual(source,System.IO.File.ReadAllBytes(manifest))&&System.Linq.Enumerable.SequenceEqual(identity,System.IO.File.ReadAllBytes(identityPath)),"manifest and identity bytes unchanged");System.IO.File.WriteAllText(System.IO.Path.Combine(root,"checks.json"),checks.ToJsonString());Console.WriteLine(checks.ToJsonString());return 0;
