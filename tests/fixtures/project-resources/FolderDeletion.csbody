System.Text.Json.Nodes.JsonObject Delete(string id){var value=Input(id);value["hash"]=Select(id)["hash"]!.DeepClone();return value;}
string Folder(string name,string? parent=null,string? id=null){id??=Id();var value=Input(id);value["name"]=name;value["parent"]=parent;Call("create-folder",value);return id;}
void Move(string[] ids,string? parent){var value=new System.Text.Json.Nodes.JsonObject{["revision"]=Call("load")["revision"]!.DeepClone(),["command"]=Id(),["ids"]=new System.Text.Json.Nodes.JsonArray(System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Select(ids,x=>(System.Text.Json.Nodes.JsonNode?)System.Text.Json.Nodes.JsonValue.Create(x)))),["parent"]=parent};Call("move",value);}
