string root=Environment.GetEnvironmentVariable("CONFECTORY_RESOURCE_CASE")!;System.IO.Directory.CreateDirectory(System.IO.Path.Combine(root,".confectory"));string manifest=System.IO.Path.Combine(root,"project.cproj"),identity=System.IO.Path.Combine(root,".confectory/project-identity.json"),store=System.IO.Path.Combine(root,".confectory/resources.v1.json"),layout=System.IO.Path.Combine(root,".confectory/resource-layout.v1.json"),names=System.IO.Path.Combine(root,".confectory/resource-file-names.v1.json"),folderNames=System.IO.Path.Combine(root,".confectory/resource-folder-names.v1.json"),project=Guid.NewGuid().ToString("N");
System.IO.File.WriteAllText(manifest,"project Probe.Assets version \"1\" {standalone true;}");System.IO.File.WriteAllText(identity,new System.Text.Json.Nodes.JsonObject{["version"]=1,["manifest"]=manifest,["namespace"]="Probe.Assets",["projectId"]=project}.ToJsonString());string original=System.IO.File.ReadAllText(manifest),originalIdentity=System.IO.File.ReadAllText(identity);
var checks=new System.Text.Json.Nodes.JsonArray();void Check(bool ok,string text){if(!ok)throw new Exception(text);checks.Add(text);}string Id()=>Guid.NewGuid().ToString("N");
System.Text.Json.Nodes.JsonObject Call(string op,System.Text.Json.Nodes.JsonObject? input=null,string? owner=null)=>System.Text.Json.Nodes.JsonNode.Parse(calls.Layout.Invoke(manifest,owner??project,op,(input??new()).ToJsonString()))!.AsObject();System.Text.Json.Nodes.JsonObject File(string op,System.Text.Json.Nodes.JsonObject? input=null)=>System.Text.Json.Nodes.JsonNode.Parse(calls.Request.Invoke(manifest,project,op,(input??new()).ToJsonString()))!.AsObject();
System.Text.Json.Nodes.JsonObject Rename(string id,string name)=>new(){["revision"]=Call("load")["revision"]!.DeepClone(),["command"]=Id(),["id"]=id,["name"]=name};string Name(string id)=>System.Linq.Enumerable.Single(Call("load")["items"]!.AsArray(),x=>x!["id"]!.ToString()==id)!["name"]!.ToString();
void Reject(string op,System.Text.Json.Nodes.JsonObject input,string text,string? owner=null){string before=System.IO.File.Exists(names)?System.IO.File.ReadAllText(names):"missing";bool failed=false;try{Call(op,input,owner);}catch{failed=true;}Check(failed,text);Check((System.IO.File.Exists(names)?System.IO.File.ReadAllText(names):"missing")==before,text+" preserves exact name store");}
Call("load");Check(!System.IO.File.Exists(names),"read never creates file name metadata");string file=Id(),folder=Id(),hash=Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes("abc"))).ToLowerInvariant();var import=new System.Text.Json.Nodes.JsonObject{["revision"]="missing",["command"]=Id(),["item"]=new System.Text.Json.Nodes.JsonObject{["id"]=file,["name"]="원본.txt",["type"]="text/plain",["size"]=3,["hash"]=hash,["modifiedAt"]=0,["data"]="YWJj"}};File("import",import);var create=Rename(folder,"원래 폴더");create["parent"]=null;Call("create-folder",create);Call("rename-folder",Rename(folder,"폴더 표시명"));string originalStore=System.IO.File.ReadAllText(store),originalLayout=System.IO.File.ReadAllText(layout),originalFolderNames=System.IO.File.ReadAllText(folderNames);
var rename=Rename(file,"새 이름 <안전> 🧪.md");Call("rename-file",rename);Check(Name(file)=="새 이름 <안전> 🧪.md","file name changes with the same stable identity");Check(System.IO.File.ReadAllText(store)==originalStore&&System.IO.File.ReadAllText(layout)==originalLayout&&System.IO.File.ReadAllText(folderNames)==originalFolderNames,"rename leaves copy bytes/import receipt/topology/folder names unchanged");Check(Call("rename-file",rename)["replayed"]!.GetValue<bool>(),"exact name receipt confirms lost reply without another record");Check(File("import",import)["replayed"]!.GetValue<bool>(),"old import receipt still replays after display rename");
var read=new System.Text.Json.Nodes.JsonObject{["id"]=file,["hash"]=hash};var data=Call("read",read);Check(data["data"]!.ToString()=="YWJj"&&data["item"]!["name"]!.ToString()==Name(file)&&data["item"]!["type"]!.ToString()=="text/plain"&&data["item"]!["kind"]!.ToString()=="document","owned read returns current display metadata and unchanged verified bytes/MIME/kind");Check(File("read",read)["item"]!["name"]!.ToString()=="원본.txt","immutable original copy API retains its original metadata contract");Reject("read",new(){["id"]=file,["hash"]=new string('0',64)},"stale read hash refused");Reject("read",new(){["id"]=file,["hash"]=hash,["path"]="outside"},"read path injection refused");
var stale=Rename(file,"old");var next=Rename(file,"이름만 변경.bin");Call("rename-file",next);Reject("rename-file",stale,"peer display name invalidates old composite basis");Reject("rename-file",rename,"superseded receipt cannot revert current display name");Check(Name(file)=="이름만 변경.bin","extension change never rewrites original type or bytes");var reused=next.DeepClone().AsObject();reused["name"]="another";Reject("rename-file",reused,"same command with different payload refused");Reject("rename-file",Rename(folder,"폴더가 아님"),"folder identity cannot be renamed as a file");Reject("rename-file",Rename(Id(),"missing"),"unknown file refused");Reject("rename-file",Rename(file,"../outside"),"path name refused");Reject("rename-file",Rename(file,new string('x',181)),"name budget refused");Reject("rename-file",Rename(file,"foreign"),"foreign project refused",Id());
var retry=Rename(file,"보존할 이름.txt");string prior=System.IO.File.ReadAllText(names);System.IO.File.SetAttributes(names,System.IO.File.GetAttributes(names)|System.IO.FileAttributes.ReadOnly);try{Reject("rename-file",retry,"write refusal retains exact pending input");}finally{System.IO.File.SetAttributes(names,System.IO.File.GetAttributes(names)&~System.IO.FileAttributes.ReadOnly);}Check(System.IO.File.ReadAllText(names)==prior,"actual failed write preserves exact previous name store");Call("rename-file",retry);Check(Name(file)=="보존할 이름.txt","explicit same input recovers after write permission restoration");
var move=new System.Text.Json.Nodes.JsonObject{["revision"]=Call("load")["revision"]!.DeepClone(),["command"]=Id(),["ids"]=new System.Text.Json.Nodes.JsonArray(file),["parent"]=folder};Call("move",move);Check(Name(file)=="보존할 이름.txt"&&Call("rename-file",retry)["replayed"]!.GetValue<bool>(),"subsequent move preserves name and exact receipt does not revert parent");
string saved=System.IO.File.ReadAllText(names);var corrupt=System.Text.Json.Nodes.JsonNode.Parse(saved)!;corrupt["items"]![0]!["name"]="tampered";System.IO.File.WriteAllText(names,corrupt.ToJsonString());try{Reject("load",new(),"corrupt file name proof fails closed");Reject("read",read,"read cannot ignore a corrupt display-name store");}finally{System.IO.File.WriteAllText(names,saved);}Check(Call("read",read)["item"]!["name"]!.ToString()=="보존할 이름.txt","fresh current read restores the verified name and bytes");Check(System.IO.File.ReadAllText(store)==originalStore&&System.IO.File.ReadAllText(folderNames)==originalFolderNames&&System.IO.File.ReadAllText(manifest)==original&&System.IO.File.ReadAllText(identity)==originalIdentity,"original copies/receipts/folder names/source/identity remain exact");System.IO.File.WriteAllText(System.IO.Path.Combine(root,"checks.json"),checks.ToJsonString());Console.WriteLine(checks.ToJsonString());return 0;
