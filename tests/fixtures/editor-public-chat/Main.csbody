string repo = Environment.GetEnvironmentVariable("CONFECTORY_EDITOR_REPO")!;
string data = Environment.GetEnvironmentVariable("CONFECTORY_CHAT_TEST_ROOT")!;
string projects = System.IO.Path.Combine(data, "projects");
string profile = System.IO.Path.Combine(data, "profile");
string emptyProfile = System.IO.Path.Combine(data, "empty-profile");
System.IO.Directory.CreateDirectory(projects);
var records = new System.Text.Json.Nodes.JsonObject();
static void Check(bool condition, string failure)
{
    if (!condition) throw new InvalidOperationException(failure);
}

void Create(string storage, string name, bool seed, bool attachment = false)
{
    string session = calls.CreateSession.Invoke(repo, storage);
    try
    {
        var created = System.Text.Json.Nodes.JsonNode.Parse(calls.Command.Invoke(session, "create",
            System.Text.Json.JsonSerializer.Serialize(new { title = name, directory = projects })))!;
        var project = created["selected"] ?? throw new InvalidOperationException(created["status"]!.ToString());
        string id = project["projectId"]!.ToString(), manifest = project["path"]!.ToString();
        records[name] = new System.Text.Json.Nodes.JsonObject
        {
            ["manifest"] = manifest, ["id"] = id
        };
        if (!seed) return;
        if (!attachment)
        {
            string activation = project["activation"]!.ToString();
            string messageId = Guid.NewGuid().ToString("N");
            string payload = name + " public message";
            string journal = System.IO.Path.Combine(storage, "project-chat", id + ".json");
            string Send(string text, string scope) => calls.LocalChat.Invoke(session, scope, "send-text", messageId, "", text);
            const string Committed = "{\"status\":\"committed\"}";
            const string Unavailable = "{\"status\":\"unavailable\"}";
            Check(calls.ChatHistory.Invoke(session, activation, "send-text", messageId, "") == Unavailable &&
                Send("", activation) == Unavailable && !System.IO.File.Exists(journal),
                "Read-only route or invalid input created a journal");

            string receipt = System.IO.Path.Combine(storage, "project-creators", id + ".json");
            string withdrawn = receipt + ".withdrawn";
            System.IO.File.Move(receipt, withdrawn);
            try { Check(Send(payload, activation) == Unavailable && !System.IO.File.Exists(journal), "Withdrawn proof allowed a send"); }
            finally { System.IO.File.Move(withdrawn, receipt); }

            Check(Send(payload, activation) == Committed, "The verified creator could not commit");
            byte[] original = System.IO.File.ReadAllBytes(journal);
            Check(Send(payload, activation) == Committed && Send("different payload", activation) == Unavailable &&
                System.IO.File.ReadAllBytes(journal).AsSpan().SequenceEqual(original), "Retry changed the committed message");

            string otherManifest = records["AuthorA"]!["manifest"]!.ToString();
            var switched = System.Text.Json.Nodes.JsonNode.Parse(calls.Command.Invoke(session, "open",
                System.Text.Json.JsonSerializer.Serialize(new { path = otherManifest })))!;
            Check(switched["selected"]?["path"]?.ToString() == otherManifest &&
                switched["selected"]?["activation"]?.ToString() != activation &&
                Send("stale project activation", activation) == Unavailable, "An older activation survived a project switch");
            var reopened = System.Text.Json.Nodes.JsonNode.Parse(calls.Command.Invoke(session, "open",
                System.Text.Json.JsonSerializer.Serialize(new { path = manifest })))!;
            string newActivation = reopened["selected"]!["activation"]!.ToString();
            Check(newActivation != activation && Send(payload, activation) == Unavailable &&
                Send(payload, newActivation) == Committed, "A previous activation survived reopening the same project");

            string other = calls.CreateSession.Invoke(repo, System.IO.Path.Combine(data, "unverified-profile"));
            try
            {
                var opened = System.Text.Json.Nodes.JsonNode.Parse(calls.Command.Invoke(other, "open",
                    System.Text.Json.JsonSerializer.Serialize(new { path = manifest })))!;
                Check(opened["selected"]?["path"]?.ToString() == manifest &&
                    calls.LocalChat.Invoke(other, opened["selected"]!["activation"]!.ToString(), "send-text",
                        Guid.NewGuid().ToString("N"), "", "same original, different profile") == Unavailable &&
                    !System.IO.Directory.Exists(System.IO.Path.Combine(data, "unverified-profile", "project-chat")),
                    "Another profile acquired a send capability");
            }
            finally { calls.CloseSession.Invoke(other); }

            calls.CloseSession.Invoke(session);
            Check(Send(payload, newActivation) == Unavailable &&
                System.IO.File.ReadAllBytes(journal).AsSpan().SequenceEqual(original),
                "Closed editor or stale request changed the host journal");
            Console.WriteLine("PASS internal creator send, idempotent retry, scope switch, proof withdrawal and session closure");
            return;
        }
        CommitSealedYogi(session, project, storage, name);
    }
    finally { calls.CloseSession.Invoke(session); }
}
void CommitSealedYogi(string session, System.Text.Json.Nodes.JsonNode project, string storage, string name)
{
    const string Unavailable = "{\"status\":\"unavailable\"}";
    const string Committed = "{\"status\":\"committed\"}";
    string id = project["projectId"]!.ToString(), manifest = project["path"]!.ToString();
    string activation = project["activation"]!.ToString();
    string message = Guid.NewGuid().ToString("N"), text = name + " public message";
    string journalFolder = System.IO.Path.Combine(storage, "project-chat");
    string journal = System.IO.Path.Combine(journalFolder, id + ".json");

    System.Text.Json.Nodes.JsonNode Command(string owner, string op, object request)
    {
        var model = System.Text.Json.Nodes.JsonNode.Parse(
            calls.Command.Invoke(owner, op, System.Text.Json.JsonSerializer.Serialize(request)))!;
        Check(!model["status"]!.ToString().StartsWith("Error:", StringComparison.Ordinal),
            op + " failed: " + model["status"]);
        return model;
    }
    System.Text.Json.Nodes.JsonNode Open(string owner, string path) => Command(owner, "open", new { path })["selected"]!;
    void Yogi(string owner, object request) => Command(owner, "yogi", request);
    string Prepare(string owner, string scope) => calls.LocalChat.Invoke(owner, scope, "prepare-attachment", message, "", "");
    string SelectSeal() => System.Text.Json.Nodes.JsonNode.Parse(Prepare(session, activation))!["selection"]?.ToString()
        ?? throw new InvalidOperationException("Active seal was not available for selection");
    string Send(string owner, string scope, string selection, string content) =>
        calls.LocalChat.Invoke(owner, scope, "send-attachment", message, selection, content);
    void NoPublicJournal() =>
        Check(!System.IO.Directory.Exists(journalFolder), "Preparing or declining a box wrote a public journal");

    Check(Prepare(session, activation) == Unavailable, "Preparing opened a Yogi box implicitly");
    Command(session, "workspace", new { action = "open" });
    foreach (string item in new[] { "Project.AuthorA::Main", "Project.AuthorA::MainBody" })
    {
        Command(session, "workspace", new { action = "select", id = item });
        Yogi(session, new { action = "exactly", id = item });
    }
    for (int index = 0; index < 2; index++)
    {
        byte[] pixels = new byte[512 * 512 * 3];
        Array.Fill(pixels, (byte)(23 + index));
        Yogi(session, new
        {
            action = "capture", id = "Project.AuthorA::MainBody", view = "",
            image = new
            {
                width = 512, height = 512, encoding = "rgb24-base64", pixels = Convert.ToBase64String(pixels),
                hash = Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(pixels)).ToLowerInvariant()
            }
        });
    }
    Yogi(session, new { action = "text", text = "Earlier description before the explicit send" });
    Check(Prepare(session, activation) == Unavailable, "An unsealed box was available for attachment");
    Yogi(session, new { action = "seal", @sealed = true });
    NoPublicJournal();

    string cancelled = SelectSeal();
    Check(calls.LocalChat.Invoke(session, activation, "cancel-attachment", message, cancelled, "") ==
        "{\"status\":\"cancelled\"}" && Send(session, activation, cancelled, text) == Unavailable,
        "A cancelled selection still permitted an explicit send");
    NoPublicJournal();

    string changed = SelectSeal();
    Yogi(session, new { action = "seal", @sealed = false });
    Check(Send(session, activation, changed, text) == Unavailable, "Unsealing left the old selection sendable");
    Yogi(session, new { action = "text", text = "전송 당시 설명\nOriginal sealed description" });
    Yogi(session, new { action = "seal", @sealed = true });
    Check(Send(session, activation, changed, text) == Unavailable, "A changed seal replaced the selected snapshot");

    string oldProjectSelection = SelectSeal();
    var otherProject = Open(session, records["Empty"]!["manifest"]!.ToString());
    string otherActivation = otherProject["activation"]!.ToString();
    Check(Send(session, activation, oldProjectSelection, text) == Unavailable &&
        Send(session, otherActivation, oldProjectSelection, text) == Unavailable, "A selection survived a project switch");
    activation = Open(session, manifest)["activation"]!.ToString();
    Check(Send(session, activation, oldProjectSelection, text) == Unavailable,
        "Reopening the project restored the old selection");

    string selection = SelectSeal();
    string otherWindow = calls.CreateSession.Invoke(repo, storage);
    try
    {
        string scope = Open(otherWindow, manifest)["activation"]!.ToString();
        Yogi(otherWindow, new { action = "show" });
        Check(System.Text.Json.Nodes.JsonNode.Parse(Prepare(otherWindow, scope))!["status"]?.ToString() == "ready" &&
            Send(otherWindow, scope, selection, text) == Unavailable, "A second window could use the first window's selection");
    }
    finally { calls.CloseSession.Invoke(otherWindow); }

    string otherStorage = System.IO.Path.Combine(data, "other-attachment-profile");
    string otherProfile = calls.CreateSession.Invoke(repo, otherStorage);
    try
    {
        string scope = Open(otherProfile, manifest)["activation"]!.ToString();
        Yogi(otherProfile, new { action = "show" });
        Check(Prepare(otherProfile, scope) == Unavailable && Send(otherProfile, scope, selection, text) == Unavailable &&
            !System.IO.Directory.Exists(System.IO.Path.Combine(otherStorage, "project-chat")),
            "A separate profile could use the original project's box");
    }
    finally { calls.CloseSession.Invoke(otherProfile); }

    string projectRoot = System.IO.Path.GetDirectoryName(manifest)!;
    string copy = System.IO.Path.Combine(data, "copied-send-project");
    foreach (string file in System.IO.Directory.EnumerateFiles(projectRoot, "*", System.IO.SearchOption.AllDirectories))
    {
        string target = System.IO.Path.Combine(copy, System.IO.Path.GetRelativePath(projectRoot, file));
        System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(target)!);
        System.IO.File.Copy(file, target);
    }
    string copyManifest = System.IO.Path.Combine(copy, System.IO.Path.GetFileName(manifest));
    string copyIdentity = System.IO.Path.Combine(copy, ".confectory", "project-identity.json");
    var proof = System.Text.Json.Nodes.JsonNode.Parse(System.IO.File.ReadAllText(copyIdentity))!;
    proof["manifest"] = copyManifest;
    System.IO.File.WriteAllText(copyIdentity, proof.ToJsonString());
    string copyWindow = calls.CreateSession.Invoke(repo, storage);
    try
    {
        var viewed = Open(copyWindow, copyManifest);
        string scope = viewed["activation"]!.ToString();
        Yogi(copyWindow, new { action = "text", text = "Sealed in the copied project" });
        Yogi(copyWindow, new { action = "seal", @sealed = true });
        Check(viewed["projectId"]!.ToString() == id && Prepare(copyWindow, scope) == Unavailable &&
            Send(copyWindow, scope, selection, text) == Unavailable, "A copy with the original project ID could send");
    }
    finally { calls.CloseSession.Invoke(copyWindow); }
    NoPublicJournal();

    string receipt = System.IO.Path.Combine(storage, "project-creators", id + ".json");
    string withdrawn = receipt + ".withdrawn";
    System.IO.File.Move(receipt, withdrawn);
    try { Check(Send(session, activation, selection, text) == Unavailable, "Withdrawn creator proof allowed a send"); }
    finally { System.IO.File.Move(withdrawn, receipt); }
    Check(Send(session, activation, selection, text) == Unavailable &&
        calls.ChatHistory.Invoke(session, activation, "send-attachment", message, selection) == Unavailable,
        "An old selection or the read-only route allowed a send");
    NoPublicJournal();

    selection = SelectSeal();
    string privateYogi = System.Linq.Enumerable.Single(
        System.IO.Directory.GetFiles(System.IO.Path.Combine(projectRoot, ".confectory", "yogi"), "package-*.json"));
    byte[] privateBytes = System.IO.File.ReadAllBytes(privateYogi);
    System.IO.File.WriteAllText(journalFolder, "fixture blocks public storage");
    try
    {
        Check(Send(session, activation, selection, text) == Unavailable && !System.IO.File.Exists(journal) &&
            System.IO.File.ReadAllText(journalFolder) == "fixture blocks public storage",
            "Failed public storage left a message or changed the blocker");
    }
    finally { System.IO.File.Delete(journalFolder); }

    Check(Send(session, activation, selection, text) == Committed, "Retry did not commit the selected attachment");
    byte[] saved = System.IO.File.ReadAllBytes(journal);
    Check(Send(session, activation, selection, text) == Committed &&
        Send(session, activation, selection, "different message") == Unavailable &&
        System.IO.File.ReadAllBytes(journal).AsSpan().SequenceEqual(saved), "Retry changed the original committed message");
    Check(System.IO.File.ReadAllBytes(privateYogi).AsSpan().SequenceEqual(privateBytes) &&
        System.IO.Directory.GetFiles(journalFolder, "*.json").Length == 1, "Send rewrote private Yogi or created an orphan attachment");

    Yogi(session, new { action = "seal", @sealed = false });
    Yogi(session, new { action = "text", text = "Private description edited after public send" });
    Check(System.IO.File.ReadAllBytes(journal).AsSpan().SequenceEqual(saved), "A private edit changed the public snapshot");
    Console.WriteLine("PASS editor-owned sealed Yogi: cancel, stale box, other scope, failed write, retry and one frozen public attachment");
}

void CheckInvitations(string storage, System.Text.Json.Nodes.JsonNode project)
{
    const string Unavailable = "{\"status\":\"unavailable\"}";
    const string Committed = "{\"status\":\"committed\"}";
    string manifest = project["manifest"]!.ToString(), id = project["id"]!.ToString();
    string journal = System.IO.Path.Combine(storage, "project-chat", id + ".json");
    string session = calls.CreateSession.Invoke(repo, storage);
    string Message(int index) => index.ToString("x32");

    System.Text.Json.Nodes.JsonNode Run(string owner, string command, object payload)
    {
        var result = System.Text.Json.Nodes.JsonNode.Parse(calls.Command.Invoke(
            owner, command, System.Text.Json.JsonSerializer.Serialize(payload)))!;
        Check(!result["status"]!.ToString().StartsWith("Error:", StringComparison.Ordinal), result["status"]!.ToString());
        return result;
    }
    string Open(string owner, string path) => Run(owner, "open", new { path })["selected"]!["activation"]!.ToString();
    string Chat(string activation, string operation, string message = "", string selection = "", string text = "") =>
        calls.LocalChat.Invoke(session, activation, operation, message, selection, text);
    (Func<int, string> Issue, Func<string, string, string, object> Accept, Action Close) Room(string activation) =>
        ((Func<int, string>, Func<string, string, string, object>, Action))calls.Invitations.Invoke(session, activation);
    static (Func<string, string, bool> Send, Func<string> Read, Action Leave,
        Func<string, string, string, bool> SendBox, Func<string, string> ReadBox, string Actor) Guest(object connected) =>
        ((Func<string, string, bool>, Func<string>, Action, Func<string, string, string, bool>, Func<string, string>, string))connected;
    static void Reject<T>(Action request) where T : Exception
    {
        try { request(); }
        catch (T) { return; }
        throw new InvalidOperationException("Expected " + typeof(T).Name);
    }
    void Received(Func<string> read, params int[] rows)
    {
        var messages = System.Text.Json.Nodes.JsonNode.Parse(read())!.AsArray();
        var ids = System.Linq.Enumerable.Select(messages, row => row!["id"]!.ToString());
        Check(System.Linq.Enumerable.SequenceEqual(ids, System.Linq.Enumerable.Select(rows, Message)),
            "The invited connection received the wrong message IDs");
    }

    try
    {
        string activation = Open(session, manifest);
        string invite = System.Text.Json.Nodes.JsonNode.Parse(Chat(activation, "issue-invitation"))!["invitation"]!.ToString();
        var room = Room(activation);
        Check(invite.Length == 64 && !System.IO.File.Exists(journal), "Issuing an invitation wrote the journal");
        Reject<ArgumentOutOfRangeException>(() => room.Issue(301));
        string expiry = room.Issue(1);

        string guestStorage = System.IO.Path.Combine(data, "invitation-guest-profile");
        string other = calls.CreateSession.Invoke(repo, guestStorage);
        try
        {
            string otherScope = Open(other, manifest);
            Reject<UnauthorizedAccessException>(() => calls.Invitations.Invoke(other, otherScope));
            Check(!System.IO.Directory.Exists(System.IO.Path.Combine(guestStorage, "project-chat")), "Guest profile gained a journal");
        }
        finally { calls.CloseSession.Invoke(other); }

        string secondWindow = calls.CreateSession.Invoke(repo, storage);
        try
        {
            string secondScope = Open(secondWindow, manifest);
            Reject<InvalidOperationException>(() => calls.Invitations.Invoke(secondWindow, secondScope));
            Check(calls.LocalChat.Invoke(secondWindow, secondScope, "send-text", Message(99), "", "Second window") == Unavailable,
                "A second window bypassed the active chat owner");
        }
        finally { calls.CloseSession.Invoke(secondWindow); }

        Check(Chat(activation, "send-text", Message(1), "", "History before admission") == Committed,
            "Host's direct send failed while an admission room was active");
        Run(session, "yogi", new { action = "text", text = "Old sealed attachment" });
        Run(session, "yogi", new { action = "seal", @sealed = true });
        string selection = System.Text.Json.Nodes.JsonNode.Parse(Chat(activation, "prepare-attachment", Message(2)))!["selection"]!.ToString();
        Check(Chat(activation, "send-attachment", Message(2), selection, "Before admission") == Committed,
            "Host attachment did not share the live room journal");

        Reject<UnauthorizedAccessException>(() => room.Accept(Message(500), invite, "local-user"));
        Reject<UnauthorizedAccessException>(() => room.Accept(id, invite, "\n"));
        using var launch = new System.Threading.ManualResetEventSlim(false);
        object? Contender()
        {
            launch.Wait();
            try { return room.Accept(id, invite, "local-user"); }
            catch (UnauthorizedAccessException) { return null; }
        }
        var first = System.Threading.Tasks.Task.Run(Contender);
        var second = System.Threading.Tasks.Task.Run(Contender);
        launch.Set();
        System.Threading.Tasks.Task.WaitAll(first, second);
        Check((first.Result is null) != (second.Result is null), "Concurrent redemption did not accept exactly one connection");
        var guest = Guest((first.Result ?? second.Result)!);
        Check(guest.Actor != "local-user" && guest.Actor.StartsWith("local-user (guest ", StringComparison.Ordinal),
            "An invited display name changed the assigned identity");
        Received(guest.Read);
        Reject<UnauthorizedAccessException>(() => guest.ReadBox(Message(2)));
        Reject<UnauthorizedAccessException>(() => room.Accept(id, invite, "local-user"));
        System.Threading.Thread.Sleep(1100);
        Reject<UnauthorizedAccessException>(() => room.Accept(id, expiry, "Expired"));

        Check(Chat(activation, "send-text", Message(3), "", "Live host text") == Committed &&
            guest.Send(Message(4), "Guest text") && guest.Send(Message(4), "Guest text"), "Live explicit sends failed");
        Received(guest.Read, 3, 4);
        string workspace = calls.OpenWorkspace.Invoke(manifest, guest.Actor, "invited-chat-fixture");
        string yogiFolder = System.IO.Path.Combine(System.IO.Path.GetDirectoryName(manifest)!, ".confectory", "yogi");
        string box = calls.OpenBox.Invoke(yogiFolder, id, guest.Actor, workspace);
        try
        {
            calls.BoxText.Invoke(box, "Guest frozen attachment");
            calls.SealBox.Invoke(box, true);
            // Save the separate local draft explicitly. Sending and closing the already
            // saved box should add no private record or change its existing bytes.
            calls.SaveBox.Invoke(box);
            var beforeSend = System.Linq.Enumerable.ToDictionary(
                System.IO.Directory.GetFiles(yogiFolder, "package-*.json"), path => path, System.IO.File.ReadAllBytes);
            Check(guest.SendBox(Message(5), "Guest attached text", box), "Guest could not send an owned sealed box");
            Check(System.Text.Json.Nodes.JsonNode.Parse(guest.ReadBox(Message(5)))!["package"]!["text"]!.ToString() ==
                "Guest frozen attachment", "Guest attachment did not arrive on its connection");
            calls.CloseBox.Invoke(box);
            string[] afterSend = System.IO.Directory.GetFiles(yogiFolder, "package-*.json");
            Check(beforeSend.Count == afterSend.Length && System.Linq.Enumerable.All(afterSend, path =>
                beforeSend.TryGetValue(path, out var bytes) && System.IO.File.ReadAllBytes(path).AsSpan().SequenceEqual(bytes)),
                "Guest send duplicated or changed a private Yogi file");
        }
        finally
        {
            calls.CloseBox.Invoke(box);
            calls.CloseWorkspace.Invoke(workspace);
        }
        Check(!System.IO.Directory.Exists(System.IO.Path.Combine(guestStorage, "project-chat")), "Guest send wrote a guest journal");
        Received(guest.Read, 3, 4, 5);
        guest.Leave();
        Reject<ObjectDisposedException>(() => guest.Read());
        Reject<ObjectDisposedException>(() => guest.ReadBox(Message(5)));

        var newcomer = Guest(room.Accept(id, room.Issue(300), "local-user"));
        Check(newcomer.Actor != guest.Actor, "The label reused the first connection identity");
        Received(newcomer.Read);
        Reject<UnauthorizedAccessException>(() => newcomer.ReadBox(Message(5)));
        Reject<InvalidOperationException>(() => newcomer.Send(Message(4), "Guest text"));
        string outstanding = room.Issue(300);
        Open(session, records["Empty"]!["manifest"]!.ToString());
        Reject<ObjectDisposedException>(() => room.Accept(id, outstanding, "After switch"));
        Reject<ObjectDisposedException>(() => newcomer.Read());

        activation = Open(session, manifest);
        room = Room(activation);
        Reject<UnauthorizedAccessException>(() => room.Accept(id, outstanding, "In the new activation"));
        var revokedGuest = Guest(room.Accept(id, room.Issue(300), "Guest"));
        string beforeWithdrawal = room.Issue(300);
        for (int pending = 1; pending < 16; pending++) room.Issue(300);
        Reject<InvalidOperationException>(() => room.Issue(300));
        string proof = System.IO.Path.Combine(storage, "project-creators", id + ".json");
        System.IO.File.Move(proof, proof + ".withheld");
        try
        {
            Reject<ObjectDisposedException>(() => room.Accept(id, beforeWithdrawal, "Withdrawn"));
            Reject<ObjectDisposedException>(() => revokedGuest.Read());
        }
        finally { System.IO.File.Move(proof + ".withheld", proof); }
        room = Room(activation);
        Reject<UnauthorizedAccessException>(() => room.Accept(id, beforeWithdrawal, "Restored proof"));
        var finalGuest = Guest(room.Accept(id, room.Issue(300), "New guest"));
        Received(finalGuest.Read);
        outstanding = room.Issue(300);
        calls.CloseSession.Invoke(session);
        Reject<ObjectDisposedException>(() => finalGuest.Read());
        Reject<ObjectDisposedException>(() => room.Accept(id, outstanding, "Closed host"));

        string saved = System.IO.File.ReadAllText(journal);
        var journalEntries = System.Text.Json.Nodes.JsonNode.Parse(saved)!["messages"]!.AsArray();
        Check(journalEntries.Count == 5 && journalEntries[3]!["sender"]!.ToString() == guest.Actor &&
            journalEntries[4]!["attachment"] is not null && !saved.Contains(invite) && !saved.Contains(outstanding),
            "The journal contained duplicate messages, missing attachments or an invitation");
        Console.WriteLine("PASS one-use invite race, expiry, project, host proof and close; live guests, attachments and no prior history");
    }
    finally { calls.CloseSession.Invoke(session); }
}

Create(emptyProfile, "Empty", false);
Create(profile, "AuthorA", true, true);
Create(profile, "AuthorB", true);
string invitationProfile = System.IO.Path.Combine(data, "invitation-profile");
Create(invitationProfile, "Invitations", false);
CheckInvitations(invitationProfile, records["Invitations"]!);
System.IO.File.WriteAllText(System.IO.Path.Combine(data, "fixtures.json"), records.ToJsonString());
return 0;
