<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <TargetFramework>net8.0-android</TargetFramework><OutputType>Exe</OutputType>
  <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
  <ApplicationId>org.confectory.checkpoint</ApplicationId><ApplicationTitle>Confectory BaseUI</ApplicationTitle>
  <ApplicationVersion>1</ApplicationVersion><ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
  <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><LangVersion>12</LangVersion>
 </PropertyGroup>
 <Target Name="ConfectoryRejectImplicitSigning" BeforeTargets="_CreateAndroidDebugSigningKey;_Sign;SignAndroidPackage">
  <Error Text="Confectory export requires unsigned packaging. Key creation and signing require a separate explicit ephemeral action." />
 </Target>
</Project>
