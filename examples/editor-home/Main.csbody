System.IO.DirectoryInfo? browserBootstrap=null;
bool browserLaunchFailed=false,browserReady=false;
long launchDeadline=0;
void RetireBootstrap(){
 if(browserBootstrap is null)return;
 browserBootstrap.Delete(true);
 browserBootstrap=null;
}
try{
 Action<string> open=address=>{
  IntPtr browser=g_app_info_get_default_for_uri_scheme("http");
  if(browser==IntPtr.Zero){Console.Error.WriteLine("No default browser is available at handoff.");browserLaunchFailed=true;return;}
  IntPtr uri=IntPtr.Zero,uris=IntPtr.Zero;
  try{
   // Pass only a file URI to the desktop launcher. The session key stays in
   // a private Unix temporary directory until the browser authenticates.
   browserBootstrap=System.IO.Directory.CreateTempSubdirectory("confectory-logic-");
   string file=System.IO.Path.Combine(browserBootstrap.FullName,"open.html");
   System.IO.File.WriteAllText(file,"<!doctype html><meta name=referrer content=no-referrer><meta http-equiv=refresh content=\"0;url="+address+"\"><title>Confectory Logic Code</title>");
   uri=System.Runtime.InteropServices.Marshal.StringToCoTaskMemUTF8(new Uri(file).AbsoluteUri);
   uris=g_list_append(IntPtr.Zero,uri);
   if(g_app_info_launch_uris(browser,uris,IntPtr.Zero,IntPtr.Zero)==0){Console.Error.WriteLine("The default browser could not be launched.");browserLaunchFailed=true;}
   else launchDeadline=Environment.TickCount64+20_000;
  }finally{
   if(uris!=IntPtr.Zero)g_list_free(uris);if(uri!=IntPtr.Zero)System.Runtime.InteropServices.Marshal.FreeCoTaskMem(uri);
   g_object_unref(browser);
  }
 };
 void BrowserReady(){RetireBootstrap();browserReady=true;}
 bool Alive(){
  if(returnAccepted)return false;
  if(!Status(browserReady?"Logic Code is open in the browser.":"Opening Logic Code…",!browserReady?"Waiting for the default browser.":
      returnRequest>0?"Continue in the Logic Code browser tab to return.":"Return to the original project or close to exit.",browserReady))return false;
  if(!browserReady&&launchDeadline!=0&&Environment.TickCount64>=launchDeadline){
   Console.Error.WriteLine("The default browser did not connect to Logic Code.");
   browserLaunchFailed=true;
  }
  return !browserLaunchFailed;
 }
 int ReadReturnRequest()=>returnAccepted?-1:returnRequest;
 bool AcceptReturn(int request){
  if(!browserReady||returnAccepted||request<=0||request!=returnRequest)return false;
  returnAccepted=true;return true;
 }
 AppContext.SetData("Confectory.EditorHome.LogicHandoff",(handoff.Manifest,handoff.Project,open,(Func<bool>)Alive,(Action)BrowserReady,(Func<int>)ReadReturnRequest,(Func<int,bool>)AcceptReturn));
 string? priorUi=Environment.GetEnvironmentVariable("CONFECTORY_UI");
 Environment.SetEnvironmentVariable("CONFECTORY_UI","web");
 try{
  int result=calls.WebStart.Invoke();
  if(result!=0||!browserLaunchFailed&&!returnAccepted)return result;
  // WebStart has closed the listener, view and model before GTK reacquires
  // the same installation lease. Reopen only the original project.
  returnToGtk=(handoff.Manifest,handoff.Project,browserLaunchFailed);
 }catch(Exception error) when(!browserLaunchFailed){
  Console.Error.WriteLine("Logic Code could not open: "+error.Message);
  RetireBootstrap();
  while(Status("Could not open Logic Code.","Close this window and reopen the project in Confectory."))System.Threading.Thread.Sleep(16);
  return 1;
 }finally{
  Environment.SetEnvironmentVariable("CONFECTORY_UI",priorUi);
  AppContext.SetData("Confectory.EditorHome.LogicHandoff",null);
 }
}finally{try{RetireBootstrap();}finally{calls.Close.Invoke(statusWindow,-1);}}
}catch{try{Dispose();}catch(Exception error){Console.Error.WriteLine(error);}if(IsClosed())AppContext.SetData("Confectory.HostLoop."+loopToken,null);else Console.Error.WriteLine("Editor cleanup retained for retry: "+loopToken);throw;}
