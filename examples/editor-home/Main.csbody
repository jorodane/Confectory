bool BeginLaySelection(int focus)
{
 if(!LayWorkspaceAvailable()){
  if(screen=="project"&&LayUnit().Length==0&&job is null)message="Select a workspace item before capturing a LaY.";
  return false;
 }
 CancelInput(eventID++);pendingFocus=0;Focus(0);layReturnScreen="project";layReturnFocus=focus;
 laySelection=(LanCurrentActivation(),LayUnit(),WorkspaceMode(),focus);
 layAnchor=null;layFrame=null;
 Render();
 return true;
}
void EndLaySelection(bool restoreFocus)
{
 if(restoreFocus&&laySelection is { } pick)pendingFocus=pick.Focus;
 laySelection=null;layAnchor=null;layFrame=null;CancelInput(eventID++);
}
int[] LayDrag(int x,int y)
{
 var start=layAnchor!.Value;
 return new[]{Math.Min(start.X,x),Math.Min(start.Y,y),Math.Abs(x-start.X),Math.Abs(y-start.Y)};
}
bool LayCanCapture(int[] area)
{
 if(layBounds.Length!=4||area[2] is <1 or >512||area[3] is <1 or >512||
    area[0]<layBounds[0]||area[1]<layBounds[1]||area[0]+area[2]>layBounds[0]+layBounds[2]||
    area[1]+area[3]>layBounds[1]+layBounds[3])return false;
 return !System.Linq.Enumerable.Any(layNativeBounds,field=>
  area[0]<field[0]+field[2]&&area[0]+area[2]>field[0]&&area[1]<field[1]+field[3]&&area[1]+area[3]>field[1]);
}
bool HandleLayGesture(int type,int x,int y,int key,int flags,bool fromNative)
{
 bool shortcut=!fromNative&&type==5&&(key is 'y' or 'Y')&&(flags&14)==2;
 if(laySelection is null)
  return shortcut&&(flags&1)==0&&BeginLaySelection(calls.ControlState.Invoke(control,"query",0)[0]);
 if((shortcut&&(flags&1)==0)||(type==(fromNative?6:5)&&key==Key(27,0xFF1B))||type is 7 or 9 or 11)
 {EndLaySelection(true);return true;}
 if(!fromNative&&type==1)
 {
  if(LayCanCapture(new[]{x,y,1,1}))layAnchor=(x,y);
  else {EndLaySelection(true);message="LaY needs a painted region inside the selected workspace.";return true;}
 }
 if(!fromNative&&type is 1 or 3){layPointerX=x;layPointerY=y;}
 if(!fromNative&&type==2&&layAnchor is not null)
 {
  int[] area=LayDrag(x,y);
  var pick=laySelection.Value;
  var frame=layFrame;
  bool valid=LayWorkspaceAvailable()&&pick.Activation==LanCurrentActivation()&&pick.Unit==LayUnit()&&
   pick.Mode==WorkspaceMode()&&LayCanCapture(area)&&frame is not null;
  EndLaySelection(true);
  if(!valid){message="Select up to 512 × 512 inside the painted workspace, clear of text fields.";return true;}
  try
  {
   var savedFrame=frame!.Value;
   var image=J(calls.CaptureWorkspaceLay.Invoke(surfaces,area,savedFrame.Rectangles,savedFrame.Labels,
    savedFrame.Clips,savedFrame.Origins,savedFrame.Text));
   Start("yogi-native",new{context=Context(),activation=pick.Activation,action="capture",id=pick.Unit,view="",image});
  }
  catch(ArgumentException){message="The selected LaY area could not be captured.";}
  catch(InvalidOperationException){message="The selected LaY area could not be captured.";}
 }
 return true;
}
void CloseLayPanel()
{
 layPreview=null;Change(layReturnScreen);pendingFocus=layReturnFocus;
}
void LayPanelAction(int id)
{
 if(job is not null)return;
 if(id==LayClose){CloseLayPanel();return;}
 if(id==LayCaptureAnother&&layReturnScreen=="project"){CloseLayPanel();BeginLaySelection(layReturnFocus);return;}
 var items=LayItems();int index=id is LayFirst or LayRemoveFirst?0:1;
 string context=Context(),activation=LanCurrentActivation();
 if(id==LaySeal&&layReturnScreen=="project")
 {
  bool seal=!LaySealed();
  Start("yogi-native",new{context,activation,action="seal",@sealed=seal,text=seal?calls.TextSnapshot.Invoke(LayDescriptionBuffer())[1]:null},LaySeal);
 }
 else if(id is LayFirst or LaySecond&&index<items.Length)
 {
  try{layPreview=DecodeLayCapture(items[index]["capture"]!);}
  catch(ArgumentException){layPreview=null;message="LaY preview unavailable.";}
  catch(FormatException){layPreview=null;message="LaY preview unavailable.";}
 }
 else if(id is LayRemoveFirst or LayRemoveSecond&&index<items.Length&&!LaySealed()&&layReturnScreen=="project")
 {
  layPreview=null;
  Start("yogi-native",new{context,activation,action="remove",item=items[index]["item"]!.GetValue<string>()},LayDescription);
 }
}
// The X11 pointer grab stays in this editor. No GTK/OS drop payload is read.
bool YogiIconHit(int id,int x,int y)
{
 if(orderFrame.Length==0)return false;
 int[] hit=calls.OrderHit.Invoke(orderFrame,x,y);
 return hit[1]==id&&hit[2]==0;
}
void ClearYogiPointer()
{
 layBoxPress=null;layBoxClick=null;layBoxDragging=false;
}
bool CanOpenLayIcon()=>OperatingSystem.IsLinux()&&job is null&&!appClosePending&&!nativePickerPending&&!storagePending&&
 (screen=="project"&&model["closeRequest"] is null&&model["workspace"]?["review"] is null||
  screen=="lan-chat"&&LanSealedIconAvailable());
bool LanSealedIconAvailable()=>lanHasSealedBox&&lanLifetime is not null&&lanActivation.Length>0&&lanActivation==LanCurrentActivation()&&
 lanViewerId.Length==0&&lanMode is "hosting" or "joined";
void OpenLayIcon()
{
 if(!CanOpenLayIcon())return;
 layReturnScreen=screen;layReturnFocus=LayEntry;
 Start("yogi-native",new{context=Context(),activation=LanCurrentActivation(),action="show"});
}
bool HandleYogiPointer(int type,int x,int y,int key,bool fromNative)
{
 if(layBoxPress is { } press)
 {
  if(type==(fromNative?6:5)&&key==Key(27,0xFF1B))
  {ClearYogiPointer();CancelInput(eventID++);return true;}
  bool current=press.Screen==screen&&press.Activation==LanCurrentActivation()&&
   (screen!="lan-chat"||press.View==lanView)&&CanOpenLayIcon();
  if(!current||type is 7 or 9 or 11)
  {ClearYogiPointer();CancelInput(eventID++);return false;}
  if(fromNative||type is not (1 or 2 or 3))return false;
  layBoxDragging|=Math.Abs(x-press.X)>=6||Math.Abs(y-press.Y)>=6;
  if(type!=2)return true;

  bool dragged=layBoxDragging;
  layBoxPress=null;layBoxDragging=false;
  if(dragged)
  {
   layBoxClick=null;
   if(screen=="lan-chat"&&YogiIconHit(LanInput,x,y))PrepareLanAttachment();
   return true;
  }
  if(!YogiIconHit(LayEntry,x,y)){layBoxClick=null;return true;}
  long now=Environment.TickCount64;
  if(layBoxClick is { } click&&click.Screen==press.Screen&&click.Activation==press.Activation&&click.View==press.View&&
     now-click.Time<=400&&Math.Abs(x-click.X)<6&&Math.Abs(y-click.Y)<6)
  {layBoxClick=null;OpenLayIcon();}
  else layBoxClick=(press.Screen,press.Activation,press.View,x,y,now);
  return true;
 }
 if(type is 7 or 9 or 11)layBoxClick=null;
 if(fromNative||type!=1)return false;
 if(!CanOpenLayIcon()||(screen=="project"&&!LaySealed())||!YogiIconHit(LayEntry,x,y))
 {layBoxClick=null;return false;}

 layBoxPress=(screen,LanCurrentActivation(),screen=="lan-chat"?lanView:"",x,y);
 layBoxDragging=false;
 CancelInput(eventID++);Focus(LayEntry);
 return true;
}
System.Text.Json.Nodes.JsonNode TraceModel()
{
 var snapshot=model.DeepClone();
 if(snapshot["yogi"]?["items"] is System.Text.Json.Nodes.JsonArray items)
  foreach(var item in items)
   if(item?["capture"] is System.Text.Json.Nodes.JsonObject capture)capture.Remove("pixels");
 return snapshot;
}
System.Text.Json.Nodes.JsonNode TraceFields()
{
 var traced=System.Text.Json.JsonSerializer.SerializeToNode(fields)!;
 if(traced[LanCard.ToString()] is System.Text.Json.Nodes.JsonNode card)
 {
  var info=J(card.GetValue<string>());
  traced[LanCard.ToString()]=new System.Text.Json.Nodes.JsonObject{
   ["id"]=info["id"]?.DeepClone(),["nativeHandle"]=info["nativeHandle"]?.DeepClone(),
   ["visible"]=info["visible"]?.DeepClone(),["enabled"]=info["enabled"]?.DeepClone(),["text"]=""
  }.ToJsonString();
 }
 return traced;
}

