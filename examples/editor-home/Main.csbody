System.Threading.Tasks.Task<System.Text.Json.Nodes.JsonNode>? lanWork = null;
string lanReturn = "home", lanView = "", lanActivation = "", lanMode = "", lanAction = "", lanStatus = "";
string lanReviewHash = "", lanReviewedCard = "", lanReviewDetails = "", lanPendingText = "", lanPendingId = "";
long lanNextPoll = 0, lanCardExpires = 0;
bool lanCanHost = false, lanUsesRelay = false, lanHasSealedBox = false;
string lanQueuedAction = "", lanQueuedId = "", lanActionId = "", lanDraftBox = "", lanViewerId = "", lanDescription = "";
var lanAttachments = new System.Collections.Generic.List<string>();
var lanImages = new System.Collections.Generic.List<(int Width, int Height, int[] Pixels)>();
int lanAttachmentIndex = 0, lanImageIndex = 0;
bool lanHasHiddenEy = false;
string lanRelayRole = "";
string LanCurrentActivation() => model["selected"]?["activation"]?.ToString() ?? "";
string LanBuffer(int id)
{
 if(!lanBuffers.TryGetValue(id,out var buffer))lanBuffers[id]=buffer=Own("lan-text",calls.CreateText.Invoke("lan-chat-"+id,""),token=>calls.CloseText.Invoke(token));
 return buffer;
}
string LanText(int id) => calls.TextSnapshot.Invoke(LanBuffer(id))[1];
void SetLanText(int id,string text)
{
 string buffer=LanBuffer(id);
 if(calls.TextSnapshot.Invoke(buffer)[1]==text)return;
 // Rebind the GTK field so its previous widget snapshot cannot overwrite an async update.
 calls.NativeRequest.Invoke(nativeHome,"forget",System.Text.Json.JsonSerializer.Serialize(new{binding=buffer}),0);
 calls.ReplaceText.Invoke(buffer,text,0,0);
}
void CloseLanAttachment()
{
 lanViewerId=lanDescription="";lanImages.Clear();lanImageIndex=0;lanHasHiddenEy=false;
 if(lanQueuedAction=="attachment")lanQueuedAction=lanQueuedId="";
}
void RetireLan()
{
 ClearYogiPointer();lanHasSealedBox=false;
 lanQueuedAction=lanQueuedId=lanDraftBox="";lanAttachments.Clear();lanAttachmentIndex=0;
 CloseLanAttachment();
 var lifetime=lanLifetime;
 if(lifetime is null)return;
 lanLifetime=null;
 var completion=lanWork;
 lanWork=null;
 _=System.Threading.Tasks.Task.WhenAll(lifetime.CancelAsync(),completion??System.Threading.Tasks.Task.CompletedTask)
  .ContinueWith(task=>{_ = task.Exception;lifetime.Dispose();},System.Threading.Tasks.TaskScheduler.Default);
}
closeNativeLan=RetireLan;
void CloseLanPanel()
{
 RetireLan();
 foreach(var id in lanBuffers.Keys)SetLanText(id,"");
 lanReviewedCard=lanReviewHash=lanReviewDetails=lanPendingText=lanPendingId="";
 Change(lanReturn=="project"&&model["selected"] is null?"home":lanReturn);
}
void OpenLanPanel()
{
 lanReturn=screen;lanActivation=LanCurrentActivation();lanView=Guid.NewGuid().ToString("N");
 lanLifetime=new System.Threading.CancellationTokenSource();
 lanCanHost=lanActivation.Length>0&&calls.CreatorHost.Invoke(session);
 lanRelayRole=calls.IsolatedRelay.Invoke(true) is (string role,Func<string,object?> _,Func<string,string?> _)?role:"";
 lanUsesRelay=lanHasSealedBox=false;
 calls.NativeRequest.Invoke(nativeHome,"block-drop",System.Text.Json.JsonSerializer.Serialize(new{id=LanInput}),0);
 lanMode="start";lanStatus="Public chat is separate from your Helper draft.";
 lanCardExpires=0;
 Change("lan-chat");
}
void RequestLan(string action,object input,string id="")
{
 if(lanLifetime is null||lanWork is not null)return;
 string payload=System.Text.Json.JsonSerializer.Serialize(input), activation=lanActivation;
 var binding=(lanView,lanLifetime.Token,activation);
 lanAction=action;lanActionId=id;
 lanWork=System.Threading.Tasks.Task.Run(()=>{
  bool LocalSealedBox()=>!binding.Token.IsCancellationRequested&&activation.Length>0&&
   J(calls.Command.Invoke(session,"yogi-chat-open",System.Text.Json.JsonSerializer.Serialize(new{activation})))["status"]?.ToString()=="ready";
  if(action=="prepare-attachment"&&!LocalSealedBox())return J("{\"status\":\"no-sealed-lay\"}");
  var response=J(calls.LanExchange.Invoke(session,payload,binding,true));
  if(action is "issue-lan" or "issue-relay" or "join-lan" or "join-relay"&&response["status"]?.ToString() is "issued" or "joined")
  {
   try{response["localSealedBox"]=LocalSealedBox();}
   catch(Exception error) when(error is ArgumentException or InvalidOperationException or System.IO.IOException or
      UnauthorizedAccessException or System.Text.Json.JsonException){response["localSealedBox"]=false;}
  }
  if(action=="status"&&response["status"]?.ToString()=="hosting")return J(calls.PublicHistory.Invoke(session,activation,"history","",""));
  if(action=="attachment"&&response["status"]?.ToString()=="available")
  {
   var images=new System.Text.Json.Nodes.JsonArray();
   int count=System.Linq.Enumerable.Count(response["items"]!.AsArray(),item=>item?["kind"]?.ToString()=="image");
   for(int index=0;index<Math.Min(count,2);index++)
   {
    string imageAction=index==0?"first-image":"second-image";
    string query=System.Text.Json.JsonSerializer.Serialize(new{action=imageAction,id});
    var image=J(calls.LanExchange.Invoke(session,query,binding,true))["capture"];
    if(image is null)return J("{\"status\":\"unavailable\"}");
    images.Add(image.DeepClone());
   }
   response["captures"]=images;
  }
  return response;
 });
}
bool LanCanRequest() => lanQueuedAction.Length==0 && (lanWork is null || lanAction is "read" or "status");
void DispatchLanRequest()
{
 string action=lanQueuedAction,id=lanQueuedId;
 lanQueuedAction=lanQueuedId="";
 if(action is "send" or "send-attachment")RequestLan(action,new{action,id,text=lanPendingText},id);
 else RequestLan(action,new{action,id},id);
}
void QueueLanRequest(string action,string id)
{
 lanQueuedAction=action;lanQueuedId=id;
 if(lanWork is null)DispatchLanRequest();
}
void PrepareLanAttachment()
{
 if(LanCanRequest()&&lanDraftBox.Length==0&&lanViewerId.Length==0&&lanActivation.Length>0&&lanActivation==LanCurrentActivation()&&
    lanLifetime is { IsCancellationRequested:false }&&lanMode is "hosting" or "joined")
  QueueLanRequest("prepare-attachment",Guid.NewGuid().ToString("N"));
}
void LanControl(int id)
{
 if(id==LanClose){CloseLanPanel();return;}
 if(id==LayEntry){OpenLayIcon();return;}
 if(lanMode is "hosting" or "joined")
 {
  if(id==LanCloseAttachment){CloseLanAttachment();return;}
  if(id==LanNextImage&&lanImages.Count>1){lanImageIndex=(lanImageIndex+1)%lanImages.Count;return;}
  if(lanViewerId.Length!=0)return;
  if(id==LanOlderAttachment&&lanAttachmentIndex>0){lanAttachmentIndex--;return;}
  if(id==LanNewerAttachment&&lanAttachmentIndex+1<lanAttachments.Count){lanAttachmentIndex++;return;}
  if(!LanCanRequest())return;
  if(id==LanOpenAttachment&&lanAttachments.Count>0)
  {
   CloseLanAttachment();lanViewerId=lanAttachments[lanAttachmentIndex];lanDescription="Loading YogiBox…";
   QueueLanRequest("attachment",lanViewerId);return;
  }
  if(id==LanAttach)
  {
   if(lanDraftBox.Length==0)PrepareLanAttachment();
   else QueueLanRequest("cancel-attachment",lanDraftBox);
   return;
  }
  if(id==LanSend)
  {
   string text=LanText(LanInput);
   if(string.IsNullOrWhiteSpace(text)||text.Length>2048){lanStatus="Enter a public message of 1 to 2048 characters.";return;}
   if(text!=lanPendingText){lanPendingText=text;lanPendingId=Guid.NewGuid().ToString("N");}
   QueueLanRequest(lanDraftBox.Length==0?"send":"send-attachment",lanDraftBox.Length==0?lanPendingId:lanDraftBox);
  }
  return;
 }
 if(lanWork is not null)return;
 if(lanMode=="start")
 {
  if(lanCanHost&&(id==LanIssue||id==LanRelayIssue&&lanRelayRole=="host"))
  {
   lanUsesRelay=id==LanRelayIssue;lanMode="issue";
   lanStatus=lanUsesRelay?"Issue an invitation through the preconfigured test relay.":"Enter the two attached private IPv4 addresses.";
  }
  else if(id==LanReview||id==LanRelayReview&&lanRelayRole=="guest")
  {
   lanUsesRelay=id==LanRelayReview;lanMode="join";
   lanStatus="Paste the card received directly from the original project host.";
  }
  return;
 }
 if(id==LanIssue&&lanMode=="issue")
 {
  if(lanUsesRelay)RequestLan("issue-relay",new{action="issue-relay"});
  else RequestLan("issue-lan",new{action="issue-lan",host=LanText(LanHostAddress).Trim(),guest=LanText(LanGuestAddress).Trim()});
 }
 if(id==LanReview&&lanMode is "join" or "review")
 {
  lanReviewedCard=LanText(LanCard).Trim();lanReviewHash=lanReviewDetails="";lanMode="join";
  string action=lanUsesRelay?"inspect-relay":"inspect-lan";
  RequestLan(action,new{action,card=lanReviewedCard});
 }
 if(id==LanJoin&&lanMode=="review"&&lanReviewedCard==LanText(LanCard).Trim())
 {
  string action=lanUsesRelay?"join-relay":"join-lan";
  RequestLan(action,new{action,card=lanReviewedCard,name=LanText(LanDisplayName).Trim(),review=lanReviewHash});
  SetLanText(LanCard,"");lanReviewedCard=lanReviewHash="";
 }
}
void UpdateLanMessages(System.Text.Json.Nodes.JsonArray? rows)
{
 string selected=lanAttachments.Count>0?lanAttachments[lanAttachmentIndex]:"";
 lanAttachments.Clear();
 var lines=new System.Collections.Generic.List<string>();
 if(rows is not null)
  foreach(var row in System.Linq.Enumerable.TakeLast(rows,40))
  {
   string sender=row!["sender"]!.GetValue<string>(),line=sender+": "+row["text"];
   if(row["attachmentId"]?.GetValue<string>() is string id&&id==row["id"]?.GetValue<string>())
   {
    lanAttachments.Add(id);line+="  [YogiBox "+lanAttachments.Count+"]";
   }
   lines.Add(line);
  }
 int previous=lanAttachments.IndexOf(selected);
 lanAttachmentIndex=previous<0?Math.Max(0,lanAttachments.Count-1):previous;
 SetLanText(LanMessages,lines.Count==0?"No messages yet.":string.Join("\n",lines));
}
(int Width,int Height,int[] Pixels) DecodeLayCapture(System.Text.Json.Nodes.JsonNode capture)
{
 if(capture["width"] is not System.Text.Json.Nodes.JsonValue horizontal||!horizontal.TryGetValue<int>(out int width)||
    capture["height"] is not System.Text.Json.Nodes.JsonValue vertical||!vertical.TryGetValue<int>(out int height)||
    width is <1 or >512||height is <1 or >512||capture["encoding"]?.ToString()!="rgb24-base64"||
    capture["pixels"] is not System.Text.Json.Nodes.JsonValue content||!content.TryGetValue<string>(out string? encoded))
  throw new ArgumentException("Unsupported LaY capture");
 if(encoded.Length!=4*((width*height*3+2)/3))throw new ArgumentException("Invalid LaY length");
 byte[] rgb=Convert.FromBase64String(encoded);
 string hash=Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(rgb));
 if(rgb.Length!=width*height*3||!string.Equals(hash,capture["hash"]?.ToString(),StringComparison.OrdinalIgnoreCase))
  throw new ArgumentException("Invalid LaY digest");
 var pixels=new int[width*height];
 for(int i=0;i<pixels.Length;i++)pixels[i]=rgb[3*i]<<16|rgb[3*i+1]<<8|rgb[3*i+2];
 return (width,height,pixels);
}
void PollLanPanel()
{
 if(screen!="lan-chat"&&!(screen=="yogi"&&layReturnScreen=="lan-chat"&&lanLifetime is not null))return;
 if(lanActivation!=LanCurrentActivation()){CloseLanPanel();return;}
 long now=Environment.TickCount64;
 if(lanCardExpires!=0&&lanCardExpires<=now){SetLanText(LanCard,"");lanCardExpires=0;lanStatus="Invitation expired. End public chat to issue a new one.";}
 if(lanWork is { IsCompleted:true } pending)
 {
  lanWork=null;
  System.Text.Json.Nodes.JsonNode? result=null;
  try{result=pending.GetAwaiter().GetResult();}catch(Exception){/* Show only bounded UI status, never invitation input or exceptions. */}
  string status=result?["status"]?.ToString()??"unavailable";
  switch(lanAction)
  {
   case "issue-lan" or "issue-relay" when status=="issued":
    SetLanText(LanCard,result!["card"]!.GetValue<string>());lanHasSealedBox=result["localSealedBox"]?.GetValue<bool>()==true;lanMode="hosting";lanCardExpires=now+300000;
    lanStatus="Select and copy the invitation directly to the guest. It can be used once within five minutes.";break;
   case "issue-lan":lanStatus="Could not issue an invitation. Check original ownership and both private addresses.";break;
   case "issue-relay":lanStatus="Could not issue an invitation through the configured test relay.";break;
   case "inspect-lan" or "inspect-relay" when status=="review"&&lanReviewedCard==LanText(LanCard).Trim():
    lanReviewHash=result!["review"]!.GetValue<string>();lanMode="review";
    string endpoint=lanUsesRelay?$"Configured test relay: {result["relay"]}":$"Host: {result["host"]}:{result["port"]}   Your address: {result["guest"]}";
    lanReviewDetails=$"{endpoint}\nProject: {result["title"]} ({result["project"]})\nHost certificate SHA-256: {result["fingerprint"]}";
    lanStatus="Confirm the project, endpoint and fingerprint with the host before joining.";break;
   case "inspect-lan":lanReviewedCard="";lanStatus="Invitation or attached private route could not be verified.";break;
   case "inspect-relay":lanReviewedCard="";lanStatus="Invitation does not match the preconfigured test relay.";break;
   case "join-lan" or "join-relay" when status=="joined":lanHasSealedBox=result!["localSealedBox"]?.GetValue<bool>()==true;lanMode="joined";lanStatus="Connected. Only public messages received on this connection appear here.";break;
   case "join-lan" or "join-relay":lanMode="join";lanReviewDetails="";lanStatus="Could not join. The invitation may be invalid, used, expired or revoked.";break;
   case "prepare-attachment" when status=="ready":
    lanHasSealedBox=true;lanDraftBox=lanActionId;lanPendingId=lanPendingText="";lanStatus="Sealed YogiBox attached to this draft. Send publicly to share it.";break;
   case "prepare-attachment" or "send-attachment" when status=="ey-unsupported":
    lanStatus="Guest YogiBoxes with EY cannot be shared. Your original box is retained.";break;
   case "prepare-attachment":lanStatus="An existing sealed YogiBox with a LaY is required.";break;
   case "cancel-attachment" when status=="cancelled":
    lanDraftBox=lanPendingId=lanPendingText="";lanStatus="Attachment removed from the public draft.";break;
   case "cancel-attachment":lanStatus="Attachment removal could not be confirmed.";break;
   case "send" or "send-attachment" when status=="committed":
    if(LanText(LanInput)==lanPendingText)SetLanText(LanInput,"");
    lanDraftBox=lanPendingId=lanPendingText="";lanStatus="Public message sent.";break;
   case "send" or "send-attachment":lanStatus="Public message was not confirmed. Your input remains here.";break;
   case "attachment" when lanViewerId==lanActionId:
    if(status!="available"){lanDescription="Attachment unavailable.";break;}
    try{
     foreach(var capture in result!["captures"]!.AsArray())lanImages.Add(DecodeLayCapture(capture!));
     if(result["description"] is not System.Text.Json.Nodes.JsonValue description||
        !description.TryGetValue<string>(out string? text)||text.Length>4096)throw new ArgumentException("Invalid YogiBox description");
     lanDescription=text;
     lanHasHiddenEy=System.Linq.Enumerable.Any(result["items"]!.AsArray(),item=>item?["kind"]?.ToString()=="semantic");
    }catch(ArgumentException){lanImages.Clear();lanDescription="Attachment unavailable.";}
    catch(FormatException){lanImages.Clear();lanDescription="Attachment unavailable.";}
    break;
   case "read" or "status" when status is "joined" or "available":
    UpdateLanMessages(result?["messages"]?.AsArray());break;
   case "read" or "status":
    RetireLan();SetLanText(LanMessages,"");SetLanText(LanCard,"");lanCardExpires=0;lanMode="closed";lanStatus="Public chat disconnected. Use a new invitation to rejoin.";break;
  }
  lanNextPoll=now+650;
 }
 if(lanWork is null&&lanQueuedAction.Length!=0)DispatchLanRequest();
 else if(lanWork is null&&now>=lanNextPoll&&(lanMode is "hosting" or "joined"))
 {
  string action=lanMode=="hosting"?"status":"read";
  RequestLan(action,new{action});
 }
}
// The private package belongs to the active project. Capture mode never opens or saves it.
const int LayFirst=475, LaySecond=476, LayRemoveFirst=477, LayRemoveSecond=478;
(string Activation,string Unit,string Mode,int Focus)? laySelection=null;
(int X,int Y)? layAnchor=null;
int layPointerX=0,layPointerY=0,layReturnFocus=0;
int[] layBounds=Array.Empty<int>();
