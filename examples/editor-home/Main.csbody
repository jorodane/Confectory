bool LaySealed()=>model["yogi"]?["sealed"]?.GetValue<bool>()==true;
System.Text.Json.Nodes.JsonNode[] LayItems()=>System.Linq.Enumerable.ToArray(
 System.Linq.Enumerable.Select(System.Linq.Enumerable.Where(model["yogi"]?["items"]?.AsArray()??new System.Text.Json.Nodes.JsonArray(),
 item=>item?["kind"]?.ToString()=="image"),item=>item!));
bool LayWorkspaceAvailable()=>OperatingSystem.IsLinux()&&screen=="project"&&!appClosePending&&!nativePickerPending&&!storagePending&&
 job is null&&model["closeRequest"] is null&&model["workspace"]?["review"] is null&&ProjectMenu().Length==0&&
 model["shell"]?["navigation"]?.ToString()==""&&LayUnit().Length!=0&&
 !System.Linq.Enumerable.Any(Views(),view=>view["open"]?.GetValue<bool>()==true);
string LayDescriptionBuffer()
{
 string context=Context();
 if(!layDescriptions.TryGetValue(context,out string? buffer))
  layDescriptions[context]=buffer=OwnProjectText(context,calls.CreateText.Invoke("yogi-description-"+context,model["yogi"]?["text"]?.ToString()??""));
 return buffer;
