        bool reviewingLan = action == "inspect-lan";
        bool joiningLan = action == "join-lan";
        bool reviewingRelay = action == "inspect-relay";
        bool joiningRelay = action == "join-relay";
        bool usingLan = reviewingLan || joiningLan;
        bool usingRelay = reviewingRelay || joiningRelay;
        if ((development && action == "join" && args.Count == 3 ||
