    (string Id, System.Net.IPEndPoint Endpoint, string Dns, System.Security.Cryptography.X509Certificates.X509Certificate2 Pin,
        System.Security.Cryptography.X509Certificates.X509Certificate2 HostIdentity)? RelayRoute(string id) =>
        isolatedRelay?.Describe(id) as (string, System.Net.IPEndPoint, string, System.Security.Cryptography.X509Certificates.X509Certificate2,
            System.Security.Cryptography.X509Certificates.X509Certificate2)?;

    object ClaimRelay((string Id, System.Net.IPEndPoint Endpoint, string Dns,
        System.Security.Cryptography.X509Certificates.X509Certificate2 Pin,
        System.Security.Cryptography.X509Certificates.X509Certificate2 HostIdentity) reserved)
    {
        life.ThrowIfCancellationRequested();
        string token = isolatedRelay?.Take(reserved.Id) ?? throw new UnauthorizedAccessException("Relay reservation unavailable.");
        return (reserved.Endpoint, reserved.Dns, reserved.Pin, token);
    }

    static string Digest(byte[] bytes) => Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(bytes));

    static bool ValidTitle(string title) => title.Length is >= 1 and <= 128 && !System.Linq.Enumerable.Any(title, char.IsControl);

    static System.Security.Cryptography.X509Certificates.X509Certificate2 NewLocalCertificate(string tlsName, bool lan)
    {
        using var key = System.Security.Cryptography.RSA.Create(2048);
        var request = new System.Security.Cryptography.X509Certificates.CertificateRequest(lan ? "CN=Confectory LAN" : "CN=localhost", key,
            System.Security.Cryptography.HashAlgorithmName.SHA256, System.Security.Cryptography.RSASignaturePadding.Pkcs1);
        var san = new System.Security.Cryptography.X509Certificates.SubjectAlternativeNameBuilder();
        san.AddDnsName(tlsName);
        request.CertificateExtensions.Add(san.Build());
        request.CertificateExtensions.Add(new System.Security.Cryptography.X509Certificates.X509BasicConstraintsExtension(true, true, 0, true));
        request.CertificateExtensions.Add(new System.Security.Cryptography.X509Certificates.X509KeyUsageExtension(
            System.Security.Cryptography.X509Certificates.X509KeyUsageFlags.DigitalSignature |
            System.Security.Cryptography.X509Certificates.X509KeyUsageFlags.KeyCertSign, true));
        return request.CreateSelfSigned(DateTimeOffset.UtcNow.AddMinutes(-1), DateTimeOffset.UtcNow.AddMinutes(15));
    }

    (System.Net.IPAddress Local, System.Net.IPAddress Peer, Func<bool> Attached) Route(string local, string peer) =>
        ((System.Net.IPAddress, System.Net.IPAddress, Func<bool>))calls.PrivateLanRoute.Invoke(local, peer);

    static string LanTlsName(string host, string project) => "lan-" + host.Replace('.', '-') + "." + project + ".confectory.invalid";

    object ListenLan(System.Net.IPAddress local, System.Net.IPAddress peer, Func<bool> attached, object options)
    {
        var (certificate, admit, active, lifetime) = ((System.Security.Cryptography.X509Certificates.X509Certificate2,
            Func<string, string, string, object>, Func<bool>, System.Threading.CancellationToken))options;
        var listener = new System.Net.Sockets.TcpListener(local, 0);
        (Func<System.Threading.CancellationToken, System.Threading.Tasks.Task<System.IO.Stream>>, Action) Open(int backlog)
        {
            listener.Server.ExclusiveAddressUse = true;
            listener.Server.Ttl = 1;
            listener.Start(backlog);
            return (Accept, listener.Stop);
        }
        async System.Threading.Tasks.Task<System.IO.Stream> Accept(System.Threading.CancellationToken cancel)
        {
            while (true)
            {
                var socket = await listener.AcceptSocketAsync(cancel).ConfigureAwait(false);
                try
                {
                    if (socket.RemoteEndPoint is System.Net.IPEndPoint remote && remote.Address.Equals(peer) &&
                        socket.LocalEndPoint is System.Net.IPEndPoint bound && bound.Address.Equals(local) && attached())
                    {
                        socket.Ttl = 1;
                        return new System.Net.Sockets.NetworkStream(socket, ownsSocket: true);
                    }
                }
                catch { socket.Dispose(); throw; }
                socket.Dispose();
            }
        }
        try
        {
            var (stop, completion) = ((Action, System.Threading.Tasks.Task))calls.ListenProtected.Invoke(
                (certificate, admit, (Func<bool>)(() => attached() && active()), lifetime,
                 (Func<int, (Func<System.Threading.CancellationToken, System.Threading.Tasks.Task<System.IO.Stream>>, Action)>)Open));
            return (((System.Net.IPEndPoint)listener.LocalEndpoint).Port, stop, completion);
        }
        catch { listener.Stop(); throw; }
    }

    static System.IO.Stream ConnectLan(System.Net.IPAddress local, System.Net.IPAddress peer, Func<bool> attached, int port,
        System.Threading.CancellationToken cancel)
    {
        if (!attached()) throw new UnauthorizedAccessException("The local private route changed.");
        var socket = new System.Net.Sockets.Socket(System.Net.Sockets.AddressFamily.InterNetwork,
            System.Net.Sockets.SocketType.Stream, System.Net.Sockets.ProtocolType.Tcp);
        try
        {
            socket.Ttl = 1;
            socket.Bind(new System.Net.IPEndPoint(local, 0));
            socket.ConnectAsync(new System.Net.IPEndPoint(peer, port), cancel).AsTask().GetAwaiter().GetResult();
            if (!attached()) throw new UnauthorizedAccessException("The local private route changed.");
            return new System.Net.Sockets.NetworkStream(socket, ownsSocket: true);
        }
        catch { socket.Dispose(); throw; }
    }

    void Bind(Func<string,string,string,string> exchange, Action release)
    {
        bool closed = false;
        System.Threading.CancellationTokenRegistration registration = default;
        void Stop()
        {
            lock (owner)
            {
                if (closed) return;
                closed = true;
                owner[DevelopmentView] = null!;
                registration.Unregister();
                release();
            }
        }
        owner[DevelopmentView] = (activation, view, exchange, (Action)Stop);
        registration = life.UnsafeRegister(_ => Stop(), null);
    }
}
