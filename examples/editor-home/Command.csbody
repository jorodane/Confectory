var state=AppDomain.CurrentDomain.GetData("Confectory.EditorHome."+session) as object[]??throw new ObjectDisposedException("Entry/home session");lock(state){if((bool)state[6])throw new ObjectDisposedException("Entry/home session");var model=(System.Text.Json.Nodes.JsonObject)state[3];var args=System.Text.Json.Nodes.JsonNode.Parse(payload)!.AsObject();var manager=(string[])state[0];var cards=model["cards"]!.AsArray();string Value(string key,string fallback="")=>args[key]?.GetValue<string>()??fallback;
void Persist()=>calls.WriteAtomic.Invoke((string)state[2],cards.ToJsonString());
void Register(string context,string title,string description){var info=calls.Context.Invoke(manager,context);var old=System.Linq.Enumerable.FirstOrDefault(cards,c=>c!["path"]!.ToString()==info[1]);if(old is null){if(cards.Count>=32)throw new InvalidOperationException("Project list is full; remove a listing first");old=new System.Text.Json.Nodes.JsonObject{["path"]=info[1],["title"]=title.Length>0?title:info[2],["description"]=description};cards.Add(old);}model["selected"]=new System.Text.Json.Nodes.JsonObject{["context"]=context,["path"]=info[1],["namespace"]=info[2],["title"]=old["title"]!.DeepClone(),["description"]=old["description"]!.DeepClone()};Persist();}
try{model["status"]="";
 if(operation=="browse"){var rows=calls.Browse.Invoke(Value("directory",System.IO.Path.GetDirectoryName((string)state[2])!),args["offset"]?.GetValue<int>()??0,8);model["picker"]=System.Text.Json.JsonSerializer.SerializeToNode(rows);}
 else if(operation=="open"){string path=System.IO.Path.GetFullPath(Value("path"));if(System.IO.Directory.Exists(path))path=System.IO.Path.Combine(path,"project.cpack");Register(calls.Open.Invoke(manager,path),"","");model["status"]="Project opened";}
 else if(operation=="create"){string title=Value("title").Trim(),description=Value("description");if(title.Length==0)throw new ArgumentException("Project name is required");if(title.Length>128||description.Length>4096)throw new ArgumentException("Project information is too long");if(cards.Count>=32)throw new InvalidOperationException("Project list is full; remove a listing first");string slug=System.Text.RegularExpressions.Regex.Replace(title,"[^A-Za-z0-9_]","_").Trim('_');if(slug.Length==0)slug="LocalProject";if(char.IsDigit(slug[0]))slug="P_"+slug;string directory=System.IO.Path.Combine(Value("directory"),slug);string context=calls.CreateProject.Invoke(manager,slug,directory,System.IO.Path.Combine((string)state[1],"targets","dotnet","pack.cpack"));var info=calls.Context.Invoke(manager,context);string workspace=calls.WorkspaceOpen.Invoke(info[1],"local-user","editor");((System.Collections.Generic.List<string>)state[5]).Add(workspace);string id=info[2]+"::ProjectInfo";calls.Create.Invoke(workspace,"object",id);calls.SetValue.Invoke(workspace,id,"title",System.Text.Json.JsonSerializer.Serialize(title));calls.SetValue.Invoke(workspace,id,"description",System.Text.Json.JsonSerializer.Serialize(description));calls.Save.Invoke(workspace);Register(context,title,description);model["status"]="Project created";}
 else if(operation=="remove"){string path=Value("path");for(int i=cards.Count-1;i>=0;i--)if(cards[i]!["path"]!.ToString()==path)cards.RemoveAt(i);Persist();model["status"]="Removed from project list; project files retained";}
 else if(operation=="leave"){model["selected"]=null;}
 else throw new ArgumentException("Unknown entry/home command");
}catch(Exception error){model["status"]="Error: "+error.Message;}
model["revision"]=model["revision"]!.GetValue<int>()+1;System.Threading.Volatile.Write(ref state[4],model.ToJsonString());return (string)state[4];}
