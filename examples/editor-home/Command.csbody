var state=AppDomain.CurrentDomain.GetData("Confectory.EditorHome."+session) as object[]??throw new ObjectDisposedException("Entry/home session");lock(state){if((bool)state[6])throw new ObjectDisposedException("Entry/home session");var model=(System.Text.Json.Nodes.JsonObject)state[3];var args=System.Text.Json.Nodes.JsonNode.Parse(payload)!.AsObject();var manager=(string[])state[0];var cards=model["cards"]!.AsArray();string Value(string key,string fallback="")=>args[key]?.GetValue<string>()??fallback;
var shells=(System.Collections.Generic.Dictionary<string,string>)state[7];var executions=(System.Collections.Generic.Dictionary<string,string>)state[8];var executionRows=model["executions"]!.AsObject();
string Active(){var selected=model["selected"]??throw new InvalidOperationException("An explicitly open project is required; project chat cannot open/load a project");string context=selected["context"]!.ToString();if(args["context"] is not null&&Value("context")!=context)throw new InvalidOperationException("Stale project context; active project owns this action");calls.Context.Invoke(manager,context);return context;}
void Shell(string context,string op,string value){calls.ShellCommand.Invoke(shells[context],op,System.Text.Json.JsonSerializer.Serialize(new{context,value}));}
void Refresh(){var selected=model["selected"];if(selected is null){model["shell"]=null;model["execution"]=null;return;}string context=selected["context"]!.ToString();model["shell"]=System.Text.Json.Nodes.JsonNode.Parse(calls.ShellSnapshot.Invoke(shells[context]));model["execution"]=executionRows[context]?.DeepClone()??new System.Text.Json.Nodes.JsonObject{["state"]="idle",["handle"]=""};}
void Persist()=>calls.WriteAtomic.Invoke((string)state[2],cards.ToJsonString());
void Register(string context,string title,string description){var info=calls.Context.Invoke(manager,context);var old=System.Linq.Enumerable.FirstOrDefault(cards,c=>c!["path"]!.ToString()==info[1]);if(old is null){if(cards.Count>=32)throw new InvalidOperationException("Project list is full; remove a listing first");old=new System.Text.Json.Nodes.JsonObject{["path"]=info[1],["title"]=title.Length>0?title:info[2],["description"]=description};cards.Add(old);}model["selected"]=new System.Text.Json.Nodes.JsonObject{["context"]=context,["path"]=info[1],["namespace"]=info[2],["title"]=old["title"]!.DeepClone(),["description"]=old["description"]!.DeepClone()};if(!shells.ContainsKey(context))shells.Add(context,calls.ShellCreate.Invoke(model["selected"]!.ToJsonString()));Persist();}
try{model["status"]="";
 if(operation=="browse"){var rows=calls.Browse.Invoke(Value("directory",System.IO.Path.GetDirectoryName((string)state[2])!),args["offset"]?.GetValue<int>()??0,8);model["picker"]=System.Text.Json.JsonSerializer.SerializeToNode(rows);}
 else if(operation=="open"){string path=System.IO.Path.GetFullPath(Value("path"));if(System.IO.Directory.Exists(path))path=System.IO.Path.Combine(path,"project.cpack");Register(calls.Open.Invoke(manager,path),"","");model["status"]="Project opened";}
 else if(operation=="create"){string title=Value("title").Trim(),description=Value("description");if(title.Length==0)throw new ArgumentException("Project name is required");if(title.Length>128||description.Length>4096)throw new ArgumentException("Project information is too long");if(cards.Count>=32)throw new InvalidOperationException("Project list is full; remove a listing first");string[] plan=calls.PlanCreation.Invoke(title,Value("directory"));string slug=plan[1],directory=plan[2];string context=calls.CreateProject.Invoke(manager,slug,directory,System.IO.Path.Combine((string)state[1],"targets","dotnet","pack.cpack"));var info=calls.Context.Invoke(manager,context);string workspace=calls.WorkspaceOpen.Invoke(info[1],"local-user","editor");((System.Collections.Generic.List<string>)state[5]).Add(workspace);string id=info[2]+"::ProjectInfo";calls.Create.Invoke(workspace,"object",id);calls.SetValue.Invoke(workspace,id,"title",System.Text.Json.JsonSerializer.Serialize(title));calls.SetValue.Invoke(workspace,id,"description",System.Text.Json.JsonSerializer.Serialize(description));calls.Save.Invoke(workspace);Register(context,title,description);model["status"]="Project created: "+directory;}
 else if(operation=="remove"){string path=Value("path");for(int i=cards.Count-1;i>=0;i--)if(cards[i]!["path"]!.ToString()==path)cards.RemoveAt(i);Persist();model["status"]="Removed from project list; project files retained";}
 else if(operation=="shell"){string context=Active();Shell(context,Value("action"),Value("value"));}
 else if(operation=="run"){string context=Active();string current=executionRows[context]?["state"]?.ToString()??"idle";if(current is "building" or "running")throw new InvalidOperationException("This project execution is already active");string handle=calls.Launch.Invoke(manager,context,"",Value("target",OperatingSystem.IsWindows()?"windows":"linux"));executions[context]=handle;executionRows[context]=new System.Text.Json.Nodes.JsonObject{["handle"]=handle,["state"]="building"};Shell(context,"log","Run requested for current ProjectPack entry; final project sources");model["status"]="Run requested";}
 else if(operation=="stop"){string context=Active();if(executions.TryGetValue(context,out string? handle)){calls.Stop.Invoke(calls.Executions.Invoke(manager),handle);executionRows[context]!["state"]="stopped";Shell(context,"log","Stopped this project execution");}model["status"]="Stopped current project";}
 else if(operation=="poll"){var execution=calls.Executions.Invoke(manager);foreach(var item in executions){var observed=calls.Observe.Invoke(execution,item.Value);string previous=executionRows[item.Key]?["state"]?.ToString()??"";executionRows[item.Key]=new System.Text.Json.Nodes.JsonObject{["handle"]=item.Value,["state"]=observed[1],["exit"]=observed[5],["error"]=observed[6]};if(previous!=observed[1])Shell(item.Key,"log","Execution: "+observed[1]+(observed[6].Length>0?" - "+observed[6]:""));foreach(string line in calls.Output.Invoke(execution,item.Value))Shell(item.Key,"log",line);}}
 else if(operation=="leave"){string context=Active();if(args["draft"] is not null)Shell(context,"draft",Value("draft"));if(executions.TryGetValue(context,out string? handle)){calls.Stop.Invoke(calls.Executions.Invoke(manager),handle);executionRows[context]!["state"]="stopped";}Shell(context,"menu","");Shell(context,"navigation","");Shell(context,"log","Project panel left; owned execution stopped");model["selected"]=null;}
 else throw new ArgumentException("Unknown entry/home command");
}catch(Exception error){model["status"]="Error: "+error.Message;}
Refresh();model["revision"]=model["revision"]!.GetValue<int>()+1;System.Threading.Volatile.Write(ref state[4],model.ToJsonString());return (string)state[4];}
