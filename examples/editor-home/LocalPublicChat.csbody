static bool StableId(string value) =>
    Guid.TryParseExact(value, "N", out var parsed) && parsed != Guid.Empty && parsed.ToString("N") == value;

const string Unavailable = "{\"status\":\"unavailable\"}";
const string Committed = "{\"status\":\"committed\"}";
const int PendingAttachment = 14; // One selection owned by this EditorHome session.
const int RoomSlot = 15;
bool history = operation == "history";
bool sendText = operation == "send-text";
bool attachment = operation is "attachment" or "first-image" or "second-image";
bool prepare = operation == "prepare-attachment";
bool cancel = operation == "cancel-attachment";
bool sendAttachment = operation == "send-attachment";
bool issue = operation == "issue-invitation";
// This journal uses the owning message UUID as its attachment UUID.
if ((!history && !sendText && !attachment && !prepare && !cancel && !sendAttachment && !issue) ||
    (attachment && (!StableId(messageId) || messageId != attachmentId)) ||
    ((sendText || prepare) && (!StableId(messageId) || attachmentId.Length != 0)) ||
    ((cancel || sendAttachment) && (!StableId(messageId) || !StableId(attachmentId))) ||
    ((prepare || cancel) && text.Length != 0) ||
    (issue && (messageId.Length != 0 || attachmentId.Length != 0 || text.Length != 0)) || activation.Length == 0 ||
    AppDomain.CurrentDomain.GetData("Confectory.EditorHome." + session) is not object[] owner)
    return Unavailable;

lock (owner)
{
    if ((bool)owner[6]) return Unavailable;
    var model = (System.Text.Json.Nodes.JsonObject)owner[3];
    var selected = model["selected"];
    if (selected?["activation"]?.GetValue<string>() != activation) return Unavailable;
    var room = owner[RoomSlot] as (string Activation, object Host, object Admission, Func<bool> Active, Action Close,
        System.Threading.CancellationToken Lifetime)?;
    var pending = owner[PendingAttachment] as (string Activation, string Message, string Selection, string Box, string Digest)?;
    if (pending is { } prior && prior.Activation != activation)
    {
        owner[PendingAttachment] = null!;
        pending = null;
    }
    if (cancel || sendAttachment)
    {
        if (pending is not { } chosen || chosen.Message != messageId || chosen.Selection != attachmentId) return Unavailable;
        if (cancel)
        {
            owner[PendingAttachment] = null!;
            return "{\"status\":\"cancelled\"}";
        }
    }
    string project = selected["projectId"]!.GetValue<string>();
    string context = selected["context"]!.GetValue<string>();
    string manifest = selected["path"]!.GetValue<string>();
    string storage = System.IO.Path.GetDirectoryName((string)owner[2])!;
    var manager = (string[])owner[0];
    var domain = AppDomain.CurrentDomain;
    string? writeLease = null;

    try
    {
        bool Authorized() => ReferenceEquals(model["selected"], selected) &&
            calls.CreatorHost.Invoke(session) && calls.ReadIdentity.Invoke(manager, context) == project;

        if (!Authorized())
        {
            owner[PendingAttachment] = null!;
            if (room is { } inactive) inactive.Close();
            return Unavailable;
        }
        string manifestOrigin = calls.Origin.Invoke(manifest, false, false);
        if (manifestOrigin.Length == 0) return Unavailable;
        bool StillAuthorized() => Authorized() && calls.Origin.Invoke(manifest, false, false) == manifestOrigin;
        if (issue)
        {
            var (invite, _, _) = ((Func<int, string>, Func<string, string, string, object>, Action))
                calls.Invitations.Invoke(session, activation);
            return System.Text.Json.JsonSerializer.Serialize(new { status = "issued", invitation = invite(300) });
        }

        string? box = null;
        if (prepare || sendAttachment)
        {
            var boxes = (System.Collections.Generic.Dictionary<string, string>)owner[12];
            if (!boxes.TryGetValue(context, out box) || (sendAttachment && pending!.Value.Box != box))
                return Unavailable;

            // Yogi commands and the handoff both hold the owning editor lock. The
            // digest pins the exact live sealed package without retaining its content.
            string snapshot = calls.Handoff.Invoke(box, project, "local-user", manifest);
            string digest = Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(
                System.Text.Encoding.UTF8.GetBytes(snapshot)));
            if (prepare)
            {
                if (!StillAuthorized()) return Unavailable;
                string selection = Guid.NewGuid().ToString("N");
                owner[PendingAttachment] = (activation, messageId, selection, box, digest);
                return System.Text.Json.JsonSerializer.Serialize(new { status = "ready", selection });
            }
            if (pending!.Value.Digest != digest) return Unavailable;
        }

        string journal = System.IO.Path.Combine(storage, "project-chat", project + ".json");
        if (System.IO.File.Exists(journal) && calls.Origin.Invoke(journal, false, false).Length == 0)
            return Unavailable;

        // The live host must deliver its own commits to the admitted inboxes. Reads
        // continue to use the durable journal, including from other editor windows.
        object? liveHost = null;
        if (sendText || sendAttachment)
        {
            if (room is { } live)
            {
                if (live.Activation != activation || !live.Active())
                {
                    live.Close();
                    return Unavailable;
                }
                liveHost = live.Host;
            }
            else
            {
                string path = OperatingSystem.IsWindows() ? journal.ToUpperInvariant() : journal;
                string key = "Confectory.EditorHome.PublicChatOwner." + Convert.ToHexString(
                    System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(path)));
                lock (domain)
                {
                    if (domain.GetData(key) is not null) return Unavailable;
                    domain.SetData(key, owner);
                    writeLease = key;
                }
            }
        }
        var (_, send, read, close, sendBox, readAttachment) =
            ((Func<string, object>, Func<string, string, bool>, Func<string>, Action,
              Func<string, string, string, bool>, Func<string, string>))
            (liveHost ?? calls.OpenHost.Invoke(storage, project, "local-user", manifest));
        try
        {
            if (sendText)
                return StillAuthorized() && send(messageId, text) ? Committed : Unavailable;
            if (sendAttachment)
                return StillAuthorized() && sendBox(messageId, text, box!) ? Committed : Unavailable;

            var result = new System.Text.Json.Nodes.JsonObject
            {
                ["status"] = "available",
                ["projectActivation"] = activation
            };
            if (history)
            {
                result["messages"] = System.Text.Json.Nodes.JsonNode.Parse(read());
            }
            else
            {
                var package = System.Text.Json.Nodes.JsonNode.Parse(readAttachment(messageId))!["package"]!;
                var items = package["items"]!.AsArray();
                result["messageId"] = messageId;
                result["attachmentId"] = attachmentId;
                if (operation == "attachment")
                {
                    result["description"] = package["text"]!.DeepClone();
                    var viewItems = new System.Text.Json.Nodes.JsonArray();
                    var workspaces = (System.Collections.Generic.Dictionary<string, string>)owner[9];
                    string? draft = workspaces.TryGetValue(context, out var workspace)
                        ? calls.BorrowDraft.Invoke(workspace) : null;
                    var identity = draft is null ? null : calls.WorkspaceIdentity.Invoke(draft);
                    if (identity?[0] != manifest || identity?[1] != "local-user") draft = null;

                    int imageIndex = 0;
                    foreach (var item in items)
                    {
                        string kind = item!["kind"]!.GetValue<string>();
                        var row = new System.Text.Json.Nodes.JsonObject
                        {
                            ["item"] = item["item"]!.DeepClone(),
                            ["kind"] = kind
                        };
                        if (kind == "image")
                        {
                            row["image"] = imageIndex++;
                            row["width"] = item["capture"]!["width"]!.DeepClone();
                            row["height"] = item["capture"]!["height"]!.DeepClone();
                        }
                        else
                        {
                            string id = item["id"]!.GetValue<string>();
                            string elementKind = item["elementKind"]!.GetValue<string>();
                            row["availability"] = "unavailable";
                            if (draft is not null && CanOpenReference(draft, id, elementKind))
                            {
                                row["availability"] = "available";
                                row["id"] = id;
                                row["elementKind"] = elementKind;
                            }
                        }
                        viewItems.Add(row);
                    }
                    result["items"] = viewItems;
                }
                else
                {
                    int index = operation == "first-image" ? 0 : 1;
                    var image = System.Linq.Enumerable.ElementAtOrDefault(
                        System.Linq.Enumerable.Where(items, item => item!["kind"]!.GetValue<string>() == "image"), index);
                    if (image is null) return Unavailable;
                    result["item"] = image["item"]!.DeepClone();
                    var capture = new System.Text.Json.Nodes.JsonObject();
                    foreach (string field in new[] { "width", "height", "pixels", "hash", "encoding" })
                        capture[field] = image["capture"]![field]!.DeepClone();
                    result["capture"] = capture;
                }
            }

            string reply = result.ToJsonString(new System.Text.Json.JsonSerializerOptions
            {
                Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
            });
            if (reply.Length > 2097152 || !StillAuthorized()) return Unavailable;
            return reply;

            bool CanOpenReference(string draft, string id, string kind)
            {
                if (kind is not ("category" or "concept" or "function" or "module" or "object" or "schema" or "implementation"))
                    return false;
                try
                {
                    // Use both the live draft's owned-unit gate and a fresh read of the
                    // registered declaration. Cached drafts alone can outlive a deletion.
                    if (calls.WorkspaceStatus.Invoke(draft, id)[1] != kind) return false;
                    string request = System.Text.Json.JsonSerializer.Serialize(new { action = "read", id });
                    var catalog = System.Text.Json.Nodes.JsonNode.Parse(calls.Catalog.Invoke(manifest, request));
                    return catalog?["status"]?.ToString() == "available" &&
                        catalog["element"]?["id"]?.ToString() == id &&
                        catalog["element"]?["kind"]?.ToString() == kind;
                }
                catch (Exception error) when (error is ArgumentException or InvalidOperationException or
                    UnauthorizedAccessException or System.IO.IOException or System.Text.Json.JsonException)
                {
                    return false;
                }
            }
        }
        finally { if (liveHost is null) close(); }
    }
    catch (Exception error) when (error is ArgumentException or InvalidOperationException or
        UnauthorizedAccessException or System.IO.IOException or System.Text.Json.JsonException or
        TimeoutException or AggregateException)
    {
        return Unavailable;
    }
    finally
    {
        if (writeLease is not null)
            lock (domain) domain.SetData(writeLease, null);
    }
}
