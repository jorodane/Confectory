const int DevelopmentView = 17;
const string Unavailable = "{\"status\":\"unavailable\"}";
const string Denied = "{\"status\":\"denied\"}";
const string Committed = "{\"status\":\"committed\"}";
static bool StableId(string id) => Guid.TryParseExact(id, "N", out var parsed) && parsed != Guid.Empty && parsed.ToString("N") == id;
if ((!OperatingSystem.IsLinux() && !OperatingSystem.IsWindows()) ||
    Environment.GetEnvironmentVariable("CONFECTORY_DEV_PUBLIC_CHAT_LOOPBACK") != "1" ||
    AppDomain.CurrentDomain.GetData("Confectory.WebUI.Transient." + cancellation) is not (string view, System.Threading.CancellationToken life, string mountedScope) ||
    AppDomain.CurrentDomain.GetData("Confectory.EditorHome." + session) is not object[] owner)
    return Unavailable;

lock (owner)
{
    if ((bool)owner[6] || life.IsCancellationRequested) return Unavailable;
    var selected = ((System.Text.Json.Nodes.JsonObject)owner[3])["selected"];
    string activation = selected?["activation"]?.ToString() ?? "";
    if (System.Text.Json.Nodes.JsonNode.Parse(mountedScope)?["projectActivation"]?.ToString() != activation) return Unavailable;
    var active = owner[DevelopmentView] as (string Activation, string View, Func<string,string,string,string> Exchange, Action Stop)?;

    try
    {
        var args = System.Text.Json.Nodes.JsonNode.Parse(payload)!.AsObject();
        string? action = args["action"]?.GetValue<string>();
        if (action is "read" or "status" or "send" or "send-attachment" or "prepare-attachment" or "cancel-attachment" or
            "attachment" or "first-image" or "second-image")
        {
            if (active is not { } bound || bound.View != view || bound.Activation != activation)
                return Unavailable;
            string id = "", text = "";
            if (action is "send" or "send-attachment")
            {
                id = args["id"]?.GetValue<string>() ?? "";
                text = args["text"]?.GetValue<string>() ?? "";
                if (args.Count != 3 || !StableId(id) || string.IsNullOrWhiteSpace(text) || text.Length > 2048 || text.Contains('\0'))
                    return Denied;
            }
            else if (action is not ("read" or "status"))
            {
                id = args["id"]?.GetValue<string>() ?? "";
                if (args.Count != 2 || !StableId(id)) return Denied;
            }
            else if (args.Count != 1) return Unavailable;
            life.ThrowIfCancellationRequested();
            try { return bound.Exchange(action, id, text); }
            catch { bound.Stop(); throw; }
        }
        if (active is not null) return Unavailable;

        if (action == "issue" && args.Count == 1 && selected is not null && calls.CreatorHost.Invoke(session))
        {
            using var key = System.Security.Cryptography.RSA.Create(2048);
            var request = new System.Security.Cryptography.X509Certificates.CertificateRequest("CN=localhost", key,
                System.Security.Cryptography.HashAlgorithmName.SHA256, System.Security.Cryptography.RSASignaturePadding.Pkcs1);
            var san = new System.Security.Cryptography.X509Certificates.SubjectAlternativeNameBuilder();
            san.AddDnsName("localhost");
            request.CertificateExtensions.Add(san.Build());
            request.CertificateExtensions.Add(new System.Security.Cryptography.X509Certificates.X509BasicConstraintsExtension(true, true, 0, true));
            request.CertificateExtensions.Add(new System.Security.Cryptography.X509Certificates.X509KeyUsageExtension(
                System.Security.Cryptography.X509Certificates.X509KeyUsageFlags.DigitalSignature |
                System.Security.Cryptography.X509Certificates.X509KeyUsageFlags.KeyCertSign, true));
            var certificate = request.CreateSelfSigned(DateTimeOffset.UtcNow.AddMinutes(-1), DateTimeOffset.UtcNow.AddMinutes(15));
            (int Port, Action Stop, System.Threading.Tasks.Task Completion) listener;
            try { listener = ((int, Action, System.Threading.Tasks.Task))calls.Start.Invoke(session, activation, certificate); }
            catch { certificate.Dispose(); throw; }
            _ = listener.Completion.ContinueWith(_ => certificate.Dispose(), System.Threading.Tasks.TaskScheduler.Default);
            (string Message, string Selection)? prepared = null;
            Bind((op, id, text) =>
            {
                if (op is not ("status" or "send" or "prepare-attachment" or "cancel-attachment" or "send-attachment"))
                    return Unavailable;
                if (listener.Completion.IsCompleted || !ReferenceEquals(owner[16], listener.Completion) ||
                    owner[15] is not (string scope, object _, object _, Func<bool> isActive, Action _, System.Threading.CancellationToken _) ||
                    scope != activation || !isActive())
                    throw new ObjectDisposedException("Local public chat host");
                if (op == "status") return "{\"status\":\"hosting\"}";
                if (op == "prepare-attachment")
                {
                    var result = System.Text.Json.Nodes.JsonNode.Parse(
                        calls.Chat.Invoke(session, activation, op, id, "", ""));
                    if (result?["selection"]?.GetValue<string>() is not string selection) return Denied;
                    prepared = (id, selection);
                    return "{\"status\":\"ready\"}";
                }
                if (op is "cancel-attachment" or "send-attachment")
                {
                    if (prepared is not { } chosen || chosen.Message != id) return Denied;
                    string result = calls.Chat.Invoke(session, activation, op, id, chosen.Selection, text);
                    if (op == "cancel-attachment" && result == "{\"status\":\"cancelled\"}")
                    {
                        prepared = null;
                        return result;
                    }
                    // Keep the selection on acknowledgement loss so the same submission
                    // can be retried by message ID through the existing journal CAS.
                    return result == Committed ? Committed : Denied;
                }
                if (prepared is { } pinned && pinned.Message == id) return Denied;
                return calls.Chat.Invoke(session, activation, "send-text", id, "", text) == Committed ? Committed : Denied;
            }, () =>
            {
                try
                {
                    if (prepared is { } chosen)
                        calls.Chat.Invoke(session, activation, "cancel-attachment", chosen.Message, chosen.Selection, "");
                }
                finally { listener.Stop(); }
            });
            try
            {
                life.ThrowIfCancellationRequested();
                var issued = System.Text.Json.Nodes.JsonNode.Parse(
                    calls.Chat.Invoke(session, activation, "issue-invitation", "", "", ""));
                if (issued?["invitation"]?.GetValue<string>() is not string code) throw new InvalidOperationException();
                return System.Text.Json.JsonSerializer.Serialize(new
                {
                    status = "issued",
                    card = System.Text.Json.JsonSerializer.Serialize(new
                    {
                        version = 1, port = listener.Port, project = selected["projectId"]!.ToString(),
                        certificate = Convert.ToBase64String(certificate.RawData), code
                    })
                });
            }
            catch
            {
                if (owner[DevelopmentView] is ValueTuple<string, string, Func<string,string,string,string>, Action> bound) bound.Item4();
                throw;
            }
        }

        if (action == "join" && args.Count == 3 && args["name"]?.GetValue<string>() is string name &&
            name.Length is > 0 and <= 64 && args["card"]?.GetValue<string>() is string card && card.Length is > 0 and <= 4096)
        {
            var invitation = System.Text.Json.Nodes.JsonNode.Parse(card)!.AsObject();
            if (invitation.Count != 5 || invitation["version"]?.GetValue<int>() != 1 ||
                invitation["port"]?.GetValue<int>() is not int port || port is < 1 or > 65535 ||
                invitation["project"]?.GetValue<string>() is not string project || !Guid.TryParseExact(project, "N", out _) ||
                invitation["code"]?.GetValue<string>() is not string code || code.Length != 64 ||
                invitation["certificate"]?.GetValue<string>() is not string encoded || encoded.Length > 3500)
                return Unavailable;

            using var pin = System.Security.Cryptography.X509Certificates.X509CertificateLoader.LoadCertificate(Convert.FromBase64String(encoded));
            var (request, close) = ((Func<System.Text.Json.Nodes.JsonObject, System.Text.Json.Nodes.JsonObject>, Action))
                calls.Connect.Invoke(port, pin, project, code, name);
            Bind((op, id, text) =>
            {
                if (op == "send")
                {
                    string? status = request(new() { ["op"] = "send", ["id"] = id, ["text"] = text })["status"]?.ToString();
                    return status switch
                    {
                        "committed" => Committed,
                        "denied" => Denied,
                        _ => throw new InvalidOperationException()
                    };
                }
                if (op is "attachment" or "first-image" or "second-image")
                {
                    // The TLS peer resolves IDs against this exact admitted inbox.
                    // Split captures to fit the WebUI result budget. EY identities
                    // remain absent until a recipient workspace can authorize them.
                    var reply = request(new() { ["op"] = "attachment", ["id"] = id });
                    if (reply["status"]?.ToString() != "ok" || reply["items"] is not System.Text.Json.Nodes.JsonArray items)
                        return Denied;
                    if (op == "attachment")
                    {
                        var metadata = new System.Text.Json.Nodes.JsonArray();
                        int nextImage = 0;
                        foreach (var item in items)
                        {
                            if (item!["kind"]?.ToString() == "image")
                                metadata.Add(new System.Text.Json.Nodes.JsonObject { ["kind"] = "image", ["image"] = nextImage++ });
                            else
                                metadata.Add(new System.Text.Json.Nodes.JsonObject { ["kind"] = "semantic", ["availability"] = "unavailable" });
                        }
                        return new System.Text.Json.Nodes.JsonObject
                        {
                            ["status"] = "available", ["description"] = reply["description"]!.DeepClone(), ["items"] = metadata
                        }.ToJsonString();
                    }
                    int index = op == "first-image" ? 0 : 1;
                    var image = System.Linq.Enumerable.ElementAtOrDefault(
                        System.Linq.Enumerable.Where(items, item => item?["kind"]?.ToString() == "image"), index);
                    return image is null ? Denied : new System.Text.Json.Nodes.JsonObject
                    {
                        ["status"] = "available", ["capture"] = image.DeepClone()
                    }.ToJsonString();
                }
                if (op != "read") return Unavailable;
                var response = request(new() { ["op"] = "read" });
                if (response["status"]?.ToString() != "ok" || response["messages"] is not System.Text.Json.Nodes.JsonArray rows)
                    throw new InvalidOperationException();
                // Leave headroom under the WebUI response limit, even with escaped text.
                int omitted = Math.Max(0, rows.Count - 128);
                var messages = new System.Text.Json.Nodes.JsonArray();
                for (int i = omitted; i < rows.Count; i++) messages.Add(rows[i]!.DeepClone());
                return new System.Text.Json.Nodes.JsonObject
                {
                    ["status"] = "joined", ["messages"] = messages, ["omitted"] = omitted
                }.ToJsonString();
            }, close);
            return life.IsCancellationRequested ? Unavailable : "{\"status\":\"joined\"}";
        }
    }
    catch (Exception error) when (error is ArgumentException or InvalidOperationException or
        UnauthorizedAccessException or System.IO.IOException or System.Text.Json.JsonException or FormatException or
        OperationCanceledException or System.Net.Sockets.SocketException or System.Security.Authentication.AuthenticationException or
        System.Security.Cryptography.CryptographicException)
    {
        return Unavailable;
    }
    return Unavailable;

    void Bind(Func<string,string,string,string> exchange, Action release)
    {
        bool closed = false;
        System.Threading.CancellationTokenRegistration registration = default;
        void Stop()
        {
            lock (owner)
            {
                if (closed) return;
                closed = true;
                owner[DevelopmentView] = null!;
                registration.Unregister();
                release();
            }
        }
        owner[DevelopmentView] = (activation, view, exchange, (Action)Stop);
        registration = life.UnsafeRegister(_ => Stop(), null);
    }
}
