const int DevelopmentView = 17;
const string Unavailable = "{\"status\":\"unavailable\"}";
if ((!OperatingSystem.IsLinux() && !OperatingSystem.IsWindows()) ||
    Environment.GetEnvironmentVariable("CONFECTORY_DEV_PUBLIC_CHAT_LOOPBACK") != "1" ||
    AppDomain.CurrentDomain.GetData("Confectory.WebUI.Transient." + cancellation) is not (string view, System.Threading.CancellationToken life, string mountedScope) ||
    AppDomain.CurrentDomain.GetData("Confectory.EditorHome." + session) is not object[] owner)
    return Unavailable;

lock (owner)
{
    if ((bool)owner[6] || life.IsCancellationRequested) return Unavailable;
    var selected = ((System.Text.Json.Nodes.JsonObject)owner[3])["selected"];
    string activation = selected?["activation"]?.ToString() ?? "";
    if (System.Text.Json.Nodes.JsonNode.Parse(mountedScope)?["projectActivation"]?.ToString() != activation) return Unavailable;
    var active = owner[DevelopmentView] as (string Activation, string View, Func<string>? Read, Action Stop)?;

    try
    {
        var args = System.Text.Json.Nodes.JsonNode.Parse(payload)!.AsObject();
        string? action = args["action"]?.GetValue<string>();
        if (action == "read" && args.Count == 1)
        {
            if (active is not { } guest || guest.View != view || guest.Activation != activation || guest.Read is null)
                return Unavailable;
            try { return guest.Read(); }
            catch { guest.Stop(); throw; }
