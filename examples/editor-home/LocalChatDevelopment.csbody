if (AppDomain.CurrentDomain.GetData("Confectory.WebUI.Transient." + cancellation) is not
    (string view, System.Threading.CancellationToken life, string mountedScope) ||
    System.Text.Json.Nodes.JsonNode.Parse(mountedScope)?["projectActivation"]?.ToString() is not string activation)
    return "{\"status\":\"unavailable\"}";
return calls.Exchange.Invoke(session, payload, (view, life, activation), false);
