                var response = request(new() { ["op"] = "read" });
                if (response["status"]?.ToString() != "ok" || response["messages"] is not System.Text.Json.Nodes.JsonArray rows)
                    throw new InvalidOperationException();
                // Leave headroom under the WebUI response limit, even with escaped text.
                int omitted = Math.Max(0, rows.Count - 128);
                var messages = new System.Text.Json.Nodes.JsonArray();
                for (int i = omitted; i < rows.Count; i++) messages.Add(rows[i]!.DeepClone());
                return new System.Text.Json.Nodes.JsonObject
