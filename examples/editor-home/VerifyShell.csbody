void Check(bool condition,string message){if(!condition)throw new Exception(message);}System.Text.Json.Nodes.JsonNode J(string text)=>System.Text.Json.Nodes.JsonNode.Parse(text)!;string repo=Environment.GetEnvironmentVariable("CONFECTORY_EDITOR_REPO")??Environment.CurrentDirectory;string root=System.IO.Path.Combine(System.IO.Path.GetTempPath(),"confectory-shell-domain-"+Guid.NewGuid().ToString("N"));System.IO.Directory.CreateDirectory(root);string token=calls.CreateSession.Invoke(repo,System.IO.Path.Combine(root,"settings"));
System.Text.Json.Nodes.JsonNode Run(string op,object args)=>J(calls.Command.Invoke(token,op,System.Text.Json.JsonSerializer.Serialize(args)));
System.Text.Json.Nodes.JsonNode Wait(string context,string expected){var watch=System.Diagnostics.Stopwatch.StartNew();while(watch.Elapsed.TotalSeconds<90){var snapshot=Run("poll",new{});string state=snapshot["executions"]![context]!["state"]!.ToString();if(state==expected)return snapshot;if(state is "failed" or "exited")throw new Exception(snapshot.ToJsonString());System.Threading.Thread.Sleep(30);}throw new Exception("Execution state deadline "+expected);}
try{
 var initial=J(calls.Snapshot.Invoke(token));Check(initial["selected"] is null&&initial["shell"] is null&&initial["executions"]!.AsObject().Count==0,"startup does not load a null project/chat");var nullChat=Run("shell",new{action="tab",value="chat"});Check(nullChat["status"]!.ToString().StartsWith("Error:")&&nullChat["selected"] is null&&nullChat["cards"]!.AsArray().Count==0,"chat cannot open/create project");
 var a=Run("create",new{title="ShellA",description="A intent",directory=root});Check(!a["status"]!.ToString().StartsWith("Error:"),a.ToJsonString());string contextA=a["selected"]!["context"]!.ToString(),pathA=a["selected"]!["path"]!.ToString();Check(a["shell"]!["project"]!["context"]!.ToString()==contextA,"project supplies chat context");
 var workspace=Run("workspace",new{context=contextA,action="open"})["workspace"]!;string unitId=workspace["selected"]!.ToString();Check(unitId.Length>0,"owned source selected");
 var filtered=Run("workspace",new{context=contextA,action="filter",query=unitId.ToUpperInvariant(),kind="body"})["workspace"]!;Check(filtered["total"]!.GetValue<int>()==1&&filtered["unit"]!["id"]!.ToString()==unitId,"actual product ID/kind navigation");
 var empty=Run("workspace",new{context=contextA,action="filter",query="missing::unit"})["workspace"]!;Check(empty["total"]!.GetValue<int>()==0&&empty["selected"]!.ToString()==unitId,"navigation does not replace selection");
 var wrong=Run("workspace",new{context="stale",action="filter",query="wrong"});Check(wrong["status"]!.ToString().StartsWith("Error:")&&wrong["workspace"]!["query"]!.ToString()=="missing::unit","stale navigation context refused");
 Run("workspace",new{context=contextA,action="select",id=unitId[..unitId.IndexOf("::",StringComparison.Ordinal)]+"::ProjectInfo"});
 var inspected=Run("workspace",new{context=contextA,action="inspect"})["workspace"]!;Check(inspected["inspection"]!["kind"]!.ToString()=="object"&&inspected["inspection"]!["relations"]!["scope"]!.ToString()=="declared","actual selected element inspection");
 string declaration=inspected["unit"]!["text"]!.ToString();long rev=inspected["unit"]!["revision"]!.GetValue<long>();
 Run("workspace",new{context=contextA,action="open",text=declaration.Insert(declaration.LastIndexOf('}'),"module Missing::Role;"),expectedRevision=rev});
 var draftInspection=Run("workspace",new{context=contextA,action="inspect"})["workspace"]!;Check(draftInspection["inspection"]!["relations"]!["edges"]!.AsArray().Count==1&&draftInspection["inspectionRevision"]!.GetValue<long>()==rev+1,"actual inspection reads draft without resolving missing target");
 Run("workspace",new{context=contextA,action="open",text=declaration,expectedRevision=rev+1});
 Run("workspace",new{context=contextA,action="select",id=unitId});
 Run("workspace",new{context=contextA,action="filter"});
 Run("shell",new{context=contextA,action="draft",value="A retained local draft"});System.IO.File.WriteAllText(System.IO.Path.Combine(System.IO.Path.GetDirectoryName(pathA)!,"main.csbody"),"Console.WriteLine(\"Shell child A\");while(true)System.Threading.Thread.Sleep(20);\n");Run("run",new{context=contextA,target="linux"});Wait(contextA,"running");
 var b=Run("create",new{title="ShellB",description="B intent",directory=root});string contextB=b["selected"]!["context"]!.ToString(),pathB=b["selected"]!["path"]!.ToString();Run("shell",new{context=contextB,action="draft",value="B isolated local draft"});System.IO.File.WriteAllText(System.IO.Path.Combine(System.IO.Path.GetDirectoryName(pathB)!,"main.csbody"),"Console.WriteLine(\"Shell child B\");while(true)System.Threading.Thread.Sleep(20);\n");Run("run",new{context=contextB,target="linux"});Wait(contextB,"running");
 var stale=Run("shell",new{context=contextA,action="draft",value="wrong project"});Check(stale["status"]!.ToString().StartsWith("Error:")&&stale["selected"]!["context"]!.ToString()==contextB&&stale["shell"]!["draft"]!.ToString()=="B isolated local draft","stale chat intent cannot switch/open/update another project");
 Run("stop",new{context=contextB});var isolated=Run("poll",new{});Check(isolated["executions"]![contextA]!["state"]!.ToString()=="running"&&isolated["executions"]![contextB]!["state"]!.ToString()=="stopped","Stop targets one project");Run("leave",new{context=contextB,draft="B preserved on leave"});var absent=Run("shell",new{action="tab",value="chat"});Check(absent["selected"] is null&&absent["shell"] is null&&absent["cards"]!.AsArray().Count==2,"leaving does not load a null-project panel");
 var reopened=Run("open",new{path=pathA});Check(reopened["shell"]!["draft"]!.ToString()=="A retained local draft"&&reopened["shell"]!["project"]!["context"]!.ToString()==contextA,"explicit reopen restores same borrowed context");Run("leave",new{context=contextA});Check(Run("poll",new{})["executions"]![contextA]!["state"]!.ToString()=="stopped","project leave stops owned execution");string relationRoot=System.IO.Path.Combine(root,"contract-pack");System.IO.Directory.CreateDirectory(relationRoot);string relationPath=System.IO.Path.Combine(relationRoot,"pack.cpack");
System.IO.File.WriteAllText(relationPath,"pack Shell.Contracts version \"0.1.0\" { standalone false; element Rules module \"Rules.celem\"; }");
string ruleSource="module Shell.Contracts::Rules { require Missing::Function (string,int[]) -> bool; }";System.IO.File.WriteAllText(System.IO.Path.Combine(relationRoot,"Rules.celem"),ruleSource);
var openedContracts=Run("open",new{path=relationPath});string contractContext=openedContracts["selected"]!["context"]!.ToString();Run("workspace",new{context=contractContext,action="select",id="Shell.Contracts::Rules"});
var requiredSnapshot=Run("workspace",new{context=contractContext,action="inspect"})["workspace"]!;var requiredEdge=requiredSnapshot["inspection"]!["relations"]!["edges"]![0]!;
Check(requiredEdge["target"]!.ToString()=="Missing::Function"&&requiredEdge["signature"]!["return"]!.ToString()=="bool"&&requiredEdge["signature"]!["Args"]!.AsArray().Count==2&&requiredSnapshot["inspectionRevision"]!.GetValue<long>()==0,"actual required function contract lookup");
Run("workspace",new{context=contractContext,action="open",text=ruleSource.Replace("-> bool","-> string[]",StringComparison.Ordinal),expectedRevision=0});
var updatedRequired=Run("workspace",new{context=contractContext,action="inspect"})["workspace"]!;Check(updatedRequired["inspectionRevision"]!.GetValue<long>()==1&&updatedRequired["inspection"]!["relations"]!["edges"]![0]!["signature"]!["return"]!.ToString()=="string[]","required signature follows draft revision");
Check(System.IO.File.ReadAllText(System.IO.Path.Combine(relationRoot,"Rules.celem"))==ruleSource,"inspection committed draft");Run("leave",new{context=contractContext});Run("remove",new{path=relationPath});
calls.CloseSession.Invoke(token);calls.CloseSession.Invoke(token);token=calls.CreateSession.Invoke(repo,System.IO.Path.Combine(root,"settings"));var restored=J(calls.Snapshot.Invoke(token));Check(restored["cards"]!.AsArray().Count==2&&restored["selected"] is null&&restored["shell"] is null&&restored["executions"]!.AsObject().Count==0,"app restart lists projects without opening a chat/project or launching code");Console.WriteLine("Project shell domain: explicit contexts, no null/chat-driven opening, isolated drafts/Run/Stop, leave/reopen/restart and owner cleanup passed");
}finally{calls.CloseSession.Invoke(token);System.IO.Directory.Delete(root,true);}return 0;
