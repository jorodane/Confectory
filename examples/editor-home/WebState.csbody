// The existing desktop inbox is pumped only on its owning parent UI thread.
if(AppDomain.CurrentDomain.GetData("Confectory.EditorHome.WebEntry."+context) is object[] entry&&(int)entry[1]==Environment.CurrentManagedThreadId){
 var incoming=System.Text.Json.Nodes.JsonNode.Parse(calls.EntryRequest.Invoke((string)entry[0],"poll","{}"))!;
 if(incoming["id"] is not null){string status="failed";try{var opened=System.Text.Json.Nodes.JsonNode.Parse(calls.Command.Invoke(context,"open-request",new System.Text.Json.Nodes.JsonObject{["path"]=incoming["path"]!.DeepClone()}.ToJsonString()))!;if(opened["selected"] is not null&&opened["status"]?.ToString().StartsWith("Error:",StringComparison.Ordinal)!=true){calls.Command.Invoke(context,"workspace","{\"action\":\"open\"}");status="opened";}}finally{calls.EntryRequest.Invoke((string)entry[0],"reply",System.Text.Json.JsonSerializer.Serialize(new{id=incoming["id"]!.ToString(),status,message=status=="opened"?"":"Project open was rejected"}));}}
}
var model=System.Text.Json.Nodes.JsonNode.Parse(calls.Snapshot.Invoke(context))!;
bool ActiveExecution(System.Text.Json.Nodes.JsonNode? execution)=>execution?["state"]?.ToString() is "building" or "running";
if(ActiveExecution(model["execution"])||System.Linq.Enumerable.Any(model["backgroundProjects"]?.AsArray()??new System.Text.Json.Nodes.JsonArray(),row=>ActiveExecution(row?["execution"]))){string key="Confectory.EditorHome.WebPoll."+context;long now=System.Diagnostics.Stopwatch.GetTimestamp(),last=AppDomain.CurrentDomain.GetData(key) is long stamp?stamp:0;if(now-last>System.Diagnostics.Stopwatch.Frequency/4){AppDomain.CurrentDomain.SetData(key,now);model=System.Text.Json.Nodes.JsonNode.Parse(calls.Command.Invoke(context,"poll","{}"))!;}}
var selected=model["selected"];string project=selected?["projectId"]?.ToString()??"";
var cards=new System.Text.Json.Nodes.JsonArray();foreach(var card in model["cards"]!.AsArray())cards.Add(new System.Text.Json.Nodes.JsonObject{["id"]=Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(card!["path"]!.ToString())))[..32],["title"]=card["title"]!.DeepClone(),["description"]=card["description"]?.DeepClone()});
