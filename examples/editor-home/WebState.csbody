// Deliberate public projection: never publish the model, handles, paths, binding configuration or approvals.
var units=new System.Text.Json.Nodes.JsonArray();foreach(var unit in workspace?["units"]?.AsArray()??new System.Text.Json.Nodes.JsonArray())units.Add(new System.Text.Json.Nodes.JsonObject{["id"]=unit!["id"]!.DeepClone(),["kind"]=unit["kind"]!.DeepClone(),["revision"]=unit["revision"]!.DeepClone(),["dirty"]=unit["dirty"]!.DeepClone()});
var source=workspace?["unit"];System.Text.Json.Nodes.JsonObject? draft=source is null?null:new(){["id"]=source["id"]!.DeepClone(),["kind"]=source["kind"]!.DeepClone(),["text"]=source["text"]!.DeepClone(),["revision"]=source["revision"]!.DeepClone(),["dirty"]=source["dirty"]!.DeepClone()};
var review=workspace?["review"];
System.Text.Json.Nodes.JsonObject? publicReview=review is null?null:new(){["id"]=review["id"]!.DeepClone(),["token"]=review["token"]!.DeepClone(),["status"]=review["status"]!.DeepClone(),["before"]=review["before"]!.DeepClone(),["after"]=review["after"]!.DeepClone()};
var schema=workspace?["schemaView"];System.Text.Json.Nodes.JsonObject? publicSchema=null;
if(schema is not null){var rows=new System.Text.Json.Nodes.JsonArray();foreach(var row in schema["rows"]!.AsArray())rows.Add(new System.Text.Json.Nodes.JsonObject{["name"]=row!["name"]!.DeepClone(),["type"]=row["type"]!.DeepClone(),["kind"]=row["kind"]!.DeepClone(),["inputKind"]=row["inputKind"]!.DeepClone(),["path"]=row["path"]!.DeepClone(),["state"]=row["state"]!.DeepClone(),["writable"]=row["pathWritable"]!.DeepClone(),["value"]=row["datum"]?["scalar"]?.DeepClone(),["reference"]=row["datum"]?["reference"]?.DeepClone()});publicSchema=new(){["revision"]=workspace!["inspectionRevision"]?.DeepClone()??source!["revision"]!.DeepClone(),["id"]=schema["id"]!.DeepClone(),["rows"]=rows};}
var logs=new System.Text.Json.Nodes.JsonArray();var allLogs=model["shell"]?["logs"]?.AsArray()??new System.Text.Json.Nodes.JsonArray();string projectRoot=selected?["path"] is null?"":System.IO.Path.GetDirectoryName(selected["path"]!.ToString())!,repo=Environment.GetEnvironmentVariable("CONFECTORY_EDITOR_REPO")??Environment.CurrentDirectory;
foreach(var row in System.Linq.Enumerable.Skip(allLogs,Math.Max(0,allLogs.Count-128))){string text=row?.ToString()??"";if(projectRoot.Length>0)text=text.Replace(projectRoot,"[Project]",StringComparison.Ordinal);text=text.Replace(repo,"[Confectory]",StringComparison.Ordinal);logs.Add(text.Length>2048?text[..2048]:text);}
var background=new System.Text.Json.Nodes.JsonArray();foreach(var row in model["backgroundProjects"]?.AsArray()??new System.Text.Json.Nodes.JsonArray())background.Add(new System.Text.Json.Nodes.JsonObject{["projectId"]=row!["project"]!["projectId"]!.DeepClone(),["title"]=row["project"]!["title"]!.DeepClone(),["state"]=row["execution"]?["state"]?.ToString()??"idle"});
return new System.Text.Json.Nodes.JsonObject{
 ["scope"]=new System.Text.Json.Nodes.JsonObject{["projectId"]=project,["helperId"]=helper?["helper"]?.ToString()??"",["allowCommon"]=helper?["allowCommon"]?.GetValue<bool>()??false},
 ["revision"]=model["revision"]!.DeepClone(),
 ["state"]=new System.Text.Json.Nodes.JsonObject{["projectId"]=project,["cards"]=cards,["title"]=selected?["title"]?.DeepClone()??System.Text.Json.Nodes.JsonValue.Create("Confectory"),["units"]=units,["draft"]=draft,["total"]=workspace?["total"]?.DeepClone(),["page"]=workspace?["page"]?.DeepClone(),["review"]=publicReview,["schema"]=publicSchema,["logs"]=logs,["background"]=background,["executionState"]=model["execution"]?["state"]?.ToString()??"idle",["canRun"]=selected?["standalone"]?.GetValue<bool>()==true&&selected?["kind"]?.ToString()=="project",["runTarget"]=OperatingSystem.IsWindows()?"windows":"linux"}
