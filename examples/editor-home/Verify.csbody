void Check(bool condition,string message){if(!condition)throw new Exception(message);}string repo=Environment.GetEnvironmentVariable("CONFECTORY_EDITOR_REPO")??Environment.CurrentDirectory;string root=System.IO.Path.Combine(System.IO.Path.GetTempPath(),"confectory-entry-home-"+Guid.NewGuid().ToString("N"));System.IO.Directory.CreateDirectory(root);string token=calls.CreateSession.Invoke(repo,System.IO.Path.Combine(root,"settings"));
System.Text.Json.Nodes.JsonNode Run(string op,object args)=>System.Text.Json.Nodes.JsonNode.Parse(calls.Command.Invoke(token,op,System.Text.Json.JsonSerializer.Serialize(args)))!;
try{
 string homePath=System.IO.Path.Combine(root,"settings","home-preferences.json"),projectsPath=System.IO.Path.Combine(root,"settings","projects.json");var home=System.Text.Json.Nodes.JsonNode.Parse(calls.Snapshot.Invoke(token))!["homePreferences"]!["value"]!.DeepClone();Check(!System.IO.File.Exists(homePath)&&home["tab"]!.ToString()=="projects","missing Home preferences are read-only defaults");string catalogBefore=System.IO.File.ReadAllText(projectsPath);home["projectQuery"]="한글 <script> 검색";home["tab"]="packs";home["packs"]!["local"]!["draft"]="미적용 입력";home["packs"]!["local"]!["query"]="Confectory.BaseUI";home["packs"]!["local"]!["sort"]="name";
 var homeSaved=Run("home-preferences-save",new{preferences=home});Check(!homeSaved["status"]!.ToString().StartsWith("Error:")&&System.IO.File.ReadAllText(projectsPath)==catalogBefore&&homeSaved["presentation"] is null,"Home preferences have independent atomic storage without project selection");string homeBytes=System.IO.File.ReadAllText(homePath);var malformed=home.DeepClone();malformed["projectQuery"]=new string('x',257);Check(Run("home-preferences-save",new{preferences=malformed})["status"]!.ToString().StartsWith("Error:")&&System.IO.File.ReadAllText(homePath)==homeBytes,"oversized query rejected before write");malformed=home.DeepClone();malformed["path"]="not an accepted setting";Check(Run("home-preferences-save",new{preferences=malformed})["status"]!.ToString().StartsWith("Error:")&&System.IO.File.ReadAllText(homePath)==homeBytes,"unknown fields are not arbitrary host settings");
 System.IO.File.SetAttributes(homePath,System.IO.FileAttributes.ReadOnly);try{var pending=home.DeepClone();pending["projectQuery"]="FAILED_PENDING";var failed=Run("home-preferences-save",new{preferences=pending});Check(failed["status"]!.ToString().StartsWith("Error:")&&System.IO.File.ReadAllText(homePath)==homeBytes&&System.Text.Json.Nodes.JsonNode.DeepEquals(failed["homePreferences"]!["value"],home),"failed atomic write retains prior disk and model state");}finally{System.IO.File.SetAttributes(homePath,System.IO.FileAttributes.Normal);}
 calls.CloseSession.Invoke(token);token=calls.CreateSession.Invoke(repo,System.IO.Path.Combine(root,"settings"));var homeRestored=System.Text.Json.Nodes.JsonNode.Parse(calls.Snapshot.Invoke(token))!;Check(System.Text.Json.Nodes.JsonNode.DeepEquals(homeRestored["homePreferences"]!["value"],home)&&homeRestored["selected"] is null,"Home preferences cold restore does not open a project");
 System.IO.File.WriteAllText(homePath,"broken{");calls.CloseSession.Invoke(token);token=calls.CreateSession.Invoke(repo,System.IO.Path.Combine(root,"settings"));var brokenHome=System.Text.Json.Nodes.JsonNode.Parse(calls.Snapshot.Invoke(token))!;Check(brokenHome["homePreferences"]!["status"]!.ToString()=="unavailable"&&System.IO.File.ReadAllText(homePath)=="broken{","corrupt Home file is reported without overwriting");Check(Run("home-preferences-save",new{preferences=home})["status"]!.ToString().StartsWith("Error:")&&System.IO.File.ReadAllText(homePath)=="broken{","saving cannot silently replace corrupt Home storage");System.IO.File.WriteAllText(homePath,homeBytes);calls.CloseSession.Invoke(token);token=calls.CreateSession.Invoke(repo,System.IO.Path.Combine(root,"settings"));
 // A paginated, confirmed root-manifest count includes neither dependencies nor schemas or draft-only elements.
 string countRoot=System.IO.Path.Combine(root,"count-owner");System.IO.Directory.CreateDirectory(countRoot);string counts=System.IO.Path.Combine(countRoot,"counted.cpack");System.IO.File.WriteAllText(counts,"pack Counted version \"1\" { standalone false; "+string.Concat(System.Linq.Enumerable.Select(System.Linq.Enumerable.Range(0,41),i=>"element O"+i+" object \"not-read-"+i+".celem\";"))+"element S schema \"not-read-schema.celem\"; }");Run("open-request",new{path=counts});Check(Run("home-summaries",new{})["status"]!.ToString().StartsWith("Error:"),"Home summary cannot switch a selected project");Run("leave",new{});var counted=Run("home-summaries",new{});Check(counted["selected"] is null&&counted["workspace"] is null&&System.Linq.Enumerable.Single(counted["homeSummaries"]!.AsObject()).Value!["objects"]!.GetValue<int>()==41,"count reads confirmed root locator total beyond one page, without declaration loading");Check(System.Linq.Enumerable.Single(counted["homeSummaries"]!.AsObject()).Value!["packsStatus"]!.ToString()=="unsupported","registry or dependency count is not installed pack count");System.IO.File.WriteAllText(counts,"pack Counted version \"1\" { standalone false; }");Check(System.Linq.Enumerable.Single(Run("home-summaries",new{})["homeSummaries"]!.AsObject()).Value!["objects"]!.GetValue<int>()==0,"changed confirmed manifest refreshes zero separately from unavailable");Run("open-request",new{path=counts});var countClosed=Run("close-project",new{});Check(countClosed["selected"] is null&&!countClosed["status"]!.ToString().StartsWith("Error:"),"idle count fixture closes through the ordinary contract");System.IO.File.Delete(counts);Check(System.Linq.Enumerable.Single(Run("home-summaries",new{})["homeSummaries"]!.AsObject()).Value!["status"]!.ToString()=="unavailable","missing project is unavailable, never zero");Run("remove",new{path=counts});
 var required=Run("create",new{title="",description="",directory=root});Check(required["status"]!.ToString().Contains("required")&&required["cards"]!.AsArray().Count==0,"required name");
 var browse=Run("browse",new{directory=root});Check(browse["picker"]![0]!.ToString()==root,"folder browser public metadata");
 var invalid=Run("open",new{path=root});Check(invalid["status"]!.ToString().StartsWith("Error:")&&invalid["cards"]!.AsArray().Count==0,"validate before registration");
 var created=Run("create",new{title="My First Project",description="A multiline intent\nNo Agent required",directory=root});Check(created["selected"]!["title"]!.ToString()=="My First Project"&&created["cards"]!.AsArray().Count==1,"create and enter offline");string path=created["selected"]!["path"]!.ToString();Check(path==System.IO.Path.Combine(root,"My First Project","project.cproj"),"spaces preserved in exact folder");
 string originalContext=created["selected"]!["context"]!.ToString();Run("shell",new{context=originalContext,action="draft",value="unsaved context survives external file request"});string library=System.IO.Path.Combine(root,"library.cpack");System.IO.File.WriteAllText(library,"pack Library version \"0.1.0\" { standalone false; }\n");var refusal=Run("open-request",new{path=library});Check(refusal["status"]!.ToString().StartsWith("Error:")&&refusal["selected"]!["context"]!.ToString()==originalContext&&refusal["shell"]!["draft"]!.ToString().Contains("unsaved"),"external open cannot silently replace active context/draft");Run("leave",new{});var openedPack=Run("open-request",new{path=library});Check(openedPack["selected"]!["kind"]!.ToString()=="pack"&&!openedPack["selected"]!["standalone"]!.GetValue<bool>(),"nonstandalone library is openable");Check(Run("run",new{})["status"]!.ToString().StartsWith("Error:"),"library open does not authorize standalone execution");string libraryDraft=calls.WorkspaceOpen.Invoke(library,"local-user","library-edit");try{calls.Create.Invoke(libraryDraft,"object","Library::Added");calls.SetValue.Invoke(libraryDraft,"Library::Added","value","3");Check(System.IO.File.Exists(calls.Save.Invoke(libraryDraft)),"plain pack owned declaration can be edited and locally saved");}finally{calls.WorkspaceClose.Invoke(libraryDraft);}Run("leave",new{});Run("remove",new{path=library});Run("open",new{path});
 var duplicate=Run("create",new{title="My First Project",description="",directory=root});Check(duplicate["status"]!.ToString().StartsWith("Error:")&&duplicate["cards"]!.AsArray().Count==1,"existing folder never overwritten");
 Check(Run("leave",new{})["selected"] is null,"leave project");Check(Run("open",new{path})["cards"]!.AsArray().Count==1,"reopen stable listing");calls.CloseSession.Invoke(token);calls.CloseSession.Invoke(token);bool disposed=false;try{calls.Snapshot.Invoke(token);}catch(ObjectDisposedException){disposed=true;}Check(disposed,"disposed session public snapshot rejects use");token=calls.CreateSession.Invoke(repo,System.IO.Path.Combine(root,"settings"));var restored=System.Text.Json.Nodes.JsonNode.Parse(calls.Snapshot.Invoke(token))!;Check(restored["cards"]!.AsArray().Count==1&&restored["cards"]![0]!["description"]!.ToString().Contains('\n'),"restart metadata");
 foreach(string title in new[]{"ㄹㅇㅋㅋ","한글 프로젝트","English"}){var unicode=Run("create",new{title,description="",directory=root});Check(!unicode["status"]!.ToString().StartsWith("Error:"),unicode.ToJsonString());string exact=System.IO.Path.Combine(root,title,"project.cproj");Check(unicode["selected"]!["path"]!.ToString()==exact&&unicode["selected"]!["title"]!.ToString()==title&&System.IO.File.Exists(exact),"exact Unicode display and folder");string before=System.IO.File.ReadAllText(exact);var collision=Run("create",new{title,description="",directory=root});Check(collision["status"]!.ToString().StartsWith("Error:")&&System.IO.File.ReadAllText(exact)==before,"collision never overwrites");Run("remove",new{path=exact});}
 foreach(string title in new[]{"../escape","a/b","a\\b","CON","con.txt","LPT1","trailing.","bad:name"}){var rejected=Run("create",new{title,description="",directory=root});Check(rejected["status"]!.ToString().StartsWith("Error:"),"unsafe name rejected: "+title);}
 var removed=Run("remove",new{path});Check(removed["cards"]!.AsArray().Count==0&&System.IO.File.Exists(path),"remove listing keeps project");Run("leave",new{});var choices=Run("connections",new{});Check(choices["connections"]!["connections"]!.AsArray().Count==2,"discover concrete inherited connection packs without provider launch");var settings=Run("connection-settings",new{connection="Confectory.Agent.Responses::Connection"});Check(!settings["status"]!.ToString().StartsWith("Error:"),settings.ToJsonString());var settingRows=settings["workspace"]!["schemaView"]!["rows"]!.AsArray();Check(settingRows.Count==4&&System.Linq.Enumerable.Any(settingRows,row=>row!["name"]!.ToString()=="credentialReference")&&System.Linq.Enumerable.Any(settingRows,row=>row!["name"]!.ToString()=="endpoint"),"ordinary inherited schema View supplies provider fields");Check(!settings["connectionSettings"]!["authenticated"]!.GetValue<bool>()&&!settings["selected"]!["standalone"]!.GetValue<bool>(),"settings do not authenticate or run");string settingsPath=settings["selected"]!["path"]!.ToString(),settingsSource=System.IO.Path.Combine(System.IO.Path.GetDirectoryName(settingsPath)!,"Settings.celem"),originalSettings=System.IO.File.ReadAllText(settingsSource);var editedSettings=Run("workspace",new{context=settings["selected"]!["context"]!.ToString(),action="data-path",id="Confectory.AISettings::Settings",path=new[]{"model"},value="user-chosen-model",expectedRevision=settings["workspace"]!["unit"]!["revision"]!.GetValue<long>()});Check(!editedSettings["status"]!.ToString().StartsWith("Error:")&&System.IO.File.ReadAllText(settingsSource)==originalSettings,"connection configuration stages ordinary data draft only: "+editedSettings.ToJsonString());Run("leave",new{});var codexSettings=Run("connection-settings",new{connection="Confectory.Agent.Codex::Connection"});Check(!codexSettings["status"]!.ToString().StartsWith("Error:")&&codexSettings["workspace"]!["schemaView"]!["rows"]!.AsArray().Count==8,"Codex declaration uses its own inherited fields");Run("leave",new{});Check(Run("connection-settings",new{connection="Unknown::Connection"})["status"]!.ToString().StartsWith("Error:"),"unregistered connection refused");Console.WriteLine("Entry/home contracts: required name, folder validation, offline create, repeated open, restart, remove and cleanup passed");
}finally{calls.CloseSession.Invoke(token);System.IO.Directory.Delete(root,true);}return 0;
