const int RoomSlot = 15;
const int MaxInvitations = 16;
const int MaxLifetimeSeconds = 300;

if (activation.Length == 0 ||
    AppDomain.CurrentDomain.GetData("Confectory.EditorHome." + session) is not object[] owner)
    throw new UnauthorizedAccessException("A verified local chat host must be active.");

lock (owner)
{
    var model = (System.Text.Json.Nodes.JsonObject)owner[3];
    var selected = model["selected"];
    if ((bool)owner[6] || selected?["activation"]?.GetValue<string>() != activation ||
        !calls.CreatorHost.Invoke(session))
        throw new UnauthorizedAccessException("A verified local chat host must be active.");

    string project = selected["projectId"]!.GetValue<string>();
    string context = selected["context"]!.GetValue<string>();
    string manifest = selected["path"]!.GetValue<string>();
    string storage = System.IO.Path.GetDirectoryName((string)owner[2])!;
    string origin = calls.Origin.Invoke(manifest, false, false);
    var manager = (string[])owner[0];
    string journal = System.IO.Path.Combine(storage, "project-chat", project + ".json");
    if (origin.Length == 0 || calls.ReadIdentity.Invoke(manager, context) != project ||
        (System.IO.File.Exists(journal) && calls.Origin.Invoke(journal, false, false).Length == 0))
        throw new UnauthorizedAccessException("The original project or host journal is unavailable.");

    if (owner[RoomSlot] is (string scope, object _, object existing, Func<bool> isActive, Action stop,
        System.Threading.CancellationToken _) && scope == activation)
    {
        if (isActive()) return LocalAdmission(existing);
        stop();
        throw new UnauthorizedAccessException("The local chat host changed.");
    }

    // Coordinate EditorHome windows in this process. The journal's existing CAS
    // remains the persistence boundary across processes.
    var domain = AppDomain.CurrentDomain;
    string registryKey = "Confectory.EditorHome.PublicChatOwner." +
        Hash(OperatingSystem.IsWindows() ? journal.ToUpperInvariant() : journal);
    var lease = new object();
    lock (domain)
    {
        if (domain.GetData(registryKey) is not null)
            throw new InvalidOperationException("Another local window owns this chat session.");
        domain.SetData(registryKey, lease);
    }

    void Release()
    {
        lock (domain)
            if (ReferenceEquals(domain.GetData(registryKey), lease)) domain.SetData(registryKey, null);
    }

    object host;
    try { host = calls.OpenHost.Invoke(storage, project, "local-user", manifest); }
    catch { Release(); throw; }
    var (join, _, _, closeHost, _, _) =
        ((Func<string, object>, Func<string, string, bool>, Func<string>, Action,
          Func<string, string, string, bool>, Func<string, string>))host;
    var invitations = new System.Collections.Generic.Dictionary<string, long>(StringComparer.Ordinal);
    var lifetime = new System.Threading.CancellationTokenSource();
    bool closed = false;

    bool Active()
    {
        if (closed || (bool)owner[6]) return false;
        var current = model["selected"];
        try
        {
            return current?["activation"]?.GetValue<string>() == activation &&
                current["context"]?.GetValue<string>() == context &&
                current["projectId"]?.GetValue<string>() == project &&
                calls.CreatorHost.Invoke(session) && calls.ReadIdentity.Invoke(manager, context) == project &&
                calls.Origin.Invoke(manifest, false, false) == origin;
        }
        catch (Exception error) when (error is ArgumentException or InvalidOperationException or
            UnauthorizedAccessException or System.IO.IOException or System.Text.Json.JsonException)
        {
            return false;
        }
    }

    void Close()
    {
        lock (owner)
        {
            if (closed) return;
            closed = true;
            invitations.Clear();
            closeHost(); // Releases every guest inbox, including attachment snapshots.
            owner[RoomSlot] = null!;
            lifetime.Cancel();
            lifetime.Dispose();
            Release();
        }
    }

    void RequireActive()
    {
        if (Active()) return;
        Close();
        throw new ObjectDisposedException("Project chat host session");
    }

    string Issue(int seconds)
    {
        lock (owner)
        {
            RequireActive();
            if (seconds is < 1 or > MaxLifetimeSeconds)
                throw new ArgumentOutOfRangeException(nameof(seconds), "Choose a lifetime of up to five minutes.");
            long now = Environment.TickCount64;
            foreach (var entry in System.Linq.Enumerable.ToArray(invitations))
                if (entry.Value <= now) invitations.Remove(entry.Key);
            if (invitations.Count == MaxInvitations)
                throw new InvalidOperationException("Too many pending project chat invitations.");
            string code = Convert.ToHexString(System.Security.Cryptography.RandomNumberGenerator.GetBytes(32));
            invitations.Add(Hash(code), now + seconds * 1000L);
            return code;
        }
    }

    object Accept(string requestedProject, string code, string displayName)
    {
        lock (owner)
        {
            RequireActive();
            if (requestedProject != project || code.Length != 64 || string.IsNullOrWhiteSpace(displayName) ||
                displayName.Length > 64 || System.Linq.Enumerable.Any(displayName, char.IsControl))
                throw new UnauthorizedAccessException("An active project chat invitation is required.");
            string key = Hash(code);
            if (!invitations.TryGetValue(key, out long expires) || expires <= Environment.TickCount64)
                throw new UnauthorizedAccessException("An active project chat invitation is required.");

            // The host assigns the actor. The supplied name is only a bounded label.
            string actor = displayName.Trim() + " (guest " + Guid.NewGuid().ToString("N") + ")";
            var (send, read, leave, sendBox, readBox, sendLaY) =
                ((Func<string, string, bool>, Func<string>, Action,
                  Func<string, string, string, bool>, Func<string, string>,
                  Func<string, string, System.Text.Json.Nodes.JsonObject, bool>))join(actor);
            invitations.Remove(key);

            T Current<T>(Func<T> action)
            {
                lock (owner)
                {
                    RequireActive();
                    return action();
                }
            }

            return ((Func<string, string, bool>)((id, text) => Current(() => send(id, text))),
                (Func<string>)(() => Current(read)), (Action)(() => { lock (owner) leave(); }),
                (Func<string, string, string, bool>)((id, text, box) => Current(() => sendBox(id, text, box))),
                (Func<string, string>)(id => Current(() => readBox(id))), actor,
                (Func<string, string, System.Text.Json.Nodes.JsonObject, bool>)((id, text, payload) =>
                    Current(() => sendLaY(id, text, payload))));
        }
    }

    object admission = ((Func<int, string>)Issue, (Func<string, string, string, object>)Accept, (Action)Close);
    owner[RoomSlot] = (activation, host, admission, (Func<bool>)Active, (Action)Close, lifetime.Token);
    return LocalAdmission(admission);
}

// Keep the local admission API shape. The protected listener holds the
// separate receive capability as part of the live room it initializes.
static object LocalAdmission(object admission)
{
    var (issue, accept, close) = ((Func<int, string>, Func<string, string, string, object>, Action))admission;
    object AcceptLocal(string project, string code, string display)
    {
        var (send, read, leave, sendBox, readBox, actor, _) =
            ((Func<string, string, bool>, Func<string>, Action, Func<string, string, string, bool>,
              Func<string, string>, string, Func<string, string, System.Text.Json.Nodes.JsonObject, bool>))
            accept(project, code, display);
        return (send, read, leave, sendBox, readBox, actor);
    }
    return (issue, (Func<string, string, string, object>)AcceptLocal, close);
}

static string Hash(string value) => Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(
    System.Text.Encoding.UTF8.GetBytes(value)));
