if (!OperatingSystem.IsLinux() || bounds.Length != 4 || bounds[2] < 1 || bounds[3] < 1 ||
    width is < 1 or > 512 || height is < 1 or > 512 || pixels.Length != width * height) return;
var pin = System.Runtime.InteropServices.GCHandle.Alloc(pixels, System.Runtime.InteropServices.GCHandleType.Pinned);
