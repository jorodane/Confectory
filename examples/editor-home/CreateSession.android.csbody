string repo=System.IO.Path.GetFullPath(repository),folder=System.IO.Path.GetFullPath(storage);
System.IO.Directory.CreateDirectory(folder);
string path=System.IO.Path.Combine(folder,"projects.json");var raw=calls.FileSnapshot.Invoke(path);var cards=new System.Text.Json.Nodes.JsonArray();
if(raw[0]=="exists"){cards=System.Text.Json.Nodes.JsonNode.Parse(raw[1])!.AsArray();if(cards.Count>32)throw new ArgumentException("Project catalog budget");foreach(var card in cards){if(card?["path"] is null||card["title"] is null)throw new ArgumentException("Invalid project catalog");}}
else calls.WriteAtomic.Invoke(path,"[]");
var model=new System.Text.Json.Nodes.JsonObject{["cards"]=cards,["status"]="",["selected"]=null,["picker"]=null,["shell"]=null,["execution"]=null,["executions"]=new System.Text.Json.Nodes.JsonObject(),["revision"]=0};
string token=Guid.NewGuid().ToString("N");AppDomain.CurrentDomain.SetData("Confectory.EditorHome."+token,new object[]{calls.CreateManager.Invoke(64),repo,path,model,model.ToJsonString(),new System.Collections.Generic.List<string>(),false,new System.Collections.Generic.Dictionary<string,string>(StringComparer.Ordinal),new System.Collections.Generic.Dictionary<string,string>(StringComparer.Ordinal)});return token;
