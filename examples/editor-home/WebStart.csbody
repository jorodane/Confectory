string root=Environment.GetEnvironmentVariable("CONFECTORY_EDITOR_REPO")??Environment.CurrentDirectory;
if(OperatingSystem.IsWindows()&&Environment.GetEnvironmentVariable("CONFECTORY_WEBVIEW_HOST") is null)Environment.SetEnvironmentVariable("CONFECTORY_WEBVIEW_HOST",System.IO.Path.Combine(root,"targets","webview-windows","bin","Release","net10.0-windows","Confectory.WebView.Windows.dll"));
(string Manifest,string Project,Action<string> Open,Func<bool> Alive,Action Retire,Func<int> ReturnRequest,Func<int,bool> AcceptReturn) handoff=AppContext.GetData("Confectory.EditorHome.LogicHandoff") is ValueTuple<string,string,Action<string>,Func<bool>,Action,Func<int>,Func<int,bool>> pending?pending:default;
bool switched=handoff.Open is not null;
string? project=switched?handoff.Manifest:Environment.GetEnvironmentVariable("CONFECTORY_WEB_PROJECT");
string storage=Environment.GetEnvironmentVariable("CONFECTORY_HOME_STORAGE")??Environment.GetEnvironmentVariable("CONFECTORY_ENTRY_STORAGE")??System.IO.Path.Combine(root,".confectory","editor-home");
bool installedLogicCode=OperatingSystem.IsLinux()&&Environment.GetEnvironmentVariable("CONFECTORY_INSTALLED_LOGIC_CODE")=="1";
bool embedded=Environment.GetEnvironmentVariable("CONFECTORY_UI")=="embedded";
// Explicit launch-only local performance capture. The writer sees fixed stage
// names and numeric timings, never source, state, path, input, or error text.
System.IO.StreamWriter? performanceWriter=null;System.Threading.Timer? performanceFlush=null;object performanceGate=new();int performanceRows=0;
string performanceKey="Confectory.Performance.Record";long performanceEpoch=System.Diagnostics.Stopwatch.GetTimestamp();
string performanceRendererKey="Confectory.Performance.Renderer";
if(Environment.GetEnvironmentVariable("CONFECTORY_PERFORMANCE")=="1"){
 try{
  string folder=System.IO.Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),"Confectory","Performance",DateTime.UtcNow.ToString("yyyyMMdd-HHmmss")+"-"+Guid.NewGuid().ToString("N")[..8]);
  if(!System.IO.Path.IsPathFullyQualified(folder))throw new System.IO.IOException("Local performance directory required");
  System.IO.Directory.CreateDirectory(folder);performanceWriter=new System.IO.StreamWriter(System.IO.Path.Combine(folder,"engine.jsonl"),false,new System.Text.UTF8Encoding(false),8192);
  AppDomain.CurrentDomain.SetData(performanceRendererKey,new[]{System.IO.Path.Combine(folder,"webview.jsonl"),performanceEpoch.ToString(System.Globalization.CultureInfo.InvariantCulture)});
  var operations=new System.Collections.Generic.HashSet<string>(StringComparer.Ordinal){"","openProject","openEditorView","closeEditorView","select","schema","inspectDeclaration","localInventory","relationsMap","savePresentation","browserDrafts","connectionSetup","homeSummaries","open","update","mount","request","resource","native","describe","inspectEffective","catalog","editorMenuDeclarations","click","project-open","object-drop","restore","foreground"};
  var stages=new System.Collections.Generic.HashSet<string>(StringComparer.Ordinal){"snapshot","invoke-before","invoke-after","consumer","invoke-queue","authoring-process","authoring-stream","renderer-call","renderer-render","renderer-update","input-delay","input-frame","restore-view","restore-total","restore-layout","workspace-attach","window-ready","foreground","embedded-request","session"};
  AppDomain.CurrentDomain.SetData(performanceKey,(Action<string,string,double,double>)((stage,operation,elapsed,pageMs)=>{
   if(!stages.Contains(stage)||!operations.Contains(operation)||!double.IsFinite(elapsed)||elapsed<0||elapsed>3600000||!double.IsFinite(pageMs)||pageMs< -1||pageMs>86400000)return;
   lock(performanceGate){if(performanceRows>=8192||performanceWriter is null)return;try{if(performanceRows==8191){stage="capture-limit";operation="";elapsed=0;pageMs=-1;}performanceWriter.WriteLine(System.Text.Json.JsonSerializer.Serialize(new{stage,operation,elapsedMs=Math.Round(elapsed,3),atMs=Math.Round(System.Diagnostics.Stopwatch.GetElapsedTime(performanceEpoch).TotalMilliseconds,3),pageMs=pageMs<0?(double?)null:Math.Round(pageMs,3)}));if(++performanceRows%32==0)performanceWriter.Flush();}catch(Exception error) when(error is System.IO.IOException or UnauthorizedAccessException or ObjectDisposedException){performanceRows=8192;}}
  }));
  ((Action<string,string,double,double>)AppDomain.CurrentDomain.GetData(performanceKey)!)("session","",0,-1);performanceWriter.Flush();
  performanceFlush=new System.Threading.Timer(_=>{lock(performanceGate){try{performanceWriter?.Flush();}catch(Exception error) when(error is System.IO.IOException or UnauthorizedAccessException or ObjectDisposedException){performanceRows=8192;}}},null,1000,1000);
 }catch(Exception error) when(error is System.IO.IOException or UnauthorizedAccessException or ArgumentException){Console.Error.WriteLine("Local performance capture unavailable");performanceFlush?.Dispose();try{performanceWriter?.Dispose();}catch(System.IO.IOException){}performanceWriter=null;AppDomain.CurrentDomain.SetData(performanceKey,null);AppDomain.CurrentDomain.SetData(performanceRendererKey,null);}
}
string session="",owner="",entry="";
string OpenEntry()=>calls.EntryRequest.Invoke(Environment.GetEnvironmentVariable("CONFECTORY_ENTRY_SCOPE")??root,"listen","{}");
try{
 // Share the native installation's same-user entry lease across both surfaces.
 if(installedLogicCode||switched)entry=OpenEntry();
 session=calls.CreateSession.Invoke(root,storage);
 // Only the serving host thread publishes background observations.
 AppDomain.CurrentDomain.SetData("Confectory.EditorHome.WebPollThread."+session,Environment.CurrentManagedThreadId);
 if(project is not null){var opened=System.Text.Json.Nodes.JsonNode.Parse(calls.Command.Invoke(session,"open-request",System.Text.Json.JsonSerializer.Serialize(new{path=System.IO.Path.GetFullPath(project)})))!;
 if(opened["selected"] is null||opened["status"]?.ToString().StartsWith("Error:",StringComparison.Ordinal)==true)throw new InvalidOperationException("Project could not be opened");
 if(switched){
  var selected=opened["selected"]!;
  if(selected["projectId"]?.ToString()!=handoff.Project||selected["path"]?.ToString()!=handoff.Manifest||selected["entry"]?.GetValue<string>() is not {Length:>0} feature)
   throw new InvalidOperationException("The selected project changed before Logic Code could open.");
  AppDomain.CurrentDomain.SetData("Confectory.EditorHome.StartupLogic."+session,(handoff.Project,selected["activation"]!.ToString(),feature));
  AppDomain.CurrentDomain.SetData("Confectory.EditorHome.LogicReturn."+session,(handoff.ReturnRequest,handoff.AcceptReturn));
 }
 var shown=System.Text.Json.Nodes.JsonNode.Parse(calls.Command.Invoke(session,"workspace","{\"action\":\"open\"}"))!;
 if(shown["workspace"] is null)throw new InvalidOperationException("Project workspace unavailable");
 if(!switched){
 if(shown["workspace"]?["unit"]?["kind"]?.ToString() is "body" or "project" or "pack"){
 var objects=System.Text.Json.Nodes.JsonNode.Parse(calls.Command.Invoke(session,"workspace","{\"action\":\"filter\",\"kind\":\"object\",\"query\":\"\"}"))!;
 var first=System.Linq.Enumerable.FirstOrDefault(objects["workspace"]?["units"]?.AsArray()??new System.Text.Json.Nodes.JsonArray());if(first is not null){calls.Command.Invoke(session,"workspace",new System.Text.Json.Nodes.JsonObject{["action"]="select",["id"]=first["id"]!.DeepClone()}.ToJsonString());calls.Command.Invoke(session,"workspace","{\"action\":\"schema-view\"}");}
 }else calls.Command.Invoke(session,"workspace","{\"action\":\"schema-view\"}");

 }
 }
 if(embedded)entry=OpenEntry();
 if(entry.Length>0)AppDomain.CurrentDomain.SetData("Confectory.EditorHome.WebEntry."+session,new object[]{entry,Environment.CurrentManagedThreadId});
 owner=calls.Open.Invoke(session,calls.Bundle.Invoke());
 if(switched)AppContext.SetData("Confectory.BrowserHost.Desktop."+owner,(handoff.Open,handoff.Alive,handoff.Retire));
 return embedded?calls.EmbeddedServe.Invoke(owner):calls.Serve.Invoke(owner);
}finally{
 try{
  if(session.Length>0){
   AppDomain.CurrentDomain.SetData("Confectory.EditorHome.WebPoll."+session,null);
   AppDomain.CurrentDomain.SetData("Confectory.EditorHome.WebEntry."+session,null);
   AppDomain.CurrentDomain.SetData("Confectory.EditorHome.StartupLogic."+session,null);
   AppDomain.CurrentDomain.SetData("Confectory.EditorHome.LogicReturn."+session,null);
   if(switched&&owner.Length>0)AppContext.SetData("Confectory.BrowserHost.Desktop."+owner,null);
   if(embedded&&entry.Length>0)calls.EntryRequest.Invoke(entry,"close","{}");
   if(owner.Length>0)while(!calls.Close.Invoke(owner))System.Threading.Thread.Sleep(2);
   calls.CloseSession.Invoke(session);
   AppDomain.CurrentDomain.SetData("Confectory.EditorHome.WebPollThread."+session,null);
  }
 }finally{try{if((installedLogicCode||switched)&&entry.Length>0)calls.EntryRequest.Invoke(entry,"close","{}");}finally{
  AppDomain.CurrentDomain.SetData(performanceKey,null);performanceFlush?.Dispose();lock(performanceGate){try{performanceWriter?.Dispose();}catch(System.IO.IOException){}performanceWriter=null;}
  AppDomain.CurrentDomain.SetData(performanceRendererKey,null);
 }}
}
