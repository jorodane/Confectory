project Confectory.EditorHome version "0.1.0" {
registry Confectory.ProjectShell "../../packs/project-shell/pack.cpack"; dependency Confectory.ProjectShell version "0.1.0";
entry Confectory.EditorHome::Main;
registry Confectory.ProjectManager "../../packs/project-manager/pack.cpack"; dependency Confectory.ProjectManager version "0.1.0";
registry Confectory.ProjectExecution "../../packs/project-execution/pack.cpack"; dependency Confectory.ProjectExecution version "0.1.0";
registry Confectory.EditWorkspace "../../packs/edit-workspace/pack.cpack"; dependency Confectory.EditWorkspace version "0.1.0";
registry Confectory.SchemaEditing "../../packs/schema-editing/pack.cpack"; dependency Confectory.SchemaEditing version "0.1.0";
registry Confectory.Save "../../packs/save/pack.cpack"; dependency Confectory.Save version "0.1.0";
registry Confectory.FileStream "../../packs/file-stream/pack.cpack"; dependency Confectory.FileStream version "0.1.0";
registry Confectory.BaseUI "../../packs/base-ui/pack.cpack"; dependency Confectory.BaseUI version "0.1.0";
registry Confectory.UINavigation "../../packs/ui-navigation/pack.cpack"; dependency Confectory.UINavigation version "0.1.0";
registry Confectory.RuntimeBase "../../packs/runtime-base/pack.cpack"; dependency Confectory.RuntimeBase version "0.1.0";
registry Confectory.RealTimeUpdate "../../packs/realtime-update/pack.cpack"; dependency Confectory.RealTimeUpdate version "0.1.0";
registry Confectory.Window "../../packs/window/pack.cpack"; dependency Confectory.Window version "0.1.0";
registry Confectory.RenderInput "../../packs/render-input/pack.cpack"; dependency Confectory.RenderInput version "0.1.0";
registry Confectory.Build.DotNet "../../targets/dotnet/pack.cpack"; dependency Confectory.Build.DotNet version "0.1.0";
target linux Confectory.Build.DotNet::Linux; target windows Confectory.Build.DotNet::Portable; target android Confectory.Build.DotNet::Portable;
element CreateSession function "CreateSession.celem"; element CreateSessionBody implementation "CreateSessionBody.celem";
element Command function "Command.celem"; element CommandBody implementation "CommandBody.celem";
element Snapshot function "Snapshot.celem"; element SnapshotBody implementation "SnapshotBody.celem";
element CloseSession function "CloseSession.celem"; element CloseSessionBody implementation "CloseSessionBody.celem";
element Main function "Main.celem"; element MainBody implementation "MainBody.celem";
element Verify function "Verify.celem"; element VerifyBody implementation "VerifyBody.celem";
element VerifyShell function "VerifyShell.celem"; element VerifyShellBody implementation "VerifyShellBody.celem";
}
