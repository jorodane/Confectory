var state=AppDomain.CurrentDomain.GetData("Confectory.EditorHome."+session) as object[];if(state is null)return;lock(state){if((bool)state[6])return;state[6]=true;try{foreach(string workspace in (System.Collections.Generic.List<string>)state[5])calls.WorkspaceClose.Invoke(workspace);}finally{calls.Dispose.Invoke((string[])state[0]);AppDomain.CurrentDomain.SetData("Confectory.EditorHome."+session,null);}}
