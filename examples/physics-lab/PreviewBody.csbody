string scene="";bool gui=Environment.GetEnvironmentVariable("CONFECTORY_PHYSICS_MODE")=="ui";System.Text.Json.Nodes.JsonNode Json(string value)=>System.Text.Json.Nodes.JsonNode.Parse(value)!;
try{scene=calls.SceneCreate.Invoke("preview-owner","preview",gui,-2);string world=calls.SceneWorld.Invoke(scene);if(!gui){double before=Json(calls.Snapshot.Invoke(world,1))["bodies"]![1]!["y"]!.GetValue<double>();for(int n=0;n<300;n++)calls.SceneFixed.Invoke(scene,.01);var events=Json(calls.Events.Invoke(world,0,128));if(events["events"]!.AsArray().Count==0)throw new Exception("actual collision missing");double after=Json(calls.Snapshot.Invoke(world,1))["bodies"]![1]!["y"]!.GetValue<double>();if(before==after)throw new Exception("actual motion missing");Console.WriteLine("Stage-free Physics preview motion/collision PASS");return 0;}
int stop=0;ConsoleCancelEventHandler interrupt=(_,args)=>{args.Cancel=true;System.Threading.Interlocked.Exchange(ref stop,1);};Console.CancelKeyPress+=interrupt;var clock=new double[3];var watch=System.Diagnostics.Stopwatch.StartNew();double prior=watch.Elapsed.TotalSeconds;try{Console.WriteLine("PHYSICS_UI ready preview");while(System.Threading.Volatile.Read(ref stop)==0){bool close=false;var input=calls.ScenePump.Invoke(scene);for(int i=0;i<input.Length;i+=6)if(input[i+1]==8||(input[i+1]==5&&(input[i+4]==81||input[i+4]==113)))close=true;if(close)break;double now=watch.Elapsed.TotalSeconds;var plan=calls.Advance.Invoke(clock,now-prior,0,0,.01,8);prior=now;for(int n=0;n<(int)plan[2];n++)calls.SceneFixed.Invoke(scene,plan[7]);calls.SceneDraw.Invoke(scene,"preview",plan[3]);if(Environment.GetEnvironmentVariable("CONFECTORY_PHYSICS_TRACE")=="1")Console.WriteLine("PHYSICS_UI snapshot preview "+calls.Snapshot.Invoke(world,plan[3]));Console.Out.Flush();System.Threading.Thread.Sleep(10);}}finally{Console.CancelKeyPress-=interrupt;}Console.WriteLine("Physics visible preview complete");return 0;}finally{if(scene!="")calls.SceneClose.Invoke(scene);Console.WriteLine("Physics preview cleanup complete");}
