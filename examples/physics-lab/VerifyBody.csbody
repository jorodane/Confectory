System.Text.Json.Nodes.JsonNode Json(string text)=>System.Text.Json.Nodes.JsonNode.Parse(text)!;
void Check(bool value,string reason){if(!value)throw new Exception(reason);}void Near(double value,double expected,string reason){Check(Math.Abs(value-expected)<1e-8,reason+": "+value+" expected "+expected);}void Throws(Action action,string reason){bool failed=false;try{action();}catch(ArgumentException){failed=true;}Check(failed,reason);}
var worlds=new System.Collections.Generic.List<string>();
string World(string configuration="{}"){string world=calls.CreateWorld.Invoke("verification-owner",configuration);worlds.Add(world);return world;}
string Disc(string world,double x,double vx=0,double mass=1,double restitution=1,bool sensor=false){string id=calls.CreateBody.Invoke(world,new System.Text.Json.Nodes.JsonObject{["position"]=System.Text.Json.JsonSerializer.SerializeToNode(new[]{x,0.0}),["velocity"]=System.Text.Json.JsonSerializer.SerializeToNode(new[]{vx,0.0}),["mass"]=mass,["restitution"]=restitution}.ToJsonString());Check(calls.SetCollider.Invoke(world,calls.Epoch.Invoke(world),id,new System.Text.Json.Nodes.JsonObject{["shape"]="circle",["radius"]=.5,["sensor"]=sensor}.ToJsonString()),"collider queued");return id;}
void Commit(string world){Check(Json(calls.Commit.Invoke(world,calls.Epoch.Invoke(world)))["accepted"]!.GetValue<bool>(),"commit accepted");}
void Tick(string world){Check(Json(calls.Step.Invoke(world,calls.Epoch.Invoke(world),.01))["accepted"]!.GetValue<bool>(),"exact fixed tick");}
System.Text.Json.Nodes.JsonNode State(string world)=>Json(calls.Snapshot.Invoke(world,1));
System.Text.Json.Nodes.JsonNode Body(string world,int index)=>State(world)["bodies"]![index]!;
try{
Check(!Json(calls.Capabilities.Invoke())["continuousCollision"]!.GetValue<bool>(),"CCD absence explicit");Throws(()=>World("{\"fixedStep\":1}"),"invalid fixed interval");Throws(()=>World("{\"gravity\":[1e999,0]}"),"nonfinite gravity");Throws(()=>World("{\"gravity\":[0,0,0]}"),"not implicit 3D vector");Throws(()=>World("{\"maxBodies\":65}"),"bounded world capacity");
string a=World(),b=World();string a1=Disc(a,-.499,1),a2=Disc(a,.499,-1);string b1=Disc(b,3);Commit(a);Commit(b);Check(State(a)["tick"]!.GetValue<long>()==0&&State(a)["bodies"]!.AsArray().Count==2,"deferred creation committed");string untouched=State(b).ToJsonString();Tick(a);Near(Body(a,0)["vx"]!.GetValue<double>(),-1,"elastic equal-mass velocity swap A");Near(Body(a,1)["vx"]!.GetValue<double>(),1,"elastic equal-mass velocity swap B");Near(Body(a,0)["x"]!.GetValue<double>(),-.5,"isolated penetration corrected");Check(State(b).ToJsonString()==untouched,"independent world unchanged");var initialEvents=Json(calls.Events.Invoke(a,0,128));Check(initialEvents["events"]![0]!["kind"]!.ToString()=="begin","contact begin");Near(initialEvents["events"]![0]!["normalImpulse"]!.GetValue<double>(),2,"analytic impulse");string beforeInterpolation=State(a).ToJsonString();var mid=Json(calls.Snapshot.Invoke(a,.5));Near(mid["bodies"]![0]!["displayX"]!.GetValue<double>(),(-.499-.5)/2,"display interpolation");Check(State(a).ToJsonString()==beforeInterpolation,"interpolation does not simulate");Tick(a);Check(Json(calls.Events.Invoke(a,0,128))["events"]![1]!["kind"]!.ToString()=="end","separation end");
string unequal=World();Disc(unequal,-.499,1,1);Disc(unequal,.499,0,3);Commit(unequal);Tick(unequal);Near(Body(unequal,0)["vx"]!.GetValue<double>(),-.5,"unequal mass A");Near(Body(unequal,1)["vx"]!.GetValue<double>(),.5,"unequal mass B");Near(Body(unequal,0)["vx"]!.GetValue<double>()+3*Body(unequal,1)["vx"]!.GetValue<double>(),1,"momentum conserved");Near(.5*Math.Pow(Body(unequal,0)["vx"]!.GetValue<double>(),2)+1.5*Math.Pow(Body(unequal,1)["vx"]!.GetValue<double>(),2),.5,"elastic kinetic energy conserved");
string inelastic=World();Disc(inelastic,-.499,1,1,0);Disc(inelastic,.499,-1,1,0);Commit(inelastic);Tick(inelastic);Near(Body(inelastic,0)["vx"]!.GetValue<double>(),0,"inelastic normal velocity");Near(Body(inelastic,1)["vx"]!.GetValue<double>(),0,"inelastic normal velocity B");
string sensor=World();Disc(sensor,-.499,1,1,1,true);Disc(sensor,.499,-1);Commit(sensor);Tick(sensor);Near(Body(sensor,0)["vx"]!.GetValue<double>(),1,"sensor never applies impulse");Check(Json(calls.Events.Invoke(sensor,0,128))["events"]![0]!["sensor"]!.GetValue<bool>(),"sensor event");
string filtered=World();string fa=Disc(filtered,-.499,1),fb=Disc(filtered,.499,-1);calls.SetCollider.Invoke(filtered,calls.Epoch.Invoke(filtered),fa,"{\"shape\":\"circle\",\"radius\":0.5,\"mask\":0}");Commit(filtered);Tick(filtered);Check(Json(calls.Events.Invoke(filtered,0,128))["events"]!.AsArray().Count==0,"symmetric bit filters");
string corner=World();string circle=calls.CreateBody.Invoke(corner,"{\"position\":[1.2,1.2],\"velocity\":[-1,-1],\"restitution\":1}");calls.SetCollider.Invoke(corner,1,circle,"{\"shape\":\"circle\",\"radius\":0.3}");string box=calls.CreateBody.Invoke(corner,"{\"type\":\"static\",\"restitution\":1}");calls.SetCollider.Invoke(corner,1,box,"{\"shape\":\"box\",\"halfExtents\":[1,1]}");Commit(corner);Tick(corner);Near(Body(corner,0)["vx"]!.GetValue<double>(),1,"circle box corner normal");Near(Body(corner,0)["vy"]!.GetValue<double>(),1,"circle box corner vertical");
string staticCircleWorld=World();string staticDisc=calls.CreateBody.Invoke(staticCircleWorld,"{\"type\":\"static\",\"position\":[1,0],\"restitution\":1}");calls.SetCollider.Invoke(staticCircleWorld,1,staticDisc,"{\"shape\":\"circle\",\"radius\":0.5}");Disc(staticCircleWorld,0,1);Commit(staticCircleWorld);Tick(staticCircleWorld);Near(Body(staticCircleWorld,1)["vx"]!.GetValue<double>(),-1,"static circle normal impulse");
string inside=World();string ins=calls.CreateBody.Invoke(inside,"{\"position\":[0.8,0]}");calls.SetCollider.Invoke(inside,1,ins,"{\"shape\":\"circle\",\"radius\":0.3}");string wall=calls.CreateBody.Invoke(inside,"{\"type\":\"static\"}");calls.SetCollider.Invoke(inside,1,wall,"{\"shape\":\"box\",\"halfExtents\":[1,1]}");Commit(inside);Tick(inside);Near(Body(inside,0)["x"]!.GetValue<double>(),1.3,"inside box nearest-face projection");
Throws(()=>calls.CreateBody.Invoke(b,"{\"mass\":0}"),"positive dynamic mass");Throws(()=>calls.CreateBody.Invoke(b,"{\"type\":\"kinematic\"}"),"unsupported body type");Throws(()=>calls.SetCollider.Invoke(b,1,b1,"{\"shape\":\"polygon\"}"),"unsupported shape");Throws(()=>calls.SetCollider.Invoke(b,1,b1,"{\"shape\":\"circle\",\"radius\":0}"),"invalid radius");Throws(()=>calls.CreateBody.Invoke(b,"{\"friction\":0.5}"),"unknown policy never silently accepted");
string unchanged=State(b).ToJsonString();Throws(()=>calls.QueueChange.Invoke(b,1,new System.Text.Json.Nodes.JsonObject{["operation"]="remove",["body"]=a1}.ToJsonString()),"wrong-world body rejected");Check(State(b).ToJsonString()==unchanged,"wrong-world mutation did not touch B");
var work=System.Threading.Tasks.Task.Run(()=>calls.QueueChange.Invoke(b,1,new System.Text.Json.Nodes.JsonObject{["operation"]="velocity",["body"]=b1,["velocity"]=System.Text.Json.JsonSerializer.SerializeToNode(new[]{1.0,0.0})}.ToJsonString()));Check(work.Wait(5000)&&work.Result,"background intent queued");Near(Body(b,0)["vx"]!.GetValue<double>(),0,"deferred mutation not yet visible");Commit(b);Near(Body(b,0)["vx"]!.GetValue<double>(),1,"mutation applied at boundary");
string validBodies=State(b)["bodies"]!.ToJsonString();calls.SetCollider.Invoke(b,1,b1,"{\"shape\":\"box\",\"halfExtents\":[1,1]}");Check(!Json(calls.Commit.Invoke(b,1))["accepted"]!.GetValue<bool>(),"dynamic box batch rejected");Check(State(b)["bodies"]!.ToJsonString()==validBodies,"failed batch retained prior body state");
string dense=World();Disc(dense,0);Disc(dense,.8);Disc(dense,-.8);Commit(dense);string denseBefore=State(dense).ToJsonString();Check(!Json(calls.Step.Invoke(dense,1,.01))["accepted"]!.GetValue<bool>(),"unverified general multi-contact solver rejected");Check(State(dense).ToJsonString()==denseBefore,"unsupported contact leaves full state valid");
string displaced=World();string embedded=calls.CreateBody.Invoke(displaced,"{\"position\":[0.8,0]}");calls.SetCollider.Invoke(displaced,1,embedded,"{\"shape\":\"circle\",\"radius\":0.3}");string enclosing=calls.CreateBody.Invoke(displaced,"{\"type\":\"static\"}");calls.SetCollider.Invoke(displaced,1,enclosing,"{\"shape\":\"box\",\"halfExtents\":[1,1]}");string neighbour=calls.CreateBody.Invoke(displaced,"{\"type\":\"static\",\"position\":[1.7,0]}");calls.SetCollider.Invoke(displaced,1,neighbour,"{\"shape\":\"circle\",\"radius\":0.3}");Commit(displaced);string displacedBefore=State(displaced).ToJsonString();Check(!Json(calls.Step.Invoke(displaced,1,.01))["accepted"]!.GetValue<bool>()&&State(displaced).ToJsonString()==displacedBefore,"depenetration introducing another overlap rejected atomically");
string fast=World();Disc(fast,0,100);Commit(fast);string fastBefore=State(fast).ToJsonString();Check(!Json(calls.Step.Invoke(fast,1,.01))["accepted"]!.GetValue<bool>(),"unsupported CCD motion rejected");Check(State(fast).ToJsonString()==fastBefore,"high speed rejected before tick/publication");
string fixedWorld=World("{\"gravity\":[0,-2]}");Disc(fixedWorld,0);Commit(fixedWorld);var clock=new double[3];var plan=calls.Advance.Invoke(clock,1000000,0,0,.01,8);Check(plan[2]==8&&plan[4]>0&&plan[3]>=0&&plan[3]<=1,"bounded large elapsed catch-up/drop/alpha");for(int n=0;n<(int)plan[2];n++)Tick(fixedWorld);Check(State(fixedWorld)["tick"]!.GetValue<long>()==8,"only fixed ticks simulated");calls.Snapshot.Invoke(fixedWorld,plan[3]);Check(State(fixedWorld)["tick"]!.GetValue<long>()==8,"alpha not extra step");string good=State(fixedWorld).ToJsonString();Throws(()=>calls.Step.Invoke(fixedWorld,1,double.NaN),"NaN physics delta rejected");Throws(()=>calls.Step.Invoke(fixedWorld,1,double.PositiveInfinity),"infinite physics delta rejected");Throws(()=>calls.Advance.Invoke(new double[3],double.NaN,0,0,.01,8),"invalid external elapsed rejected");Throws(()=>calls.Step.Invoke(fixedWorld,1,.02),"variable delta cannot masquerade as fixed tick");Throws(()=>calls.Step.Invoke(fixedWorld,1,double.MaxValue),"extreme physics delta rejected");Throws(()=>calls.Snapshot.Invoke(fixedWorld,2),"invalid interpolation");Check(State(fixedWorld).ToJsonString()==good,"invalid numerical requests leave state unchanged");
string query=World();string q1=Disc(query,0),q2=Disc(query,3);Commit(query);var hits=Json(calls.QueryAabb.Invoke(query,new[]{-1.0,-1,4,1},1));Check(hits["truncated"]!.GetValue<bool>()&&hits["bodies"]![0]!.ToString()==q1&&hits["total"]!.GetValue<int>()==2,"query sorted/truncated");Check(Json(calls.QueryAabb.Invoke(query,new[]{.49,.49,.51,.51},64))["total"]!.GetValue<int>()==0,"exact circle query excludes bounding-box corner");Throws(()=>calls.QueryAabb.Invoke(query,new[]{1.0,0,-1,0},1),"invalid query bounds");
string resting=World("{\"gravity\":[0,-2]}");string floor=calls.CreateBody.Invoke(resting,"{\"type\":\"static\",\"position\":[0,-0.5]}");calls.SetCollider.Invoke(resting,1,floor,"{\"shape\":\"box\",\"halfExtents\":[3,0.5]}");string restingBall=Disc(resting,0,0,1,0);calls.QueueChange.Invoke(resting,1,new System.Text.Json.Nodes.JsonObject{["operation"]="transform",["body"]=restingBall,["position"]=System.Text.Json.JsonSerializer.SerializeToNode(new[]{0.0,.5})}.ToJsonString());Commit(resting);for(int n=0;n<600;n++)Tick(resting);Near(Body(resting,1)["y"]!.GetValue<double>(),.5,"stable isolated resting contact");var history=Json(calls.Events.Invoke(resting,0,128));Check(history["historyLost"]!.GetValue<bool>()&&history["truncated"]!.GetValue<bool>(),"event retention overflow explicit");Check(history.ToJsonString()==Json(calls.Events.Invoke(resting,0,128)).ToJsonString(),"independent event cursors do not consume shared queue");long latest=history["latestSequence"]!.GetValue<long>();Check(calls.RemoveBody.Invoke(resting,1,restingBall),"remove queued from event consumer");Check(State(resting)["bodies"]!.AsArray().Count==2,"remove safely deferred");Commit(resting);Check(Json(calls.Events.Invoke(resting,latest,128))["events"]![0]!["kind"]!.ToString()=="end","deferred removal emits end");Check(!calls.RemoveBody.Invoke(resting,1,restingBall),"retired callback rejected");
for(int n=0;n<40;n++){string id=Disc(query,8);Commit(query);Check(calls.RemoveBody.Invoke(query,1,id),"repeat removal accepted");Commit(query);Check(!calls.QueueChange.Invoke(query,1,new System.Text.Json.Nodes.JsonObject{["operation"]="remove",["body"]=id}.ToJsonString()),"retired ID cannot mutate new body");}Check(State(query)["bodies"]!.AsArray().Count==2,"repeat create/remove does not leak bodies");
string beforeFence=State(b)["bodies"]!.ToJsonString();long priorGeneration=calls.Epoch.Invoke(b);Check(calls.Fence.Invoke(b)!=priorGeneration&&State(b)["bodies"]!.ToJsonString()==beforeFence,"generation fence preserves poses");Check(!calls.RemoveBody.Invoke(b,priorGeneration,b1),"fenced callback suppressed");
string ordered=World();string center=Disc(ordered,0,0,1,0,true);for(int n=0;n<12;n++){string target=calls.CreateBody.Invoke(ordered,"{\"type\":\"static\",\"position\":[0.5,0]}");calls.SetCollider.Invoke(ordered,1,target,"{\"shape\":\"circle\",\"radius\":0.5}");}Commit(ordered);Tick(ordered);var orderedEvents=Json(calls.Events.Invoke(ordered,0,128))["events"]!.AsArray();Check(orderedEvents.Count==12,"all sensor pairs recorded");for(int n=0;n<12;n++)Check(orderedEvents[n]!["bID"]!.GetValue<long>()==n+2,"numeric pair order beyond lexicographic 9/10");
long old=calls.Epoch.Invoke(a);Check(calls.DisposeWorld.Invoke(a)&&calls.DisposeWorld.Invoke(a),"idempotent close");Check(calls.Epoch.Invoke(a)==0&&!calls.RemoveBody.Invoke(a,old,a1),"closed callback suppressed");string reopened=World();Check(reopened!=a&&calls.Epoch.Invoke(reopened)==1,"fresh world same owner has distinct scope");Check(State(b)["bodies"]!.AsArray().Count==1,"close another world preserves B");Console.WriteLine("Physics analytic momentum/energy, circle-box contact, world isolation, query/event order, deferred/stale changes, bounded timing/numerics, repeated lifecycle PASS");return 0;
}finally{foreach(string world in worlds)calls.DisposeWorld.Invoke(world);Console.WriteLine("Physics owner cleanup complete");}
