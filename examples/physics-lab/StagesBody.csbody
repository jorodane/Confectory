System.Text.Json.Nodes.JsonNode Json(string value)=>System.Text.Json.Nodes.JsonNode.Parse(value)!;void Check(bool value,string reason){if(!value)throw new Exception(reason);}string a="",b="";bool gui=Environment.GetEnvironmentVariable("CONFECTORY_PHYSICS_MODE")=="ui";string Scene(string stage)=>Json(calls.StageSnapshot.Invoke(stage))["resource"]!.ToString();string World(string stage)=>calls.SceneWorld.Invoke(Scene(stage));
try{a=calls.StageCreate.Invoke("physics-A",new System.Text.Json.Nodes.JsonObject{["name"]="A",["gui"]=gui,["gravity"]=-2,["fixedPeriod"]=.01,["returnPolicy"]="preserve"}.ToJsonString());b=calls.StageCreate.Invoke("physics-B",new System.Text.Json.Nodes.JsonObject{["name"]="B",["gui"]=gui,["gravity"]=-3,["fixedPeriod"]=.01,["returnPolicy"]="preserve"}.ToJsonString());foreach(string stage in new[]{a,b}){calls.StageRegister.Invoke(stage,"Example.PhysicsLab::SceneFixed","fixed",0);Check(calls.StageEnter.Invoke(stage),"Stage enter");}string worldA=World(a),worldB=World(b);
if(!gui){for(int n=0;n<300;n++){calls.StageAdvance.Invoke(a,calls.StageEpoch.Invoke(a),.01);calls.StageAdvance.Invoke(b,calls.StageEpoch.Invoke(b),.01);}Check(Json(calls.Events.Invoke(worldA,0,128))["events"]!.AsArray().Count>0&&Json(calls.Events.Invoke(worldB,0,128))["events"]!.AsArray().Count>0,"independent Stage-owned real collisions");Check(calls.Snapshot.Invoke(worldA,1)!=calls.Snapshot.Invoke(worldB,1),"independent world state");long oldWorldEpoch=calls.Epoch.Invoke(worldA);string aBodies=Json(calls.Snapshot.Invoke(worldA,1))["bodies"]!.ToJsonString();calls.StageStop.Invoke(a);string aState=calls.Snapshot.Invoke(worldA,1);Check(calls.Epoch.Invoke(worldA)!=oldWorldEpoch&&Json(aState)["bodies"]!.ToJsonString()==aBodies,"Stop fences stale Physics work while retaining poses");Check(!calls.QueueChange.Invoke(worldA,oldWorldEpoch,"{\"operation\":\"remove\",\"body\":\"retired\"}"),"old generation callback rejected before body interpretation");long old=calls.StageEpoch.Invoke(a);for(int n=0;n<10;n++){calls.StageAdvance.Invoke(a,old,.01);calls.StageAdvance.Invoke(b,calls.StageEpoch.Invoke(b),.01);}Check(calls.Snapshot.Invoke(worldA,1)==aState&&Json(calls.Snapshot.Invoke(worldB,1))["tick"]!.GetValue<long>()==310,"only B continues");Check(calls.StageEnter.Invoke(a)&&World(a)==worldA,"preserved world identity on return");Check(Json(calls.StageTransition.Invoke(a,b,"stop-prior"))["accepted"]!.GetValue<bool>(),"explicit transition");calls.StageClose.Invoke(a);Check(calls.Epoch.Invoke(worldA)==0&&calls.Epoch.Invoke(worldB)>0,"Stage Close releases only its Physics Owner");Console.WriteLine("Two-stage same Physics contracts collision/isolation/stop/return/close PASS");return 0;}
int stop=0;ConsoleCancelEventHandler interrupt=(_,args)=>{args.Cancel=true;System.Threading.Interlocked.Exchange(ref stop,1);};Console.CancelKeyPress+=interrupt;var watch=System.Diagnostics.Stopwatch.StartNew();double prior=watch.Elapsed.TotalSeconds;int[] active={1,1};try{Console.WriteLine("PHYSICS_UI ready stages");while(System.Threading.Volatile.Read(ref stop)==0&&(active[0]!=0||active[1]!=0)){for(int index=0;index<2;index++){if(active[index]==0)continue;string stage=index==0?a:b;var input=calls.ScenePump.Invoke(Scene(stage));for(int i=0;i<input.Length;i+=6){int type=input[i+1],key=input[i+4];if(type==8||(type==5&&(key==81||key==113))){calls.StageClose.Invoke(stage);active[index]=0;break;}if(type==5&&(key==83||key==115))calls.StageStop.Invoke(stage);if(type==5&&(key==69||key==101))calls.StageEnter.Invoke(stage);}}double now=watch.Elapsed.TotalSeconds,elapsed=now-prior;prior=now;for(int index=0;index<2;index++)if(active[index]!=0){string stage=index==0?a:b;var result=Json(calls.StageAdvance.Invoke(stage,calls.StageEpoch.Invoke(stage),elapsed));var info=Json(calls.StageSnapshot.Invoke(stage));double alpha=result["timing"]?[3]?.GetValue<double>()??1;calls.SceneDraw.Invoke(Scene(stage),info["status"]!.ToString(),alpha);if(Environment.GetEnvironmentVariable("CONFECTORY_PHYSICS_TRACE")=="1")Console.WriteLine("PHYSICS_UI snapshot "+index+" "+new System.Text.Json.Nodes.JsonObject{["stage"]=info.DeepClone(),["world"]=Json(calls.Snapshot.Invoke(World(stage),alpha))}.ToJsonString());}Console.Out.Flush();System.Threading.Thread.Sleep(10);}}finally{Console.CancelKeyPress-=interrupt;}Console.WriteLine("Physics visible stages complete");return 0;
}finally{foreach(string stage in new[]{a,b})if(stage!=""){var result=Json(calls.StageClose.Invoke(stage));if(!result["accepted"]!.GetValue<bool>())throw new Exception(result.ToJsonString());}Console.WriteLine("Physics Stage cleanup complete");}
