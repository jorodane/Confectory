string scene=Guid.NewGuid().ToString("N"),world="";long[] surfaces=Array.Empty<long>();try{world=calls.CreateWorld.Invoke(ownerID,new System.Text.Json.Nodes.JsonObject{["gravity"]=System.Text.Json.JsonSerializer.SerializeToNode(new[]{0.0,gravity}),["fixedStep"]=.01,["maxSpeed"]=20,["lengthUnit"]="demo-unit",["massUnit"]="demo-mass"}.ToJsonString());long epoch=calls.Epoch.Invoke(world);string floor=calls.CreateBody.Invoke(world,"{\"type\":\"static\",\"position\":[3,0.3],\"restitution\":0.8}");calls.SetCollider.Invoke(world,epoch,floor,"{\"shape\":\"box\",\"halfExtents\":[3,0.2]}");string ball=calls.CreateBody.Invoke(world,"{\"position\":[3,2.5],\"restitution\":0.8}");calls.SetCollider.Invoke(world,epoch,ball,"{\"shape\":\"circle\",\"radius\":0.3}");var commit=System.Text.Json.Nodes.JsonNode.Parse(calls.Commit.Invoke(world,epoch))!;if(!commit["accepted"]!.GetValue<bool>())throw new InvalidOperationException(commit.ToJsonString());if(gui){if(calls.WindowCapabilities.Invoke()[0]!=1)throw new NotSupportedException("Desktop preview requires native multiwindow; Android needs app-owned surface consumer");surfaces=calls.WindowCreateSurfaces.Invoke(new[]{"Confectory Physics "+name},480,320);calls.WindowPlace.Invoke(surfaces,0,name=="B"?510:10,20);}AppDomain.CurrentDomain.SetData("Example.PhysicsLab.Scene."+scene,new object[]{name,surfaces,world,ball,floor});return scene;}catch{if(surfaces.Length>0)calls.WindowClose.Invoke(surfaces,-1);if(world!="")calls.DisposeWorld.Invoke(world);throw;}
