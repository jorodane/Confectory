project Confectory.Engine version "0.1.0" {
entry Confectory.Engine::Main;
registry Confectory.RuntimeBase "../../packs/runtime-base/pack.cpack";
dependency Confectory.RuntimeBase version "0.1.0";
registry Confectory.RealTimeUpdate "../../packs/realtime-update/pack.cpack";
dependency Confectory.RealTimeUpdate version "0.1.0";
registry Confectory.RenderInput "../../packs/render-input/pack.cpack";
dependency Confectory.RenderInput version "0.1.0";
registry Confectory.BaseUI "../../packs/base-ui/pack.cpack";
dependency Confectory.BaseUI version "0.1.0";
registry Confectory.Window "../../packs/window/pack.cpack";
dependency Confectory.Window version "0.1.0";
registry Confectory.Build.DotNet "../../targets/dotnet/pack.cpack";
dependency Confectory.Build.DotNet version "0.1.0";
target windows Confectory.Build.DotNet::Portable;
target portable Confectory.Build.DotNet::Portable;
target linux Confectory.Build.DotNet::Linux;
element Main function "main.celem";
element MainBody implementation "main_body.celem";
element FixedUpdate function "FixedUpdate.celem";
element FixedUpdateBody implementation "FixedUpdateBody.celem";
registry Confectory.ProjectExecution "../../packs/project-execution/pack.cpack";
dependency Confectory.ProjectExecution version "0.1.0";
registry Confectory.ProjectManager "../../packs/project-manager/pack.cpack";
dependency Confectory.ProjectManager version "0.1.0";
}
