project Confectory.Engine version "0.1.0" {
    description "Engine composition boundary proof; not the complete engine product";
    entry Confectory.Engine::Boot;
    registry Confectory.Build.DotNet "../../targets/dotnet/pack.cpack";
    dependency Confectory.Build.DotNet version "0.1.0";
    target portable Confectory.Build.DotNet::Portable;
    target linux Confectory.Build.DotNet::Linux;
    element Boot function "boot.celem";
    element BootBody implementation "boot_body.celem";
}
