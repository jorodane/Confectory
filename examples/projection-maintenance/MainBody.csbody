void Check(bool value,string reason){if(!value)throw new Exception(reason);}System.Text.Json.Nodes.JsonNode Json(string text)=>System.Text.Json.Nodes.JsonNode.Parse(text)!;
string project=Environment.GetEnvironmentVariable("CONFECTORY_PROJECTION_PROJECT")??throw new InvalidOperationException("Explicit private ProjectPack required"),storage=Environment.GetEnvironmentVariable("CONFECTORY_PROJECTION_DIR")??System.IO.Path.Combine(System.IO.Path.GetTempPath(),"projection-maintenance-"+Guid.NewGuid().ToString("N"));System.IO.Directory.CreateDirectory(storage);string helpers="",tasks="",workspace="",view="";string function="Example.Authoring::Main",implementation="Example.Authoring::MainBody",bodyID=implementation+"/body:common";try{
helpers=calls.HelperOpen.Invoke(storage);foreach(string helper in new[]{"chief","editor"})calls.HelperRecruit.Invoke(helpers,"local-owner",new System.Text.Json.Nodes.JsonObject{["helper"]=helper,["owner"]="local-owner",["personality"]="calm",["speciality"]="public description maintenance"}.ToJsonString());string td=System.IO.Path.Combine(storage,"tasks");System.IO.Directory.CreateDirectory(td);tasks=calls.WorkerTasksOpen.Invoke(td,project,helpers,"local-owner","chief");AppDomain.CurrentDomain.SetData("Example.ProjectionMaintenance.Route",new[]{tasks,"chief","editor",project});workspace=calls.EditWorkspaceOpen.Invoke(project,"local-owner","projection-maintenance");view=calls.AlgorithmProjectionOpen.Invoke(workspace);
Check(calls.AlgorithmProjectionRegenerate.Invoke(view,function,implementation,bodyID),"initial confirmed projection");string baseline=calls.AlgorithmProjectionBrowse.Invoke(project,function,implementation,bodyID,"{}");Check(Json(calls.AlgorithmProjectionQuery.Invoke(project,function,implementation,bodyID))["freshness"]!.ToString()=="current-source","public current source");string original=calls.EditWorkspaceRead.Invoke(workspace,bodyID)[3];calls.EditWorkspaceSetText.Invoke(workspace,bodyID,"if (true) { Console.WriteLine(1); } return 0;");var changes=calls.EditWorkspaceChanges.Invoke(workspace,new[]{bodyID});string[] changedIDs=System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Select(System.Linq.Enumerable.Range(0,changes.Length/4),n=>changes[n*4]));for(int n=0;n<10;n++)calls.AlgorithmProjectionChanged.Invoke(view,changedIDs,"human","functional","completed-batch");var maintained=Json(calls.AlgorithmProjectionMaintain.Invoke(view));Check(maintained.AsArray().Count==1&&maintained[0]!["accepted"]!.GetValue<bool>(),"one maintenance update per human batch");string requestID=maintained[0]!["requestID"]!.ToString();var task=Json(calls.WorkerTasksInspect.Invoke(tasks,"projection-"+requestID));Check(task["ownerHelper"]!.ToString()=="editor"&&task["status"]!.ToString()=="ready","chief routed ordinary pending task; no live execution");Check(Json(calls.AlgorithmProjectionMaintain.Invoke(view)).AsArray().Count==0,"completed batch acknowledged once");Check(Json(calls.AlgorithmProjectionQuery.Invoke(project,function,implementation,bodyID))["version"]!.GetValue<long>()==1,"draft leaves public baseline unchanged");calls.AlgorithmProjectionClose.Invoke(view);view=calls.AlgorithmProjectionOpen.Invoke(workspace);Check(Json(calls.AlgorithmProjectionSnapshot.Invoke(view,function))["durability"]!.ToString()=="draft-unconfirmed","same-context durable recovery");Check(calls.ChangeSetConfirm.Invoke(workspace,changedIDs,"portable")[0]=="confirmed","existing changed-ID Confirm");Check(calls.AlgorithmProjectionRegenerate.Invoke(view,function,implementation,bodyID),"confirmed source refresh");string delta=calls.AlgorithmProjectionDelta.Invoke(project,function,implementation,bodyID,"{\"baseVersion\":1,\"newVersion\":2}");var applied=Json(calls.AlgorithmProjectionApplyDelta.Invoke(baseline,delta));Check(applied["applied"]!.GetValue<bool>(),"revision-qualified delta applies");Check(Json(calls.AlgorithmProjectionApplyDelta.Invoke(applied["snapshot"]!.ToJsonString(),delta))["reason"]!.ToString()=="already-applied","repeated delivery is idempotent");var tampered=Json(delta);tampered["snapshot"]!["descriptionPreview"]="tampered";Check(Json(calls.AlgorithmProjectionApplyDelta.Invoke(baseline,tampered.ToJsonString()))["requiresRefresh"]!.GetValue<bool>(),"tampered replacement requires full refresh");Check(Json(calls.AlgorithmProjectionEditorDescribe.Invoke(project,function))["format"]!.ToString().Contains("current declaration",StringComparison.Ordinal),"current DSL editor help");calls.EditWorkspaceSetText.Invoke(workspace,bodyID,original);calls.AlgorithmProjectionChanged.Invoke(view,new[]{bodyID},"ai","functional","author-self-update");Check(Json(calls.AlgorithmProjectionMaintain.Invoke(view)).AsArray().Count==0,"AI author self-update creates no separate maintenance task");Console.WriteLine("Projection durable qualified public/draft recovery changed-ID batch chief Task routing delta apply/idempotence/tamper and AI self-update PASS");return 0;
}finally{AppDomain.CurrentDomain.SetData("Example.ProjectionMaintenance.Route",null);if(view!="")calls.AlgorithmProjectionClose.Invoke(view);if(workspace!="")calls.EditWorkspaceClose.Invoke(workspace);if(tasks!="")calls.WorkerTasksClose.Invoke(tasks);if(helpers!="")calls.HelperClose.Invoke(helpers);Console.WriteLine("Projection owner cleanup complete");}
