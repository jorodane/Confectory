project Example.ProjectionMaintenance version "0.1.0" {
standalone true;
entry Example.ProjectionMaintenance::Main;
registry Confectory.WorkerTasks "../../packs/worker-tasks/pack.cpack";
dependency Confectory.WorkerTasks version "0.1.0";
registry Confectory.Helper "../../packs/helper/pack.cpack";
dependency Confectory.Helper version "0.1.0";
registry Confectory.Agent "../../packs/agent/pack.cpack";
dependency Confectory.Agent version "0.1.0";
registry Confectory.EditWorkspace "../../packs/edit-workspace/pack.cpack";
dependency Confectory.EditWorkspace version "0.1.0";
registry Confectory.SchemaEditing "../../packs/schema-editing/pack.cpack";
dependency Confectory.SchemaEditing version "0.1.0";
registry Confectory.FileStream "../../packs/file-stream/pack.cpack";
dependency Confectory.FileStream version "0.1.0";
registry Confectory.Save "../../packs/save/pack.cpack";
dependency Confectory.Save version "0.1.0";
registry Confectory.ChangeSet "../../packs/change-set/pack.cpack";
dependency Confectory.ChangeSet version "0.1.0";
registry Confectory.YogiBox "../../packs/yogi-box/pack.cpack";
dependency Confectory.YogiBox version "0.1.0";
registry Confectory.Window "../../packs/window/pack.cpack";
dependency Confectory.Window version "0.1.0";
registry Confectory.RenderInput "../../packs/render-input/pack.cpack";
dependency Confectory.RenderInput version "0.1.0";
registry Confectory.Harvest "../../packs/harvest/pack.cpack";
dependency Confectory.Harvest version "0.1.0";
registry Confectory.Inventory "../../packs/inventory/pack.cpack";
dependency Confectory.Inventory version "0.1.0";
registry Confectory.Build.DotNet "../../targets/dotnet/pack.cpack";
dependency Confectory.Build.DotNet version "0.1.0";
target portable Confectory.Build.DotNet::Portable;
target linux Confectory.Build.DotNet::Linux;
target windows Confectory.Build.DotNet::Portable;
target android Confectory.Build.DotNet::Portable;
registry Confectory.AlgorithmProjection "../../packs/algorithm-projection/pack.cpack";
dependency Confectory.AlgorithmProjection version "0.1.0";
element Main function "Main.celem";
element MainBody implementation "MainBody.celem";
element Route implementation "Route.celem";
}
