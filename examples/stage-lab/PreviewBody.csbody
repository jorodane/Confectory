string scene="";try{bool gui=Environment.GetEnvironmentVariable("CONFECTORY_STAGE_MODE")=="ui";scene=calls.SceneNew.Invoke("Preview",gui,180);calls.SceneInput.Invoke(scene,12,0,1);for(int n=0;n<5;n++){calls.SceneFixed.Invoke(scene,0.01);calls.ScenePresent.Invoke(scene);}var snapshot=System.Text.Json.Nodes.JsonNode.Parse(calls.SceneSnapshot.Invoke(scene,1))!;if(snapshot["camera"]![0]!.GetValue<double>()!=12||snapshot["steps"]!.GetValue<long>()!=5)throw new Exception("Standalone render/gameplay contexts failed");calls.SceneDraw.Invoke(scene,"stage-free",5,1);if(gui){var watch=System.Diagnostics.Stopwatch.StartNew();while(watch.ElapsedMilliseconds<500){calls.ScenePump.Invoke(scene);System.Threading.Thread.Sleep(10);}}Console.WriteLine("Stage-free render/camera/bounded ballistic preview PASS");return 0;}finally{if(scene!="")calls.SceneClose.Invoke(scene);}
