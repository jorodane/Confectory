string scene=Guid.NewGuid().ToString("N"),projectile="";long[] surfaces=Array.Empty<long>();try{projectile=calls.Ballistic2DCreate.Invoke(80,175,350,175,0.7,0.1,gravity);if(gui){if(calls.WindowCapabilities.Invoke()[0]!=1)throw new NotSupportedException("Desktop multiwindow experiment requires native desktop windows; Android needs an explicit external-surface consumer");surfaces=calls.WindowCreateSurfaces.Invoke(new[]{"Confectory Stage "+name},480,280);calls.WindowPlace.Invoke(surfaces,0,name=="A"?10:510,20);}AppDomain.CurrentDomain.SetData("Example.StageLab.Scene."+scene,new object[]{name,surfaces,projectile,new double[]{0,0,1},new double[]{0,0,1},new double[]{0,0,1},0L});return scene;}catch{if(surfaces.Length>0)calls.WindowClose.Invoke(surfaces,-1);if(projectile!="")calls.Ballistic2DClose.Invoke(projectile);throw;}
