int RunWindowless(){
bool editable=Environment.GetEnvironmentVariable("CONFECTORY_WINDOWLESS_EDIT")=="1";
string project=Environment.GetEnvironmentVariable("CONFECTORY_BROWSER_PROJECT")??throw new ArgumentException("Set CONFECTORY_BROWSER_PROJECT to an existing project.cpack; browser never creates or moves a project implicitly.");
string workspace=calls.WorkspaceOpen.Invoke(System.IO.Path.GetFullPath(project),"local-browser","semantic-editors");var owner=calls.CreateOwner.Invoke(1);var surfaces=calls.CreateSurfaces.Invoke(new[]{"Confectory - Windowless browser proof"},1120,780);
System.Text.Json.Nodes.JsonNode J(string value)=>System.Text.Json.Nodes.JsonNode.Parse(value)!;
string state=calls.OrderCreate.Invoke(),frame="";int tab=0,density=0,offset=0,nextWindow=10;bool stop=false,suspended=false;string notice=editable?"Experimental native editing host; actual Windows IME, clipboard and DPI validation pending.":"Readonly rendering proof; keyboard and IME provider is not ready.";
var models=new System.Collections.Generic.Dictionary<string,string>(StringComparer.Ordinal);var editors=new System.Collections.Generic.Dictionary<int,string[]>();var rows=new System.Collections.Generic.List<string[]>();int[] capture=new[]{0,0,0};int[] drag=Array.Empty<int>();int pendingNativeFocus=0,lastNativeWindow=0;int width=0,height=0;
void NativeFocus(string host,string control,int id){foreach(var item in editors.Values)calls.TextRequest.Invoke(item[1],"focus",System.Text.Json.JsonSerializer.Serialize(new{focus=item[1]==host&&id==10}),0);}
void Pointer(int key,int kind,int x,int y){if(!editors.TryGetValue(key,out var data))return;var scene=calls.OrderCompose.Invoke(state,new[]{0,0,width,height});var row=System.Linq.Enumerable.First(J(scene)["windows"]!.AsArray(),w=>w!["id"]!.GetValue<int>()==key)!;var field=System.Linq.Enumerable.First(row["controls"]!.AsArray(),c=>c!["id"]!.GetValue<int>()==10)!;calls.TextRequest.Invoke(data[1],"pointer",System.Text.Json.JsonSerializer.Serialize(new{kind,x,y,bounds=System.Text.Json.JsonSerializer.Deserialize<int[]>(field["bounds"]!.ToJsonString())!}),0);}
void Order(string op,object value)=>state=calls.OrderUpdate.Invoke(state,op,System.Text.Json.JsonSerializer.Serialize(value));
void Catalog(){rows.Clear();foreach(string id in calls.WorkspaceList.Invoke(workspace)){var unit=calls.WorkspaceRead.Invoke(workspace,id);if(unit[1]==(tab==0?"concept":tab==1?"function":"module"))rows.Add(unit);}rows.Sort((a,b)=>StringComparer.Ordinal.Compare(a[0],b[0]));offset=Math.Clamp(offset,0,Math.Max(0,rows.Count-1));}
object C(int id,int x,int y,int w,int h)=>new{id,bounds=new[]{x,y,w,h}};
void RootLayout(){Catalog();var controls=new System.Collections.Generic.List<object>{C(1,12,42,105,32),C(2,125,42,105,32),C(3,238,42,105,32),C(4,12,82,105,30),C(5,125,82,105,30),C(6,238,82,105,30)};int pitch=density==0?32:density==1?76:50;for(int n=offset;n<rows.Count&&n-offset<112&&(n-offset)*pitch+128<height-70;n++)controls.Add(C(100+n-offset,12,124+(n-offset)*pitch,Math.Max(8,width-24),pitch-5));int x=12,restoreWidth=Math.Max(8,(width-24)/Math.Max(1,editors.Count)-4);foreach(var pair in editors){controls.Add(C(400+pair.Key,x,height-48,restoreWidth,30));x+=restoreWidth+4;}Order("move",new{id=1,bounds=new[]{0,0,width,height}});Order("controls",new{id=1,controls});}
void Open(string id){int existing=0;foreach(var pair in editors)if(pair.Value[0]==id)existing=pair.Key;if(existing!=0){Order("restore",new{id=existing});Order("activate",new{id=existing,control=10});pendingNativeFocus=existing;return;}if(editors.Count>=8){notice="Eight semantic editors are supported in this experiment.";return;}var unit=calls.WorkspaceRead.Invoke(workspace,id);int key=nextWindow++;string host="",control=calls.CreateControls.Invoke(new[]{10}),buffer=models.TryGetValue(id,out string? retained)?retained:calls.CreateText.Invoke("semantic-"+id,unit[3]);models[id]=buffer;int x=300+editors.Count%3*50,y=120+editors.Count%3*45;try{host=calls.TextRequest.Invoke("","create",System.Text.Json.JsonSerializer.Serialize(new{text=calls.TextSnapshot.Invoke(buffer)[1],bounds=new[]{x+12,y+58,536,310},@readonly=!editable}),surfaces[1]);if(editable)calls.TextRequest.Invoke(host,"input-begin","{}",0);}catch{if(host.Length>0)calls.TextRequest.Invoke(host,"close","{}",0);calls.CloseControls.Invoke(control);throw;}editors.Add(key,new[]{id,host,control,buffer});Order("open",new{id=key,order=0,bounds=new[]{x,y,560,430},controls=new[]{C(10,12,58,536,310),C(20,504,6,44,30),C(21,452,6,44,30),C(22,12,380,170,34),C(23,194,380,170,34)}});Order("activate",new{id=key,control=10});pendingNativeFocus=key;RootLayout();}
void Sync(string[] data){if(!editable)return;var snapshot=J(calls.TextRequest.Invoke(data[1],"snapshot","{}",0));if(snapshot["composing"]!.GetValue<bool>())return;calls.ReplaceText.Invoke(data[3],snapshot["text"]!.ToString(),snapshot["caret"]!.GetValue<int>(),snapshot["anchor"]!.GetValue<int>());}
void Close(int key){if(!editors.TryGetValue(key,out var data))return;Sync(data);calls.TextRequest.Invoke(data[1],"close","{}",0);calls.CloseControls.Invoke(data[2]);editors.Remove(key);Order("close",new{id=key});RootLayout();lastNativeWindow=0;}
void Activate(int win,int control){Order("activate",new{id=win,control,frameRevision=J(frame)["revision"]!.GetValue<long>()});if(editors.TryGetValue(win,out var data)){NativeFocus(data[1],data[2],control==10?10:0);lastNativeWindow=control==10?win:0;}else{NativeFocus("","",0);lastNativeWindow=0;}}
void Action(int win,int control){if(win==1){if(control>=1&&control<=3){tab=control-1;offset=0;RootLayout();}else if(control>=4&&control<=6){density=control-4;RootLayout();}else if(control>=400){int key=control-400;if(editors.ContainsKey(key)){Order("restore",new{id=key});Order("activate",new{id=key,control=10});pendingNativeFocus=key;}}else if(control>=100&&offset+control-100<rows.Count)Open(rows[offset+control-100][0]);return;}if(!editors.TryGetValue(win,out var data))return;if(control==20)Close(win);else if(control==21){NativeFocus(data[1],data[2],0);Order("minimize",new{id=win});}else if(control==22&&editable){Sync(data);calls.WorkspaceSetText.Invoke(workspace,data[0],calls.TextSnapshot.Invoke(data[3])[1]);notice="Validated local draft; source files unchanged: "+data[0];}else if(control==22){calls.TextRequest.Invoke(data[1],"send","{\"message\":177,\"wparam\":0,\"lparam\":5}",0);notice="Native selection preview: "+data[0];}else if(control==23){var row=System.Linq.Enumerable.First(J(frame)["windows"]!.AsArray(),w=>w!["id"]!.GetValue<int>()==win)!;Order("order",new{id=win,order=row["order"]!.GetValue<int>()==0?5:0});}}
void Render(){foreach(var data in editors.Values)Sync(data);frame=calls.OrderCompose.Invoke(state,new[]{0,0,width,height});var rectangles=new System.Collections.Generic.List<int>();var labels=new System.Collections.Generic.List<string>();var clips=new System.Collections.Generic.List<int>();var origins=new System.Collections.Generic.List<int>();var texts=new System.Collections.Generic.List<string>();var fieldTrace=new System.Text.Json.Nodes.JsonObject();var rendered=new System.Collections.Generic.HashSet<int>();var nativeDraws=new System.Collections.Generic.List<object[]>();
 void Box(int[] r,int color){rectangles.AddRange(new[]{r[0],r[1],r[2],r[3],color});labels.Add("");}
 void Text(System.Text.Json.Nodes.JsonNode regions,int[] box,string text){int[] visible=System.Text.Json.JsonSerializer.Deserialize<int[]>(regions.ToJsonString())!;for(int n=0;n<visible.Length;n+=4){int x=Math.Max(box[0],visible[n]),y=Math.Max(box[1],visible[n+1]),right=Math.Min(box[0]+box[2],visible[n]+visible[n+2]),bottom=Math.Min(box[1]+box[3],visible[n+1]+visible[n+3]);if(right<=x||bottom<=y)continue;clips.AddRange(new[]{x,y,right-x,bottom-y});origins.AddRange(new[]{box[0]+8,box[1]+8});texts.Add(text);}}
 foreach(var node in J(frame)["windows"]!.AsArray()){var row=node!;int id=row["id"]!.GetValue<int>();int[] bounds=System.Text.Json.JsonSerializer.Deserialize<int[]>(row["bounds"]!.ToJsonString())!,regions=System.Text.Json.JsonSerializer.Deserialize<int[]>(row["regions"]!.ToJsonString())!;for(int n=0;n<regions.Length;n+=4)Box(regions[n..(n+4)],id==1?0x14212B:row["active"]!.GetValue<bool>()?0x29475B:0x213644);
 if(id==1){Text(row["regions"]!,new[]{12,4,width-24,32},"Project browser - "+System.IO.Path.GetFileName(System.IO.Path.GetDirectoryName(project)));foreach(var c in row["controls"]!.AsArray()){int control=c!["id"]!.GetValue<int>();string title=control<=3?new[]{"Concepts","Features","Modules"}[control-1]:control<=6?new[]{"Compact","Preview","Data"}[control-4]:control>=400?"Restore editor "+(control-400):rows[offset+control-100][0]+(density==0?"":"  | "+rows[offset+control-100][1]);Text(c["regions"]!,System.Text.Json.JsonSerializer.Deserialize<int[]>(c["bounds"]!.ToJsonString())!,title);}Text(row["regions"]!,new[]{12,height-82,width-24,30},notice);continue;}
 rendered.Add(id);var data=editors[id];Text(row["regions"]!,new[]{bounds[0]+8,bounds[1]+4,bounds[2]-125,38},data[0]+"  [Order "+row["order"]+"]");
 foreach(var c in row["controls"]!.AsArray()){int control=c!["id"]!.GetValue<int>();int[] box=System.Text.Json.JsonSerializer.Deserialize<int[]>(c["bounds"]!.ToJsonString())!;if(control==10){int[] nativeRegions=System.Text.Json.JsonSerializer.Deserialize<int[]>(c["regions"]!.ToJsonString())!;var field=J(calls.TextRequest.Invoke(data[1],"snapshot","{}",0)).AsObject();field["id"]=10;field["bounds"]=System.Text.Json.JsonSerializer.SerializeToNode(box);field["visible"]=nativeRegions.Length>0;field["enabled"]=c["input"]!.GetValue<bool>();if(field["focus"]!.GetValue<bool>()&&!c["input"]!.GetValue<bool>())calls.TextRequest.Invoke(data[1],"focus","{\"focus\":false}",0);field["value"]=field["text"]!.DeepClone();fieldTrace[id.ToString()]=field;nativeDraws.Add(new object[]{data[1],box,nativeRegions});continue;}Text(c["regions"]!,box,control==20?"X":control==21?"_":control==22?(editable?"Keep local draft":"Native selection"):"Toggle Order 0/5");}}
 
 if(pendingNativeFocus!=0){if(fieldTrace[pendingNativeFocus.ToString()] is System.Text.Json.Nodes.JsonNode field&&field["visible"]!.GetValue<bool>()&&field["enabled"]!.GetValue<bool>()){var data=editors[pendingNativeFocus];NativeFocus(data[1],data[2],10);lastNativeWindow=pendingNativeFocus;}pendingNativeFocus=0;}
 calls.Draw.Invoke(surfaces,0,rectangles.ToArray(),labels.ToArray());if(texts.Count>0)calls.DrawText.Invoke(surfaces,0,clips.ToArray(),origins.ToArray(),texts.ToArray());foreach(var draw in nativeDraws)calls.TextRequest.Invoke((string)draw[0],"draw",System.Text.Json.JsonSerializer.Serialize(new{surfaces,view=0,bounds=(int[])draw[1],regions=(int[])draw[2]}),0);
 if(Environment.GetEnvironmentVariable("CONFECTORY_BROWSER_TRACE")=="1")Console.WriteLine("BROWSER_UI "+new System.Text.Json.Nodes.JsonObject{["frame"]=J(frame),["tab"]=tab,["density"]=density,["project"]=project,["fields"]=fieldTrace,["rows"]=System.Text.Json.JsonSerializer.SerializeToNode(System.Linq.Enumerable.Select(rows,r=>r[0])),["editors"]=System.Text.Json.JsonSerializer.SerializeToNode(System.Linq.Enumerable.ToDictionary(editors,p=>p.Key,p=>p.Value[0]))}.ToJsonString());
}
Order("open",new{id=1,order=-100,bounds=new[]{0,0,1120,780},controls=Array.Empty<object>()});width=1120;height=780;RootLayout();ConsoleCancelEventHandler interrupt=(_,e)=>{e.Cancel=true;System.Threading.Volatile.Write(ref stop,true);};Console.CancelKeyPress+=interrupt;var watch=System.Diagnostics.Stopwatch.StartNew();double last=0;
try{while(!System.Threading.Volatile.Read(ref stop)){var events=calls.Pump.Invoke(surfaces);
 for(int n=0;n<events.Length;n+=6){int type=events[n+1],x=events[n+2],y=events[n+3];if(type==8){stop=true;break;}if(type is 9 or 11){NativeFocus("","",0);capture=new[]{0,0,0};drag=Array.Empty<int>();continue;}if(type==7){var size=calls.Dimensions.Invoke(surfaces,0);if(size[0]>0&&size[1]>0){suspended=false;width=size[0];height=size[1];RootLayout();}else{suspended=true;NativeFocus("","",0);}continue;}
 frame=calls.OrderCompose.Invoke(state,new[]{0,0,width,height});if(type==1){capture=calls.OrderHit.Invoke(frame,x,y);if(capture[0]!=0&&capture[2]==0){Activate(capture[0],capture[1]);if(capture[0]!=1&&capture[1]==10)Pointer(capture[0],1,x,y);if(capture[0]!=1&&capture[1]==0){var row=System.Linq.Enumerable.First(J(frame)["windows"]!.AsArray(),w=>w!["id"]!.GetValue<int>()==capture[0])!;int[] b=System.Text.Json.JsonSerializer.Deserialize<int[]>(row["bounds"]!.ToJsonString())!;if(y<b[1]+40)drag=new[]{capture[0],x-b[0],y-b[1],b[2],b[3]};}}}
 else if(type==3&&capture[1]==10){Pointer(capture[0],3,x,y);}
 else if(type==3&&drag.Length>0)Order("move",new{id=drag[0],bounds=new[]{x-drag[1],y-drag[2],drag[3],drag[4]}});
 else if(type==2){if(capture[1]==10)Pointer(capture[0],2,x,y);var hit=calls.OrderHit.Invoke(frame,x,y);if(drag.Length==0&&capture[2]==0&&hit[0]==capture[0]&&hit[1]==capture[1])Action(hit[0],hit[1]);capture=new[]{0,0,0};drag=Array.Empty<int>();}
 else if(type==4&&editable){var hit=calls.OrderHit.Invoke(frame,x,y);if(hit[2]==0&&hit[1]==10&&editors.TryGetValue(hit[0],out var data)){var row=System.Linq.Enumerable.First(J(frame)["windows"]!.AsArray(),w=>w!["id"]!.GetValue<int>()==hit[0])!;var field=System.Linq.Enumerable.First(row["controls"]!.AsArray(),c=>c!["id"]!.GetValue<int>()==10)!;calls.TextRequest.Invoke(data[1],"wheel",System.Text.Json.JsonSerializer.Serialize(new{x,y,delta=events[n+4],bounds=System.Text.Json.JsonSerializer.Deserialize<int[]>(field["bounds"]!.ToJsonString())!}),0);}else if(hit[0]==1){offset=Math.Clamp(offset+(events[n+4]>0?-1:1),0,Math.Max(0,rows.Count-1));RootLayout();}}
 else if(type==4&&calls.OrderHit.Invoke(frame,x,y)[0]==1){offset=Math.Clamp(offset+(events[n+4]>0?-1:1),0,Math.Max(0,rows.Count-1));RootLayout();}
 }
 double now=watch.Elapsed.TotalSeconds;if(!suspended&&now-last>1.0/30){Render();last=now;}System.Threading.Thread.Sleep(2);
}}finally{Console.CancelKeyPress-=interrupt;foreach(var data in editors.Values){Sync(data);calls.TextRequest.Invoke(data[1],"close","{}",0);calls.CloseControls.Invoke(data[2]);}foreach(string buffer in models.Values)calls.CloseText.Invoke(buffer);calls.WorkspaceClose.Invoke(workspace);calls.DisposeOwner.Invoke(owner);calls.CloseSurfaces.Invoke(surfaces,-1);Console.WriteLine("Windowless browser proof native objects, models, workspace and Owner disposed");}return 0;

}
if(!OperatingSystem.IsWindows())throw new PlatformNotSupportedException("Windowless browser requires Windows x64 OLE STA");int result=-1;Exception? failure=null;var ui=new System.Threading.Thread(()=>{try{result=RunWindowless();}catch(Exception error){failure=error;}});ui.SetApartmentState(System.Threading.ApartmentState.STA);ui.Start();ui.Join();if(failure is not null)System.Runtime.ExceptionServices.ExceptionDispatchInfo.Capture(failure).Throw();return result;
