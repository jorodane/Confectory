void Check(bool value,string message){if(!value)throw new Exception(message);}
string project=Environment.GetEnvironmentVariable("CONFECTORY_COLLAB_PROJECT")??throw new Exception("Project required"),id="Example.Authoring::Counter";
string room=calls.CollaborationeditingRoomOpen.Invoke(project);string[] server=calls.MultiplayOpenServer.Invoke(room);string a="",b="",third="",same="",observer="",reader="";
System.Text.Json.Nodes.JsonNode Poll(string session)=>System.Text.Json.Nodes.JsonNode.Parse(calls.CollaborationeditingPoll.Invoke(session))!;
void Edit(string session,int count){string workspace=calls.CollaborationeditingWorkspace.Invoke(session);calls.EditworkspaceSetValue.Invoke(workspace,id,"count",count.ToString());calls.CollaborationeditingAnnounce.Invoke(session,new[]{id});}
try
{
 a=calls.CollaborationeditingOpen.Invoke(server[1],project,"alice","room-work");b=calls.CollaborationeditingOpen.Invoke(server[1],project,"bob","room-work");
 reader=calls.CollaborationeditingOpen.Invoke(server[1],project,"reader","room-work");calls.CollaborationeditingAnnounce.Invoke(reader,new[]{id});
 bool wrongProject=false,wrongContext=false;try{calls.CollaborationeditingOpen.Invoke(server[1],System.IO.Path.Combine(System.IO.Path.GetDirectoryName(project)!,"another-project.cpack"),"wrong-project","room-work");}catch(InvalidOperationException error){wrongProject=error.Message.Contains("project-mismatch");}try{calls.CollaborationeditingOpen.Invoke(server[1],project,"alice","other-work");}catch(InvalidOperationException error){wrongContext=error.Message.Contains("context-mismatch");}Check(wrongProject&&wrongContext,"Room rejects another project or unsupported participant context without creating/writing a workspace");
 string wa=calls.CollaborationeditingWorkspace.Invoke(a),wb=calls.CollaborationeditingWorkspace.Invoke(b);Check(wa!=wb,"Per-participant draft identity");using(var edits=new System.Threading.ManualResetEventSlim(false)){var ea=System.Threading.Tasks.Task.Run(()=>{edits.Wait();Edit(a,11);});var eb=System.Threading.Tasks.Task.Run(()=>{edits.Wait();Edit(b,22);});edits.Set();System.Threading.Tasks.Task.WaitAll(ea,eb);}
 Check(System.Linq.Enumerable.Single(Poll(a)["conflicts"]!.AsArray())!["kind"]!.GetValue<string>()=="conflict","Early two-participant conflict before Confirm");Check(Poll(b)["conflicts"]!.AsArray().Count==1,"Peer conflict callback state before Confirm");
 same=calls.CollaborationeditingOpen.Invoke(server[1],project,"alice","room-work");Check(calls.CollaborationeditingWorkspace.Invoke(same)==wa,"Same participant additional View shares draft");Check(System.Linq.Enumerable.Single(Poll(a)["conflicts"]!.AsArray())!["kind"]!.GetValue<string>()=="conflict","Same participant not another candidate");
 third=calls.CollaborationeditingOpen.Invoke(server[1],project,"carol","room-work");Edit(third,33);Check(System.Linq.Enumerable.Single(Poll(a)["conflicts"]!.AsArray())!["kind"]!.GetValue<string>()=="clash","Three candidates are clash");
 calls.CollaborationeditingClose.Invoke(third);third="";Check(System.Linq.Enumerable.Any(Poll(a)["presence"]!.AsArray(),x=>x!["participant"]!.GetValue<string>()=="carol"&&x["connections"]!.GetValue<int>()==0),"Participant departure releases active presence without deleting saved draft");
 // Request order is not a winner policy: only one real source baseline may be committed.
 using var start=new System.Threading.ManualResetEventSlim(false);var first=System.Threading.Tasks.Task.Run(()=>{start.Wait();return calls.CollaborationeditingConfirm.Invoke(a,new[]{id},"portable");});var second=System.Threading.Tasks.Task.Run(()=>{start.Wait();return calls.CollaborationeditingConfirm.Invoke(b,new[]{id},"portable");});start.Set();System.Threading.Tasks.Task.WaitAll(first,second);
 var outcomes=new[]{first.Result[0],second.Result[0]};Check(System.Linq.Enumerable.Count(outcomes,x=>x=="confirmed")==1&&System.Linq.Enumerable.Count(outcomes,x=>x=="conflict")==1,"Concurrent Confirm: exactly one actual CAS winner / conflict: "+string.Join(",",outcomes));string winner=first.Result[0]=="confirmed"?a:b,loser=winner==a?b:a;int losingValue=loser==a?11:22;
 Poll(loser);Check(calls.EditworkspaceRead.Invoke(calls.CollaborationeditingWorkspace.Invoke(loser),id)[3].Contains("count = "+losingValue),"Confirmed peer never overwrites dirty draft");Check(System.Linq.Enumerable.Any(Poll(loser)["conflicts"]!.AsArray(),x=>x!["baselineChanged"]!.GetValue<bool>()),"Shared confirmed baseline notification");
 Poll(reader);Check(calls.EditworkspaceRead.Invoke(calls.CollaborationeditingWorkspace.Invoke(reader),id)[3].Contains("count = "+(winner==a?11:22)),"Clean peer observes confirmed source through public refresh");
 string saved=calls.SaveWrite.Invoke(calls.CollaborationeditingWorkspace.Invoke(loser));calls.CollaborationeditingDisconnect.Invoke(loser);Check(Poll(loser)["state"]!.GetValue<string>()=="disconnected","Disconnected session state");Check(System.IO.File.Exists(saved),"Disconnect retains participant save");calls.CollaborationeditingReconnect.Invoke(loser);Check(calls.EditworkspaceRead.Invoke(calls.CollaborationeditingWorkspace.Invoke(loser),id)[3].Contains("count = "+losingValue),"Reconnect keeps dirty draft");Check(calls.CollaborationeditingConfirm.Invoke(loser,new[]{id},"portable")[0]=="conflict","Reconnected stale baseline still conflicts");
 string body="Example.Authoring::MainBody/body:common",workspace=calls.CollaborationeditingWorkspace.Invoke(winner);string oldBody=calls.EditworkspaceRead.Invoke(workspace,body)[3];calls.EditworkspaceSetText.Invoke(workspace,body,"this is invalid C#;");calls.CollaborationeditingAnnounce.Invoke(winner,new[]{body});Check(calls.CollaborationeditingConfirm.Invoke(winner,new[]{body},"portable")[0]=="invalid","Failed actual build preserves draft and confirmed source");Check(System.IO.File.ReadAllText(System.IO.Path.Combine(System.IO.Path.GetDirectoryName(project)!,"main.csbody"))==oldBody,"Failed build did not overwrite source");
 observer=calls.CollaborationeditingOpen.Invoke(server[1],project,"observer","room-work");Edit(observer,44);Check(calls.CollaborationeditingConfirm.Invoke(observer,new[]{id},"portable")[0]=="denied","Configured Work versus Apply authority");
 // Close one duplicate View/session must not close the shared workspace used by the other.
 calls.CollaborationeditingClose.Invoke(same);same="";Check(calls.EditworkspaceRead.Invoke(wa,id)[0]==id,"Closing duplicate session leaves other owner live");Check(System.Linq.Enumerable.Any(Poll(a)["presence"]!.AsArray(),x=>x!["participant"]!.GetValue<string>()=="alice"&&x["connections"]!.GetValue<int>()==1),"Duplicate owner cleanup leaves one active connection");
}
finally
{
 foreach(string session in new[]{reader,observer,third,same,a,b})if(session!="")calls.CollaborationeditingClose.Invoke(session);
 calls.MultiplayCloseServer.Invoke(server[0]);calls.MultiplayCloseServer.Invoke(server[0]);calls.CollaborationeditingRoomClose.Invoke(room);
}
bool refused=false;try{calls.MultiplayConnect.Invoke(server[1],"after-close");}catch(Exception){refused=true;}Check(refused,"Owned server is closed and cannot accept another participant");
Console.WriteLine("Collaboration two-client loopback drafts/conflicts/CAS/reconnect/cleanup PASS");return 0;
