System.Text.Json.Nodes.JsonNode J(string text)=>System.Text.Json.Nodes.JsonNode.Parse(text)!;
var surfaces=calls.CreateSurfaces.Invoke(new[]{"Native input A","Native input B"},500,500);var controls=new[]{calls.CreateControls.Invoke(new[]{1,2,3,4}),calls.CreateControls.Invoke(new[]{1,2,3,4})};var hosts=new[]{calls.CreateNative.Invoke(surfaces,0),calls.CreateNative.Invoke(surfaces,1)};var buffers=new string[2][];for(int v=0;v<2;v++)buffers[v]=new[]{calls.CreateText.Invoke("name","Native "+v),calls.CreateText.Invoke("document","one two\nthree four"),calls.CreateText.Invoke("readonly","Synthetic readonly"),calls.CreateText.Invoke("disabled","Synthetic disabled")};bool stop=false;int frames=0;bool visible=true,clipped=false;ConsoleCancelEventHandler interrupt=(_,e)=>{e.Cancel=true;stop=true;};Console.CancelKeyPress+=interrupt;
int Key(int windows,int linux)=>OperatingSystem.IsWindows()?windows:linux;
void Dispatch(int v,int kind,int key,int flags){if(kind==8){stop=true;return;}if(kind!=5||(flags&1)!=0)return;int focus=calls.ControlState.Invoke(controls[v],"query",0)[0];if(key==Key(9,0xFF09)){int next=(flags&4)!=0?focus==1?3:focus-1:focus==3?1:focus+1;calls.NativeFocus.Invoke(hosts[v],controls[v],next);return;}if(key==Key(27,0xFF1B))calls.NativeFocus.Invoke(hosts[v],controls[v],0);
 if(key==Key(115,0xFFC1))clipped=!clipped;
 if(key==Key(112,0xFFBE))calls.NativeFocus.Invoke(hosts[v],controls[v],1);if(key==Key(113,0xFFBF))calls.NativeFocus.Invoke(hosts[v],controls[v],2);if(key==Key(114,0xFFC0)){visible=!visible;if(!visible)foreach(string host in hosts)calls.NativeFrame.Invoke(host,Array.Empty<string>());}if(key==Key(117,0xFFC3))calls.NativeRequest.Invoke(hosts[v],"folder-begin",System.Text.Json.JsonSerializer.Serialize(new{initial=Environment.GetEnvironmentVariable("CONFECTORY_NATIVE_FOLDER")??System.IO.Path.GetTempPath()}),0);
 if(key==Key(118,0xFFC4)){calls.CloseNative.Invoke(hosts[1]);calls.CloseNative.Invoke(hosts[1]);calls.CloseSurfaces.Invoke(surfaces,1);calls.Reopen.Invoke(surfaces,1,"Native input B",500,500);hosts[1]=calls.CreateNative.Invoke(surfaces,1);Console.WriteLine("NATIVE_REOPEN "+hosts[1]);}
 if(key==Key(119,0xFFC5))calls.ReplaceText.Invoke(buffers[v][0],"External model value",8,3);if(key==Key(120,0xFFC6))calls.NativeFocus.Invoke(hosts[v],controls[v],3);
 if(key==Key(121,0xFFC7)){calls.NativeRequest.Invoke(hosts[v],"folder-cancel","{}",0);}
}
foreach(string host in hosts){bool rejected=System.Threading.Tasks.Task.Run(()=>{try{calls.NativeRequest.Invoke(host,"snapshot","{}",0);return false;}catch(InvalidOperationException){return true;}}).GetAwaiter().GetResult();if(!rejected)throw new InvalidOperationException("Foreign thread accepted native UI access");}Console.WriteLine("Native UI creating-thread guard PASS");
try{while(!stop&&calls.SurfaceInfo.Invoke(surfaces)[0]>0){
 var events=calls.Pump.Invoke(surfaces);
 for(int v=0;v<2;v++)if(surfaces[v+1]!=0){var poll=J(calls.NativePoll.Invoke(hosts[v],controls[v]));var nativeEvents=System.Text.Json.JsonSerializer.Deserialize<int[]>(poll["events"]!.ToJsonString())!;for(int n=0;n<nativeEvents.Length;n+=6)Dispatch(v,nativeEvents[n+1],nativeEvents[n+4],nativeEvents[n+5]);}
 for(int n=0;n<events.Length;n+=6)Dispatch(events[n],events[n+1],events[n+4],events[n+5]);
 for(int v=0;v<2;v++)if(surfaces[v+1]!=0){calls.Draw.Invoke(surfaces,v,new[]{0,0,500,500,0x14212B,10,10,480,28,0x314758},new[]{"","Native controls: F1 name, F2 document, F3 hide/show, F6 folder"});var shown=new System.Collections.Generic.List<string>();for(int id=1;id<=4;id++){int[] nativeBounds=new[]{20,50+(id==1?0:id==2?60:id==3?240:300),460,id==2?160:44};var row=J(calls.NativeField.Invoke(hosts[v],controls[v],id,buffers[v][id-1],nativeBounds,id==2?"source":"singleline","",visible,id!=4,id==3));calls.NativeClip.Invoke(hosts[v],row["key"]!.ToString(),clipped&&v==0&&id==1?new[]{20,50,230,44}:nativeBounds);calls.NativeRequest.Invoke(hosts[v],"commands",System.Text.Json.JsonSerializer.Serialize(new{id,keys=new[]{Key(112,0xFFBE),Key(113,0xFFBF),Key(114,0xFFC0),Key(115,0xFFC1),Key(117,0xFFC3),Key(118,0xFFC4),Key(119,0xFFC5),Key(120,0xFFC6),Key(121,0xFFC7)}}),0);shown.Add(row["key"]!.ToString());}calls.NativeFrame.Invoke(hosts[v],visible?shown.ToArray():Array.Empty<string>());var snapshot=new System.Text.Json.Nodes.JsonObject{["fields"]=J(calls.NativeRequest.Invoke(hosts[v],"snapshot","{}",0)),["focus"]=calls.ControlState.Invoke(controls[v],"query",0)[0]};var folder=J(calls.NativeRequest.Invoke(hosts[v],"folder-poll","{}",0));if(folder["state"]!.ToString()!="idle")Console.WriteLine("NATIVE_FOLDER "+folder.ToJsonString());if(frames%10==0)Console.WriteLine("NATIVE_UI "+new System.Text.Json.Nodes.JsonObject{["view"]=v,["clipped"]=clipped,["surface"]=surfaces[v+1].ToString(),["controls"]=controls[v],["host"]=hosts[v],["native"]=snapshot,["values"]=System.Text.Json.JsonSerializer.SerializeToNode(System.Linq.Enumerable.Select(buffers[v],token=>calls.TextSnapshot.Invoke(token)[1]))}.ToJsonString());}
 frames++;System.Threading.Thread.Sleep(15);
}}finally{Console.CancelKeyPress-=interrupt;foreach(string host in hosts)calls.CloseNative.Invoke(host);foreach(var list in buffers)foreach(string token in list)calls.CloseText.Invoke(token);foreach(string surface in controls)calls.CloseControls.Invoke(surface);calls.CloseSurfaces.Invoke(surfaces,-1);Console.WriteLine("Native game controls, dialogs, borrowed buffers and surfaces retired");}return 0;
