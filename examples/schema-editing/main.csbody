void Check(bool value,string message){if(!value)throw new Exception(message);}
foreach(string kind in new[]{"category","concept","function","module","object","schema"})
{
 string declaration=calls.Create.Invoke(kind,"App::Authored");string updated=calls.SetValue.Invoke(declaration,"score","7");var parsed=System.Text.Json.Nodes.JsonNode.Parse(calls.Inspect.Invoke(updated))!;Check(parsed["kind"]!.GetValue<string>()==kind&&parsed["values"]!["score"]!.GetValue<int>()==7,"Authored kind/scalar value");
}
string original="implementation App::Body for App::Function (int number) -> int extends App::Parent { description \"functional\"; module App::Module; provide App::Function with App::Body; use object App::Thing; contain concept App::Idea; import App::Function as Fn (int) -> int in App::Scope; body common \"main.csbody\"; }";
string edited=calls.SetValue.Invoke(original,"flag","true");Check(edited.Contains("(int number) -> int extends App::Parent")&&edited.Contains("import App::Function as Fn (int) -> int in App::Scope;")&&edited.Contains("module App::Module;")&&edited.Contains("provide App::Function with App::Body;"),"Contract/binding/inheritance preservation");
string newDescription="한국어 \"인용\"\n설명";
string described=System.Text.Json.JsonSerializer.Deserialize<string>(calls.Call.Invoke("setDescription",System.Text.Json.JsonSerializer.Serialize(new{text=edited,value=newDescription})))!;
var beforeDescription=System.Text.Json.Nodes.JsonNode.Parse(calls.Inspect.Invoke(edited))!.AsObject();var afterDescription=System.Text.Json.Nodes.JsonNode.Parse(calls.Inspect.Invoke(described))!.AsObject();
Check(afterDescription["description"]!.GetValue<string>()==newDescription,"Description escaping/roundtrip");beforeDescription.Remove("description");afterDescription.Remove("description");beforeDescription["editor"]!.AsObject().Remove("description");afterDescription["editor"]!.AsObject().Remove("description");Check(System.Text.Json.Nodes.JsonNode.DeepEquals(beforeDescription,afterDescription),"Description must preserve identity/signature/relations/values");
System.Text.Json.Nodes.JsonNode Summary(string kind,string before,string after)=>System.Text.Json.Nodes.JsonNode.Parse(calls.Call.Invoke("reviewSummary",System.Text.Json.JsonSerializer.Serialize(new{kind,before,after})))!;
var reviewDescription=Summary("implementation",edited,described);Check(reviewDescription["changes"]!.AsArray().Count==1&&!reviewDescription["additionalChanges"]!.GetValue<bool>(),"Description Review must summarize only exact description without source");
var reviewCreation=Summary("object","","object App::Thing { description \"created\"; value n = 0; }");Check(reviewCreation["changes"]!.AsArray().Count==3&&!reviewCreation["additionalChanges"]!.GetValue<bool>(),"Creation and actual scalar value must be represented");
Check(Summary("object","","object App::Thing { value n = null; }")["additionalChanges"]!.GetValue<bool>(),"Unsupported null metadata must require advanced review rather than fake a semantic change");
Check(Summary("object","object App::Thing { value n = 0; }","object App::Thing { value n = 0.0; description \"changed\"; }")["additionalChanges"]!.GetValue<bool>(),"Numeric representation change must not disappear beside a known description change");
Check(Summary("object","object App::Thing { value a = 0; value b = 1; }","object App::Thing { value b = 1; value a = 0; description \"changed\"; }")["additionalChanges"]!.GetValue<bool>(),"Reordered declaration entries must not disappear beside a known change");
var mixedReview=Summary("object","object App::Thing {}","object App::Thing { description \"changed\"; use schema App::Unknown; }");Check(mixedReview["changes"]!.AsArray().Count==2&&!mixedReview["additionalChanges"]!.GetValue<bool>()&&System.Linq.Enumerable.Single(mixedReview["changes"]!.AsArray(),row=>row!["label"]!.ToString()=="사용 관계")!["after"]![0]!["대상"]!.ToString()=="App::Unknown","Declared relation is represented exactly beside description; existence/link validation remains separate");
Check(Summary("object","object App::Thing {}","object App::Thing {} // changed comment")["additionalChanges"]!.GetValue<bool>()&&Summary("body","return 0;","return 1;")["additionalChanges"]!.GetValue<bool>(),"Unknown comment/body changes require full advanced review");
string quotedDescription=System.Text.Json.JsonSerializer.Deserialize<string>(calls.Call.Invoke("setDescription",System.Text.Json.JsonSerializer.Serialize(new{text=edited,value="https://example.test/ \"quoted\" // description"})))!;Check(!Summary("implementation",edited,quotedDescription)["additionalChanges"]!.GetValue<bool>(),"Description quote/slashes must not be mistaken for source comments");
string emptyDescription=System.Text.Json.JsonSerializer.Deserialize<string>(calls.Call.Invoke("setDescription",System.Text.Json.JsonSerializer.Serialize(new{text=described,value=""})))!;
Check(emptyDescription.Contains("description \"\";")&&System.Text.Json.Nodes.JsonNode.Parse(calls.Inspect.Invoke(emptyDescription))!["description"]!.GetValue<string>()=="","Empty string remains an explicit empty description");
foreach(var badDescription in new[]{"null","7","true","{}"}){bool rejected=false;try{calls.Call.Invoke("setDescription","{\"text\":"+System.Text.Json.JsonSerializer.Serialize(edited)+",\"value\":"+badDescription+"}");}catch(InvalidOperationException){rejected=true;}Check(rejected,"Non-string description must be rejected");}
string module=calls.SetValue.Invoke("module App::Rules { include App::Other; require App::Function (int) -> int; default App::Function with App::Body; }","range","3");Check(module.Contains("require App::Function (int) -> int;")&&module.Contains("default App::Function with App::Body;")&&module.Contains("include App::Other;"),"Module preservation");
var direct=System.Text.Json.Nodes.JsonNode.Parse(calls.Inspect.Invoke("module App::Rules extends Missing::Parent { module Missing::Role; include Missing::Child; require Missing::Function (int) -> int; default Missing::Function with Missing::Body; provide Missing::Function with Missing::Explicit; }"))!["relations"]!;
Check(direct["scope"]!.ToString()=="declared"&&direct["owner"]!.ToString()=="App::Rules"&&direct["edges"]!.AsArray().Count==6,"Direct relation scope/count");
Check(System.Linq.Enumerable.Any(direct["edges"]!.AsArray(),e=>e!["role"]!.ToString()=="default"&&e["target"]!.ToString()=="Missing::Body"&&e["function"]!.ToString()=="Missing::Function"),"Default relation identity");
foreach(var requiredText in new[]{"() -> void","(string,int[],bool) -> string[]","(long[],double,float[]) -> bool"}){
 var required=System.Text.Json.Nodes.JsonNode.Parse(calls.Inspect.Invoke("module App::Rules { require Missing::Function "+requiredText+"; }"))!["relations"]!["edges"]![0]!;
 string named=requiredText.Replace("string,int[],bool","string arg0,int[] arg1,bool arg2",StringComparison.Ordinal).Replace("long[],double,float[]","long[] arg0,double arg1,float[] arg2",StringComparison.Ordinal);
 var signature=System.Text.Json.Nodes.JsonNode.Parse(calls.Inspect.Invoke("function Missing::Function "+named+" {}"))!["signature"];
 Check(required["target"]!.ToString()=="Missing::Function"&&System.Text.Json.Nodes.JsonNode.DeepEquals(required["signature"],signature),"Required function signature differs from existing function format");
}
bool invalid=false;try{calls.SetValue.Invoke(original,"flag","null");}catch(InvalidOperationException){invalid=true;}Check(invalid,"Unsupported null metadata rejected");
string project=Environment.GetEnvironmentVariable("CONFECTORY_TEST_AUTHOR_PROJECT")??throw new Exception("Test project required");var description=System.Text.Json.Nodes.JsonNode.Parse(calls.Describe.Invoke(project))!;Check(description["units"]!.AsArray().Count==4,"Only owned declarations/body described");
Check(calls.Validate.Invoke(project,"portable").Contains("valid"),"Actual structural/compiler validation");
string body=System.IO.Path.Combine(System.IO.Path.GetDirectoryName(project)!,"main.csbody"),before=System.IO.File.ReadAllText(body);
try{System.IO.File.WriteAllText(body,"this is invalid C#;");bool compileFailure=false;try{calls.Validate.Invoke(project,"portable");}catch(InvalidOperationException){compileFailure=true;}Check(compileFailure,"Functional body compile failure detected");}finally{System.IO.File.WriteAllText(body,before);}
string ownedDeclaration=System.IO.Path.Combine(System.IO.Path.GetDirectoryName(project)!,"MainBody.celem"),contract=System.IO.File.ReadAllText(ownedDeclaration);
try{System.IO.File.WriteAllText(ownedDeclaration,contract.Replace("() -> int","() -> long",StringComparison.Ordinal));bool mismatch=false;try{calls.Validate.Invoke(project,"portable");}catch(InvalidOperationException){mismatch=true;}Check(mismatch,"Mismatched public implementation contract rejected");}finally{System.IO.File.WriteAllText(ownedDeclaration,contract);}
string main=System.IO.Path.Combine(System.IO.Path.GetDirectoryName(project)!,"Main.celem"),mainText=System.IO.File.ReadAllText(main);
try{System.IO.File.WriteAllText(main,mainText.Replace("{","{ module App::Absent;",StringComparison.Ordinal));bool moduleFailure=false;try{calls.Validate.Invoke(project,"portable");}catch(InvalidOperationException){moduleFailure=true;}Check(moduleFailure,"Missing module cannot be confirmed");}finally{System.IO.File.WriteAllText(main,mainText);}
Console.WriteLine("SchemaEditing authoring/preservation/compiler PASS");return 0;
