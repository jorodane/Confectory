void Check(bool value,string message){if(!value)throw new Exception(message);}
string pipe="confectory-frame-test-"+Guid.NewGuid().ToString("N"),secret=new string('A',64),handle=Guid.NewGuid().ToString("N");Environment.SetEnvironmentVariable("CONFECTORY_FRAME_PIPE",pipe);Environment.SetEnvironmentVariable("CONFECTORY_FRAME_SECRET",secret);Environment.SetEnvironmentVariable("CONFECTORY_FRAME_HANDLE",handle);
string owner=calls.Open.Invoke(),runtime="";
System.Text.Json.Nodes.JsonNode Wire(string operation,int sequence=0,string? identity=null,string? epoch=null,string? run=null){using var deadline=new System.Threading.CancellationTokenSource(500);using var client=new System.IO.Pipes.NamedPipeClientStream(".",pipe,System.IO.Pipes.PipeDirection.InOut,System.IO.Pipes.PipeOptions.Asynchronous|System.IO.Pipes.PipeOptions.CurrentUserOnly);client.ConnectAsync(deadline.Token).GetAwaiter().GetResult();var request=new System.Text.Json.Nodes.JsonObject{["version"]=1,["request"]=Guid.NewGuid().ToString("N"),["handle"]=run??handle,["runtime"]=epoch??runtime,["secret"]=identity??secret,["operation"]=operation,["sequence"]=sequence};byte[] bytes=System.Text.Encoding.UTF8.GetBytes(request.ToJsonString()),header=new byte[4];System.Buffers.Binary.BinaryPrimitives.WriteInt32LittleEndian(header,bytes.Length);client.Write(header);client.Write(bytes);client.Flush();client.ReadExactlyAsync(header,deadline.Token).AsTask().GetAwaiter().GetResult();int length=System.Buffers.Binary.BinaryPrimitives.ReadInt32LittleEndian(header);Check(length>0&&length<=4096,"Bounded reply");bytes=new byte[length];client.ReadExactlyAsync(bytes,deadline.Token).AsTask().GetAwaiter().GetResult();return System.Text.Json.Nodes.JsonNode.Parse(bytes)!;}
void Reject(Action action,string meaning){bool refused=false;try{action();}catch(Exception error) when(error is System.IO.InvalidDataException or System.IO.IOException or System.OperationCanceledException or System.InvalidOperationException){refused=true;}Check(refused,meaning);}
void Malformed(string value,int size=0){using var deadline=new System.Threading.CancellationTokenSource(500);using var client=new System.IO.Pipes.NamedPipeClientStream(".",pipe,System.IO.Pipes.PipeDirection.InOut,System.IO.Pipes.PipeOptions.Asynchronous|System.IO.Pipes.PipeOptions.CurrentUserOnly);client.ConnectAsync(deadline.Token).GetAwaiter().GetResult();byte[] bytes=System.Text.Encoding.UTF8.GetBytes(value),header=new byte[4];System.Buffers.Binary.BinaryPrimitives.WriteInt32LittleEndian(header,size==0?bytes.Length:size);client.Write(header);client.Write(bytes);client.Flush();Reject(()=>client.ReadExactlyAsync(header,deadline.Token).AsTask().GetAwaiter().GetResult(),"Malformed envelope must close only that connection");}
try{
 Malformed("null");Malformed("[]");Malformed("{}",5000);Malformed("{}");Malformed(new System.Text.Json.Nodes.JsonObject{["version"]=1,["request"]=Guid.NewGuid().ToString("N"),["handle"]=handle,["runtime"]="",["secret"]=secret,["operation"]="pause",["sequence"]=long.MaxValue}.ToJsonString());
 var initial=Wire("observe");runtime=initial["runtime"]!.ToString();Check(initial["frame"]!.ToString()=="0","No invented startup frame");
 Reject(()=>Wire("pause",1,identity:new string('B',64)),"Foreign owner refused");Reject(()=>Wire("observe",epoch:new string('0',32)),"Stale epoch refused");Reject(()=>Wire("observe",run:new string('0',32)),"Cross run refused");Reject(()=>Wire("resume",3),"Out of order command refused");Reject(()=>Wire("step",1),"Must pause before stepping");
 var queued=Wire("pause",1);Check(queued["ack"]!.GetValue<int>()==0&&queued["pending"]!.GetValue<int>()==1,"Pause not acknowledged by transport acceptance");Check(calls.Begin.Invoke(owner)==0,"Pause boundary");Reject(()=>calls.Complete.Invoke(owner),"No frame may be fabricated while paused");
 var paused=Wire("observe");Check(paused["ack"]!.GetValue<int>()==1&&paused["frame"]!.ToString()=="0","Pause acknowledgement reflects actual boundary");
 var step=Wire("step",2);var repeat=Wire("step",2);Check(repeat["pending"]!.GetValue<int>()==2&&repeat["ack"]!.GetValue<int>()==1,"Repeated in-flight Step has one intent");Reject(()=>Wire("resume",3),"Pending Step fences another command");Check(calls.Begin.Invoke(owner)==2,"Step enters one actual callback frame");Check(Wire("observe")["ack"]!.GetValue<int>()==1,"Step ack waits through callbacks");Reject(()=>calls.Begin.Invoke(owner),"Reentrant Begin refused");
 bool threadRejected=false;System.Threading.Tasks.Task.Run(()=>{try{calls.Complete.Invoke(owner);}catch(InvalidOperationException){threadRejected=true;}}).GetAwaiter().GetResult();Check(threadRejected,"Wrong callback thread refused");calls.Tick.Invoke(new long[1]);calls.Complete.Invoke(owner);
 var done=Wire("observe");Check(done["ack"]!.GetValue<int>()==2&&done["frame"]!.ToString()=="1","Only completed callback advances frame/ack");Check(Wire("step",2)["frame"]!.ToString()=="1"&&calls.Begin.Invoke(owner)==0,"Acknowledged repeated Step never runs again");Reject(()=>Wire("pause",1),"Old command sequence refused");
 Wire("resume",3);Check(calls.Begin.Invoke(owner)==1,"Actual resumed frame");System.Threading.Thread.Sleep(2100);Wire("observe");calls.Complete.Invoke(owner);Check(calls.Begin.Invoke(owner)==0,"Reconnect during a long callback still pauses the next boundary");Check(Wire("observe")["frame"]!.ToString()=="2","Long callback completed once before lease pause");
 Wire("step",4);Check(calls.Begin.Invoke(owner)==2,"Start next frame");calls.Close.Invoke(owner);calls.Close.Invoke(owner);Reject(()=>Wire("observe"),"Closing an unfinished frame sends no fabricated ack");
 Console.WriteLine("Actual frame protocol boundary PASS: authenticated handle/epoch, order/repeat/stale rejection, pending versus completed ack, thread/reentrancy, incomplete close");
}finally{calls.Close.Invoke(owner);Environment.SetEnvironmentVariable("CONFECTORY_FRAME_PIPE",null);Environment.SetEnvironmentVariable("CONFECTORY_FRAME_SECRET",null);Environment.SetEnvironmentVariable("CONFECTORY_FRAME_HANDLE",null);}return 0;
