
string checkedRig=calls.Validate.Invoke(rig);var model=System.Text.Json.Nodes.JsonNode.Parse(checkedRig)!;string checkedDefinition=calls.RenderValidate.Invoke(definition);var resolved=System.Text.Json.Nodes.JsonNode.Parse(calls.Resolve.Invoke(checkedDefinition))!;if(resolved["rig"]?.ToString()!=model["id"]!.ToString())throw new ArgumentException("Resolved Object/common Rig must match selected Rig document");var ids=new System.Collections.Generic.HashSet<string>(System.Linq.Enumerable.Select(model["joints"]!.AsArray(),x=>x!["id"]!.ToString()),StringComparer.Ordinal);foreach(var layer in resolved["layers"]!.AsArray())foreach(var joint in layer!["bones"]!.AsArray())if(!ids.Contains(joint!.ToString()))throw new ArgumentException("Layer refers to unknown Rig joint");foreach(var action in resolved["actions"]!.AsArray())if(action!["motion"] is not null){string id=action["motion"]!.ToString();var motion=System.Linq.Enumerable.SingleOrDefault(model["actions"]!.AsArray(),x=>x!["id"]!.ToString()==id);if(motion is null||motion["meaning"]!.ToString()!=action["meaning"]!.ToString())throw new ArgumentException("Motion must preserve resolved Action meaning");}return new System.Text.Json.Nodes.JsonObject{["schemaVersion"]=1,["rig"]=System.Text.Json.Nodes.JsonNode.Parse(checkedRig),["definition"]=System.Text.Json.Nodes.JsonNode.Parse(checkedDefinition),["resolved"]=resolved}.ToJsonString();

