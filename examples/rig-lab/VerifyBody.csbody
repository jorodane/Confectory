
System.Text.Json.Nodes.JsonNode Json(string text)=>System.Text.Json.Nodes.JsonNode.Parse(text)!;
void Check(bool condition,string reason){if(!condition)throw new Exception(reason);}void Near(double a,double b,string reason){Check(Math.Abs(a-b)<1e-4,reason+": "+a+" expected "+b);}void Reject(Action action,string reason){bool rejected=false;try{action();}catch(ArgumentException){rejected=true;}Check(rejected,reason);}
string rig=calls.Validate.Invoke(calls.Fixture.Invoke()),definition=calls.RenderValidate.Invoke(calls.RenderFixture.Invoke());var parsed=Json(rig);var visual=Json(calls.Resolve.Invoke(definition));Check(visual["rig"]!.ToString()==parsed["id"]!.ToString(),"common Rig inherited");Check(visual["layers"]!.AsArray().Count==2&&parsed["joints"]!.AsArray().Count==5,"independent groups, not layers per bone");Check(visual["style"]!["visual"]!.ToString()=="geometric compartment"&&visual["style"]!["line"]!.ToString()=="bold","style rules override independently");Check(visual["actions"]!.AsArray().Count==2&&visual["concept"]!["harness"]!["structure"] is not null,"base actions/object/optional harness preserved");
var start=Json(calls.Evaluate.Invoke(rig,"Open",0,false));var mid=Json(calls.Evaluate.Invoke(rig,"Open",.5,false));var end=Json(calls.Evaluate.Invoke(rig,"Open",1,false));System.Text.Json.Nodes.JsonNode Joint(System.Text.Json.Nodes.JsonNode pose,string id)=>System.Linq.Enumerable.Single(pose["joints"]!.AsArray(),n=>n!["id"]!.ToString()==id)!;
Near(mid["fraction"]!.GetValue<double>(),.5,"symmetric Bezier timing");Near(Joint(mid,"clamp")["worldPosition"]![0]!.GetValue<double>(),Math.Sqrt(.5)*.8,"parent quaternion interpolation");Near(Joint(mid,"clamp")["worldPosition"]![1]!.GetValue<double>(),.2+Math.Sqrt(.5)*1.2,"parent rotation hierarchy");Near(Joint(mid,"clamp")["worldPosition"]![2]!.GetValue<double>(),.9,"depth interpolation");Check(Joint(start,"clamp").ToJsonString()!=Joint(end,"clamp").ToJsonString(),"real pose motion");Near(Joint(Json(calls.Evaluate.Invoke(rig,"Open",2,true)),"clamp")["worldPosition"]![0]!.GetValue<double>(),1,"loop returns first pose");Near(Joint(Json(calls.Evaluate.Invoke(rig,"Open",1000000000,false)),"clamp")["worldPosition"]![0]!.GetValue<double>(),1,"nonloop clamps duration");var front=Json(calls.Project.Invoke(mid.ToJsonString(),"front"));var side=Json(calls.Project.Invoke(mid.ToJsonString(),"side"));Near(Joint(side,"clamp")["x"]!.GetValue<double>(),.9,"same 3D pose side projection");Near(Joint(front,"clamp")["depth"]!.GetValue<double>(),.9,"front retains depth");
var invalid=parsed.DeepClone();invalid["joints"]![2]!["parent"]="clamp";Reject(()=>calls.Validate.Invoke(invalid.ToJsonString()),"cyclic hierarchy");invalid=parsed.DeepClone();invalid["joints"]![1]!["parent"]="missing";Reject(()=>calls.Validate.Invoke(invalid.ToJsonString()),"missing parent");invalid=parsed.DeepClone();invalid["actions"]![1]!["keyPoses"]![0]!["transforms"]!["boom"]!["rotation"]=System.Text.Json.JsonSerializer.SerializeToNode(new[]{0,0,0,0});Reject(()=>calls.Validate.Invoke(invalid.ToJsonString()),"nonunit quaternion");invalid=parsed.DeepClone();invalid["actions"]![1]!["keyPoses"]![0]!["transforms"]!["boom"]!["scale"]=System.Text.Json.JsonSerializer.SerializeToNode(new[]{1,-1,1});Reject(()=>calls.Validate.Invoke(invalid.ToJsonString()),"negative scale");invalid=parsed.DeepClone();invalid["actions"]![1]!["deltas"]![0]!["duration"]=0;Reject(()=>calls.Validate.Invoke(invalid.ToJsonString()),"invalid segment duration");invalid=parsed.DeepClone();invalid["actions"]![1]!["deltas"]![0]!["easing"]=System.Text.Json.JsonSerializer.SerializeToNode(new[]{.9,0,.1,1});Reject(()=>calls.Validate.Invoke(invalid.ToJsonString()),"nonmonotone timing curve");Reject(()=>calls.Evaluate.Invoke(rig,"Open",double.NaN,false),"nonfinite time");Reject(()=>calls.Project.Invoke(mid.ToJsonString(),"perspective"),"unsupported projection explicit");
var render=Json(definition);invalid=render.DeepClone();invalid["categories"]![0]!["parent"]="Compartment";Reject(()=>calls.RenderValidate.Invoke(invalid.ToJsonString()),"category cycle");invalid=render.DeepClone();invalid["object"]!["actions"]=new System.Text.Json.Nodes.JsonArray(new System.Text.Json.Nodes.JsonObject{["id"]="Open",["meaning"]="different meaning"});Reject(()=>calls.RenderValidate.Invoke(invalid.ToJsonString()),"action meaning cannot silently change");invalid=render.DeepClone();invalid["categories"]![1]!["layers"]![0]!["order"]=0;Reject(()=>calls.RenderValidate.Invoke(invalid.ToJsonString()),"ambiguous layer order");render["object"]!.AsObject().Remove("concept");calls.RenderValidate.Invoke(render.ToJsonString());Check(!Json(calls.RigCapabilities.Invoke())["skinning"]!.GetValue<bool>(),"production skinning absence explicit");
Console.WriteLine("Rig/Motion 3D hierarchy, quaternion/duration/Bezier, coherent projections, inherited render meaning/layers, invalid-domain PASS");return 0;

