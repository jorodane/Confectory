project Example.RigAsset version "0.1.0" {
entry Example.RigAsset::Main;
registry Confectory.RigMotion "../../../packs/rig-motion/pack.cpack";
dependency Confectory.RigMotion version "0.1.0";
registry Confectory.RenderAuthoring "../../../packs/render-authoring/pack.cpack";
dependency Confectory.RenderAuthoring version "0.1.0";
registry Confectory.Build.DotNet "../../../targets/dotnet/pack.cpack";
dependency Confectory.Build.DotNet version "0.1.0";
target linux Confectory.Build.DotNet::Linux;
target windows Confectory.Build.DotNet::Portable;
target android Confectory.Build.DotNet::Portable;
element Main function "Main.celem";
element MainBody implementation "MainBody.celem";
element Rig object "Rig.celem";
element Render object "Render.celem";
}
