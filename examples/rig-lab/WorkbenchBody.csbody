
System.Text.Json.Nodes.JsonNode Json(string text)=>System.Text.Json.Nodes.JsonNode.Parse(text)!;
void Check(bool condition,string reason){if(!condition)throw new Exception(reason);}
string project=Environment.GetEnvironmentVariable("CONFECTORY_RIG_AUTHOR_PROJECT")??throw new ArgumentException("Select an explicit owned Rig asset ProjectPack using CONFECTORY_RIG_AUTHOR_PROJECT; do not edit the repository sample implicitly");bool gui=Environment.GetEnvironmentVariable("CONFECTORY_RIG_MODE")=="ui";string rigID="Example.RigAsset::Rig",renderID="Example.RigAsset::Render",participant="rig-author",context="rig-workbench";string workspace="",other="";var scenes=new[]{"",""};var tokens=new[]{Array.Empty<string>(),Array.Empty<string>()};System.Threading.Tasks.Task<string[]>? job=null;string scope="rig-confirm-"+Guid.NewGuid().ToString("N");int stop=0;string status="ready";string rig="",definition="";
string Document(string session,string id)=>Json(calls.Inspect.Invoke(calls.WorkspaceRead.Invoke(session,id)[3]))["values"]!["document"]!.GetValue<string>();
void ReadDocuments(){rig=Document(workspace,rigID);definition=Document(workspace,renderID);calls.Compose.Invoke(rig,definition);}
void Subscribe(){for(int n=0;n<2;n++)if(scenes[n]!="")tokens[n]=calls.WorkspaceSubscribe.Invoke(workspace,rigID);}
void Unsubscribe(){foreach(var token in tokens)if(token.Length>0)calls.WorkspaceUnsubscribe.Invoke(token);tokens=new[]{Array.Empty<string>(),Array.Empty<string>()};}
void Reload(){Unsubscribe();calls.WorkspaceClose.Invoke(workspace);workspace=calls.WorkspaceOpen.Invoke(project,participant,context);calls.SaveRestore.Invoke(workspace);ReadDocuments();Subscribe();status="saved draft reloaded";}
void Edit(int key){var model=Json(rig);var visual=Json(definition);if(key==72||key==104){var joint=model["joints"]![3]!;joint["parent"]=joint["parent"]!.ToString()=="boom"?"tower":"boom";}if(key==80||key==112){var pose=model["actions"]![1]!["keyPoses"]![1]!["transforms"]!["clamp"]!;var translation=pose["translation"]!.AsArray();translation[2]=translation[2]!.GetValue<double>()+.15;}if(key==68||key==100){var delta=model["actions"]![1]!["deltas"]![0]!;delta["duration"]=delta["duration"]!.GetValue<double>()+.1;}if(key==76||key==108){var layer=visual["categories"]![1]!["layers"]![0]!;layer["visible"]=!layer["visible"]!.GetValue<bool>();}if(key==79||key==111){var baseLayer=visual["categories"]![0]!["layers"]![0]!;var toolLayer=visual["categories"]![1]!["layers"]![0]!;int order=baseLayer["order"]!.GetValue<int>();baseLayer["order"]=toolLayer["order"]!.GetValue<int>();toolLayer["order"]=order;}string candidateRig=model.ToJsonString(),candidateDefinition=visual.ToJsonString();calls.Compose.Invoke(candidateRig,candidateDefinition);if(candidateRig!=rig)calls.WorkspaceSetValue.Invoke(workspace,rigID,"document",System.Text.Json.JsonSerializer.Serialize(candidateRig));if(candidateDefinition!=definition)calls.WorkspaceSetValue.Invoke(workspace,renderID,"document",System.Text.Json.JsonSerializer.Serialize(candidateDefinition));ReadDocuments();status="validated local draft";}
ConsoleCancelEventHandler interrupt=(_,args)=>{args.Cancel=true;System.Threading.Interlocked.Exchange(ref stop,1);};Console.CancelKeyPress+=interrupt;
try{
 workspace=calls.WorkspaceOpen.Invoke(project,participant,context);ReadDocuments();scenes[0]=calls.SceneCreate.Invoke(workspace,"A","front",gui,rig,definition);scenes[1]=calls.SceneCreate.Invoke(workspace,"B","side",gui,rig,definition);Subscribe();
 if(!gui){
  string original=calls.WorkspaceRead.Invoke(workspace,rigID)[3];other=calls.WorkspaceOpen.Invoke(project,"independent-author",context);string otherOriginal=Document(other,rigID);var first=Json(calls.SceneFrame.Invoke(scenes[0],rig,definition,"Open",.5,false,status));var comparison=Json(calls.SceneFrame.Invoke(scenes[1],rig,definition,"Open",1,false,status));Check(first["scene"]!.ToString()!=comparison["scene"]!.ToString()&&first["plane"]!.ToString()!=comparison["plane"]!.ToString(),"independent View owners and pose/projection");
  Edit(72);Edit(80);Edit(68);Edit(76);Edit(79);Check(Document(other,rigID)==otherOriginal,"other workspace participant retains independent draft");Check(calls.WorkspacePoll.Invoke(tokens[0]).Length==7&&calls.WorkspacePoll.Invoke(tokens[0]).Length==0&&calls.WorkspacePoll.Invoke(tokens[1]).Length==7,"exact shared-model subscriptions independent per View");string changed=rig;string changedDefinition=definition;string saved=calls.SaveWrite.Invoke(workspace);Check(System.IO.File.Exists(saved)&&System.IO.File.ReadAllText(System.IO.Path.Combine(System.IO.Path.GetDirectoryName(project)!,"Rig.celem"))==original,"Save persists draft without changing final source");string stableB=scenes[1];calls.SceneClose.Invoke(scenes[0]);calls.WorkspaceUnsubscribe.Invoke(tokens[0]);Check(calls.WorkspacePoll.Invoke(tokens[0]).Length==0,"closed View subscription ignores late callbacks");scenes[0]="";calls.SceneFrame.Invoke(scenes[1],rig,definition,"Open",.5,false,status);scenes[0]=calls.SceneCreate.Invoke(workspace,"A","front",false,rig,definition);Reload();Check(rig==changed&&definition==changedDefinition&&scenes[1]==stableB,"hierarchy/KeyPose/duration/layers reload without recreating comparison View");Check(Json(calls.SceneFrame.Invoke(scenes[1],rig,definition,"Open",.5,false,status))["scene"]!.ToString()==stableB,"persistent comparison surface/model");
  var invalid=Json(rig);invalid["joints"]![2]!["parent"]="clamp";invalid["joints"]![3]!["parent"]="boom";calls.WorkspaceSetValue.Invoke(workspace,rigID,"document",System.Text.Json.JsonSerializer.Serialize(invalid.ToJsonString()));bool rejected=false;try{calls.Compose.Invoke(Document(workspace,rigID),definition);}catch(ArgumentException){rejected=true;}Check(rejected&&System.IO.File.ReadAllText(System.IO.Path.Combine(System.IO.Path.GetDirectoryName(project)!,"Rig.celem"))==original,"domain-invalid draft cannot reach Confirm or alter final source");calls.WorkspaceSetValue.Invoke(workspace,rigID,"document",System.Text.Json.JsonSerializer.Serialize(changed));ReadDocuments();calls.Compose.Invoke(rig,definition);var confirmed=calls.Confirm.Invoke(workspace,new[]{rigID,renderID},"linux");Check(confirmed[0]=="confirmed","actual Rig/Render source Confirm/build: "+string.Join("|",confirmed));Check(calls.WorkspaceRead.Invoke(workspace,rigID)[6]=="clean"&&calls.WorkspaceRead.Invoke(workspace,renderID)[6]=="clean","selected Confirm accepts both models");string committed=Json(calls.Inspect.Invoke(System.IO.File.ReadAllText(System.IO.Path.Combine(System.IO.Path.GetDirectoryName(project)!,"Rig.celem"))))["values"]!["document"]!.GetValue<string>();Check(committed==changed,"confirmed source roundtrip preserves authored hierarchy and KeyPoses");calls.SceneFrame.Invoke(scenes[1],rig,definition,"Open",.5,false,status);Console.WriteLine("Rig workspace hierarchy/KeyPose/duration/layer edit, Save/reload, domain validation, actual Confirm, comparison ownership/close/reopen PASS");return 0;
 }
 Console.WriteLine("RIG_UI ready workbench");double[] at={0,1},previousAt={0,1};bool[] play={true,false};var clock=new double[3];var watch=System.Diagnostics.Stopwatch.StartNew();double prior=watch.Elapsed.TotalSeconds;
 while(System.Threading.Volatile.Read(ref stop)==0&&System.Linq.Enumerable.Any(scenes,x=>x!="")){
  if(job is not null&&job.IsCompleted){var result=job.GetAwaiter().GetResult();status=result[0];Console.WriteLine("RIG_UI confirm "+string.Join("|",result));job=null;ReadDocuments();for(int n=0;n<2;n++)if(scenes[n]==""&&tokens[n].Length>0){calls.WorkspaceUnsubscribe.Invoke(tokens[n]);tokens[n]=Array.Empty<string>();}}
  for(int view=0;view<2;view++){if(scenes[view]=="")continue;var input=calls.SceneInput.Invoke(scenes[view]);for(int n=0;n<input.Length;n+=6){int type=input[n+1],key=input[n+4];if(type==8||(type==5&&(key==81||key==113))){calls.SceneClose.Invoke(scenes[view]);scenes[view]="";if(job is null){calls.WorkspaceUnsubscribe.Invoke(tokens[view]);tokens[view]=Array.Empty<string>();}break;}if(type!=5)continue;if(key==32){play[view]=!play[view];previousAt[view]=at[view];}if(key==37||key==0xff51){at[view]=Math.Max(0,at[view]-.1);previousAt[view]=at[view];}if(key==39||key==0xff53){at[view]+=.1;previousAt[view]=at[view];}if(job is not null)continue;try{if(key==83||key==115){calls.SaveWrite.Invoke(workspace);status="draft saved";}else if(key==82||key==114)Reload();else if(key==67||key==99){ReadDocuments();calls.Compose.Invoke(rig,definition);string captured=workspace;job=System.Threading.Tasks.Task.Run(()=>{calls.BeginScope.Invoke(scope);try{return calls.Confirm.Invoke(captured,new[]{rigID,renderID},"linux");}catch(Exception error){return new[]{"cancelled-or-failed",error.GetType().Name};}finally{calls.EndScope.Invoke();}});status="confirming; draft edits paused";}else if(key==72||key==104||key==80||key==112||key==68||key==100||key==76||key==108||key==79||key==111)Edit(key);}catch(ArgumentException error){status="domain-invalid: "+error.GetType().Name;}}}
  if(job is null){ReadDocuments();foreach(var token in tokens)if(token.Length>0)calls.WorkspacePoll.Invoke(token);}double now=watch.Elapsed.TotalSeconds;var plan=calls.Advance.Invoke(clock,now-prior,0,1.0/60,.01,8);prior=now;for(int view=0;view<2;view++){if(scenes[view]=="")continue;if(play[view])for(int tick=0;tick<(int)plan[2];tick++){previousAt[view]=at[view];at[view]+=plan[7];}else previousAt[view]=at[view];double display=play[view]?previousAt[view]+(at[view]-previousAt[view])*plan[3]:at[view];if(plan[1]!=0){string frame=calls.SceneFrame.Invoke(scenes[view],rig,definition,"Open",display,play[view],status);if(Environment.GetEnvironmentVariable("CONFECTORY_RIG_TRACE")=="1")Console.WriteLine("RIG_UI snapshot "+view+" "+new System.Text.Json.Nodes.JsonObject{["status"]=status,["playing"]=play[view],["snapshot"]=Json(frame)}.ToJsonString());}}
  Console.Out.Flush();System.Threading.Thread.Sleep(5);
 }
 return 0;
}finally{
 Console.CancelKeyPress-=interrupt;if(job is not null){if(!job.IsCompleted)calls.Cancel.Invoke(scope);try{job.GetAwaiter().GetResult();}catch(Exception){}job=null;}Unsubscribe();foreach(string scene in scenes)if(scene!="")calls.SceneClose.Invoke(scene);if(workspace!="")calls.WorkspaceClose.Invoke(workspace);if(other!="")calls.WorkspaceClose.Invoke(other);Console.WriteLine("Rig workbench cleanup complete");}

