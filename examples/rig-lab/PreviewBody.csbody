
string rig=calls.Fixture.Invoke(),definition=calls.RenderFixture.Invoke();string scene="";bool gui=Environment.GetEnvironmentVariable("CONFECTORY_RIG_MODE")=="ui";try{scene=calls.SceneCreate.Invoke("standalone-preview","preview","front",gui,rig,definition);if(!gui){string before=calls.SceneFrame.Invoke(scene,rig,definition,"Open",0,false,"independent motion preview"),after=calls.SceneFrame.Invoke(scene,rig,definition,"Open",.5,false,"independent motion preview");if(before==after)throw new Exception("Motion preview did not update");Console.WriteLine("Independent Rig/Motion preview real hierarchy/frame PASS; no Stage/physics/Helper");return 0;}int stop=0;ConsoleCancelEventHandler interrupt=(_,args)=>{args.Cancel=true;System.Threading.Interlocked.Exchange(ref stop,1);};Console.CancelKeyPress+=interrupt;double at=0,previousAt=0;bool play=true;var clock=new double[3];var watch=System.Diagnostics.Stopwatch.StartNew();double prior=watch.Elapsed.TotalSeconds;try{Console.WriteLine("RIG_UI ready preview");while(System.Threading.Volatile.Read(ref stop)==0){bool close=false;var input=calls.SceneInput.Invoke(scene);for(int n=0;n<input.Length;n+=6){int type=input[n+1],key=input[n+4];if(type==8||(type==5&&(key==81||key==113)))close=true;if(type==5&&key==32){play=!play;previousAt=at;}if(type==5&&(key==37||key==0xff51)){at=Math.Max(0,at-.1);previousAt=at;}if(type==5&&(key==39||key==0xff53)){at+=.1;previousAt=at;}}if(close)break;double now=watch.Elapsed.TotalSeconds;var plan=calls.Advance.Invoke(clock,now-prior,0,1.0/60,.01,8);prior=now;if(play)for(int tick=0;tick<(int)plan[2];tick++){previousAt=at;at+=plan[7];}else previousAt=at;double display=play?previousAt+(at-previousAt)*plan[3]:at;if(plan[1]!=0){string frame=calls.SceneFrame.Invoke(scene,rig,definition,"Open",display,true,"independent motion preview");if(Environment.GetEnvironmentVariable("CONFECTORY_RIG_TRACE")=="1")Console.WriteLine("RIG_UI snapshot preview "+frame);}Console.Out.Flush();System.Threading.Thread.Sleep(5);}}finally{Console.CancelKeyPress-=interrupt;}return 0;}finally{if(scene!="")calls.SceneClose.Invoke(scene);Console.WriteLine("Rig preview cleanup complete");}

