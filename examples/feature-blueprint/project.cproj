project Example.FeatureBlueprint version "0.1.0" {
entry Example.FeatureBlueprint::Main;
registry Confectory.Build.DotNet "../../targets/dotnet/pack.cpack";
dependency Confectory.Build.DotNet version "0.1.0";
target portable Confectory.Build.DotNet::Portable;
element Main function "Main.celem";
element MainBody implementation "MainBody.celem";
element Add function "Add.celem";
element AddBody implementation "AddBody.celem";
}
