void Check(bool condition,string why){if(!condition)throw new Exception(why);}System.Text.Json.Nodes.JsonNode Json(string text)=>System.Text.Json.Nodes.JsonNode.Parse(text)!;
string project=Environment.GetEnvironmentVariable("CONFECTORY_CONTEXT_PROJECT")??throw new InvalidOperationException("Explicit private fixture required");string workspace=calls.EditWorkspaceOpen.Invoke(project,"alice","context-tools"),table="",projection="",box="";long[] surfaces=Array.Empty<long>();bool captureRan=false;try{
