n)).AsArray().Count==0,"AI author updates own local projection without separate AI call");var confirmed=calls.InstantTableConfirm.Invoke(table,new[]{id},"portable");Check(confirmed[0]=="confirmed","table uses actual existing ChangeSet validation/Confirm");Console.WriteLine("Context tools shared table/semantic capture/"+(captureRan?"actual scoped pixels":"capture not run")+"/batched read-only projection/real Confirm PASS");return 0;
}finally{if(surfaces.Length>0)calls.WindowClose.Invoke(surfaces,-1);if(box!="")calls.YogiBoxDiscard.Invoke(box);if(projection!="")calls.AlgorithmProjectionClose.Invoke(projection);if(table!="")calls.InstantTableClose.Invoke(table);calls.EditWorkspaceClose.Invoke(workspace);}
