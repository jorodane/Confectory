box=calls.YogiBoxCreate.Invoke();calls.YogiBoxExactly.Invoke(box,workspace,new[]{id},new[]{"count"});var semantic=Json(calls.YogiBoxSnapshot.Invoke(box))["items"]![0]!;Check(semantic["id"]!.GetValue<string>()==id&&semantic["metadata"]!["count"]!.GetValue<int>()==7&&!semantic.ToJsonString().Contains("object Example",StringComparison.Ordinal),"semantic IDs/selected metadata, no raw source export");calls.YogiBoxText.Invoke(box,"selected counter");calls.YogiBoxSeal.Invoke(box,true);string receipt=calls.YogiBoxHandoff.Invoke(box,"local-inspector");calls.YogiBoxRemove.Invoke(box,semantic["item"]!.GetValue<string>());Check(Json(calls.YogiBoxSnapshot.Invoke(box))["sealed"]!.GetValue<bool>()==false,"per-item removal unseals");Check(Json((string)AppDomain.CurrentDomain.GetData("Example.ContextTools.Receipt."+receipt)!)["items"]!.AsArray().Count==1,"delivered snapshot immutable");calls.YogiBoxDiscard.Invoke(box);calls.YogiBoxDiscard.Invoke(box);box=calls.YogiBoxCreate.Invoke();bool empty=false;try{calls.YogiBoxSeal.Invoke(box,true);}catch(InvalidOperationException){empty=true;}Check(empty,"empty package cannot seal");
if(!string.IsNullOrEmpty(Environment.GetEnvironmentVariable("DISPLAY"))){surfaces=calls.WindowCreateSurfaces.Invoke(new[]{"Confectory Bounded Capture Probe"},128,128);calls.RenderInputDraw.Invoke(surfaces,0,new[]{0,0,128,128,0x202020,10,10,24,24,0xCC0000},new[]{"",""});string image=calls.WindowCapture.Invoke(surfaces,0,12,12,4,4);var captured=Json(image);byte[] pixels=Convert.FromBase64String(captured["pixels"]!.GetValue<string>());Check(pixels.Length==48&&pixels[0]==204&&pixels[1]==0&&pixels[2]==0,"actual selected X11 pixels");string ticket=calls.YogiBoxReserveCapture.Invoke(box,captured["source"]!.GetValue<string>(),0,12,12,4,4);calls.YogiBoxRemove.Invoke(box,ticket);Check(!calls.YogiBoxCompleteCapture.Invoke(box,ticket,image),"removed pending capture cannot reappear");ticket=calls.YogiBoxReserveCapture.Invoke(box,captured["source"]!.GetValue<string>(),0,12,12,4,4);calls.YogiBoxDiscard.Invoke(box);Check(!calls.YogiBoxCompleteCapture.Invoke(box,ticket,image),"discard rejects late capture");captureRan=true;box=calls.YogiBoxCreate.Invoke();ticket=calls.YogiBoxReserveCapture.Invoke(box,captured["source"]!.GetValue<string>(),0,12,12,4,4);Check(calls.YogiBoxCompleteCapture.Invoke(box,ticket,image),"scoped capture admitted");bool bounds=false;try{calls.WindowCapture.Invoke(surfaces,0,126,126,4,4);}catch(ArgumentException){bounds=true;}Check(bounds,"capture cannot disclose pixels outside client scope");calls.WindowClose.Invoke(surfaces,0);bool closed=false;try{calls.WindowCapture.Invoke(surfaces,0,0,0,4,4);}catch(InvalidOperationException){closed=true;}Check(closed,"closed source reports failure without crash");calls.WindowClose.Invoke(surfaces,-1);surfaces=Array.Empty<long>();}
