void Check(bool condition,string why){if(!condition)throw new Exception(why);}System.Text.Json.Nodes.JsonNode Json(string text)=>System.Text.Json.Nodes.JsonNode.Parse(text)!;
string project=Environment.GetEnvironmentVariable("CONFECTORY_COMPARISON_PROJECT")??throw new InvalidOperationException("Explicit owned child project required");string view=calls.ExecutionComparisonCreate.Invoke(false,"");try{
string[] keys={"CONFECTORY_GAME_MODE","CONFECTORY_GAME_PROJECT"};string[] values={"mechanics-test",project};string first=calls.ExecutionComparisonLaunch.Invoke(view,"first",project,"Example.HarvestGame::Main","linux",keys,values),second=calls.ExecutionComparisonLaunch.Invoke(view,"second",project,"Example.HarvestGame::Main","linux",keys,values);Check(first!=second,"stable isolated handles");string a="",b="";for(int i=0;i<12000;i++){var snapshot=Json(calls.ExecutionComparisonSnapshot.Invoke(view));var rows=snapshot["cases"]!.AsArray();Check(rows[0]!["handle"]!.GetValue<string>()==first&&rows[1]!["handle"]!.GetValue<string>()==second,"snapshot preserves handle identity");if(System.Linq.Enumerable.All(rows,row=>row!["state"]!.GetValue<string>()=="exited")){a=string.Join("\n",calls.ExecutionComparisonOutput.Invoke(view,"first"));b=string.Join("\n",calls.ExecutionComparisonOutput.Invoke(view,"second"));break;}if(System.Linq.Enumerable.Any(rows,row=>row!["state"]!.GetValue<string>()=="failed"))throw new Exception(snapshot.ToJsonString());System.Threading.Thread.Sleep(10);}
Check(a.Contains("repeated flows PASS",StringComparison.Ordinal)&&b.Contains("repeated flows PASS",StringComparison.Ordinal),"both real declared-game executions finished");string Instance(string output){string line=System.Linq.Enumerable.First(output.Split('\n'),line=>line.StartsWith("{\"event\"",StringComparison.Ordinal));return Json(line)["instance"]!.GetValue<string>();}Check(Instance(a)!=Instance(b),"world models independently owned");Check(a.Contains("\"case\":\"first\"",StringComparison.Ordinal)&&b.Contains("\"case\":\"second\"",StringComparison.Ordinal),"explicit case routing");calls.ExecutionComparisonStop.Invoke(view,"first");calls.ExecutionComparisonClose.Invoke(view);calls.ExecutionComparisonClose.Invoke(view);view=calls.ExecutionComparisonCreate.Invoke(false,"");Check(Json(calls.ExecutionComparisonSnapshot.Invoke(view))["cases"]!.AsArray().Count==0,"reopened view has no retained child ownership");Console.WriteLine("Execution comparison actual isolated game models stable handles repeated close/reopen PASS");
string? input=Environment.GetEnvironmentVariable("CONFECTORY_COMPARISON_TEST_INPUT");if(input is not null){Check(!string.IsNullOrEmpty(Environment.GetEnvironmentVariable("DISPLAY")),"Live shared-input gate needs actual X11");calls.ExecutionComparisonClose.Invoke(view);calls.FileStreamWriteAtomic.Invoke(input,"{\"commands\":[]}");view=calls.ExecutionComparisonCreate.Invoke(true,input);Check(Json(calls.ExecutionComparisonSnapshot.Invoke(view))["sharedInput"]!.GetValue<bool>(),"explicit shared policy");string[] sharedKeys={"CONFECTORY_GAME_MODE","CONFECTORY_GAME_PROJECT","CONFECTORY_GAME_X","CONFECTORY_GAME_Y"};calls.ExecutionComparisonLaunch.Invoke(view,"shared-first",project,"Example.HarvestGame::Main","linux",sharedKeys,new[]{"",project,"10","405"});calls.ExecutionComparisonLaunch.Invoke(view,"shared-second",project,"Example.HarvestGame::Main","linux",sharedKeys,new[]{"",project,"510","405"});
void Wait(string state){for(int attempt=0;attempt<18000;attempt++){var current=Json(calls.ExecutionComparisonSnapshot.Invoke(view));var cases=current["cases"]!.AsArray();if(System.Linq.Enumerable.Any(cases,row=>row!["state"]!.GetValue<string>()=="failed"))throw new Exception(current.ToJsonString());if(System.Linq.Enumerable.All(cases,row=>row!["state"]!.GetValue<string>()==state))return;System.Threading.Thread.Sleep(10);}throw new Exception("Shared case state timeout: "+calls.ExecutionComparisonSnapshot.Invoke(view));}
Wait("running");string commands="{\"commands\":[{\"id\":\"harvest-1\",\"operation\":\"harvest\"},{\"id\":\"craft-1\",\"operation\":\"craft\"},{\"id\":\"throw-1\",\"operation\":\"throw\"}]";calls.FileStreamWriteAtomic.Invoke(input,commands+"}");var firstLog=new System.Text.StringBuilder();var secondLog=new System.Text.StringBuilder();void Drain(){foreach(string line in calls.ExecutionComparisonOutput.Invoke(view,"shared-first"))firstLog.AppendLine(line);foreach(string line in calls.ExecutionComparisonOutput.Invoke(view,"shared-second"))secondLog.AppendLine(line);Check(firstLog.Length<=65536&&secondLog.Length<=65536,"bounded gate diagnostics");}bool burst=false;for(int attempt=0;attempt<3000;attempt++){Drain();if(firstLog.ToString().Contains("phase-burst",StringComparison.Ordinal)&&secondLog.ToString().Contains("phase-burst",StringComparison.Ordinal)){burst=true;break;}System.Threading.Thread.Sleep(10);}Check(burst,"both simulations must reach their fuse effect; no wall-time assumption");calls.FileStreamWriteAtomic.Invoke(input,commands+",\"label\":\"same intent IDs in a new snapshot\"}");System.Threading.Thread.Sleep(100);calls.FileStreamWriteAtomic.Invoke(input,commands+",\"close\":true}");Wait("exited");Drain();string firstOutput=firstLog.ToString(),secondOutput=secondLog.ToString();
foreach(string output in new[]{firstOutput,secondOutput}){foreach(string intent in new[]{"harvest-applied","craft-applied","throw-applied"})Check(output.Split(intent,StringSplitOptions.None).Length==2,"explicit shared intent applies once per isolated model");Check(output.Contains("phase-burst",StringComparison.Ordinal)&&output.Contains("game owner cleanup complete",StringComparison.Ordinal),"both actual shared-input games advanced fuse/effect and cleaned up");}Check(Instance(firstOutput)!=Instance(secondOutput),"sharing intents never shares model identity");Console.WriteLine("Execution comparison explicit shared-input actual games no duplicate intents independent models cleanup PASS");}return 0;
}finally{calls.ExecutionComparisonClose.Invoke(view);}
