
string configuration="{\"initial\":\"game\",\"groups\":[{\"id\":\"game\",\"controls\":[1]},{\"id\":\"inventory\",\"controls\":[1,2]}],\"bindings\":[{\"id\":\"inventory-win\",\"group\":\"*\",\"key\":9,\"action\":\"toggle\",\"target\":\"inventory\",\"priority\":100,\"text\":false},{\"id\":\"inventory-x11\",\"group\":\"*\",\"key\":65289,\"action\":\"toggle\",\"target\":\"inventory\",\"priority\":100,\"text\":false},{\"id\":\"traverse-win\",\"group\":\"inventory\",\"key\":117,\"action\":\"next\",\"priority\":0,\"text\":false},{\"id\":\"traverse-x11\",\"group\":\"inventory\",\"key\":65475,\"action\":\"next\",\"priority\":0,\"text\":false},{\"id\":\"activate-win\",\"group\":\"*\",\"key\":13,\"action\":\"activate\",\"priority\":0,\"text\":false},{\"id\":\"activate-x11\",\"group\":\"*\",\"key\":65293,\"action\":\"activate\",\"priority\":0,\"text\":false}]}";string[] state={calls.NavCreate.Invoke(configuration),calls.NavCreate.Invoke(configuration)};long[] ids=new long[2];long[][] views={calls.CreateView.Invoke(480,360),calls.CreateView.Invoke(480,360)};string[][] owners={calls.CreateOwner.Invoke(2),calls.CreateOwner.Invoke(2)};int[][] models={new[]{calls.CreateInstance.Invoke(owners[0],"Confectory.BaseUI::Count"),calls.CreateInstance.Invoke(owners[0],"Confectory.BaseUI::Toggle")},new[]{calls.CreateInstance.Invoke(owners[1],"Confectory.BaseUI::Count"),calls.CreateInstance.Invoke(owners[1],"Confectory.BaseUI::Toggle")}};long[] surfaces=Array.Empty<long>();bool[] editing=new bool[2];int stop=0;ConsoleCancelEventHandler interrupt=(_,args)=>{args.Cancel=true;System.Threading.Interlocked.Exchange(ref stop,1);};Console.CancelKeyPress+=interrupt;
try{surfaces=calls.CreateSurfaces.Invoke(new[]{"Confectory Navigation A","Confectory Navigation B"},480,360);calls.Place.Invoke(surfaces,0,10,20);calls.Place.Invoke(surfaces,1,510,20);Console.WriteLine("NAV_UI ready");while(System.Threading.Volatile.Read(ref stop)==0){var events=calls.Pump.Invoke(surfaces);for(int n=0;n<events.Length;n+=6){int view=events[n],type=events[n+1],key=events[n+4],flags=events[n+5];if(type==8){calls.Close.Invoke(surfaces,view);continue;}if(type==5&&flags==0&&(key==81||key==113)){System.Threading.Interlocked.Exchange(ref stop,1);continue;}if(type==5&&flags==0&&(key==84||key==116))editing[view]=!editing[view];var focus=calls.Focus.Invoke(views[view],"query",0);state[view]=calls.NavRoute.Invoke(state[view],ids[view]++,type,key,flags,editing[view],focus[0],System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Where(new[]{1,2},c=>focus[c]!=0)));var result=System.Text.Json.Nodes.JsonNode.Parse(state[view])!;bool consumed=result["consumed"]!.GetValue<bool>();if(consumed){int next=result["focus"]!.GetValue<int>();if(next!=focus[0])calls.Focus.Invoke(views[view],"set",next);int activate=result["activate"]!.GetValue<int>();if(activate!=0)calls.Activate.Invoke(owners[view],models[view],views[view],activate);}else if(!editing[view])calls.Input.Invoke(owners[view],models[view],views[view],type,events[n+2],events[n+3],key,flags);if(Environment.GetEnvironmentVariable("CONFECTORY_NAV_TRACE")=="1")Console.WriteLine("NAV_UI event "+view+" "+state[view]);}
var info=calls.SurfaceInfo.Invoke(surfaces);if(info[0]==0&&info[2]==0)break;for(int view=0;view<2;view++){if(info[view*2]==0)continue;var count=calls.Read.Invoke(owners[view],models[view][0]);var toggle=calls.Read.Invoke(owners[view],models[view][1]);calls.UpdateView.Invoke(views[view],count[0],count[1],toggle[0],toggle[1]);var labels=calls.Labels.Invoke(views[view],new double[]{0,0,1});labels[0]="Navigation "+System.Text.Json.Nodes.JsonNode.Parse(state[view])!["active"]+" focus="+calls.Focus.Invoke(views[view],"query",0)[0];labels[1]="Tab inventory; F6 traverse; Enter activate";labels[4]="T text mode="+editing[view]+"; Q quit";calls.Draw.Invoke(surfaces,view,calls.Layout.Invoke(views[view]),labels);}Console.Out.Flush();System.Threading.Thread.Sleep(10);}return 0;}finally{Console.CancelKeyPress-=interrupt;if(surfaces.Length>0)calls.Close.Invoke(surfaces,-1);foreach(var owner in owners)calls.DisposeOwner.Invoke(owner);Console.WriteLine("Navigation owners/windows cleanup complete");}
