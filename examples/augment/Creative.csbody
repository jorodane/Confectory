if(operation=="cancel"){AppDomain.CurrentDomain.SetData("Example.Augment.Cancel."+requestID,true);return "{}";}if(operation!="generate")throw new ArgumentException("Unknown fixture operation");var request=System.Text.Json.Nodes.JsonNode.Parse(payload)!;if(request["direction"]!.ToString()=="hold"){AppDomain.CurrentDomain.SetData("Example.Augment.Held",true);var wait=System.Diagnostics.Stopwatch.StartNew();while(AppDomain.CurrentDomain.GetData("Example.Augment.Release") is not true){if(AppDomain.CurrentDomain.GetData("Example.Augment.Cancel."+requestID) is true)throw new OperationCanceledException("Fixture cancelled");if(wait.ElapsedMilliseconds>10000)throw new TimeoutException("Fixture hold timed out");System.Threading.Thread.Sleep(5);}}if(request["direction"]!.ToString()=="slow"){AppDomain.CurrentDomain.SetData("Example.Augment.Started",true);var wait=System.Diagnostics.Stopwatch.StartNew();while(wait.ElapsedMilliseconds<10000){if(AppDomain.CurrentDomain.GetData("Example.Augment.Cancel."+requestID) is true)throw new OperationCanceledException("Fixture cancelled");System.Threading.Thread.Sleep(5);}throw new TimeoutException("Fixture not cancelled");}if(request["direction"]!.ToString()=="bad-count")return "{\"cards\":[]}";var target=request["targets"]![0]!;var cards=new System.Text.Json.Nodes.JsonArray();for(int i=0;i<3;i++){cards.Add(new System.Text.Json.Nodes.JsonObject{["title"]="Fixture harvest yield "+(i+2),["summary"]="Local deterministic yield variation "+(i+1)+"; direction: "+request["direction"],["rarity"]=new[]{"standard","variation","discovery"}[i],["effort"]="small",["risk"]="verify harvest",["tags"]=new System.Text.Json.Nodes.JsonArray("harvest","yield"),["changes"]=new System.Text.Json.Nodes.JsonArray(new System.Text.Json.Nodes.JsonObject{["id"]=target["id"]!.DeepClone(),["field"]="yield",["value"]=i+2})});}return new System.Text.Json.Nodes.JsonObject{["cards"]=cards}.ToJsonString();
