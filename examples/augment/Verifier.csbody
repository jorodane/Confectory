try{string Verify(){var spec=System.Text.Json.Nodes.JsonNode.Parse(specification)!;var changes=spec["changes"]!.AsArray();if(changes.Count!=1)throw new InvalidOperationException("Local verifier requires one scalar plan");var change=changes[0]!;string project=spec["sourceProject"]!.GetValue<string>();var description=System.Text.Json.Nodes.JsonNode.Parse(calls.Describe.Invoke(project))!;string root=System.IO.Path.GetDirectoryName(System.IO.Path.GetFullPath(project))!;foreach(var unit in description["units"]!.AsArray())if(unit!["id"]!.ToString()==change["id"]!.ToString()){var file=calls.Snapshot.Invoke(System.IO.Path.Combine(root,unit["path"]!.GetValue<string>()));if(file[0]!="exists")throw new InvalidOperationException("Verification target deleted");var declaration=System.Text.Json.Nodes.JsonNode.Parse(calls.Inspect.Invoke(file[1]))!;if(declaration["values"]![change["field"]!.GetValue<string>()]!.ToJsonString()!=change["value"]!.ToJsonString())throw new InvalidOperationException("Source does not implement selected goal");string plant=calls.HarvestCreate.Invoke(declaration.ToJsonString());calls.HarvestClose.Invoke(plant);return "verified-source:"+file[2];}throw new InvalidOperationException("Verification target unavailable");
}string expected=Verify();return progress==expected&&evidence==expected;}catch(Exception){return false;}
