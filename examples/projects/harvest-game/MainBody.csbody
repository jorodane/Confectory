void Check(bool ok,string why){if(!ok)throw new Exception(why);}System.Text.Json.Nodes.JsonNode Json(string text)=>System.Text.Json.Nodes.JsonNode.Parse(text)!;
string project=Environment.GetEnvironmentVariable("CONFECTORY_GAME_PROJECT")??throw new InvalidOperationException("Explicit game ProjectPack source required");string root=System.IO.Path.GetDirectoryName(System.IO.Path.GetFullPath(project))!;var description=Json(calls.SchemaEditingDescribe.Invoke(project));
System.Text.Json.Nodes.JsonNode Declaration(string id){foreach(var unit in description["units"]!.AsArray())if(unit!["id"]!.GetValue<string>()==id)return Json(calls.SchemaEditingInspect.Invoke(calls.FileStreamSnapshot.Invoke(System.IO.Path.Combine(root,unit["path"]!.GetValue<string>()))[1]));throw new ArgumentException("Declared game element missing: "+id);}
var plantDeclaration=Declaration("Example.HarvestGame::PowderPlant");string[] resources=new[]{plantDeclaration["values"]!["resource"]!.GetValue<string>(),"Example.HarvestGame::Herb","Example.HarvestGame::Timber","Example.HarvestGame::Bomb"};foreach(string id in resources)Declaration(id);string inventory=calls.InventoryCreate.Invoke(resources,new[]{0,5,5,0}),plant="",recipe="",projectile="";long[] surfaces=Array.Empty<long>();string instance=Guid.NewGuid().ToString("N"),name=Environment.GetEnvironmentVariable("CONFECTORY_COMPARISON_CASE")??"single";int ticks=0;
int stopRequested=0;ConsoleCancelEventHandler interrupt=(sender,args)=>{args.Cancel=true;System.Threading.Interlocked.Exchange(ref stopRequested,1);};Console.CancelKeyPress+=interrupt;
void Trace(string kind){var item=new System.Text.Json.Nodes.JsonObject{["event"]=kind,["instance"]=instance,["case"]=name,["tick"]=ticks,["inventory"]=Json(calls.InventorySnapshot.Invoke(inventory)),["plant"]=Json(calls.HarvestSnapshot.Invoke(plant))};if(projectile!="")item["projectile"]=Json(calls.Ballistic2DSnapshot.Invoke(projectile,1));Console.WriteLine(item.ToJsonString());Console.Out.Flush();}
try{plant=calls.HarvestCreate.Invoke(plantDeclaration.ToJsonString());recipe=calls.RecipeCreate.Invoke(Declaration("Example.HarvestGame::BombRecipe").ToJsonString());double gravity=double.Parse(Environment.GetEnvironmentVariable("CONFECTORY_GAME_GRAVITY")??"350",System.Globalization.CultureInfo.InvariantCulture);
bool Throw(double x,double y){if(projectile!=""){if(Json(calls.Ballistic2DSnapshot.Invoke(projectile,1))["phase"]!.GetValue<string>()!="spent")return false;calls.Ballistic2DClose.Invoke(projectile);projectile="";}projectile=calls.Throw.Invoke(inventory,x,y,gravity);return projectile!="";}
if(Environment.GetEnvironmentVariable("CONFECTORY_GAME_MODE")=="mechanics-test"){
string before=calls.InventorySnapshot.Invoke(inventory);Check(!calls.RecipeCraft.Invoke(recipe,inventory)&&calls.InventorySnapshot.Invoke(inventory)==before,"insufficient recipe leaves stock/revision unchanged");Check(!Throw(320,190),"throw without crafted item creates no owned flight");Check(calls.HarvestCollect.Invoke(plant,inventory),"declared plant yields declared resource");before=calls.InventorySnapshot.Invoke(inventory);Check(!calls.HarvestCollect.Invoke(plant,inventory)&&calls.InventorySnapshot.Invoke(inventory)==before,"repeated cooldown harvest no duplicate stock");Check(calls.RecipeCraft.Invoke(recipe,inventory),"recipe composes registered ingredient IDs");Check(Throw(320,190),"crafted item spawns moving instance");var start=Json(calls.Ballistic2DSnapshot.Invoke(projectile,1));Check(start["x"]!.GetValue<double>()==80&&start["phase"]!.GetValue<string>()=="flying","no teleport at throw");for(int i=0;i<20;i++)calls.Ballistic2DStep.Invoke(projectile,0.02);var middle=Json(calls.Ballistic2DSnapshot.Invoke(projectile,1));Check(middle["x"]!.GetValue<double>()>80&&middle["x"]!.GetValue<double>()<320&&middle["y"]!.GetValue<double>()<190,"real intermediate ballistic arc");var previous=Json(calls.Ballistic2DSnapshot.Invoke(projectile,0));Check(previous["displayX"]!.GetValue<double>()<middle["displayX"]!.GetValue<double>(),"display interpolation separate from fixed advancement");for(int i=0;i<20;i++)calls.Ballistic2DStep.Invoke(projectile,0.02);Check(Json(calls.Ballistic2DSnapshot.Invoke(projectile,1))["phase"]!.GetValue<string>()=="landed","landed before fuse effect");for(int i=0;i<10;i++)calls.Ballistic2DStep.Invoke(projectile,0.02);Check(Json(calls.Ballistic2DSnapshot.Invoke(projectile,1))["phase"]!.GetValue<string>()=="landed","delayed effect not instantaneous landing");for(int i=0;i<6;i++)calls.Ballistic2DStep.Invoke(projectile,0.02);Check(Json(calls.Ballistic2DSnapshot.Invoke(projectile,1))["phase"]!.GetValue<string>()=="burst","fixed time produces delayed visible-effect state");for(int i=0;i<31;i++)calls.Ballistic2DStep.Invoke(projectile,0.02);Check(Json(calls.Ballistic2DSnapshot.Invoke(projectile,1))["phase"]!.GetValue<string>()=="spent","bounded effect completes");calls.HarvestStep.Invoke(plant,0.5);Check(calls.HarvestCollect.Invoke(plant,inventory),"plant regrows for repeated flow");string other=calls.InventoryCreate.Invoke(resources,new[]{0,5,5,0});try{Check(Json(calls.InventorySnapshot.Invoke(other))["quantities"]![resources[0]]!.GetValue<int>()==0,"independent model isolation");}finally{calls.InventoryClose.Invoke(other);}Trace("mechanics-complete");Console.WriteLine("Declared harvest recipe ballistic motion fuse interpolation isolation/repeated flows PASS");return 0;}
surfaces=calls.WindowCreateSurfaces.Invoke(new[]{"Confectory Harvest "+name},400,300);int xpos=int.Parse(Environment.GetEnvironmentVariable("CONFECTORY_GAME_X")??"20",System.Globalization.CultureInfo.InvariantCulture),ypos=int.Parse(Environment.GetEnvironmentVariable("CONFECTORY_GAME_Y")??"40",System.Globalization.CultureInfo.InvariantCulture);calls.WindowPlace.Invoke(surfaces,0,xpos,ypos);var watch=System.Diagnostics.Stopwatch.StartNew();double prior=0;var clock=new double[3];bool running=true,dirty=true;string shared=Environment.GetEnvironmentVariable("CONFECTORY_COMPARISON_INPUT")??"",inputHash="";var consumed=new System.Collections.Generic.Dictionary<string,string>(StringComparer.Ordinal);string lastPhase="";Trace("ready");
void Intent(string operation,double x=320,double y=190){bool changed=operation switch{"harvest"=>calls.HarvestCollect.Invoke(plant,inventory),"craft"=>calls.RecipeCraft.Invoke(recipe,inventory),"throw"=>Throw(x,y),_=>throw new ArgumentException("Unknown bounded game intent")};Trace(changed?operation+"-applied":operation+"-rejected");dirty=true;}
while(running&&System.Threading.Volatile.Read(ref stopRequested)==0){var events=calls.RenderInputPump.Invoke(surfaces);for(int i=0;i<events.Length;i+=6){int type=events[i+1],code=events[i+4],flags=events[i+5];if(type==8)running=false;if(type==5&&(flags&1)==0){if(code==72||code==104)Intent("harvest");if(code==67||code==99)Intent("craft");if(code==84||code==116)Intent("throw");if(code==27||code==0xFF1B)running=false;}if(type==1){int x=events[i+2],y=events[i+3];if(y>=245&&x<125)Intent("harvest");else if(y>=245&&x<255)Intent("craft");else if(y>=245)Intent("throw");else Intent("throw",Math.Clamp(x,100,375),Math.Clamp(y,100,220));}if(type==7||type==10)dirty=true;}
if(shared!=""){var snapshot=calls.FileStreamSnapshot.Invoke(shared);if(snapshot[0]=="exists"&&snapshot[2]!=inputHash){if(snapshot[1].Length>65536)throw new ArgumentException("Shared input log exceeds bound");var packet=Json(snapshot[1]);var commands=packet["commands"]!.AsArray();if(commands.Count>64)throw new ArgumentException("Shared input count exceeds bound");foreach(var command in commands){string id=command!["id"]!.GetValue<string>(),fingerprint=command.ToJsonString();if(string.IsNullOrWhiteSpace(id)||id.Length>128)throw new ArgumentException("Bounded shared intent ID required");if(consumed.TryGetValue(id,out var old)){if(old!=fingerprint)throw new ArgumentException("Shared intent identity conflict");continue;}if(consumed.Count>=1024)throw new ArgumentException("Shared intent capacity reached");Intent(command["operation"]!.GetValue<string>(),command["x"]?.GetValue<double>()??320,command["y"]?.GetValue<double>()??190);consumed.Add(id,fingerprint);}inputHash=snapshot[2];if(packet["close"]?.GetValue<bool>()==true)running=false;}}
double now=watch.Elapsed.TotalSeconds;var timing=calls.RealTimeUpdateAdvance.Invoke(clock,now-prior,1.0/120,1.0/60,0.01,8);prior=now;for(int step=0;step<(int)timing[2];step++){calls.HarvestStep.Invoke(plant,0.01);if(projectile!="")calls.Ballistic2DStep.Invoke(projectile,0.01);ticks++;}if(projectile!=""){string phase=Json(calls.Ballistic2DSnapshot.Invoke(projectile,1))["phase"]!.GetValue<string>();if(phase!=lastPhase){lastPhase=phase;Trace("phase-"+phase);}}
if(timing[1]!=0||dirty){var stock=Json(calls.InventorySnapshot.Invoke(inventory))["quantities"]!;var plantState=Json(calls.HarvestSnapshot.Invoke(plant));var rectangles=new System.Collections.Generic.List<int>{0,0,400,300,0x18202A,0,0,400,42,0x283645,0,215,400,25,0x415C33,42,145,36,65,plantState["ready"]!.GetValue<bool>()?0x28AD55:0x746A43,5,245,120,45,0x356840,135,245,120,45,0x5E5840,265,245,130,45,0x685040};var labels=new System.Collections.Generic.List<string>{"",name+" powder="+stock[resources[0]]+" items="+stock[resources[3]],"target plane","plant", "Harvest [H]","Craft [C]","Throw [T]"};if(projectile!=""){var pose=Json(calls.Ballistic2DSnapshot.Invoke(projectile,timing[3]));string phase=pose["phase"]!.GetValue<string>();int x=(int)Math.Round(pose["displayX"]!.GetValue<double>()),y=(int)Math.Round(pose["displayY"]!.GetValue<double>());if(phase=="flying"||phase=="landed"){rectangles.AddRange(new[]{x-5,y-5,10,10,0xF4D12D});labels.Add("");}if(phase=="burst"){int radius=(int)pose["effectRadius"]!.GetValue<double>();rectangles.AddRange(new[]{x-radius,y-radius,radius*2,radius*2,0xEB7130});labels.Add("effect");}}calls.RenderInputDraw.Invoke(surfaces,0,rectangles.ToArray(),labels.ToArray());dirty=false;}
string? stop=Environment.GetEnvironmentVariable("CONFECTORY_GAME_CLOSE_MS");if(stop is not null&&watch.ElapsedMilliseconds>=int.Parse(stop,System.Globalization.CultureInfo.InvariantCulture))running=false;System.Threading.Thread.Sleep(1);}
Trace("closed");return 0;
}finally{Console.CancelKeyPress-=interrupt;if(surfaces.Length>0)calls.WindowClose.Invoke(surfaces,-1);if(projectile!="")calls.Ballistic2DClose.Invoke(projectile);if(recipe!="")calls.RecipeClose.Invoke(recipe);if(plant!="")calls.HarvestClose.Invoke(plant);calls.InventoryClose.Invoke(inventory);Console.WriteLine("game owner cleanup complete");}
