void Check(bool ok,string message){if(!ok)throw new Exception(message);}
string root=Environment.GetEnvironmentVariable("CONFECTORY_TEST_HISTORY_ROOT")!,project=System.IO.Path.Combine(root,"project.cpack"),entry="Example.FrameLoop::Main";
var session=calls.CreateSession.Invoke();var cold=calls.CreateSession.Invoke();
System.Text.Json.Nodes.JsonNode Query(string[] owner,string operation,string id="",string? current=null)=>System.Text.Json.Nodes.JsonNode.Parse(calls.History.Invoke(owner,project,operation,new System.Text.Json.Nodes.JsonObject{["execution"]=id,["page"]=0,["current"]=current??""}.ToJsonString()))!;
System.Text.Json.Nodes.JsonNode Control(string id,string action)=>System.Text.Json.Nodes.JsonNode.Parse(calls.Control.Invoke(session,id,action))!;
void Reject(Action action,string reason){bool refused=false;try{action();}catch(ArgumentException){refused=true;}catch(InvalidOperationException){refused=true;}Check(refused,reason);}
System.Text.Json.Nodes.JsonNode WaitFrame(string id,Func<System.Text.Json.Nodes.JsonNode,bool> predicate){var watch=System.Diagnostics.Stopwatch.StartNew();while(watch.Elapsed.TotalSeconds<90){var frame=Control(id,"observe");if(predicate(frame))return frame;if(calls.Observe.Invoke(session,id)[1]=="failed")throw new Exception(string.Join(" | ",calls.Observe.Invoke(session,id)));System.Threading.Thread.Sleep(15);}throw new Exception("Frame timeout");}
string[] WaitState(string id,params string[] desired){var watch=System.Diagnostics.Stopwatch.StartNew();while(watch.Elapsed.TotalSeconds<90){var state=calls.Observe.Invoke(session,id);if(Array.IndexOf(desired,state[1])>=0)return state;System.Threading.Thread.Sleep(15);}throw new Exception("State timeout");}
string key=Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(OperatingSystem.IsWindows()?project.ToUpperInvariant():project))).ToLowerInvariant(),folder=System.IO.Path.Combine(root,".confectory","run-history"),path=System.IO.Path.Combine(folder,key+".json"),historyLease=System.IO.Path.Combine(folder,key+".lock");
var sources=System.Linq.Enumerable.ToDictionary(System.IO.Directory.EnumerateFiles(root),p=>p,p=>System.IO.File.ReadAllBytes(p));
try{
 Check(Query(cold,"history")["total"]?.GetValue<int>()==0,"Fresh empty history");
 string sourceLease=calls.LeasePath.Invoke(root);System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(sourceLease)!);
 string cancelled;using(var lease=new System.IO.FileStream(sourceLease,System.IO.FileMode.OpenOrCreate,System.IO.FileAccess.ReadWrite,System.IO.FileShare.None)){
  var watch=System.Diagnostics.Stopwatch.StartNew();cancelled=calls.Launch.Invoke(session,project,entry,"portable");Check(Query(session,"info",cancelled)["recordedState"]?.ToString()=="building","Launch facts stored while source/build lease is held");calls.Stop.Invoke(session,cancelled);Check(watch.Elapsed.TotalSeconds<3,"History must not wait on the build/source lease");Check(Query(session,"info",cancelled)["recordedState"]?.ToString()=="stopped","Actual build cancellation persisted");}
 byte[] terminal=System.IO.File.ReadAllBytes(path);calls.Stop.Invoke(session,cancelled);System.Threading.Thread.Sleep(100);calls.Observe.Invoke(session,cancelled);Check(System.Linq.Enumerable.SequenceEqual(terminal,System.IO.File.ReadAllBytes(path)),"Repeated Stop and late worker result cannot rewrite terminal facts");
 string live=calls.Launch.Invoke(session,project,entry,"portable");WaitFrame(live,v=>v["available"]?.GetValue<bool>()==true&&long.Parse(v["frame"]!.ToString())>1);Control(live,"pause");var paused=WaitFrame(live,v=>v["ack"]?.GetValue<int>()==1&&v["mode"]?.ToString()=="paused");var own=Query(session,"info",live);Check(own["frame"]?.ToString()==paused["frame"]?.ToString()&&own["ack"]?.GetValue<int>()==1&&own["frameState"]?.ToString()=="paused","Only verified actual frame/ack facts persisted");
 var historical=Query(cold,"info",live);Check(historical["state"]?.ToString()=="owner-unavailable"&&historical["recordedState"]?.ToString()=="running"&&!historical["ownerAvailable"]!.GetValue<bool>()&&!historical["canControl"]!.GetValue<bool>()&&!historical["canStop"]!.GetValue<bool>(),"Cold facts cannot assert live ownership or control");
 Reject(()=>calls.Observe.Invoke(cold,live),"No Observe adoption");Reject(()=>calls.Control.Invoke(cold,live,"step"),"No frame capability adoption");Reject(()=>calls.Stop.Invoke(cold,live),"No Stop adoption");Reject(()=>Query(cold,"checkpoint",live),"Checkpoint cannot supply another owner's facts");
 byte[] stable=System.IO.File.ReadAllBytes(path);Query(cold,"history");calls.Observe.Invoke(session,live);Check(System.Linq.Enumerable.SequenceEqual(stable,System.IO.File.ReadAllBytes(path)),"Read/no-op observation never refreshes receipt time/version");
 Control(live,"step");var stepped=WaitFrame(live,v=>v["ack"]?.GetValue<int>()==2);Check(long.Parse(stepped["frame"]!.ToString())==long.Parse(paused["frame"]!.ToString())+1&&Query(cold,"info",live)["ack"]?.GetValue<int>()==2,"Completed Step durable as read-only facts");
 using(var busy=new System.IO.FileStream(historyLease,System.IO.FileMode.OpenOrCreate,System.IO.FileAccess.ReadWrite,System.IO.FileShare.None)){var timer=System.Diagnostics.Stopwatch.StartNew();Check(Query(session,"checkpoint",live)["state"]?.ToString()=="busy"&&timer.ElapsedMilliseconds<1000,"Busy history lease is bounded and does not block execution");}Check(Query(session,"checkpoint",live)["state"]?.ToString()=="available","Storage retry is not command replay");
 byte[] readOnlyBytes=System.IO.File.ReadAllBytes(path);var attributes=System.IO.File.GetAttributes(path);try{System.IO.File.SetAttributes(path,attributes|System.IO.FileAttributes.ReadOnly);Control(live,"step");WaitFrame(live,v=>v["ack"]?.GetValue<int>()==3);Check(System.Linq.Enumerable.SequenceEqual(readOnlyBytes,System.IO.File.ReadAllBytes(path))&&Query(session,"history",current:live)["recordingState"]?.ToString()=="unavailable","Read-only write failure preserves old bytes and real control outcome");}finally{System.IO.File.SetAttributes(path,attributes);}Check(Query(session,"checkpoint",live)["state"]?.ToString()=="available"&&Query(cold,"info",live)["ack"]?.GetValue<int>()==3,"Retry saves latest confirmed facts without replaying Step");
 byte[] original=System.IO.File.ReadAllBytes(path);var file=System.Text.Json.Nodes.JsonNode.Parse(original)!.AsObject();var row=System.Linq.Enumerable.Single(file["rows"]!.AsArray(),n=>n!["execution"]!.ToString()==live)!;row["revision"]=row["revision"]!.GetValue<long>()+10;System.IO.File.WriteAllText(path,file.ToJsonString());byte[] foreign=System.IO.File.ReadAllBytes(path);Check(Query(session,"checkpoint",live)["state"]?.ToString()=="conflict"&&System.Linq.Enumerable.SequenceEqual(foreign,System.IO.File.ReadAllBytes(path)),"Newer external receipt must not be overwritten by stale owner state");System.IO.File.WriteAllBytes(path,original);Check(Query(session,"checkpoint",live)["state"]?.ToString()=="available","Exact original receipt permits retry");
 foreach(byte[] bad in new[]{System.Text.Encoding.UTF8.GetBytes("null"),new byte[]{255,254,253},new byte[262145],System.Text.Encoding.UTF8.GetBytes(System.Text.Encoding.UTF8.GetString(original).Replace("\"version\":1","\"version\":2",StringComparison.Ordinal))}){System.IO.File.WriteAllBytes(path,bad);Check(Query(cold,"history")["state"]?.ToString()=="unavailable","Corrupt/unreadable distinct from empty");Query(session,"checkpoint",live);Check(System.Linq.Enumerable.SequenceEqual(bad,System.IO.File.ReadAllBytes(path)),"Corrupt bytes preserved without reset");}System.IO.File.WriteAllBytes(path,original);
 var unknown=System.Text.Json.Nodes.JsonNode.Parse(original)!.AsObject();unknown["token"]="MUST_NOT_RETURN";System.IO.File.WriteAllText(path,unknown.ToJsonString());Check(!Query(cold,"history").ToJsonString().Contains("MUST_NOT_RETURN",StringComparison.Ordinal),"Unknown secret-like fields never projected");Query(session,"checkpoint",live);Check(System.IO.File.ReadAllText(path)==unknown.ToJsonString(),"Unknown fields never silently migrated or overwritten");System.IO.File.WriteAllBytes(path,original);
 string sibling=System.IO.Path.Combine(root,"different.cpack");System.IO.File.Copy(project,sibling);string siblingKey=Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(OperatingSystem.IsWindows()?sibling.ToUpperInvariant():sibling))).ToLowerInvariant();System.IO.File.WriteAllBytes(System.IO.Path.Combine(folder,siblingKey+".json"),original);Check(System.Text.Json.Nodes.JsonNode.Parse(calls.History.Invoke(cold,sibling,"history","{}"))!["state"]?.ToString()=="unavailable","Copied project receipt cannot cross manifest scope");System.IO.File.Delete(sibling);System.IO.File.Delete(System.IO.Path.Combine(folder,siblingKey+".json"));
 if(!OperatingSystem.IsWindows()){string outside=System.IO.Path.Combine(root,"outside-history.json"),saved=path+".saved";System.IO.File.WriteAllBytes(outside,original);System.IO.File.Move(path,saved);System.IO.File.CreateSymbolicLink(path,outside);Check(Query(cold,"history")["state"]?.ToString()=="unavailable","Foreign symlink history refused");Query(session,"checkpoint",live);Check(System.Linq.Enumerable.SequenceEqual(original,System.IO.File.ReadAllBytes(outside)),"No writes through symlink");System.IO.File.Delete(path);System.IO.File.Move(saved,path);System.IO.File.Delete(outside);}
 calls.Stop.Invoke(session,live);var stopped=Query(cold,"info",live);Check(stopped["recordedState"]?.ToString()=="stopped"&&stopped["exitCode"] is null,"Stop stores no invented exit code");
 string exited=calls.Launch.Invoke(session,project,"Example.FrameLoop::Exit","portable");Check(WaitState(exited,"exited","failed")[1]=="exited","Actual successful child exit");Check(Query(cold,"info",exited)["exitCode"]?.GetValue<int>()==0&&Query(cold,"info",exited)["recordedState"]?.ToString()=="exited","Actual zero exit result persisted");
 string? host=Environment.GetEnvironmentVariable("CONFECTORY_PROJECT_EXECUTION_HOST");Environment.SetEnvironmentVariable("CONFECTORY_PROJECT_EXECUTION_HOST",System.IO.Path.Combine(root,"CANARY_PRIVATE_DIAGNOSTIC.dll"));string failed=calls.Launch.Invoke(session,project,entry,"portable");WaitState(failed,"failed");Environment.SetEnvironmentVariable("CONFECTORY_PROJECT_EXECUTION_HOST",host);Check(Query(cold,"info",failed)["recordedState"]?.ToString()=="failed","Actual launch failure durable without diagnostic payload");Check(!System.IO.File.ReadAllText(path).Contains("CANARY_PRIVATE_DIAGNOSTIC",StringComparison.Ordinal),"No raw error/environment secrets stored");
 var newest=Query(cold,"history")["rows"]!.AsArray()[0]!["execution"]!.ToString();Query(session,"checkpoint",cancelled);Check(Query(cold,"history")["rows"]!.AsArray()[0]!["execution"]!.ToString()==newest,"Old execution checkpoint cannot replace newer history entry");
 byte[] beforeCapacity=System.IO.File.ReadAllBytes(path);var capacity=System.Text.Json.Nodes.JsonNode.Parse(beforeCapacity)!.AsObject();var rows=new System.Text.Json.Nodes.JsonArray();for(int i=1;i<=256;i++)rows.Add(new System.Text.Json.Nodes.JsonObject{["execution"]=i.ToString("x32"),["revision"]=1,["order"]=i,["observedUtc"]=DateTimeOffset.UtcNow.ToString("O"),["recordedState"]="exited",["frame"]=null,["ack"]=null,["frameState"]=null,["exitCode"]=0});capacity["rows"]=rows;capacity["sequence"]=256;System.IO.File.WriteAllText(path,capacity.ToJsonString());byte[] full=System.IO.File.ReadAllBytes(path);string extra=calls.Launch.Invoke(session,project,entry,"portable");Check(Query(session,"history",current:extra)["recordingState"]?.ToString()=="capacity","Capacity explicitly reported while run remains independent");calls.Stop.Invoke(session,extra);Check(System.Linq.Enumerable.SequenceEqual(full,System.IO.File.ReadAllBytes(path)),"Full history never evicts or overwrites old facts");System.IO.File.WriteAllBytes(path,beforeCapacity);
 var schema=System.Text.Json.Nodes.JsonNode.Parse(System.IO.File.ReadAllText(path))!;foreach(var item in schema["rows"]!.AsArray()){Check(item!.AsObject().Count==9,"Fixed nine-field non-authorizing row");foreach(string prohibited in new[]{"secret","pipe","token","owner","runtime","pid","environment","error","capability"})Check(!item.AsObject().ContainsKey(prohibited),"Forbidden stored field "+prohibited);}
 foreach(var pair in sources)Check(System.Linq.Enumerable.SequenceEqual(pair.Value,System.IO.File.ReadAllBytes(pair.Key)),"Project source bytes unchanged");
 Console.WriteLine("Run history actual lifecycle PASS: build cancel/Stop/no-op, completed frame/ack, cold owner-unavailable/no adoption/replay, conflict/corruption/schema/scope/symlink/capacity, no secret/error payload");
}finally{calls.Dispose.Invoke(session);calls.Dispose.Invoke(cold);}return 0;
