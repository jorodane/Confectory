void Check(bool ok,string message){if(!ok)throw new Exception(message);}
var session=calls.CreateSession.Invoke();var other=calls.CreateSession.Invoke();string root=Environment.GetEnvironmentVariable("CONFECTORY_TEST_REPO")!;string path=System.IO.Path.Combine(root,"examples","frame-loop","project.cpack");string entry="Example.FrameLoop::Main",outputPrefix="LOCAL_FRAME ";
System.Text.Json.Nodes.JsonNode Control(string handle,string op)=>System.Text.Json.Nodes.JsonNode.Parse(calls.Control.Invoke(session,handle,op))!;
System.Text.Json.Nodes.JsonNode Until(string handle,Func<System.Text.Json.Nodes.JsonNode,bool> condition){var timer=System.Diagnostics.Stopwatch.StartNew();while(timer.ElapsedMilliseconds<90000){var status=Control(handle,"observe");if(condition(status))return status;var process=calls.Observe.Invoke(session,handle);if(process[1] is "failed" or "exited")throw new Exception("Actual child ended: "+string.Join(" | ",process)+" "+string.Join("\n",calls.Output.Invoke(session,handle)));System.Threading.Thread.Sleep(15);}throw new Exception("Actual frame timeout");}
int Ack(System.Text.Json.Nodes.JsonNode node)=>node["ack"]!.GetValue<int>();long Frame(System.Text.Json.Nodes.JsonNode node)=>long.Parse(node["frame"]!.ToString());
long ActualTicks(string handle,System.Text.Json.Nodes.JsonNode receipt){var timer=System.Diagnostics.Stopwatch.StartNew();while(timer.ElapsedMilliseconds<3000){foreach(string line in calls.Output.Invoke(session,handle)){if(!line.StartsWith(outputPrefix,StringComparison.Ordinal))continue;var row=System.Text.Json.Nodes.JsonNode.Parse(line[outputPrefix.Length..])!;if(row["frame"]!.ToString()==receipt["frame"]!.ToString())return long.Parse((row["fixedTicks"]??row["ticks"])!.ToString());}System.Threading.Thread.Sleep(10);}throw new Exception("Actual callback telemetry missing for acknowledged frame "+receipt);}

try{
 string a=calls.LaunchConfigured.Invoke(session,path,entry,"portable",new[]{"CONFECTORY_ENGINE_TRACE_FRAME","CONFECTORY_WINDOW_PREFIX"},new[]{"1","Confectory Frame Proof "+Guid.NewGuid().ToString("N")}),b=calls.LaunchConfigured.Invoke(session,path,entry,"portable",new[]{"CONFECTORY_ENGINE_TRACE_FRAME","CONFECTORY_WINDOW_PREFIX"},new[]{"1","Confectory Frame Proof "+Guid.NewGuid().ToString("N")});
 var first=Until(a,s=>s["available"]?.GetValue<bool>()==true&&Frame(s)>2);var second=Until(b,s=>s["available"]?.GetValue<bool>()==true&&Frame(s)>2);Check(first["runtime"]!.ToString()!=second["runtime"]!.ToString(),"Separate runtime epochs");
 bool cross=false;try{calls.Control.Invoke(other,a,"pause");}catch(ArgumentException){cross=true;}Check(cross,"Cross session frame command rejected");
 Control(a,"pause");var paused=Until(a,s=>s["mode"]?.ToString()=="paused"&&Ack(s)==1);long frame=Frame(paused),ticks=ActualTicks(a,paused);System.Threading.Thread.Sleep(150);Check(Frame(Control(a,"observe"))==frame,"Pause freezes actual completed callbacks");
 // b may lease-pause while a is under observation; explicitly resume then verify independence.
 var bs=Control(b,"observe");if(bs["mode"]?.ToString()=="paused"){Control(b,"resume");bs=Until(b,s=>s["mode"]?.ToString()=="running"&&Ack(s)>0);}long before=Frame(bs);System.Threading.Thread.Sleep(100);Check(Frame(Control(b,"observe"))>before,"Other owned simulation advances");
 for(int i=0;i<3;i++){Control(a,"step");var stepped=Until(a,s=>Ack(s)==2+i&&s["mode"]?.ToString()=="paused");Check(Frame(stepped)==++frame,"Exactly one real completed frame per Step");Check(ActualTicks(a,stepped)==++ticks,"Step invokes exactly one actual fixed update");}
 Control(a,"disconnect");System.Threading.Thread.Sleep(2300);var detached=Control(a,"observe");Check(detached["connected"]?.GetValue<bool>()==false,"Detached transport stays disconnected");var resumed=Control(a,"reconnect");Check(resumed["mode"]?.ToString()=="paused"&&Frame(resumed)==frame&&Ack(resumed)==4,"Reconnect does not replay Step or resume");
 Control(a,"resume");var playing=Until(a,s=>s["mode"]?.ToString()=="running"&&Ack(s)==5&&Frame(s)>frame);Control(a,"disconnect");System.Threading.Thread.Sleep(2300);var reconnect=Control(a,"reconnect");Check(reconnect["mode"]?.ToString()=="paused","Lost heartbeat pauses at real boundary");long stoppedFrame=Frame(reconnect);System.Threading.Thread.Sleep(100);Check(Frame(Control(a,"observe"))==stoppedFrame,"Lease pause has no catch-up");
 Control(a,"step");var one=Until(a,s=>Ack(s)==6);Check(Frame(one)==stoppedFrame+1,"Reconnect Step is single frame");
 string[] lines=calls.Output.Invoke(session,a);var frames=System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Select(System.Linq.Enumerable.Where(lines,line=>line.StartsWith(outputPrefix,StringComparison.Ordinal)),line=>System.Text.Json.Nodes.JsonNode.Parse(line[outputPrefix.Length..])!));Check(frames.Length>0&&System.Linq.Enumerable.Any(frames,row=>row["frame"]!.ToString()==one["frame"]!.ToString()),"Acknowledged frame exists in actual callback output");
 calls.Stop.Invoke(session,a);calls.Stop.Invoke(session,a);Check(Control(a,"observe")["connected"]?.GetValue<bool>()==false,"Terminal Stop cannot regain control");Check(calls.Observe.Invoke(session,b)[1]=="running","Stop only owns selected process tree");calls.Stop.Invoke(session,b);
 bool reserved=false;try{calls.LaunchConfigured.Invoke(session,path,"Example.FrameLoop::Main","portable",new[]{"CONFECTORY_FRAME_HANDLE"},new[]{a});}catch(ArgumentException){reserved=true;}Check(reserved,"Child cannot override frame ownership");
 Console.WriteLine("Actual owned frame control PASS: two sessions/epochs, pause, three single callback Steps, disconnect/lease/reconnect, no replay/catch-up, real output/ack and owned Stop");
}finally{calls.Dispose.Invoke(session);calls.Dispose.Invoke(other);}return 0;
