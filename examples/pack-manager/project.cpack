project Example.PackManager version "0.1.0" {
entry Example.PackManager::Main;
registry Confectory.FileStream "../../packs/file-stream/pack.cpack";
dependency Confectory.FileStream version "0.1.0";
registry Confectory.SchemaEditing "../../packs/schema-editing/pack.cpack";
dependency Confectory.SchemaEditing version "0.1.0";
registry Confectory.PackManager "../../packs/pack-manager/pack.cpack";
dependency Confectory.PackManager version "0.1.0";
registry Confectory.Build.DotNet "../../targets/dotnet/pack.cpack";
dependency Confectory.Build.DotNet version "0.1.0";
target portable Confectory.Build.DotNet::Portable;
element Main function "main.celem";
element MainBody implementation "main_body.celem";
element DispatchBody implementation "dispatch.celem";
element Alpha function "Alpha.celem";
element AlphaBody implementation "AlphaBody.celem";
element Beta function "Beta.celem";
element BetaBody implementation "BetaBody.celem";
element First function "First.celem";
element FirstBody implementation "FirstBody.celem";
}
