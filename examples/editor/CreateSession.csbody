
string root=System.IO.Path.GetFullPath(repository);if(!System.IO.File.Exists(System.IO.Path.Combine(root,"targets","dotnet","pack.cpack")))throw new ArgumentException("Choose the Confectory tool repository");string settings=System.IO.Path.Combine(System.IO.Path.GetFullPath(storage),"recent.json");var saved=calls.FileStreamSnapshot.Invoke(settings);var recent=new System.Text.Json.Nodes.JsonArray();if(saved[0]=="exists")try{recent=System.Text.Json.Nodes.JsonNode.Parse(saved[1])!.AsArray();if(recent.Count>12)throw new ArgumentException("Recent project budget");}catch(System.Text.Json.JsonException){recent=new();}else calls.FileStreamWriteAtomic.Invoke(settings,"[]");
var model=new System.Text.Json.Nodes.JsonObject{["projects"]=new System.Text.Json.Nodes.JsonArray(),["views"]=new System.Text.Json.Nodes.JsonObject(),["recent"]=recent,["homeFolder"]=System.IO.Path.GetDirectoryName(settings),["status"]="Local editing ready",["serial"]=0L};string session=Guid.NewGuid().ToString("N");var manager=calls.ProjectManagerCreateManager.Invoke(64);AppDomain.CurrentDomain.SetData("Confectory.Editor.Session."+session,new object[]{manager,new System.Collections.Generic.Dictionary<string,string[]>(StringComparer.Ordinal),new System.Collections.Generic.Dictionary<int,string>(),model,model.ToJsonString(),root,settings,false});return session;
