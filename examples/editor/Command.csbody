  else if(operation=="review"){var ids=System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Select(Project(context)["units"]!.AsArray(),x=>x!["id"]!.GetValue<string>()));var changes=calls.EditWorkspaceChanges.Invoke(Workspace(context),ids);var selected=new string[changes.Length/4];for(int n=0;n<selected.Length;n++)selected[n]=changes[n*4];var baseline=calls.ChangeSetReview.Invoke(Workspace(context),selected);model["review"]=new System.Text.Json.Nodes.JsonObject{["project"]=context,["selected"]=System.Text.Json.JsonSerializer.SerializeToNode(selected),["changes"]=System.Text.Json.JsonSerializer.SerializeToNode(changes),["baseline"]=System.Text.Json.JsonSerializer.SerializeToNode(baseline)};model["status"]=baseline[0]=="conflict"?"Source changed externally; drafts retained. Resolve before Confirm":"Review local changes before Confirm";}
