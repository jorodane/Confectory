try{
 if(operation=="browse"){var page=calls.FileStreamBrowseDirectory.Invoke(Value("directory"),args["offset"]?.GetValue<int>()??0,16);var pickers=model["pickers"] as System.Text.Json.Nodes.JsonObject??new System.Text.Json.Nodes.JsonObject();pickers[view.ToString()]=System.Text.Json.JsonSerializer.SerializeToNode(page);model["pickers"]=pickers;model["status"]="Choose a folder or ProjectPack";}
 else if(operation=="create"){string title=Value("title").Trim();if(title.Length==0)throw new ArgumentException("Project name is required");if(title.Length>128||Value("description").Length>4096)throw new ArgumentException("Project information budget");string slug=System.Text.RegularExpressions.Regex.Replace(title,"[^A-Za-z0-9_]","_").Trim('_');if(slug.Length==0)slug="LocalProject";if(char.IsDigit(slug[0]))slug="P_"+slug;string parent=Value("directory"),directory=System.IO.Path.Combine(parent,slug);string handle=calls.ProjectManagerCreateProject.Invoke(manager,slug,directory,System.IO.Path.Combine(repository,"targets","dotnet","pack.cpack"));context=Open(handle,title,Value("description"),true);model["status"]="Created project; project information is a saved local draft";}
 else if(operation=="open"){string path=Value("path");if(System.IO.Directory.Exists(path))path=System.IO.Path.Combine(path,"project.cpack");context=Open(path,Value("title"),Value("description"),false);model["status"]="Project opened";}
