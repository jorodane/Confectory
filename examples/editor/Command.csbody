string Open(string path,string title,string description,bool created){string handle=created?path:calls.ProjectManagerOpen.Invoke(manager,path);var info=calls.ProjectManagerContext.Invoke(manager,handle);var existing=System.Linq.Enumerable.FirstOrDefault(projects,x=>x!["id"]!.GetValue<string>()==handle);if(existing is null){string workContext="editor";var remembered=System.Linq.Enumerable.FirstOrDefault(model["recent"]!.AsArray(),x=>x!["project"]!.GetValue<string>()==info[1]);if(!created&&remembered?["workContext"] is not null)workContext=remembered["workContext"]!.GetValue<string>();if(!created&&title==""&&remembered?["title"] is not null)title=remembered["title"]!.ToString();if(!created&&description==""&&remembered?["description"] is not null)description=remembered["description"]!.ToString();string workspace=calls.EditWorkspaceOpen.Invoke(info[1],"local-user",workContext);calls.SaveRestore.Invoke(workspace);owned.Add(handle,new[]{info[1],workspace,""});var p=new System.Text.Json.Nodes.JsonObject{["id"]=handle,["path"]=info[1],["namespace"]=info[2],["workContext"]=workContext,["entry"]=info[3],["title"]=title!=""?title:info[2],["description"]=description,["units"]=new System.Text.Json.Nodes.JsonArray(),["logs"]=new System.Text.Json.Nodes.JsonArray(),["execution"]=new System.Text.Json.Nodes.JsonObject{["state"]="idle"}};projects.Add(p);foreach(string element in calls.EditWorkspaceList.Invoke(workspace))Unit(handle,element);if(created){string infoID=info[2]+"::ProjectInfo";calls.EditWorkspaceCreate.Invoke(workspace,"object",infoID);calls.EditWorkspaceSetValue.Invoke(workspace,infoID,"title",System.Text.Json.JsonSerializer.Serialize(title));calls.EditWorkspaceSetValue.Invoke(workspace,infoID,"description",System.Text.Json.JsonSerializer.Serialize(description));calls.SaveWrite.Invoke(workspace);Unit(handle,infoID);Unit(handle,info[2]+"::ProjectManifest");}}calls.ProjectManagerSelect.Invoke(manager,handle);string selected=System.Linq.Enumerable.First(Project(handle)["uni