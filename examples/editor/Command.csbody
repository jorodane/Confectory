 else throw new ArgumentException("Unknown editor command");
}catch(Exception error){model["status"]="Error: "+error.Message;model["error"]=error.GetType().Name;}
model["serial"]=model["serial"]!.GetValue<long>()+1;model["lastOperation"]=operation;model["lastView"]=view;System.Threading.Volatile.Write(ref state[4],model.ToJsonString());return (string)state[4];}
