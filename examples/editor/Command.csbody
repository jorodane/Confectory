 else if(operation=="detach"){if(views.TryGetValue(view,out var token)){calls.ElementViewClose.Invoke(token);views.Remove(view);}publicViews.Remove(view.ToString());model["status"]="View detached; project drafts retained";}
 else if(operation=="element"){string name=Value("name"),ns=Project(context)["namespace"]!.GetValue<string>();if(!System.Text.RegularExpressions.Regex.IsMatch(name,"^[A-Za-z_][A-Za-z0-9_]*$"))throw new ArgumentException("Element ID must be an identifier");string id=ns+"::"+name;calls.EditWorkspaceCreate.Invoke(Workspace(context),Value("kind","object"),id);Unit(context,id);Unit(context,ns+"::ProjectManifest");Bind(view,context,id);model["status"]="New element and registration are local drafts";}
 else if(operation=="text"||operation=="save"||operation=="review"){
  string element=Value("element"),text=Value("text");if(args["text"] is not null){if(!calls.EditWorkspaceSetTextIfRevision.Invoke(Workspace(context),element,text,args["revision"]!.GetValue<long>()))throw new InvalidOperationException("Another draft revision changed; your text buffer is retained");Unit(context,element);}
