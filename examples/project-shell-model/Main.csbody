void Check(bool condition,string reason){if(!condition)throw new Exception(reason);}System.Text.Json.Nodes.JsonNode J(string text)=>System.Text.Json.Nodes.JsonNode.Parse(text)!;string Project(string context)=>System.Text.Json.JsonSerializer.Serialize(new{context,path=System.IO.Path.Combine(System.IO.Path.GetTempPath(),context,"project.cpack"),title=context,@namespace="Project."+context,description=""});
foreach(string bad in new[]{"null","{}","{\"context\":\"\",\"path\":\"relative\",\"title\":\"No project\"}"}){bool rejected=false;try{calls.Create.Invoke(bad);}catch(ArgumentException){rejected=true;}Check(rejected,"null-project factory must reject without opening/loading");}
string a=calls.Create.Invoke(Project("A")),b=calls.Create.Invoke(Project("B"));string Update(string token,string context,string op,string value)=>calls.Command.Invoke(token,op,System.Text.Json.JsonSerializer.Serialize(new{context,value}));
try{var first=J(Update(a,"A","draft","A local message"));Check(!first["liveProvider"]!.GetValue<bool>()&&first["project"]!["context"]!.ToString()=="A","draft retains already-open project, no provider response");Update(b,"B","draft","B isolated message");bool wrong=false;try{Update(a,"B","tab","chat");}catch(InvalidOperationException){wrong=true;}Check(wrong,"cross-project stale chat route rejected");wrong=false;try{Update(a,"","tab","chat");}catch(InvalidOperationException){wrong=true;}Check(wrong,"missing project chat route rejected");Check(J(calls.Snapshot.Invoke(a))["draft"]!.ToString()=="A local message"&&J(calls.Snapshot.Invoke(b))["draft"]!.ToString()=="B isolated message","independent contexts");
Update(a,"A","navigation","main");Check(J(calls.Snapshot.Invoke(a))["navigation"]!.ToString()=="main"&&J(calls.Snapshot.Invoke(b))["navigation"]!.ToString()=="","navigation is context-owned");Update(a,"A","navigate","logs");Check(J(calls.Snapshot.Invoke(a))["tab"]!.ToString()=="logs"&&J(calls.Snapshot.Invoke(a))["navigation"]!.ToString()=="","route closes navigation");Update(a,"A","menu","grievance");var unavailable=J(calls.Snapshot.Invoke(a))["grievance"]!;Check(!unavailable["available"]!.GetValue<bool>()&&unavailable["unresolved"] is null&&unavailable["highestUrgency"] is null,"no fabricated grievance count or urgency");Update(a,"A","navigate","chat");Update(a,"A","log","Meaningful state");Update(a,"A","log","   ");Check(J(calls.Snapshot.Invoke(a))["latestLog"]!.ToString()=="Meaningful state","empty poll cannot erase latest log");for(int i=0;i<80;i++)Update(a,"A","log","Event "+i);Check(J(calls.Snapshot.Invoke(a))["logs"]!.AsArray().Count==64,"bounded logs");Update(a,"A","tab","logs");Update(a,"A","menu","info");Check(J(calls.Snapshot.Invoke(b))["tab"]!.ToString()=="chat"&&J(calls.Snapshot.Invoke(b))["menu"]!.ToString()=="","route state is per project");calls.Close.Invoke(a);calls.Close.Invoke(a);bool disposed=false;try{calls.Snapshot.Invoke(a);}catch(ObjectDisposedException){disposed=true;}Check(disposed&&J(calls.Snapshot.Invoke(b))["draft"]!.ToString()=="B isolated message","close only owned shell, borrowed project untouched");Console.WriteLine("ProjectShell context model: no null loading, project-to-chat direction, isolation, bounded logs, offline drafts and close passed");}finally{calls.Close.Invoke(a);calls.Close.Invoke(b);}return 0;
