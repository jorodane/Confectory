void Check(bool value,string message){if(!value)throw new Exception(message);}
string project=Environment.GetEnvironmentVariable("CONFECTORY_TEST_AUTHOR_PROJECT")??throw new Exception("Explicit test project required");
string workspace=calls.EditWorkspaceOpen.Invoke(project,"participant-one","lesson");string peer=calls.EditWorkspaceOpen.Invoke(project,"participant-one","lesson"),other=calls.EditWorkspaceOpen.Invoke(project,"participant-two","lesson");
Check(workspace==peer&&workspace!=other,"Shared same user/project/work-context; independent participant");
string body="App::MainBody/body:common",manifest="App::ProjectManifest",created="App::Counter";
var subscription=calls.EditWorkspaceSubscribe.Invoke(peer,body);
string original=calls.EditWorkspaceRead.Invoke(workspace,body)[3];
try
{
 bool emptyRejected=false;try{calls.EditWorkspaceOpen.Invoke("","participant-one","lesson");}catch(ArgumentException){emptyRejected=true;}Check(emptyRejected,"No implicit/null project");
 calls.EditWorkspaceCreate.Invoke(workspace,"object",created);calls.EditWorkspaceSetValue.Invoke(workspace,created,"count","1");Check(calls.EditWorkspaceRead.Invoke(peer,created)[3].Contains("count = 1"),"Peer sees created draft");Check(!System.IO.File.Exists(System.IO.Path.Combine(System.IO.Path.GetDirectoryName(project)!,"elements","Counter.celem")),"Creation draft only");
 calls.EditWorkspaceSetText.Invoke(workspace,body,"Console.WriteLine(\"edited draft runs\"); return 0;");Check(calls.EditWorkspacePoll.Invoke(subscription).Length==7&&calls.EditWorkspacePoll.Invoke(subscription).Length==0,"Exact revision subscription");Check(calls.EditWorkspaceRead.Invoke(other,body)[3]==original,"Other participant draft unchanged");
 var preview=calls.ChangeSetPreview.Invoke(workspace,"portable");Check(preview[0]=="preview"&&preview[1]=="0"&&preview[2].Contains("edited draft runs"),"Draft functional body actually builds/runs: "+string.Join("|",preview));
 string savePath=calls.SaveWrite.Invoke(workspace);Check(System.IO.File.Exists(savePath)&&System.IO.File.ReadAllText(System.IO.Path.Combine(System.IO.Path.GetDirectoryName(project)!,"main.csbody"))==original,"Save changes no final source");
 calls.EditWorkspaceClose.Invoke(workspace);Check(calls.EditWorkspacePoll.Invoke(subscription).Length==0,"Owner close releases late subscriptions");calls.EditWorkspaceUnsubscribe.Invoke(subscription);calls.EditWorkspaceClose.Invoke(workspace);
 workspace=calls.EditWorkspaceOpen.Invoke(project,"participant-one","lesson");calls.SaveRestore.Invoke(workspace);Check(calls.EditWorkspaceRead.Invoke(workspace,created)[3].Contains("count = 1")&&calls.EditWorkspaceRead.Invoke(workspace,body)[3].Contains("edited draft runs"),"Save close/reopen restores all draft units");
 var partial=calls.ChangeSetConfirm.Invoke(workspace,new[]{created},"portable");Check(partial[0]=="invalid","Detached creation cannot publish");
 var selected=calls.ChangeSetConfirm.Invoke(workspace,new[]{body},"portable");Check(selected[0]=="confirmed","Selected body Confirm: "+string.Join("|",selected));Check(calls.EditWorkspaceRead.Invoke(workspace,created)[6]=="dirty"&&calls.EditWorkspaceRead.Invoke(workspace,manifest)[6]=="dirty"&&calls.EditWorkspaceRead.Invoke(workspace,body)[6]=="clean","Selective Confirm retains independent drafts");
 string unrelated=System.IO.Path.Combine(System.IO.Path.GetDirectoryName(project)!,"unrelated.txt");System.IO.File.WriteAllText(unrelated,"unrelated metadata");Check(calls.ChangeSetReview.Invoke(workspace,new[]{created,manifest})[0]=="ready","Unrelated source does not self-conflict");
 var publishCreation=calls.ChangeSetConfirm.Invoke(workspace,new[]{created,manifest},"portable");Check(publishCreation[0]=="confirmed","Created element registration actually validates/confirms: "+string.Join("|",publishCreation));
 calls.EditWorkspaceSetText.Invoke(workspace,body,"this is invalid C#;");var invalid=calls.ChangeSetConfirm.Invoke(workspace,new[]{body},"portable");Check(invalid[0]=="invalid"&&calls.EditWorkspaceRead.Invoke(workspace,body)[6]=="dirty","Compile failure preserves draft");
 calls.EditWorkspaceSetText.Invoke(workspace,body,"Console.WriteLine(\"second draft\"); return 0;");calls.SaveWrite.Invoke(workspace);calls.EditWorkspaceClose.Invoke(workspace);
 string finalBody=System.IO.Path.Combine(System.IO.Path.GetDirectoryName(project)!,"main.csbody");System.IO.File.WriteAllText(finalBody,"Console.WriteLine(\"external final\"); return 0;");
 workspace=calls.EditWorkspaceOpen.Invoke(project,"participant-one","lesson");calls.SaveRestore.Invoke(workspace);Check(calls.ChangeSetReview.Invoke(workspace,new[]{body})[0]=="conflict","Restore retains true old baseline");var conflict=calls.ChangeSetConfirm.Invoke(workspace,new[]{body},"portable");Check(conflict[0]=="conflict"&&System.IO.File.ReadAllText(finalBody).Contains("external final")&&calls.EditWorkspaceRead.Invoke(workspace,body)[3].Contains("second draft"),"Genuine baseline conflict preserves final and draft");
 calls.EditWorkspaceUnsubscribe.Invoke(subscription);
}
finally{calls.EditWorkspaceClose.Invoke(workspace);calls.EditWorkspaceClose.Invoke(other);}
Console.WriteLine("EditWorkspace Save/restore selective Confirm/preview/conflict PASS");return 0;
