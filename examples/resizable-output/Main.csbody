string loop=calls.Open.Invoke(),surface=calls.OpenSurface.Invoke(loop);calls.ConfigureSize.Invoke(surface,64,36);long frame=0;
try{while(true){System.Threading.Thread.Sleep(16);if(calls.Begin.Invoke(loop)==0)continue;frame++;var size=calls.RequestedSize.Invoke(surface);int width=size[0],height=size[1];var pixels=new byte[width*height*4];for(int y=0;y<height;y++)for(int x=0;x<width;x++){int at=(y*width+x)*4;pixels[at]=(byte)(frame%256);pixels[at+1]=(byte)(x*4);pixels[at+2]=(byte)(y*7);pixels[at+3]=255;}calls.Present.Invoke(surface,width,height,Convert.ToBase64String(pixels));calls.Complete.Invoke(loop);}}
finally{calls.CloseSurface.Invoke(surface);calls.Close.Invoke(loop);}
