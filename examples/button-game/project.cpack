project Example.ButtonGame version "0.1.0" {
standalone true;
registry Confectory.FrameControl "../../packs/frame-control/pack.cpack"; dependency Confectory.FrameControl version "0.1.0";
entry Example.ButtonGame::Main;
registry Confectory.BaseUI "../../packs/base-ui/pack.cpack"; dependency Confectory.BaseUI version "0.1.0";
registry Confectory.UINavigation "../../packs/ui-navigation/pack.cpack"; dependency Confectory.UINavigation version "0.1.0";
registry Confectory.RuntimeBase "../../packs/runtime-base/pack.cpack"; dependency Confectory.RuntimeBase version "0.1.0";
registry Confectory.RealTimeUpdate "../../packs/realtime-update/pack.cpack"; dependency Confectory.RealTimeUpdate version "0.1.0";
registry Confectory.Window "../../packs/window/pack.cpack"; dependency Confectory.Window version "0.1.0";
registry Confectory.RenderInput "../../packs/render-input/pack.cpack"; dependency Confectory.RenderInput version "0.1.0";
registry Confectory.Build.DotNet "../../targets/dotnet/pack.cpack"; dependency Confectory.Build.DotNet version "0.1.0";
target linux Confectory.Build.DotNet::Linux; target windows Confectory.Build.DotNet::Portable; target android Confectory.Build.DotNet::Portable;
element Main function "main.celem"; element MainBody implementation "main_body.celem"; element Score object "Score.celem";
registry Confectory.WebUI "../../packs/web-ui/pack.cpack"; dependency Confectory.WebUI version "0.1.0";
registry Confectory.BrowserHost "../../packs/browser-host/pack.cpack"; dependency Confectory.BrowserHost version "0.1.0";
registry Confectory.HostLoop "../../packs/host-loop/pack.cpack"; dependency Confectory.HostLoop version "0.1.0";
element WebStart function "WebStart.celem"; element WebStartBody implementation "WebStartBody.celem";
element WebStateBody implementation "WebStateBody.celem";
element WebInvokeBody implementation "WebInvokeBody.celem";
element WebBundle function "WebBundle.celem"; element WebBundleBody implementation "WebBundleBody.celem";
element ChangeScore function "ChangeScore.celem"; element ChangeScoreBody implementation "ChangeScoreBody.celem";
}
