project Example.AudioOutput version "0.1.0" {standalone true;
registry Confectory.RunSurface "../../packs/run-surface/pack.cpack";dependency Confectory.RunSurface version "0.1.0";
registry Confectory.FrameControl "../../packs/frame-control/pack.cpack";dependency Confectory.FrameControl version "0.1.0";
registry Confectory.Build.DotNet "../../targets/dotnet/pack.cpack";dependency Confectory.Build.DotNet version "0.1.0";
target portable Confectory.Build.DotNet::Portable;target linux Confectory.Build.DotNet::Linux;target windows Confectory.Build.DotNet::Portable;
registry Confectory.RunAudio "../../packs/run-audio/pack.cpack";dependency Confectory.RunAudio version "0.1.0";
entry Example.AudioOutput::Main;element Main function "Main.celem";element MainBody implementation "MainBody.celem";}
