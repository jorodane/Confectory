string loop=calls.Open.Invoke(),surface=calls.OpenSurface.Invoke(loop);string audio=calls.OpenAudio.Invoke(loop);long frame=0,samples=0;var clock=System.Diagnostics.Stopwatch.StartNew();long last=clock.ElapsedTicks;
try{while(true){System.Threading.Thread.Sleep(16);if(calls.Begin.Invoke(loop)==0){last=clock.ElapsedTicks;continue;}long now=clock.ElapsedTicks;int count=Math.Clamp((int)((now-last)*16000/System.Diagnostics.Stopwatch.Frequency),1,1600);last=now;frame++;var pixels=new byte[64*36*4];for(int y=0;y<36;y++)for(int x=0;x<64;x++){int at=(y*64+x)*4;pixels[at]=(byte)(frame%256);pixels[at+1]=(byte)(x*4);pixels[at+2]=(byte)(y*7);pixels[at+3]=255;}calls.Present.Invoke(surface,64,36,Convert.ToBase64String(pixels));var pcm=new byte[count*2];for(int i=0;i<count;i++){short sample=(short)Math.Round(Math.Sin((samples+i)*Math.PI*2*440/16000)*8192);System.Buffers.Binary.BinaryPrimitives.WriteInt16LittleEndian(pcm.AsSpan(i*2,2),sample);}calls.AppendAudio.Invoke(audio,Convert.ToBase64String(pcm));samples+=count;calls.Complete.Invoke(loop);}}
finally{calls.CloseAudio.Invoke(audio);calls.CloseSurface.Invoke(surface);calls.Close.Invoke(loop);}
