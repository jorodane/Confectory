lock(AppDomain.CurrentDomain){var counts=AppDomain.CurrentDomain.GetData("Example.Agent.Counts") as int[]??new int[3];AppDomain.CurrentDomain.SetData("Example.Agent.Counts",counts);var state=AppDomain.CurrentDomain.GetData("Example.Agent.Provider."+execution) as object[];
if(operation=="open"){counts[0]++;if(state is null)state=new object[]{System.Text.Json.Nodes.JsonNode.Parse(payload)!,0,false};else state[0]=System.Text.Json.Nodes.JsonNode.Parse(payload)!;AppDomain.CurrentDomain.SetData("Example.Agent.Provider."+execution,state);return "{}";}
if(operation=="cancel"){counts[1]++;if(state is null){state=new object[]{new System.Text.Json.Nodes.JsonObject(),0,true};AppDomain.CurrentDomain.SetData("Example.Agent.Provider."+execution,state);}state[2]=true;return "{}";}
if(operation=="close"){counts[2]++;AppDomain.CurrentDomain.SetData("Example.Agent.Provider."+execution,null);return "{}";}
if(operation!="next"||state is null)throw new InvalidOperationException("test provider protocol");if((bool)state[2])return "{\"kind\":\"completed\"}";var request=(System.Text.Json.Nodes.JsonNode)state[0];string? gate=request["gate"]?.GetValue<string>();if(gate is not null&&AppDomain.CurrentDomain.GetData("Example.Agent.Gate."+gate) is not true)return "{\"kind\":\"wait\"}";if(request["error"]?.GetValue<bool>()==true)throw new Exception("synthetic error; must not leak private text");var chunks=request["chunks"] as System.Text.Json.Nodes.JsonArray??new System.Text.Json.Nodes.JsonArray();int cursor=(int)state[1];if(cursor>=chunks.Count)return "{\"kind\":\"completed\"}";state[1]=cursor+1;return new System.Text.Json.Nodes.JsonObject{["kind"]="delta",["text"]=chunks[cursor]!.GetValue<string>()}.ToJsonString();}
