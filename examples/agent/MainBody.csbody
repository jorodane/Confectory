void Check(bool ok,string message){if(!ok)throw new Exception(message);}
System.Text.Json.Nodes.JsonNode Poll(string run)=>System.Text.Json.Nodes.JsonNode.Parse(calls.Poll.Invoke(run))!;
void Wait(string run,string status){var w=System.Diagnostics.Stopwatch.StartNew();while(w.ElapsedMilliseconds<3000){if(Poll(run)["state"]!.GetValue<string>()==status)return;System.Threading.Thread.Sleep(5);}throw new Exception("Expected "+status);}
string agent=calls.Open.Invoke("{\"provider\":\"deterministic-test\",\"model\":\"fake\"}");try{
string run=calls.Start.Invoke(agent,"stream","{\"gate\":\"stream\",\"chunks\":[\"one\",\"two\",\"three\"]}");Check(run==calls.Start.Invoke(agent,"stream","{\"gate\":\"stream\",\"chunks\":[\"one\",\"two\",\"three\"]}"),"duplicate execution");Check(Poll(run)["state"]!.GetValue<string>()=="running","Start must not block on provider");calls.Release.Invoke("stream");var events=new System.Collections.Generic.List<System.Text.Json.Nodes.JsonNode>();var watch=System.Diagnostics.Stopwatch.StartNew();while(watch.ElapsedMilliseconds<3000){var frame=Poll(run);foreach(var item in frame["events"]!.AsArray())events.Add(item!);if(frame["state"]!.GetValue<string>()=="completed")break;System.Threading.Thread.Sleep(5);}Check(events.Count==4&&events[0]["text"]!.GetValue<string>()=="one"&&events[2]["text"]!.GetValue<string>()=="three"&&events[3]["kind"]!.GetValue<string>()=="completed","ordered streamed chunks and terminal");for(int i=0;i<events.Count;i++)Check(events[i]["sequence"]!.GetValue<long>()==i+1,"stream sequence");
bool mismatch=false;try{calls.Start.Invoke(agent,"stream","{}");}catch(InvalidOperationException){mismatch=true;}Check(mismatch,"idempotency payload conflict");calls.CloseRun.Invoke(run);bool retired=false;try{calls.Start.Invoke(agent,"stream","{\"gate\":\"stream\",\"chunks\":[\"one\",\"two\",\"three\"]}");}catch(InvalidOperationException){retired=true;}Check(retired,"retired request cannot execute twice");
string cancel=calls.Start.Invoke(agent,"cancel","{\"gate\":\"never\",\"chunks\":[\"late\"]}");calls.Cancel.Invoke(cancel);calls.Release.Invoke("never");var cancelled=Poll(cancel);Check(cancelled["state"]!.GetValue<string>()=="cancelled"&&cancelled["events"]!.AsArray().Count==1,"one cancellation, no stale chunk");calls.Cancel.Invoke(cancel);calls.CloseRun.Invoke(cancel);calls.CloseRun.Invoke(cancel);
string fail=calls.Start.Invoke(agent,"error","{\"error\":true}");Wait(fail,"error");calls.CloseRun.Invoke(fail);
string overflow=calls.Start.Invoke(agent,"overflow","{\"chunks\":[\"1\",\"2\",\"3\",\"4\",\"5\"]}");var overflowWait=System.Diagnostics.Stopwatch.StartNew();while(overflowWait.ElapsedMilliseconds<3000){if(System.Text.Json.Nodes.JsonNode.Parse(calls.Counts.Invoke())!["close"]!.GetValue<int>()>=4)break;System.Threading.Thread.Sleep(5);}var over=Poll(overflow);Check(over["state"]!.GetValue<string>()=="error"&&over["events"]!.AsArray().Count==5&&over["events"]![4]!["text"]!.GetValue<string>()=="event-overflow","bounded queue with reserved terminal");calls.CloseRun.Invoke(overflow);
string timeout=calls.Start.Invoke(agent,"timeout","{\"gate\":\"timeout\"}");Wait(timeout,"error");calls.CloseRun.Invoke(timeout);
using(var barrier=new System.Threading.ManualResetEventSlim(false)){using var ready=new System.Threading.CountdownEvent(2);string[] duplicate=new string[2];var first=System.Threading.Tasks.Task.Run(()=>{ready.Signal();barrier.Wait();duplicate[0]=calls.Start.Invoke(agent,"parallel","{\"gate\":\"parallel\"}");});var second=System.Threading.Tasks.Task.Run(()=>{ready.Signal();barrier.Wait();duplicate[1]=calls.Start.Invoke(agent,"parallel","{\"gate\":\"parallel\"}");});Check(ready.Wait(2000),"both callers ready");barrier.Set();System.Threading.Tasks.Task.WaitAll(first,second);Check(duplicate[0]==duplicate[1],"simultaneous retry creates one execution");calls.CloseRun.Invoke(duplicate[0]);}
string cleanup=calls.Start.Invoke(agent,"cleanup","{\"cleanupGate\":\"cleanup-fix\"}");Wait(cleanup,"completed");bool cleanupFailed=false;try{calls.CloseRun.Invoke(cleanup);}catch(InvalidOperationException){cleanupFailed=true;}Check(cleanupFailed&&Poll(cleanup)["state"]!.GetValue<string>()=="completed","failed provider cleanup retains owner");calls.Release.Invoke("cleanup-fix");calls.CloseRun.Invoke(cleanup);
string owned=calls.Start.Invoke(agent,"owned","{\"gate\":\"owned\"}");calls.Close.Invoke(agent);calls.Close.Invoke(agent);bool closed=false;try{calls.Poll.Invoke(owned);}catch(ObjectDisposedException){closed=true;}Check(closed,"Agent close releases owned run");var count=System.Text.Json.Nodes.JsonNode.Parse(calls.Counts.Invoke())!;Check(count["open"]!.GetValue<int>()==count["close"]!.GetValue<int>(),"provider owners released exactly once");Console.WriteLine("Agent simulated async stream/cancel/error/timeout/bounds/idempotency/cleanup PASS");return 0;
}finally{calls.Close.Invoke(agent);}
