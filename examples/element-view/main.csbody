void Check(bool value,string message){if(!value)throw new Exception(message);}
string project=Environment.GetEnvironmentVariable("CONFECTORY_TEST_AUTHOR_PROJECT")??throw new Exception("Explicit project required");string workspace=calls.EditWorkspaceOpen.Invoke(project,"participant","view-consumer");
string card=calls.ElementViewCreate.Invoke(workspace,"App::Counter","card",480,760),table=calls.ElementViewCreate.Invoke(workspace,"App::Counter","table",480,760);
try
{
 string cardIdentity=calls.ElementViewInfo.Invoke(card)[3],tableIdentity=calls.ElementViewInfo.Invoke(table)[3];Check(cardIdentity!=tableIdentity,"Independent View identity");Check(!calls.ElementViewPoll.Invoke(card)&&!calls.ElementViewPoll.Invoke(table),"No idle recreation/redraw");
 calls.EditWorkspaceSetValue.Invoke(workspace,"App::Counter","count","1");Check(calls.ElementViewPoll.Invoke(card)&&calls.ElementViewPoll.Invoke(table),"Shared unit independent projections");Check(calls.ElementViewLabels.Invoke(card,"")[2].Contains("count = 1")&&calls.ElementViewLabels.Invoke(table,"")[2].Contains("count = 1"),"Card/table same actual draft");Check(calls.ElementViewInfo.Invoke(card)[3]==cardIdentity&&calls.ElementViewInfo.Invoke(table)[3]==tableIdentity,"Stable Views on model update");
 var rect=calls.ElementViewLayout.Invoke(card);int x=rect[20]+2,y=rect[21]+2;Check(calls.ElementViewInput.Invoke(card,1,x,y,0,0)==-1&&calls.ElementViewInput.Invoke(card,2,-1,-1,0,0)==-1,"Release outside cancels intent");Check(calls.ElementViewInput.Invoke(table,2,x,y,0,0)==0,"Pressed state isolated");
 calls.ElementViewInput.Invoke(card,1,x,y,0,0);calls.ElementViewInput.Invoke(card,9,0,0,0,0);Check(calls.ElementViewInput.Invoke(card,2,x,y,0,0)==0,"Focus loss cancels press");calls.ElementViewInput.Invoke(card,7,640,900,0,0);Check(calls.ElementViewLayout.Invoke(card)[2]!=rect[2]&&calls.ElementViewLayout.Invoke(table)[2]==rect[2],"Resize independent");
 calls.ElementViewClose.Invoke(card);calls.ElementViewClose.Invoke(card);Check(calls.EditWorkspaceRead.Invoke(workspace,"App::Counter")[3].Contains("count = 1"),"View disposal does not dispose data");card=calls.ElementViewCreate.Invoke(workspace,"App::Counter","card",480,760);Check(calls.ElementViewLabels.Invoke(card,"")[2].Contains("count = 1"),"Reopened reusable View retains draft");
 calls.EditWorkspaceCreate.Invoke(workspace,"concept","App::Idea");Check(calls.ElementViewPoll.Invoke(table),"Aggregate membership update");calls.ElementViewBind.Invoke(card,"App::Idea");Check(calls.ElementViewInfo.Invoke(table)[1]=="App::Counter"&&calls.ElementViewLabels.Invoke(card,"")[0].Contains("concept"),"View selections independent, concepts reusable outside tables");
}
finally{calls.ElementViewClose.Invoke(card);calls.ElementViewClose.Invoke(table);calls.EditWorkspaceClose.Invoke(workspace);}
string owner="cancel-owner";
var job=System.Threading.Tasks.Task.Run(()=>{calls.SchemaEditingBeginScope.Invoke(owner);try{calls.SchemaEditingCall.Invoke("run",new System.Text.Json.Nodes.JsonObject{["project"]=project,["target"]="portable"}.ToJsonString());return false;}catch(Exception){return true;}finally{calls.SchemaEditingEndScope.Invoke();}});
var wait=System.Diagnostics.Stopwatch.StartNew();while(calls.SchemaEditingPending.Invoke(owner)==0&&wait.ElapsedMilliseconds<5000)System.Threading.Thread.Sleep(5);Check(calls.SchemaEditingPending.Invoke(owner)==1,"Scoped tool job became pending");calls.SchemaEditingCancel.Invoke(owner);Check(job.Wait(5000)&&job.Result&&calls.SchemaEditingPending.Invoke(owner)==0,"Owned cancellation terminates process and unregisters job");
calls.SchemaEditingBeginScope.Invoke("other-owner");try{Check(calls.SchemaEditingInspect.Invoke("object App::Probe { }").Contains("App::Probe"),"Unrelated owner survives cancellation");}finally{calls.SchemaEditingEndScope.Invoke();}
Console.WriteLine("ElementView shared card/table persistent lifetime/selection PASS");return 0;
